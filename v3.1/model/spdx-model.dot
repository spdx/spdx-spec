# Na555acc21adf43cfa5e062a3486384f7 node258
node258 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na555acc21adf43cfa5e062a3486384f7</B></td></tr><tr><td href='Na555acc21adf43cfa5e062a3486384f7' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na555acc21adf43cfa5e062a3486384f7</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, from must be an Action or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/createdBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/DefinedProcess&gt; }
}&quot;</td></tr></table> > ] 
