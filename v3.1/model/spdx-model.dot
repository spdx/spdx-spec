# N1cb14e30dcb64d9a9145bfa714ccd11e node1787
node1787 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N1cb14e30dcb64d9a9145bfa714ccd11e</B></td></tr><tr><td href='N1cb14e30dcb64d9a9145bfa714ccd11e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N1cb14e30dcb64d9a9145bfa714ccd11e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasAssociatedVulnerability, to must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasAssociatedVulnerability&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
