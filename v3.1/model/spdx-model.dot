# N05883d4c9e6d4fe6a028f49d407cfd57 node444
node444 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N05883d4c9e6d4fe6a028f49d407cfd57</B></td></tr><tr><td href='N05883d4c9e6d4fe6a028f49d407cfd57' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N05883d4c9e6d4fe6a028f49d407cfd57</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/createdBy&gt; .
    $this &lt;Core/to&gt; ?to .
