# N0dd003dd4d3b46fd91e25c248410f916 node1283
node1283 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N0dd003dd4d3b46fd91e25c248410f916</B></td></tr><tr><td href='N0dd003dd4d3b46fd91e25c248410f916' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N0dd003dd4d3b46fd91e25c248410f916</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is resolved, to must be an OutOfSpecAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/resolved&gt; .
    $this &lt;Core/to&gt; ?to .
