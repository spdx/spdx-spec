# https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ark node128
node128 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>ark</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ark' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ark</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;[Archival Resource Key (ARK)](https://arks.org/about/), is a Uniform Resource Identifier (URI) suited to being a persistent identifier for information objects of any type, standardized by the [ARK Identifier Scheme](https://datatracker.ietf.org/doc/draft-kunze-ark/) Internet-Draft. It consists of the &quot;ark:&quot; label followed by a Name Assigning Authority Number, a forward slash, a name, and an optional qualifier (e.g., `ark:12148/btv1b8449691v/f29`).&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/supplyChain node129
node129 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>supplyChain</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/supplyChain' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/supplyChain</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The element follows the SupplyChain profile specification.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3.1/terms/Software/ContentIdentifierType/swhid node130
node130 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>swhid</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Software/ContentIdentifierType/swhid' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Software/ContentIdentifierType/swhid</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;SoftWare Hash IDentifier, a persistent intrinsic identifier for digital artifacts, such as files, trees (also known as directories or folders), commits, and other objects typically found in version control systems. The format of the identifiers is defined in the [SWHID specification](https://www.swhid.org/swhid-specification/v1.2/) ([ISO/IEC 18670](https://www.iso.org/standard/89985.html)). They typically look like `swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2`.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/isan node131
node131 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>isan</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/isan' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/isan</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;[International Standard Audiovisual Number (ISAN)](https://www.isan.org/about/#what_is_isan) is a unique 24-digit hexadecimal identifier for audiovisual works standardized by [ISO 15706](https://www.iso.org/standard/83124.html). The ISAN remains persistent for a work regardless of its distribution format or its use. To facilitate human readability, the &quot;ISAN&quot; label, grouping hyphens, and two check characters are included (e.g., `ISAN 0000-0000-3A8D-0000-Z-0000-0000-6`); however, these elements shall be omitted when the identifier is stored electronically (e.g., `000000003A8D000000000000`).&quot;@en</td></tr></table> > ] 
