node1662 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ncb0850e963bd43be8c9b5d356a553bb8</B></td></tr><tr><td href='Ncb0850e963bd43be8c9b5d356a553bb8' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ncb0850e963bd43be8c9b5d356a553bb8</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasDeclaredLicense, to must be an AnyLicenseInfo&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
