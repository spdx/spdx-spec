# Na206b61ce02d44b9b40ebbd20ab2d34c node1160
node1160 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na206b61ce02d44b9b40ebbd20ab2d34c</B></td></tr><tr><td href='Na206b61ce02d44b9b40ebbd20ab2d34c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na206b61ce02d44b9b40ebbd20ab2d34c</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/createdBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
