node627 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>conformsTo</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipType/conformsTo' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipType/conformsTo</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The `from` Element conforms to each `to` /FunctionalSafety/Assumption or Specification.&quot;@en</td></tr></table> > ] 
