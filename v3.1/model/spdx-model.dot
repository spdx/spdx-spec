node1292 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N00d6c10389b248b3a4aeee2fcce231c0</B></td></tr><tr><td href='N00d6c10389b248b3a4aeee2fcce231c0' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N00d6c10389b248b3a4aeee2fcce231c0</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
