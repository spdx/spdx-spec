# Neb9357dbc4c549b39af2f4cd07cc3751 node1534
node1534 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Neb9357dbc4c549b39af2f4cd07cc3751</B></td></tr><tr><td href='Neb9357dbc4c549b39af2f4cd07cc3751' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Neb9357dbc4c549b39af2f4cd07cc3751</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is coordinatedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
