# N5e483fe26ba34fdf8be79d4e1c547aa4 node1977
node1977 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N5e483fe26ba34fdf8be79d4e1c547aa4</B></td></tr><tr><td href='N5e483fe26ba34fdf8be79d4e1c547aa4' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N5e483fe26ba34fdf8be79d4e1c547aa4</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is doesNotAffect, class must be VexNotAffectedVulnAssessmentRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/doesNotAffect&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Security/VexNotAffectedVulnAssessmentRelationship&gt; }
}&quot;</td></tr></table> > ] 
