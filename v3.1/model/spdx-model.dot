# Nfe891e0caf9a4b549b4f8acde4d9d57a node1797
node1797 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nfe891e0caf9a4b549b4f8acde4d9d57a</B></td></tr><tr><td href='Nfe891e0caf9a4b549b4f8acde4d9d57a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nfe891e0caf9a4b549b4f8acde4d9d57a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, from must be an Action or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
