# N82c644a99cd74aa48625e46d04cb9ae0 node1862
node1862 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N82c644a99cd74aa48625e46d04cb9ae0</B></td></tr><tr><td href='N82c644a99cd74aa48625e46d04cb9ae0' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N82c644a99cd74aa48625e46d04cb9ae0</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is implementedBy, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/implementedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
