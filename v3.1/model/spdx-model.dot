node1396 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N707f1b155a9c411e8dee1de50af454ed</B></td></tr><tr><td href='N707f1b155a9c411e8dee1de50af454ed' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N707f1b155a9c411e8dee1de50af454ed</font></td></tr></table> > ] 
