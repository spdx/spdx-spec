# Nca5a7e9c5ce145bc97346e9db14df5cf node1695
node1695 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nca5a7e9c5ce145bc97346e9db14df5cf</B></td></tr><tr><td href='Nca5a7e9c5ce145bc97346e9db14df5cf' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nca5a7e9c5ce145bc97346e9db14df5cf</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is reportedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/reportedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
