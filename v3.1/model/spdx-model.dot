# N4e845ad472a54887bc4640e355cd98c9 node1748
node1748 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N4e845ad472a54887bc4640e355cd98c9</B></td></tr><tr><td href='N4e845ad472a54887bc4640e355cd98c9' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N4e845ad472a54887bc4640e355cd98c9</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is reportedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
