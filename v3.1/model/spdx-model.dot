node228 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8f4046e8e70a469c9df64a5786a4f31e</B></td></tr><tr><td href='N8f4046e8e70a469c9df64a5786a4f31e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8f4046e8e70a469c9df64a5786a4f31e</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:minCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
