node222 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N433fa4daa4554f6b953e5aa17877c230</B></td></tr><tr><td href='N433fa4daa4554f6b953e5aa17877c230' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N433fa4daa4554f6b953e5aa17877c230</font></td></tr></table> > ] 
