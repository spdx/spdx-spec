# https://spdx.org/rdf/3/terms/Core/RelationshipType/hasProvidedDependency node1289
node1289 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>hasProvidedDependency</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipType/hasProvidedDependency' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipType/hasProvidedDependency</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The `from` Element has a dependency on each `to` Element, dependency is not in the distributed artifact, but assumed to be provided, during a LifecycleScopeType period.&quot;@en</td></tr></table> > ] 
