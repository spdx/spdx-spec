# N28a23c43d08f4b39b38ca7e62637ca9e node1680
node1680 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N28a23c43d08f4b39b38ca7e62637ca9e</B></td></tr><tr><td href='N28a23c43d08f4b39b38ca7e62637ca9e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N28a23c43d08f4b39b38ca7e62637ca9e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is publishedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/publishedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
