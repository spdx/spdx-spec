# N22f071170a7243e784b06010c8dff3f6 node1291
node1291 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N22f071170a7243e784b06010c8dff3f6</B></td></tr><tr><td href='N22f071170a7243e784b06010c8dff3f6' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N22f071170a7243e784b06010c8dff3f6</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is reportedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/reportedBy&gt; .
    $this &lt;Core/to&gt; ?to .
