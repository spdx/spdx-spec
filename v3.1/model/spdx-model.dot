# N37d8141e1a1748deb6573e79e1719fa4 node1210
node1210 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N37d8141e1a1748deb6573e79e1719fa4</B></td></tr><tr><td href='N37d8141e1a1748deb6573e79e1719fa4' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N37d8141e1a1748deb6573e79e1719fa4</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is tracedToDetail, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/tracedToDetail&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
