# N878b2ca80d89478d9e733b1856375bab node1170
node1170 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N878b2ca80d89478d9e733b1856375bab</B></td></tr><tr><td href='N878b2ca80d89478d9e733b1856375bab' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N878b2ca80d89478d9e733b1856375bab</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is invokedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
