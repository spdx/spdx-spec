# N183b0945d2ed490ebc93a5f10e13c226 node1350
node1350 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N183b0945d2ed490ebc93a5f10e13c226</B></td></tr><tr><td href='N183b0945d2ed490ebc93a5f10e13c226' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N183b0945d2ed490ebc93a5f10e13c226</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is underInvestigationFor, class must be VexUnderInvestigationVulnAssessmentRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
