node621 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>additionalInformationSpecification</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Hardware/additionalInformationSpecification' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Hardware/additionalInformationSpecification</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;It is the authoritative or credible entity, document, or body of knowledge that provides the meaning of an additionalInformation key and/or its values, ensuring accuracy, context, and standardization.&quot;@en</td></tr></table> > ] 
