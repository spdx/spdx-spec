# N747d8e0d68704455aea6bafe55e605a2 node1975
node1975 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N747d8e0d68704455aea6bafe55e605a2</B></td></tr><tr><td href='N747d8e0d68704455aea6bafe55e605a2' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N747d8e0d68704455aea6bafe55e605a2</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is runsOn, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/runsOn&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
