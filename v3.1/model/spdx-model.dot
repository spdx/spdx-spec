# Nbe9b5ffb57414fb3a72f675da8e3b45a node1345
node1345 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nbe9b5ffb57414fb3a72f675da8e3b45a</B></td></tr><tr><td href='Nbe9b5ffb57414fb3a72f675da8e3b45a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nbe9b5ffb57414fb3a72f675da8e3b45a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasDeclaredLicense, to must be an AnyLicenseInfo&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
