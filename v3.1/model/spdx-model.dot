node953 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>nuget</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/nuget' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/nuget</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A reference to a NuGet package. The package locator format is defined in the [NuGet documentation](https://docs.nuget.org) and looks like `package/version`.&quot;@en</td></tr></table> > ] 
