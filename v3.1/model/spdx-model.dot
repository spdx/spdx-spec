# Nb4ad9ce154cc4ebe839cb2b464c91d94 node403
node403 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb4ad9ce154cc4ebe839cb2b464c91d94</B></td></tr><tr><td href='Nb4ad9ce154cc4ebe839cb2b464c91d94' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb4ad9ce154cc4ebe839cb2b464c91d94</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is affects, from must be a Vulnerability, Action, or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/affects&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
