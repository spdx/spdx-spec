# N9cf4fcc7c6b04c0690eae659a3f7dc77 node1384
node1384 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N9cf4fcc7c6b04c0690eae659a3f7dc77</B></td></tr><tr><td href='N9cf4fcc7c6b04c0690eae659a3f7dc77' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N9cf4fcc7c6b04c0690eae659a3f7dc77</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is implementedBy, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/implementedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
