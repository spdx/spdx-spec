# Nba89f7cfb0de439ca4931e1f7d332f39 node29
node29 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nba89f7cfb0de439ca4931e1f7d332f39</B></td></tr><tr><td href='Nba89f7cfb0de439ca4931e1f7d332f39' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nba89f7cfb0de439ca4931e1f7d332f39</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is doesNotAffect, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/doesNotAffect&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
# N8e1348a55588436cbd82224a87585dce node30
