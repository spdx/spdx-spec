node0 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>additionalInformationSpecification</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/additionalInformationSpecification' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/additionalInformationSpecification</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;An authoritative or credible entity, document, or body of knowledge
that provides the meaning of an `additionalInformation` key and/or its values,
ensuring accuracy, context, and standardization.&quot;@en</td></tr></table> > ] 
# N4a7c530bb49147709e2f32d9e91161ef node1
node1 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N4a7c530bb49147709e2f32d9e91161ef</B></td></tr><tr><td href='N4a7c530bb49147709e2f32d9e91161ef' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N4a7c530bb49147709e2f32d9e91161ef</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is performedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/performedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/inspection node2
node2 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>inspection</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/inspection' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/inspection</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A thorough examination or checking of documentation, records, processes, or systems to confirm compliance or adherence. An inspection needs to have a defined set of acceptance criteria (e.g. a checklist), a documentation of roles involved in the inspection (e.g. to document the inspector&#x27;s independence) and a clear documentation of when and how it was performed.&quot;@en</td></tr></table> > ] 
# Nac1d55d1a37444cc859e485c5a268769 node3
node3 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nac1d55d1a37444cc859e485c5a268769</B></td></tr><tr><td href='Nac1d55d1a37444cc859e485c5a268769' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nac1d55d1a37444cc859e485c5a268769</font></td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/requirement node4
node4 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>requirement</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/requirement' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/requirement</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The Element provides a requirement needed as input for another Element.&quot;@en</td></tr></table> > ] 
# N4651ceb35438413e85172dee2aeb3190 node5
node5 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N4651ceb35438413e85172dee2aeb3190</B></td></tr><tr><td href='N4651ceb35438413e85172dee2aeb3190' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N4651ceb35438413e85172dee2aeb3190</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is invokedBy, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
# N29ab687f39214e24a73553fa93ed1915 node6
node6 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N29ab687f39214e24a73553fa93ed1915</B></td></tr><tr><td href='N29ab687f39214e24a73553fa93ed1915' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N29ab687f39214e24a73553fa93ed1915</font></td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ismn node7
node7 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>ismn</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ismn' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ismn</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;[International Standard Music Number (ISMN)](https://ismn-international.org/ismn/the-ismn/) is a unique numeric identifier for printed music (notated music) standardized by [ISO 10957](https://www.iso.org/standard/83122.html). It consists of either 10 characters (starting with the letter &quot;M&quot; for assignments prior to January 1, 2008) or 13 digits. A 13-digit ISMN is composed of four parts: the GS1 prefix `979-0`, a registrant element, an item element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., `9790006538424`).&quot;@en</td></tr></table> > ] 
