# Nbd1ff7c498344378841f16c68769b05e node1398
node1398 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nbd1ff7c498344378841f16c68769b05e</B></td></tr><tr><td href='Nbd1ff7c498344378841f16c68769b05e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nbd1ff7c498344378841f16c68769b05e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is performedBy, from must be an Action&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/performedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
}&quot;</td></tr></table> > ] 
