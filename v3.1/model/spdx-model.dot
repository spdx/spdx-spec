# Nf60b772b7b3a45d49cf7e3694e28851b node1
node1 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf60b772b7b3a45d49cf7e3694e28851b</B></td></tr><tr><td href='Nf60b772b7b3a45d49cf7e3694e28851b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf60b772b7b3a45d49cf7e3694e28851b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is implementedBy, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/implementedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
