# N5af09bf156be4e639536880eaeccc59a node1781
node1781 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N5af09bf156be4e639536880eaeccc59a</B></td></tr><tr><td href='N5af09bf156be4e639536880eaeccc59a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N5af09bf156be4e639536880eaeccc59a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is conformsTo, to must be an Assumption or Specification&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
