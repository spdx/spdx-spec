node1847 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N3bfb6d9c1e774dc7ab6a17f1f4e69940</B></td></tr><tr><td href='N3bfb6d9c1e774dc7ab6a17f1f4e69940' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N3bfb6d9c1e774dc7ab6a17f1f4e69940</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is runsOn, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
