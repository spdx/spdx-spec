# Nb1ef35808ca94de781d340a16f3fa652 node864
node864 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb1ef35808ca94de781d340a16f3fa652</B></td></tr><tr><td href='Nb1ef35808ca94de781d340a16f3fa652' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb1ef35808ca94de781d340a16f3fa652</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasContactPoint, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasContactPoint&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
