# N6fe36365475940be9a7d06e214ded33d node609
node609 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N6fe36365475940be9a7d06e214ded33d</B></td></tr><tr><td href='N6fe36365475940be9a7d06e214ded33d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N6fe36365475940be9a7d06e214ded33d</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasInput, from must be a Build, DefinedProcess, or Action&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
