# N3e43ad8bd4e046fa91ab81f758985ff8 node977
node977 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N3e43ad8bd4e046fa91ab81f758985ff8</B></td></tr><tr><td href='N3e43ad8bd4e046fa91ab81f758985ff8' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N3e43ad8bd4e046fa91ab81f758985ff8</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasProvidedDependency, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasProvidedDependency&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
# Nf951d26726dd4ef4ba652be9b6580664 node978
node978 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf951d26726dd4ef4ba652be9b6580664</B></td></tr><tr><td href='Nf951d26726dd4ef4ba652be9b6580664' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf951d26726dd4ef4ba652be9b6580664</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasInstall, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasInstall&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Artifact&gt; }
}&quot;</td></tr></table> > ] 
