# N606b4213c5824253b7234e4b008f0cec node1421
node1421 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N606b4213c5824253b7234e4b008f0cec</B></td></tr><tr><td href='N606b4213c5824253b7234e4b008f0cec' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N606b4213c5824253b7234e4b008f0cec</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is serializedInArtifact, from must be a SpdxDocument&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
