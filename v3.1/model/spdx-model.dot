# Nc75e3707372541bbbc2c50b8a824a1a6 node1079
node1079 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nc75e3707372541bbbc2c50b8a824a1a6</B></td></tr><tr><td href='Nc75e3707372541bbbc2c50b8a824a1a6' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nc75e3707372541bbbc2c50b8a824a1a6</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, to must be a Relationship whose relationshipType is invokedBy&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
