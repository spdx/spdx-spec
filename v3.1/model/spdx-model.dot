node501 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nbeff4032886643d18ffce8ab78e69a48</B></td></tr><tr><td href='Nbeff4032886643d18ffce8ab78e69a48' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nbeff4032886643d18ffce8ab78e69a48</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
