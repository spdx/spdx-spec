["_:N8177aa4b0d9f45c0bbf3da8baa65f63f", "http://www.w3.org/ns/shacl#hasValue", "https://spdx.org/rdf/3/terms/Core/Location", "globalId", "", ""]
["_:N21ab1b0b798546ec9f9f9b932f2d1ea6", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:N09aa4898a3614efdb398723b0f06cd55", "localId", "", ""]
["https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel/highAutomation", "http://www.w3.org/2000/01/rdf-schema#comment", "Level 4 - High automation. The system performs parts of its mission without external intervention.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Security/publishedTime", "http://www.w3.org/2000/01/rdf-schema#comment", "Specifies the time when a vulnerability was published.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
