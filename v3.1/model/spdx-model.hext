["https://spdx.org/rdf/3.1/terms/Core/RelationshipType/evaluatedOn", "http://www.w3.org/2000/01/rdf-schema#comment", "The `from` Element has been evaluated on the `to` Element(s).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
