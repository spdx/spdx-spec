["https://spdx.org/rdf/3.1/terms/FunctionalSafety/verificationPrecondition", "http://www.w3.org/2000/01/rdf-schema#comment", "Verification preconditions are initial criteria that are to be met prior to initiating the verification method.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Operations/assessmentTime", "http://www.w3.org/2000/01/rdf-schema#range", "http://www.w3.org/2001/XMLSchema#dateTimeStamp", "globalId", "", ""]
