["https://spdx.org/rdf/3/terms/Core/RelationshipType/expandsTo", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Core/RelationshipType", "globalId", "", ""]
