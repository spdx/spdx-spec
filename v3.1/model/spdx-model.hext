["https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/purchaseOrder", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Security/withdrawnTime", "http://www.w3.org/2000/01/rdf-schema#comment", "Specified the time and date when a vulnerability was withdrawn.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
