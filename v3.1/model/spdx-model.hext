["_:Ne6d38046460b427b9ecaecba8088a38f", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/module", "globalId", "", ""]
