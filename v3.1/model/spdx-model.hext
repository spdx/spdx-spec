["https://spdx.org/rdf/3/terms/Core/quantity", "http://www.w3.org/2000/01/rdf-schema#comment", "Quantity is the amount in the selected QUDT unit.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
