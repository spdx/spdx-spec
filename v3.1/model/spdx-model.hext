["https://spdx.org/rdf/3/terms/SupplyChain/ResponsibilityType/custody", "http://www.w3.org/2000/01/rdf-schema#comment", "Custody refers to the responsibility, control, and safekeeping of an asset, person, or legal entity. It involves both physical possession and legal authority over something or someone.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/SpecificationType/specification", "http://www.w3.org/2000/01/rdf-schema#comment", "A specification is a detailed document (or set of documents) that describes the requirements, design, behavior, or other characteristics of a system, component, or process so that all stakeholders have a clear, unambiguous reference.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N21fd5826efd74a9f8b3bc1387f668154", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/rorid", "globalId", "", ""]
