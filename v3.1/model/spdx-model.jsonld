    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The amount or measure of a bulk product."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/UnitOfMeasure"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/postalName",
