        "@id": "_:N9ad910294061472ebca6f0b1e1b1acc0"
      }
    ]
  },
  {
    "@id": "_:N9ad910294061472ebca6f0b1e1b1acc0",
    "http://www.w3.org/ns/shacl#message": [
