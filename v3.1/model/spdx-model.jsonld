      {
        "@id": "http://www.w3.org/2001/XMLSchema#positiveInteger"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/phoneNumber",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
