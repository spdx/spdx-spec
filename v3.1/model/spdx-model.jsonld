      {
        "@language": "en",
        "@value": "Limited distribution - organization and clients. The dataset shall be shared only with specific organizations and their clients on a need-to-know basis."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "amber"
      }
    ]
  },
