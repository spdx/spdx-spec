      {
        "@language": "en",
        "@value": "Used when the type does not match any of the other options."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "other"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Software/contentIdentifier",
