    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Limited distribution - organization only. The dataset shall be shared only with specific organizations on a need-to-know basis."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "amberStrict"
      }
    ]
  },
