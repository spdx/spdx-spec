    "@id": "https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType/query",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Dataset is publicly available, but not all at once, and can only be accessed through queries which return parts of the dataset."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
