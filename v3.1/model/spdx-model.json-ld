        "@value": "Stock Keeping Unit (SKU) identifier, assigned by an organization to track sales and inventory for a specific product or service offering."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "sku"
      }
    ]
  },
