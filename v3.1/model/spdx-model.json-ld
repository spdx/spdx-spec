        "@value": "A reference to the [security threat model](https://en.wikipedia.org/wiki/Threat_model) for the package."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "securityThreatModel"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/SupplyChain/plannedCurrent",
