        "@value": "A reference the [security threat model](https://en.wikipedia.org/wiki/Threat_model) for a package."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "securityThreatModel"
      }
    ]
  },
