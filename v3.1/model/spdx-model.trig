            ns1:HashAlgorithm ;
        rdfs:label "falcon" ;
        rdfs:comment "[FALCON](https://falcon-sign.info/falcon.pdf)"@en .

    <https://spdx.org/rdf/3/terms/Core/HashAlgorithm/md2> a owl:NamedIndividual,
            ns1:HashAlgorithm ;
