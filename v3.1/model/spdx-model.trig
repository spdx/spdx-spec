        sh:nodeKind sh:IRI ;
        sh:property _:N2faba29e24814e1f900abd059b4bf6b3,
            _:N31e28affebac4247bbbf400e53f8de41,
            _:N49913cf53e9a438198248bbdbbfbec82,
            _:N49dc82237c454d218306e8a63f59b702,
            _:N983ed140f127471297d263dbb406f200,
            _:Nc158826cddd44697a8d4f135c9594a3d,
            _:Nc3e5a9db9099434e958ec4efc4523d7c,
            _:Nd0d9f05d615d4f3aa12bef4bd935442e,
            _:Nf3d55a634f484bc185db522e9106e27e .

