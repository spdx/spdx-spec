        sh:nodeKind sh:IRI ;
        sh:property _:N08577cf778be4cc6bf28feeab8c5bf23,
            _:N14b1b79d237d4452a9955cdd698861ce,
            _:N1c3c61d883cb46058d61fbce157b172a,
