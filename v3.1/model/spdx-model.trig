        sh:nodeKind sh:IRI ;
        sh:property _:N034bdf49886848b6957d1e0d51ed6a79,
            _:N84f4f20645ef41b2b8fdbb750bb41a29,
            _:Nc8498216d7624ff5a4aab55c854b333e .

