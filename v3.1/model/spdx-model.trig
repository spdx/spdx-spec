    _:Nf2d939cb5ef342be91e46752a3629d0a a sh:SPARQLConstraint ;
        sh:message "When relationship is reportedBy, from must be a Vulnerability" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/reportedBy> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }
}""" .

