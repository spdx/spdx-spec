        sh:nodeKind sh:IRI ;
        sh:property _:N10e3a91b692844509b7c4930ad3d4372,
            _:Nd7e83c7807664b5e9ef6f45f6c444580 .

    ns2:OrLaterOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing this version, or any later version,
of the indicated License."""@en ;
        rdfs:subClassOf ns2:ExtendableLicense ;
        sh:nodeKind sh:IRI ;
        sh:property _:Nc20bf7b9137640e8bd875560ea674104 .

    ns2:WithAdditionOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing a License which has additional
text applied to it."""@en ;
