        rdfs:range xsd:boolean .

    ns2:isDeprecatedLicenseId a owl:DatatypeProperty ;
        rdfs:comment """Specifies whether a license or additional text identifier has been marked as
deprecated."""@en ;
        rdfs:range xsd:boolean .

    ns2:isFsfLibre a owl:DatatypeProperty ;
