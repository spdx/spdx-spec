            _:N5e76baadf09b46748dcd4112c198e24d,
            _:Nb354172af2c843c0a9070e04996eb498,
            _:Nbb959e809c4146cab48620674ddc9973,
            _:Ne1600afaeb014c2995f1002309bf1a4e,
            _:Nff895aae62464d5190b10b2cf2887cca .

    <https://spdx.org/rdf/3/terms/Core/ProcessReadinessType/active> a owl:NamedIndividual,
            ns1:ProcessReadinessType ;
        rdfs:label "active" ;
        rdfs:comment "In use."@en .

