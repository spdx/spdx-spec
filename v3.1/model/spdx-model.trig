        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:property _:N2e9fed4c396c4a70b4a7e7fa7b352e8f,
            _:N4a7a2e00830147d696d7cdd94aa11f76,
            _:Nad5cd80e6db3460fb6a009bbc0dfa367 .

