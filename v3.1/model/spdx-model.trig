        rdfs:range ns2:ConfidentialityLevelType .

    ns2:dataCollectionProcess a owl:DatatypeProperty ;
        rdfs:comment "How the dataset was collected."@en ;
        rdfs:range xsd:string .

    ns2:dataPreprocessing a owl:DatatypeProperty ;
        rdfs:comment "Preprocessing steps that were applied to the raw data to create the given dataset."@en ;
        rdfs:range xsd:string .

    ns2:datasetAvailability a owl:ObjectProperty ;
