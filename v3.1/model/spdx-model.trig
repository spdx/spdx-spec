        sh:nodeKind sh:IRI ;
        sh:property _:N13cf3ac906bc41cb90d99faee3ab7a3e,
            _:N14568cd31cee40228aeb185f4f6bc88f,
            _:N1e5d059b5a374b83a1a0b73e6821fa2a,
            _:N5aa8bae0ce0348379db2fb3f19791b52,
            _:N623941f83471457aa4a2882cd790c01c,
            _:N6be9a435b91b40c389f8ec57b211ad00,
            _:N7905e98a973e4f18a07950964d676a90,
