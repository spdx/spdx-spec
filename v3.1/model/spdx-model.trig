        rdfs:range xsd:string .

    ns9:datasetAvailability a owl:ObjectProperty ;
        rdfs:comment "Availability of a dataset."@en ;
        rdfs:range ns9:DatasetAvailabilityType .

    ns9:datasetNoise a owl:DatatypeProperty ;
        rdfs:comment "Potentially noisy elements of the dataset."@en ;
        rdfs:range xsd:string .

