        sh:nodeKind sh:IRI ;
        sh:property _:N402b686ba82445f88c09551fad37abf0,
            _:N958569ad0b214b0c82f1530d05258371 .

    ns5:OrLaterOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing this version, or any later version,
of the indicated License."""@en ;
        rdfs:subClassOf ns5:ExtendableLicense ;
        sh:nodeKind sh:IRI ;
        sh:property _:N614603c6ae1a428fba75f1ac0d264112 .

    ns5:WithAdditionOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing a License which has additional
text applied to it."""@en ;
