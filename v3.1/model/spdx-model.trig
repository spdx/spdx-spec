    _:N9c863101c60f4bb9b1f7884f37280e28 a sh:SPARQLConstraint ;
        sh:message "When relationship is hasContactPoint, to must be an Agent" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/hasContactPoint> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Agent> }
}""" .

    _:N9cba4734e1714cdf9c632c9329064a6a a sh:SPARQLConstraint ;
        sh:message "When relationship is verifiedBy, to must be a RequirementVerification" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/verifiedBy> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <FunctionalSafety/RequirementVerification> }
}""" .

