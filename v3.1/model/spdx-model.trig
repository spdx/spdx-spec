        sh:nodeKind sh:IRI ;
        sh:property _:N0b2b829c082e4893b382a5b87e011fae,
            _:N0e45aaf06e3b4815b22949b8b8adef09,
            _:N1df29323f4b04ff2af87ce0dec5c355c,
