        rdfs:subClassOf ns6:UseAction ;
        sh:nodeKind sh:IRI .

    ns6:PlanProcess a owl:Class ;
        rdfs:comment "Process plans outline the stages of implementation or use related to a process."@en ;
        rdfs:subClassOf ns6:UseProcess ;
        sh:nodeKind sh:IRI .

    ns6:ReproduceAction a owl:Class ;
        rdfs:comment "Reproduction is the biological process by which organisms generate new individuals of the same species."@en ;
        rdfs:subClassOf ns6:CreateAction ;
        sh:nodeKind sh:IRI .

    ns6:ReproduceProcess a owl:Class ;
        rdfs:comment "Reproduction is the biological process by which living organisms produce offspring."@en ;
        rdfs:subClassOf ns6:CreateProcess ;
        sh:nodeKind sh:IRI .

    ns6:ResolutionAction a owl:Class ;
