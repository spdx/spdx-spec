    _:N03b2550b499c4647842cc49282954d1d a sh:SPARQLConstraint ;
        sh:message "When relationship is exploitCreatedBy, to must be an Agent" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/exploitCreatedBy> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Agent> }
}""" .

