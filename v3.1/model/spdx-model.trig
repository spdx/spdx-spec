            sh:NodeShape ;
        rdfs:comment "Provides an SSVC assessment for a vulnerability."@en ;
        rdfs:subClassOf ns4:VulnAssessmentRelationship ;
        sh:nodeKind sh:IRI ;
        sh:property _:N57c425ce467f4ebaa47000ec30853e5f .

