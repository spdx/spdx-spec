    spdx: a owl:Ontology ;
        rdfs:label "System Package Data Exchange™ (SPDX®) Ontology"@en ;
        dcterms:abstract "This ontology defines the terms and relationships used in the SPDX specification to describe system packages"@en ;
        dcterms:created "2026-01-23"^^xsd:date ;
        dcterms:creator "SPDX Project"@en ;
        dcterms:license <https://spdx.org/licenses/Community-Spec-1.0.html> ;
        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns3:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns2:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N06017b29a8ef416ca8559a08d5df2e56,
            _:N139bb408756d44cbac10bd701f67b8c4,
            _:N16d8add9fdaa4c18aa3422b6b87d5849,
            _:N2719d369e2fa4f3c8cec1fd083aaa0bc,
            _:N28e1fe778cfd4c6b8557dff6b4c6fd51,
            _:N41321be6820f44fcb1d64362441c29d4,
            _:N5abee545e02741d282abc38eaa48ed7f,
            _:N60f57e1dc4e44b598fcaa34edabbf113,
            _:N678b79e8570b43b98c5cb2b224120aa8,
            _:N848f23bf4d9b4251892bbfce0234dbe4,
            _:N954b6dcf562641838f7ccf5e199edaf8,
            _:Na68fd6a16d094c7ba41f9e0140180ecd,
            _:Nad05d41e2d3943d7aad39f289dd6303e,
            _:Nbab4a058297749c1ab9b5621cea4e3fc,
            _:Nce5ce542a9f44147bed0d9e905625197,
            _:Nef380013d83a4d6bb9e7b1f173dfb34c .

    <https://spdx.org/rdf/3/terms/AI/EnergyUnitType/kilowattHour> a owl:NamedIndividual,
            ns3:EnergyUnitType ;
        rdfs:label "kilowattHour" ;
        rdfs:comment "Kilowatt-hour."@en .

    <https://spdx.org/rdf/3/terms/AI/EnergyUnitType/megajoule> a owl:NamedIndividual,
            ns3:EnergyUnitType ;
        rdfs:label "megajoule" ;
        rdfs:comment "Megajoule."@en .

    <https://spdx.org/rdf/3/terms/AI/EnergyUnitType/other> a owl:NamedIndividual,
            ns3:EnergyUnitType ;
        rdfs:label "other" ;
        rdfs:comment "Any other units of energy measurement."@en .

    ns3:InteractionTemplate a owl:Class,
            sh:NodeShape ;
        rdfs:comment "An artifact that defines the structure, formatting, and variable placeholders for AI model interactions."@en ;
        rdfs:subClassOf ns1:Artifact ;
        sh:nodeKind sh:IRI ;
        sh:property _:N274aa7ed4b984747977b5f6bb38bcd44,
            _:N7a270fc0844b4be28347a3cac29b89d5 .

    <https://spdx.org/rdf/3/terms/AI/SafetyRiskAssessmentType/high> a owl:NamedIndividual,
            ns3:SafetyRiskAssessmentType ;
        rdfs:label "high" ;
        rdfs:comment "The second-highest level of risk posed by an AI system."@en .

    <https://spdx.org/rdf/3/terms/AI/SafetyRiskAssessmentType/low> a owl:NamedIndividual,
            ns3:SafetyRiskAssessmentType ;
        rdfs:label "low" ;
        rdfs:comment "Low/no risk is posed by an AI system."@en .

    <https://spdx.org/rdf/3/terms/AI/SafetyRiskAssessmentType/medium> a owl:NamedIndividual,
            ns3:SafetyRiskAssessmentType ;
        rdfs:label "medium" ;
        rdfs:comment "The third-highest level of risk posed by an AI system."@en .

    <https://spdx.org/rdf/3/terms/AI/SafetyRiskAssessmentType/serious> a owl:NamedIndividual,
            ns3:SafetyRiskAssessmentType ;
        rdfs:label "serious" ;
        rdfs:comment "The highest level of risk posed by an AI system."@en .

    ns3:autonomyType a owl:ObjectProperty ;
        rdfs:comment """**DEPRECATED in SPDX 3.1.**
Use [/Core/isoAutomationLevel](../../Core/Properties/isoAutomationLevel.md)
instead.

Indicates whether the system can perform a decision or action without human
involvement or guidance."""@en ;
        rdfs:range ns1:PresenceType .

    ns3:domain a owl:DatatypeProperty ;
        rdfs:comment "Domain in which the AI package can be used."@en ;
        rdfs:range xsd:string .

    ns3:energyConsumption a owl:ObjectProperty ;
        rdfs:comment "Energy consumption incurred by an AI model."@en ;
        rdfs:range ns3:EnergyConsumption .

    ns3:energyQuantity a owl:DatatypeProperty ;
        rdfs:comment "Energy quantity."@en ;
        rdfs:range xsd:decimal .

    ns3:energyUnit a owl:ObjectProperty ;
        rdfs:comment "Unit in which energy is measured."@en ;
        rdfs:range ns3:EnergyUnitType .

    ns3:finetuningEnergyConsumption a owl:ObjectProperty ;
        rdfs:comment """Energy consumed when finetuning the AI model that is
being used in the AI system."""@en ;
        rdfs:range ns3:EnergyConsumptionDescription .

    ns3:hyperparameter a owl:ObjectProperty ;
        rdfs:comment "Hyperparameter used to build the AI model contained in the AI package."@en ;
        rdfs:range ns1:DictionaryEntry .

    ns3:inferenceEnergyConsumption a owl:ObjectProperty ;
        rdfs:comment """Energy consumed during inference time by an AI model
that is being used in the AI system."""@en ;
        rdfs:range ns3:EnergyConsumptionDescription .

    ns3:informationAboutApplication a owl:DatatypeProperty ;
        rdfs:comment "Information about the AI software, not including the model description."@en ;
        rdfs:range xsd:string .

    ns3:informationAboutTraining a owl:DatatypeProperty ;
        rdfs:comment "Information about different steps of the training process."@en ;
        rdfs:range xsd:string .

    ns3:interactionTemplateDictionary a owl:ObjectProperty ;
        rdfs:comment "A Dictionary containing the template format used to structure interactions with the AI model."@en ;
        rdfs:range ns1:DictionaryEntry .

    ns3:interactionTemplateString a owl:DatatypeProperty ;
        rdfs:comment "A string containing the template format used to structure interactions with the AI model."@en ;
        rdfs:range xsd:string .

    ns3:limitation a owl:DatatypeProperty ;
        rdfs:comment "Limitation of the AI software."@en ;
        rdfs:range xsd:string .

    ns3:metric a owl:ObjectProperty ;
        rdfs:comment "Metric used to evaluate the AI model."@en ;
        rdfs:range ns1:DictionaryEntry .

    ns3:metricDecisionThreshold a owl:ObjectProperty ;
        rdfs:comment """Threshold that was used for computation of a metric described in
the metric field."""@en ;
        rdfs:range ns1:DictionaryEntry .

    ns3:modelDataPreprocessing a owl:DatatypeProperty ;
        rdfs:comment "Preprocessing steps applied to the training data before the model training."@en ;
        rdfs:range xsd:string .

    ns3:modelExplainability a owl:DatatypeProperty ;
        rdfs:comment "Methods that can be used to explain the results from the AI model."@en ;
        rdfs:range xsd:string .

    ns3:safetyRiskAssessment a owl:ObjectProperty ;
        rdfs:comment "Results of general safety risk assessment of the AI system."@en ;
        rdfs:range ns3:SafetyRiskAssessmentType .

    ns3:standardCompliance a owl:DatatypeProperty ;
        rdfs:comment """**DEPRECATED in SPDX 3.1.**
Use [/Core/Relationship](../../Core/Classes/Relationship.md)
with "conformsTo" relationship type instead.

A standard with which the artifact complies."""@en ;
        rdfs:range xsd:string .

    ns3:trainingEnergyConsumption a owl:ObjectProperty ;
        rdfs:comment """Energy consumed when training the AI model that is
being used in the AI system."""@en ;
        rdfs:range ns3:EnergyConsumptionDescription .

    ns3:typeOfModel a owl:DatatypeProperty ;
        rdfs:comment "Type of the model used in the AI software."@en ;
        rdfs:range xsd:string .

    ns3:useSensitivePersonalInformation a owl:ObjectProperty ;
        rdfs:comment """Records if sensitive personal information is used during model training or
could be used during the inference."""@en ;
        rdfs:range ns1:PresenceType .

    <https://spdx.org/rdf/3/terms/Build/Build> a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Class that describes a build instance of software/artifacts."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0a529e148c60423bb97f6c75e583127d,
            _:N3b7a381124c04e24976474d9e9fc829c,
            _:N660ac2a3e77047309aa3a4632f736ca2,
            _:N85bf5687528047b9a2a5b7fe582326ee,
            _:Na5fcf171718b46b2ad36924be771d35d,
            _:Na7bb323679bd4e06bc4ef236e46549fd,
            _:Nb8d3f17c248d49e2a09cdc9924172e31,
            _:Nd2f090231ac54e58b7c01825b7cee695,
            _:Ndf9e61d701834ebcbe0cff6b4a948ec6,
