        rdfs:subClassOf ns6:VulnAssessmentRelationship ;
        sh:nodeKind sh:IRI ;
        sh:property _:Nf926e51c26ee463b9205ed693b8178b6 .

    ns6:VexAffectedVulnAssessmentRelationship a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Connects a vulnerability and an element designating the element as a product
affected by the vulnerability."""@en ;
