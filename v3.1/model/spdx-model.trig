    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Action> }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/DefinedProcess> }
}""" .

