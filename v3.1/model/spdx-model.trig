        sh:nodeKind sh:IRI ;
        sh:property _:N04c0c2f689fb459ca341bc2aa371e396,
            _:N2324784b1a5f4635a9b5fe1fd84838b8,
            _:N2be857c941b5442a87fba21591a55831,
