    _:N0303d074bc554a149251b63b9c493692 a sh:SPARQLConstraint ;
        sh:message "When relationship is affects, from must be a Vulnerability, Action, or DefinedProcess" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/affects> .
