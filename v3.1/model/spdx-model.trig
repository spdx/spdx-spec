        sh:nodeKind sh:IRI ;
        sh:property _:N2b01010f13bc461b8ac7bc55ec35ca90,
            _:N2daae36193cd47efa23a4f4b53c30a0e,
            _:N53cbc148aab14bf18ae0d017b13263af,
            _:N7584962b1fd94880b1f6874d7790cd6c,
            _:Nc26d1e86649b4c6a97dc42d381f19cd6,
