    <https://spdx.org/rdf/3/terms/Core/LifecycleScopeType/update> a owl:NamedIndividual,
            ns1:LifecycleScopeType ;
        rdfs:label "update" ;
        rdfs:comment "A relationship has specific context implications for a product update."@en .

