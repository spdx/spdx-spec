            _:N6b31f387ca684fa1bda615e398904beb .

    ns3:StateAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "This is the state of an affected Element at a specific moment in time."@en ;
        rdfs:subClassOf ns3:UseAction ;
        sh:nodeKind sh:IRI ;
        sh:property _:N4d0f9031426a400ea3f0247184f38d72,
            _:Na834a9f834494ed1b3808f79c4ee44f5 .

    ns3:StorageAction a owl:Class ;
        rdfs:comment "Records the storage of a product."@en ;
        rdfs:subClassOf ns3:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns3:StorageProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Prescribes the storage of a product."@en ;
        rdfs:subClassOf ns3:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:Na0ced8dc17d345c6a67dbc16d7f6205d .

    ns3:TestAction a owl:Class ;
        rdfs:comment "A test action is a specific action associated with a test."@en ;
        rdfs:subClassOf ns3:UseAction ;
        sh:nodeKind sh:IRI .

    ns3:TestProcess a owl:Class ;
        rdfs:comment "Test Process defines the testing process for an element."@en ;
        rdfs:subClassOf ns3:UseProcess ;
        sh:nodeKind sh:IRI .

    ns3:TransportAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "An actual change to a product's location."@en ;
        rdfs:subClassOf ns3:ModifyAction ;
        sh:nodeKind sh:IRI ;
        sh:property _:N34cad1acee564496baee87e2ed1eff62,
            _:N7617aca9ab6e458fb03585d42e68edd8,
            _:N9236b7c4ac78412c86df7e824c4dee30 .

    ns3:TransportProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A prescribed change to a product's location."@en ;
        rdfs:subClassOf ns3:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N11f8f86ae9844549ae2b4fe785c1ec47,
            _:N6eb050c834f54436b3fe8407b58c1be9,
