    ns1:requirementUUID a owl:DatatypeProperty ;
        rdfs:comment "Provides a universally unique Requirement ID."@en ;
        rdfs:range ns1:ExternalIdentifier .

    ns1:rootElement a owl:ObjectProperty ;
