        sh:nodeKind sh:IRI ;
        sh:property _:Ne49efc7e369c401db2854c3328937397,
            _:Nf4322f997aca4bdab0d0ee85a94b2e57 .

    ns2:ListedLicenseException a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A license exception that is listed on the SPDX Exceptions list."@en ;
