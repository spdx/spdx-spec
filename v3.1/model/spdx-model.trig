        rdfs:label "metrics" ;
        rdfs:comment "A reference to metrics related to package such as OpenSSF scorecards."@en .

    <https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/npm> a owl:NamedIndividual,
            ns2:ExternalRefType ;
