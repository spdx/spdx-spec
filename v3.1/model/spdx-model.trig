        sh:nodeKind sh:IRI ;
        sh:property _:N161b3e78ea144e1f87e912368eb969d4,
            _:N7846fb5fdeec4d96aa687fa9e55bd868,
            _:Nd2d47bcce6a640b690674cd93b0df94e .

