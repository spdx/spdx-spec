            ns5:CvssSeverityType ;
        rdfs:label "high" ;
        rdfs:comment "When a CVSS score is between 7.0 - 8.9."@en .

    <https://spdx.org/rdf/3.1/terms/Security/CvssSeverityType/low> a owl:NamedIndividual,
            ns5:CvssSeverityType ;
        rdfs:label "low" ;
