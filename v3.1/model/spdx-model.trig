            sh:NodeShape ;
        rdfs:comment "EvaluationResult is the result of an evaluation."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N160ff7366a104d52a072fb44acbdf40c,
            _:N7ec62c36eb8b4c3abb60ff8c1c56d480,
