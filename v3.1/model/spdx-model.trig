    ns9:OutOfSpecAction a owl:Class ;
        rdfs:comment "An out of specification action is defined in this class."@en ;
        rdfs:subClassOf ns9:UseAction ;
        sh:nodeKind sh:IRI .

    ns9:PlanAction a owl:Class ;
