        sh:property _:N526a571d808148b89fefc50db6bd15d4,
            _:Na2b9ee41375641bfb0b3b8381e08952a .

    ns7:ListedLicenseException a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A license exception that is listed on the SPDX Exceptions list."@en ;
        rdfs:subClassOf ns7:LicenseAddition ;
        sh:nodeKind sh:IRI ;
        sh:property _:N48fb129bcb484d78bf0257aadf042f7c,
            _:N7a93e4d9793f44beb5a11decbf986f34 .

    ns7:OrLaterOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing this version, or any later version,
of the indicated License."""@en ;
        rdfs:subClassOf ns7:ExtendableLicense ;
        sh:nodeKind sh:IRI ;
        sh:property _:Nc6cb943df7834566a73b5ffae0215a20 .

    ns7:WithAdditionOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing a License which has additional
text applied to it."""@en ;
