        sh:nodeKind sh:IRI ;
        sh:property _:N23fe7a27c7ec471794639a5f63872f56,
            _:N37b554c100d94a07bbcc90bd8ecff7b0,
            _:N3e176ed78ce64d8695d83727c5b59020,
            _:N56e240aef6484bda933bf9598954d046,
            _:N72aa0a4651004f3fa4ebf24043227c48,
