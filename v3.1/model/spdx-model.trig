        rdfs:range ns8:LicenseAddition .

    ns8:subjectExtendableLicense a owl:ObjectProperty ;
        rdfs:comment "A License participating in a 'with addition' model."@en ;
        rdfs:range ns8:ExtendableLicense .

    ns8:subjectLicense a owl:ObjectProperty ;
