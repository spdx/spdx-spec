        sh:nodeKind sh:IRI ;
        sh:property _:N0d9cde8bf1124298b7ccdfa91e96bbd7,
            _:N104a256b15614f429b1b6c6b013d652f,
            _:N2b9ec1fd5ffe4603b8e554961804e768,
            _:N3f59141045bb4d87a9a782e282748e82,
            _:N5ba3d82a8627404eb42759b48880da3a,
            _:N647a5efde5ca491b9770805312abff9b,
            _:N8eb8c16484ba4a4a9bebdd763c2af495,
            _:Na9a7ced5cb8d4c8baadc10259b2ad8b9,
            _:Nbf6a259e711d495497e09d86a19a9654 .

