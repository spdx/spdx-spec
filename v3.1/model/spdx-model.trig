        rdfs:comment "A license addition that is not listed on the SPDX Exceptions List."@en ;
        rdfs:subClassOf ns9:LicenseAddition ;
        sh:nodeKind sh:IRI .

    ns9:DisjunctiveLicenseSet a owl:Class,
