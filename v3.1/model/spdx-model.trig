        sh:nodeKind sh:IRI ;
        sh:property _:N28e647f83e9d47c5b914e6147187c2c0,
            _:N37295ce1d04d4ba58a893159e42a9f77,
            _:N3822c48ab7c04d36991c7ac43b61b9b3,
