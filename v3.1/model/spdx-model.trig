        sh:nodeKind sh:IRI ;
        sh:property _:N63355a314e9f4cb7b97a903729391e6b,
            _:N96fc34de1d3c47cda6245291ea090faf .

    ns8:serverAuthenticationProtocol a owl:ObjectProperty ;
