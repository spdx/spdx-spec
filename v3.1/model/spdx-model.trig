        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N1faf87a0a9384737bfc635bf5ce49546,
            _:Na75bf935e7034f3780acb29705e0ed92,
