        rdfs:subClassOf <https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo> ;
        sh:nodeKind sh:IRI ;
        sh:property _:N7996856f8d104df78d125eab1e0360c7 .

    ns8:ListedLicense a owl:Class,
