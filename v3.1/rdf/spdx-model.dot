# N56aae51689eb4b99b610a16cd4281e79 node761
node761 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N56aae51689eb4b99b610a16cd4281e79</B></td></tr><tr><td href='N56aae51689eb4b99b610a16cd4281e79' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N56aae51689eb4b99b610a16cd4281e79</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasAssessmentFor, class must be VulnAssessmentRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasAssessmentFor&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Security/VulnAssessmentRelationship&gt; }
