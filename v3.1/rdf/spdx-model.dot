# Nf44d362813fe485dbb8d64180071f1fb node1806
node1806 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf44d362813fe485dbb8d64180071f1fb</B></td></tr><tr><td href='Nf44d362813fe485dbb8d64180071f1fb' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf44d362813fe485dbb8d64180071f1fb</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is reportedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/reportedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
