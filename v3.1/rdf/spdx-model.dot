# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isbn node880
node880 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>isbn</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isbn' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isbn</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;[International Standard Book Number (ISBN)](https://www.isbn-international.org/content/isbn-users-manual/29) is a unique numeric identifier for monographic publications standardized by [ISO 2108](https://www.iso.org/standard/65483.html). It consists of either 10 digits (for assignments prior to January 1, 2007) or 13 digits. A 13-digit ISBN is composed of five parts: a GS1 prefix, a registration group, a registrant, a publication element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., `9780198836063`).&quot;@en</td></tr></table> > ] 
# N93546fd3fc034362af3a2eabb2c6a4c3 node881
node881 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N93546fd3fc034362af3a2eabb2c6a4c3</B></td></tr><tr><td href='N93546fd3fc034362af3a2eabb2c6a4c3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N93546fd3fc034362af3a2eabb2c6a4c3</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is implementedBy, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/implementedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
