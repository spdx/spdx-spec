node801 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>ResponsibilityChangeAction</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/SupplyChain/ResponsibilityChangeAction' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/SupplyChain/ResponsibilityChangeAction</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;ResponsibilityChangeAction refers to the transfer of responsibility from one party to another.&quot;@en</td></tr></table> > ] 
