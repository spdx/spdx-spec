node798 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nd5afa15f1ac940668699d1305d827b3f</B></td></tr><tr><td href='Nd5afa15f1ac940668699d1305d827b3f' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nd5afa15f1ac940668699d1305d827b3f</font></td></tr></table> > ] 
