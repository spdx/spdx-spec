# N00bcc63066e34ab7ac07439fb0da1e26 node1694
node1694 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N00bcc63066e34ab7ac07439fb0da1e26</B></td></tr><tr><td href='N00bcc63066e34ab7ac07439fb0da1e26' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N00bcc63066e34ab7ac07439fb0da1e26</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasSpecification, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasSpecification&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
# N91ce2a7103a04690b95f160d24726bd6 node1695
