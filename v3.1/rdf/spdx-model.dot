node1438 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nfe9c7bd0d79548fea0975c1f1f3de45e</B></td></tr><tr><td href='Nfe9c7bd0d79548fea0975c1f1f3de45e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nfe9c7bd0d79548fea0975c1f1f3de45e</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:minCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
