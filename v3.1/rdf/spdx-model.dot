# N1ca9e5d6bc6c440f8be142a40b55951a node1896
node1896 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N1ca9e5d6bc6c440f8be142a40b55951a</B></td></tr><tr><td href='N1ca9e5d6bc6c440f8be142a40b55951a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N1ca9e5d6bc6c440f8be142a40b55951a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasRoleIn, class must be RoleRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasRoleIn&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/RoleRelationship&gt; }
}&quot;</td></tr></table> > ] 
