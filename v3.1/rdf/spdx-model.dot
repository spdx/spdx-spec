# N7d031540e16648209ff892cdd9f11d7a node1339
node1339 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N7d031540e16648209ff892cdd9f11d7a</B></td></tr><tr><td href='N7d031540e16648209ff892cdd9f11d7a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N7d031540e16648209ff892cdd9f11d7a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is invokedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
# N3a41a48b15154093bda616c60d92386c node1340
