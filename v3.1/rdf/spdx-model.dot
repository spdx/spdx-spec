node631 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N6263aa33b05a444c8ede230ca9733c39</B></td></tr><tr><td href='N6263aa33b05a444c8ede230ca9733c39' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N6263aa33b05a444c8ede230ca9733c39</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:pattern</td><td align='left'>&quot;^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T(([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]|23:59:60)Z$&quot;</td></tr></table> > ] 
