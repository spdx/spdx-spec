# Nfd97f5338cc1410a9f82e636bd5540e3 node1102
node1102 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nfd97f5338cc1410a9f82e636bd5540e3</B></td></tr><tr><td href='Nfd97f5338cc1410a9f82e636bd5540e3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nfd97f5338cc1410a9f82e636bd5540e3</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasAssessmentFor, class must be VulnAssessmentRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasAssessmentFor&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Security/VulnAssessmentRelationship&gt; }
}&quot;</td></tr></table> > ] 
