# Ne7f0a0afb7c34754ad40bd529f139156 node1764
node1764 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne7f0a0afb7c34754ad40bd529f139156</B></td></tr><tr><td href='Ne7f0a0afb7c34754ad40bd529f139156' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne7f0a0afb7c34754ad40bd529f139156</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is runsOn, to must be a Hardware&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/runsOn&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Hardware/Hardware&gt; }
}&quot;</td></tr></table> > ] 
