# Nd4fd87114d2140baa7eb4ff5ea1ae147 node1578
node1578 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nd4fd87114d2140baa7eb4ff5ea1ae147</B></td></tr><tr><td href='Nd4fd87114d2140baa7eb4ff5ea1ae147' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nd4fd87114d2140baa7eb4ff5ea1ae147</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasHost, from must be a Build&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasHost&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Build/Build&gt; }
}&quot;</td></tr></table> > ] 
