# N6502f7a7c6474ca2b01e28180804596a node1476
node1476 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N6502f7a7c6474ca2b01e28180804596a</B></td></tr><tr><td href='N6502f7a7c6474ca2b01e28180804596a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N6502f7a7c6474ca2b01e28180804596a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, from must be an Action or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
