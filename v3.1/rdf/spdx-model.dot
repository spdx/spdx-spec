SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/providesSupportFor&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/SupportRelationship&gt; }
}&quot;</td></tr></table> > ] 
