# N7fa119e27ed24772b5f7bd18b24b8437 node1266
node1266 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N7fa119e27ed24772b5f7bd18b24b8437</B></td></tr><tr><td href='N7fa119e27ed24772b5f7bd18b24b8437' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N7fa119e27ed24772b5f7bd18b24b8437</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasAssessmentFor, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
