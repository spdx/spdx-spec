# N45273e8748a342f6ab8cfbca230dc6b3 node1171
node1171 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N45273e8748a342f6ab8cfbca230dc6b3</B></td></tr><tr><td href='N45273e8748a342f6ab8cfbca230dc6b3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N45273e8748a342f6ab8cfbca230dc6b3</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is affects, from must be a Vulnerability, Action, or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/affects&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/DefinedProcess&gt; }
}&quot;</td></tr></table> > ] 
