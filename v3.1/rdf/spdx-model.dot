# https://spdx.org/rdf/3/terms/ node687
node687 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>System Package Data Exchange™ (SPDX®) Ontology</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/</font></td></tr><tr><td align='left'>dcterms:abstract</td><td align='left'>&quot;This ontology defines the terms and relationships used in the SPDX specification to describe system packages&quot;@en</td></tr><tr><td align='left'>dcterms:created</td><td align='left'>&quot;2026-01-23&quot;^^xsd:date</td></tr><tr><td align='left'>dcterms:creator</td><td align='left'>&quot;SPDX Project&quot;@en</td></tr><tr><td align='left'>dcterms:title</td><td align='left'>&quot;System Package Data Exchange (SPDX) Ontology&quot;@en</td></tr><tr><td align='left'>omg-ann:copyright</td><td align='left'>&quot;Copyright (C) 2026 SPDX Project&quot;@en</td></tr></table> > ] 
# Nea7d2e38444d4c8c8a4439fb6c93c4b8 node688
node688 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nea7d2e38444d4c8c8a4439fb6c93c4b8</B></td></tr><tr><td href='Nea7d2e38444d4c8c8a4439fb6c93c4b8' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nea7d2e38444d4c8c8a4439fb6c93c4b8</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, from must be an Action or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/createdBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/DefinedProcess&gt; }
