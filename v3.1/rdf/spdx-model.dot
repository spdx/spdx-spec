# Nfb26dda4ab3d472dbf3b8387b80c0217 node471
node471 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nfb26dda4ab3d472dbf3b8387b80c0217</B></td></tr><tr><td href='Nfb26dda4ab3d472dbf3b8387b80c0217' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nfb26dda4ab3d472dbf3b8387b80c0217</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:pattern</td><td align='left'>&quot;^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T(([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]|23:59:60)Z$&quot;</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Software/SbomType/analyzed node472
node472 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>analyzed</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Software/SbomType/analyzed' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Software/SbomType/analyzed</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;SBOM generated through analysis of artifacts (e.g., executables, packages, containers, and virtual machine images) after its build. Such analysis generally requires a variety of heuristics. In some contexts, this may also be referred to as a &quot;3rd party&quot; SBOM.&quot;@en</td></tr></table> > ] 
