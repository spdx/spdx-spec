# N99d11c8ae0a14b58925af2ad9f0c7ceb node582
node582 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N99d11c8ae0a14b58925af2ad9f0c7ceb</B></td></tr><tr><td href='N99d11c8ae0a14b58925af2ad9f0c7ceb' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N99d11c8ae0a14b58925af2ad9f0c7ceb</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is publishedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/publishedBy&gt; .
    $this &lt;Core/to&gt; ?to .
