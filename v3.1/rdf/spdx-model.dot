# Ne60d938613b343da8d57586cae1dca87 node1570
node1570 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne60d938613b343da8d57586cae1dca87</B></td></tr><tr><td href='Ne60d938613b343da8d57586cae1dca87' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne60d938613b343da8d57586cae1dca87</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasContactPoint, class must be ContactPointRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasContactPoint&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/ContactPointRelationship&gt; }
}&quot;</td></tr></table> > ] 
