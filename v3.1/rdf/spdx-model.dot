# https://spdx.org/rdf/3/terms/Core/ExternalRefType/x509Cert node382
node382 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>x509Cert</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalRefType/x509Cert' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalRefType/x509Cert</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A reference to an X.509 certificate as defined in [RFC 5280](https://datatracker.ietf.org/doc/rfc5280/). The primary media type shall be `application/pkix-cert`. The legacy media types `application/x-x509-ca-cert` and `application/x-x509-user-cert` may be used for backward compatibility, but shall not be used in new implementations. NOTE — RFC 5280 supersedes earlier X.509 profiles, including RFC 1422. Existing references based on RFC 1422 remain valid.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isbn node383
node383 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>isbn</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isbn' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isbn</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;[International Standard Book Number (ISBN)](https://www.isbn-international.org/content/isbn-users-manual/29) is a unique numeric identifier for monographic publications standardized by [ISO 2108](https://www.iso.org/standard/65483.html). It consists of either 10 digits (for assignments prior to January 1, 2007) or 13 digits. A 13-digit ISBN is composed of five parts: a GS1 prefix, a registration group, a registrant, a publication element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., `9780198836063`).&quot;@en</td></tr></table> > ] 
