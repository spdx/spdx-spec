# Ncd0941c5419d44c6a7d047c5b1669cde node9
node9 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ncd0941c5419d44c6a7d047c5b1669cde</B></td></tr><tr><td href='Ncd0941c5419d44c6a7d047c5b1669cde' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ncd0941c5419d44c6a7d047c5b1669cde</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is invokedBy, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
