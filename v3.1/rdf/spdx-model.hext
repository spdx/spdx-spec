["_:Na72a6508d0594020aa57901cf8fef284", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3/terms/Core/builtTime", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/ResponsibilityType/custody", "http://www.w3.org/2000/01/rdf-schema#comment", "Custody refers to the responsibility, control, and safekeeping of an asset, person, or legal entity. It involves both physical possession and legal accountability over something.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/LifecycleScopeType/decommission", "http://www.w3.org/2000/01/rdf-schema#comment", "A relationship has specific context implications for a product's retirement and/or decommissioning.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N040820cd86404105bd8eb2dd7bd9f475", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/performedBy> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Agent> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
