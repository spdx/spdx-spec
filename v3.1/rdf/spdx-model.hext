["https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/securityThreatModel", "http://www.w3.org/2000/01/rdf-schema#label", "securityThreatModel", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/ProcessReadinessType/other", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/RelationshipType/locatedAt", "http://www.w3.org/2000/01/rdf-schema#label", "locatedAt", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["_:Ne32ffdb8fb474991957009a172f20851", "http://www.w3.org/ns/shacl#maxCount", "1", "http://www.w3.org/2001/XMLSchema#integer", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/RelationshipType/follows", "http://www.w3.org/2000/01/rdf-schema#comment", "The `to` Element succeeds the `from` Element, establishing a unidirectional sequence. This succession is defined as chronological, procedural, or logical. It is used to represent either a temporal order (e.g., in a workflow) or a logical order for processing and traversal (e.g., in an ordered list).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
