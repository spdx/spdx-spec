["https://spdx.org/rdf/3/terms/Core/HashAlgorithm/md6", "http://www.w3.org/2000/01/rdf-schema#comment", "[MD6 hash function](https://people.csail.mit.edu/rivest/pubs/RABCx08.pdf)", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
