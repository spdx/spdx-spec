["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/gtin", "http://www.w3.org/2000/01/rdf-schema#comment", "[Global Trade Item Number (GTIN)](https://www.gs1.org/standards/id-keys/gtin) is a number, assigned by GS1, that uniquely identifies a trade item (product or service).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/InspectionAction", "http://www.w3.org/2000/01/rdf-schema#comment", "An inspection action refers to a specific activity or set of activities performed during an inspection to examine, verify, or evaluate an item, process, or system.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
