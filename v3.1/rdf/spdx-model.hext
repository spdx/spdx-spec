["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/isil", "http://www.w3.org/2000/01/rdf-schema#comment", "[International Standard Identifier for Libraries and Related Organizations (ISIL)](https://slks.dk/english/work-areas/libraries-and-literature/library-standards/isil/) is a unique alphanumeric code for identifying libraries, archives, museums, and related organizations standardized by [ISO 15511](https://www.iso.org/standard/77849.html). It consists of a prefix\u2014which may be an ISO 3166-1 alpha-2 country code or a non-country code assigned by the ISIL Registration Authority\u2014followed by a unit identifier, totaling up to 16 characters (e.g., `FI-Sipoo-S\u00f6` or `ZDB-1-SBD`). Valid symbols include any alphanumeric character, solidus (`/`), hyphen-minus (`-`), or colon.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Software/File", "http://www.w3.org/ns/shacl#property", "_:N5bf7b56f2d8142319fa5228dcfe860e3", "localId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ibid", "http://www.w3.org/2000/01/rdf-schema#comment", "[International Business Identifier (IBID)](https://ekys.org/business_identifiers/) is a verifiable unique identifier for legal entities as defined in the [ISO/DIS 25500-3](https://www.iso.org/standard/87705.html) draft standard. It is composed of three data elements: the International Business Registration Number (IBRN), the legal name, and the date of origin formatted as eight numeric characters (YYYYMMDD). Each element is separated by a pipe character (`|`) (e.g., `US-DE.BER:3031657|Code Management Association|19990420`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/Specification", "http://www.w3.org/2000/01/rdf-schema#subClassOf", "https://spdx.org/rdf/3.1/terms/Core/Artifact", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/cpe22", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType", "globalId", "", ""]
