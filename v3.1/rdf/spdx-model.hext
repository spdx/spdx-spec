["https://spdx.org/rdf/3/terms/Core/locationTime", "http://www.w3.org/2000/01/rdf-schema#comment", "A known location is specified at this time.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ProfileIdentifierType/functionalSafety", "http://www.w3.org/2000/01/rdf-schema#comment", "The element follows the FunctionalSafety profile specification.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
