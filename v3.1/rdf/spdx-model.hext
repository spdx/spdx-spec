["https://spdx.org/rdf/3/terms/Core/RequirementStatusType/reviewable", "http://www.w3.org/2000/01/rdf-schema#comment", "A requirement is ready for formal review by stakeholders for a specific use.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
