["https://spdx.org/rdf/3.1/terms/Extension/CdxPropertiesExtension", "http://www.w3.org/2000/01/rdf-schema#subClassOf", "https://spdx.org/rdf/3.1/terms/Extension/Extension", "globalId", "", ""]
