["_:Nca2e827ce1f74046af42d806f4161244", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/model", "globalId", "", ""]
