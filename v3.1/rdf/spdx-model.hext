["https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/sha512", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm", "globalId", "", ""]
