["_:Nad23fc4b6c80479c9255600148b35937", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/lei", "globalId", "", ""]
