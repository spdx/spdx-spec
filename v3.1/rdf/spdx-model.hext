["_:Nabfbba2ba7814c74b1ef6dd637edcf9c", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/performedBy> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Action> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["_:N84dd762f444b4dad869ed3bf336f05b4", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/module", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/analysis", "http://www.w3.org/2000/01/rdf-schema#comment", "Analytical evaluating of data, designs, or processes methodically to verify correctness against standards or expectations. Typical analysis methods are FMEA, FTA, STPA, static analysis for MISRA compliance etc.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Hardware/Dimensions", "http://www.w3.org/2000/01/rdf-schema#comment", "Dimensions generally refer to measurable extents or attributes that define the size, shape, or scale of an object, system, or concept.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N8cd7210c32c14fefbda07d741ae8c267", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:N200e3e0d4d314887a8cd26a4d973faab", "localId", "", ""]
