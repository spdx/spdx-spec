["https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/patch", "http://www.w3.org/2000/01/rdf-schema#comment", "The Element contains a set of changes to update, fix, or improve another Element.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/LifecycleScopeType/decommission", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Core/LifecycleScopeType", "globalId", "", ""]
