["https://spdx.org/rdf/3.1/terms/Security/CvssSeverityType/high", "http://www.w3.org/2000/01/rdf-schema#comment", "When a CVSS score is between 7.0 - 8.9.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
