  {
    "@id": "https://spdx.org/rdf/3/terms/SupplyChain/ReproduceProcess",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reproduction is the biological process by which living organisms produce offspring."
      }
    ],
