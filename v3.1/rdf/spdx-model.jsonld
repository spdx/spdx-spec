      "https://spdx.org/rdf/3/terms/Core/RelationshipCompleteness"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The relationship is known not to be exhaustive."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "incomplete"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/SimpleLicensing/customIdToLicense",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Maps a \"LicenseRef-\" string for a custom license or a \"AdditionRef-\" string for\na custom license addition to a `CustomLicense`, a `CustomLicenseAddition`, or a\n`SimpleLicensingText`."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/ElementMap"
      }
    ]
