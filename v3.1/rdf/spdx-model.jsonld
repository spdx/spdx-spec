      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "altDownloadLocation"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/glue",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "[GLobal Unique Enterprise (GLUE) Identifiers](https://datatracker.ietf.org/doc/draft-ietf-spice-glue-id/), as defined by the IETF Internet-Draft, is expressed as a GLUE URI, a Uniform Resource Identifier that standardizes the representation of existing organizational entity identifiers."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "glue"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/SimpleLicensing/customIdToUri",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "**DEPRECATED in SPDX 3.1.**\nUse [customIdToLicense](./customIdToLicense.md) instead.\n\nMaps a \"LicenseRef-\" string for a custom license or a \"AdditionRef-\" string for\na custom license addition to its URI identifier.\n\n**NOTE:**\nThis property is deprecated and only included for backward compatibility.\nNew documents should use [customIdToLicense](./customIdToLicense.md) instead."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/DictionaryEntry"
      }
    ]
  },
  {
