  {
    "@id": "https://spdx.org/rdf/3/terms/SupplyChain/BoundaryDefinitionProcess",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
