        "@language": "en",
        "@value": "Property that describes the URI of the build configuration source file."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ]
  },
  {
