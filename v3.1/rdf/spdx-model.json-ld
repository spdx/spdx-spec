      {
        "@id": "https://spdx.org/rdf/3.1/creationInfo_NoneElement"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/identifierLocator",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
