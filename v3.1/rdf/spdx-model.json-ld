      "https://spdx.org/rdf/3/terms/FunctionalSafety/EvaluationResultType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Indicates a successful evaluation where the requirement or condition is clearly met."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "pass"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Service/KeyValidationProtocolType/crl",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Service/KeyValidationProtocolType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Certificate Revocation List, or CRL, is a list of revoked certificates as defined in [RFC 5280]](https://datatracker.ietf.org/doc/rfc5280/) that is downloaded from the Certificate Authority (CA)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "crl"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Security/VexNotAffectedVulnAssessmentRelationship",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
