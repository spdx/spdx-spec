        "@value": "The element follows the Operations profile specification."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "operations"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/NoneElement",
