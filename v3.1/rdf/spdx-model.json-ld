  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iswc",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "[International Standard Musical Work Code (ISWC)](https://www.iswc.org/iswc) is an 11-character unique identifier standardized by [ISO 15707](https://www.iso.org/standard/83125.html) for musical works (compositions) as distinct from specific recordings. While the \"ISWC\" label and grouping separators (dots and hyphens) are used for human readability, they shall be omitted when the identifier is stored electronically (e.g., `T0017812031`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "iswc"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalRefType/x509Cert",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalRefType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A reference to an X.509 certificate as defined in [RFC 5280](https://datatracker.ietf.org/doc/rfc5280/). The primary media type shall be `application/pkix-cert`. The legacy media types `application/x-x509-ca-cert` and `application/x-x509-user-cert` may be used for backward compatibility, but shall not be used in new implementations. NOTE — RFC 5280 supersedes earlier X.509 profiles, including RFC 1422. Existing references based on RFC 1422 remain valid."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "x509Cert"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/bic",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Business Identifier Code (BIC), also known as SWIFT-BIC or SWIFT code, is a unique 8 or 11-character alphanumeric code standardized by [ISO 9362](https://www.iso.org/standard/84108.html) to identify financial and non-financial institutions (e.g., `BBWCUS33`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "bic"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Dataset/DatasetType/timestamp",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Dataset/DatasetType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Data is recorded with a timestamp for each entry, but not necessarily ordered or at specific intervals, such as when a taxi ride starts and ends."
