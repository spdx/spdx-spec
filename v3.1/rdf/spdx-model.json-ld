      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/nli",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "[Natural Location Identifier (NLI)](https://eccma.org/enli-eccma-natural-location-identifier/) is a 14- or 15-character alphanumeric string standardized by [ISO 8000-118](https://www.iso.org/standard/85428.html) that uniquely identifies a three-dimensional geographic point location. The identifier is generated from geodetic coordinates and elevation data. For electronic storage, the `ISO.NLI:` prefix shall be retained (e.g., `ISO.NLI:41TS8M-A8ELTQ-H2`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "nli"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasDependencyManifest",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Core/RelationshipType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The `from` Element has manifest files that contain dependency information in each `to` Element."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "hasDependencyManifest"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/iswc",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "[International Standard Musical Work Code (ISWC)](https://www.iswc.org/iswc) is an 11-character unique identifier standardized by [ISO 15707](https://www.iso.org/standard/83125.html) for musical works (compositions) as distinct from specific recordings. While the \"ISWC\" label and grouping separators (dots and hyphens) are used for human readability, they shall be omitted when the identifier is stored electronically (e.g., `T0017812031`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "iswc"
      }
    ]
  },
  {
