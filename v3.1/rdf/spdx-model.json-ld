      {
        "@language": "en",
        "@value": "CISA's Known Exploited Vulnerability (KEV) catalog."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "kev"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/cve",
