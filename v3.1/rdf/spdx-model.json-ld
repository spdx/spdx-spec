        "@value": "When a CVSS score is between 4.0 - 6.9."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "medium"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Software/contentIdentifierValue",
