        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N24e77c539c704d6ab189ec49a33cb310,
            _:N538dd17e382c449ea51eed8de74d5d6d,
