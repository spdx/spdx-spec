        sh:nodeKind sh:IRI ;
        sh:property _:N07b3474db50b4848a634c26a07c9a040,
            _:N1ffcd7f25b4649f38fab6dedd3e5277e,
            _:N2aa8933392f74b318c319088b58555fe,
