        sh:nodeKind sh:IRI ;
        sh:property _:N0c756683fcdf42e7ba9d61f712b5f140,
            _:N4652444ceec9429e9796dcf053b2f6a7,
            _:N5d77a14aacc643b6a8bdf4b9d08797b3,
