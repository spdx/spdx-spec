        rdfs:subClassOf ns8:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns8:StorageProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Prescribes the storage of a product."@en ;
        rdfs:subClassOf ns8:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N67feacd346c841febae2b170bd03cdb3 .

    ns8:TestAction a owl:Class ;
        rdfs:comment "A test action is a specific action associated with a test."@en ;
        rdfs:subClassOf ns8:UseAction ;
        sh:nodeKind sh:IRI .

    ns8:TestProcess a owl:Class ;
        rdfs:comment "Test Process defines the testing process for an element."@en ;
        rdfs:subClassOf ns8:UseProcess ;
        sh:nodeKind sh:IRI .

    ns8:TransportAction a owl:Class,
            sh:NodeShape ;
