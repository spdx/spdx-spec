        rdfs:range ns8:RequirementVerification .

    ns8:evidenceCategory a owl:ObjectProperty ;
        rdfs:comment "evidenceCategory refers to a category of documented or observable proof."@en ;
        rdfs:range ns8:EvidenceType .

