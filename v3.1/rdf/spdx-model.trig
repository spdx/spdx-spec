        rdfs:range xsd:string .

    <https://spdx.org/rdf/3.1/terms/Extension/cdxPropValue> a owl:DatatypeProperty ;
        rdfs:comment "A value used in a CdxPropertyEntry name-value pair."@en ;
        rdfs:range xsd:string .

