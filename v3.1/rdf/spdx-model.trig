        sh:nodeKind sh:IRI ;
        sh:property _:N384e9f0d09c6446caa8a7bc26d02ec96,
            _:N3d0a36900fef4ecbad8acbbe8e2dddd7,
            _:N47e9a272ced9442a9a9931778e888458,
            _:N7b5d2b9e2a01464cbd447be56aa8f80a,
            _:N806b491cd1db4a6bb0e7245cb34ab841,
