        sh:nodeKind sh:IRI ;
        sh:property _:N3b316c3cb1954ba69244c98ca74e1010,
            _:N55ab1d9dfe5445038ddc72022849b1f8 .

    ns7:ListedLicenseException a owl:Class,
            sh:NodeShape ;
