        rdfs:comment "The element follows the Lite profile specification."@en .

    <https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/security> a owl:NamedIndividual,
            ns2:ProfileIdentifierType ;
        rdfs:label "security" ;
