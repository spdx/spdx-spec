        sh:nodeKind sh:IRI .

    ns7:OutOfSpecAction a owl:Class ;
        rdfs:comment "An out of specification action is defined in this class."@en ;
        rdfs:subClassOf ns7:UseAction ;
        sh:nodeKind sh:IRI .

    ns7:PlanAction a owl:Class ;
