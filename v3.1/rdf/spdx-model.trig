    _:N0019c9732daa403ca4b8873a97873e82 a sh:SPARQLConstraint ;
        sh:message "When relationship is providesSupportFor, from must be an Agent" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/providesSupportFor> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Agent> }
}""" .

