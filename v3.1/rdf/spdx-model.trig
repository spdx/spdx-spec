    ns2:standardLicenseHeader a owl:DatatypeProperty ;
        rdfs:comment """Provides a License author's preferred text to indicate that a file is covered
by the License."""@en ;
        rdfs:range xsd:string .

    ns2:standardLicenseTemplate a owl:DatatypeProperty ;
