        rdfs:range ns8:ConfidentialityLevelType .

    ns8:dataCollectionProcess a owl:DatatypeProperty ;
        rdfs:comment "How the dataset was collected."@en ;
        rdfs:range xsd:string .

    ns8:dataPreprocessing a owl:DatatypeProperty ;
