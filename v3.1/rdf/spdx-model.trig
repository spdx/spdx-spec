        sh:nodeKind sh:IRI ;
        sh:property _:N5ad43fb8dee8433aa02219c9f14d2662,
            _:Na081889ebe624608b86d543de086cbc4 .

    ns10:ListedLicenseException a owl:Class,
            sh:NodeShape ;
