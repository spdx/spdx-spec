            _:Nbfe7a949103f4115a4f005c97ebe7578 .

    ns3:ResponsibilityChangeProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "ResponsibilityChangeProcess refers to the process of transferring responsibility from one party to another."@en ;
        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N7171c7ed8a3f43498d23156ef605f1e7,
            _:N819a489841064cd293992dcd9a54f5da,
