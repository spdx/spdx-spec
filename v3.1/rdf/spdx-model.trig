    spdx: a owl:Ontology ;
        rdfs:label "System Package Data Exchange™ (SPDX®) Ontology"@en ;
        dcterms:abstract "This ontology defines the terms and relationships used in the SPDX specification to describe system packages"@en ;
        dcterms:created "2026-01-23"^^xsd:date ;
        dcterms:creator "SPDX Project"@en ;
        dcterms:license <https://spdx.org/licenses/Community-Spec-1.0.html> ;
        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns2:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns8:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N02f6b73a5dc64a3a90323549ab855f55,
            _:N09b2ba705df240ce8452a7112e3cc908,
            _:N151c553f7c164126b2fdceb961ebaa25,
            _:N274b84f2fb7d40da96d6b0fa8242428a,
            _:N2b861aa36c9344d4975fbd35381d4555,
            _:N2f9f516192b6461994a00609cbe50848,
            _:N41b3059bcbc04bee8dc4ff65ad180a90,
            _:N46ef02f9e98c4ed08eee7d039da8e274,
            _:N565e1d20a0fb4c6891321d2619f4cb02,
            _:N9a8a3c0dae624af78258ed9dcdd56c81,
            _:Nb2122366e64e4b58a84f82ad381dc5ef,
            _:Nb841514e06dd455a91ee4cc2f5bbb91e,
            _:Nb89580fd539f449bb906d114f6b4c18f,
