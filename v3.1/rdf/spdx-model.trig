        sh:nodeKind sh:IRI ;
        sh:property _:N1355c958697545e5ab3504fdb445e4ef,
            _:N4854a330e5854fe59ed8d97343d8d274,
            _:N4fb553edf96d448d8e54d04b2e7fb634,
            _:N52d68c5ff1244a15820821bd8bdb2cb3,
            _:N666fa209933742bfb0c5c4cb5e7c8bbd,
            _:N7b121f2ad1914498a9620e5f55a8b47f,
            _:N8446eeead940406abfb5935a1f7a98cc,
            _:Nb532dcfc0ffa4afa9d8015a1ea096953,
            _:Nf36bd7359787414f9df7211e5e8a133e .

