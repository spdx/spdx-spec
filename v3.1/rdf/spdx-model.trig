        sh:nodeKind sh:IRI .

    ns4:Vulnerability a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Specifies a vulnerability and its associated information."@en ;
        rdfs:subClassOf ns1:Artifact ;
        sh:nodeKind sh:IRI ;
        sh:property _:N8122c109b93e444a800a0717d1cb2b5f,
