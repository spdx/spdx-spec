        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns8:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns6:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N050cb524bf44435bbdc425976474fd92,
            _:N060df8d895c742d9bb3ed8fbc11e8403,
            _:N093627904a444241a56f5105243e9641,
