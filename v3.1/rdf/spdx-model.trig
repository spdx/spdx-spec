        sh:nodeKind sh:IRI ;
        sh:property _:N6d217f6f47d34952ac2164a0eb9e3ea7,
            _:N760bd52b18d144f9998b937a7c52c934 .

    ns6:ListedLicenseException a owl:Class,
            sh:NodeShape ;
