        sh:nodeKind sh:IRI ;
        sh:property _:N0c3f6bca5f7244c3a3510de6b67c1405,
            _:N0dddda6ede80446e9d389a10352d882a,
            _:N2999dc52662e4b6fa978e0168c835d8d,
