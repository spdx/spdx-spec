        sh:nodeKind sh:IRI ;
        sh:property _:N51071f244414404dbfb3b3296014eb57 .

    ns4:CustomLicense a owl:Class ;
        rdfs:comment "A license that is not listed on the SPDX License List."@en ;
        rdfs:subClassOf ns4:License ;
        sh:nodeKind sh:IRI .

    ns4:CustomLicenseAddition a owl:Class ;
        rdfs:comment "A license addition that is not listed on the SPDX Exceptions List."@en ;
        rdfs:subClassOf ns4:LicenseAddition ;
        sh:nodeKind sh:IRI .

    ns4:DisjunctiveLicenseSet a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing a set of licensing information where
only one of the elements applies."""@en ;
