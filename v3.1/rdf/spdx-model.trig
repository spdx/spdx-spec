        sh:nodeKind sh:IRI ;
        sh:property _:N0855507b8d11466dab352b9699d1baa4,
            _:N6a14fc06d7ab4be3918569fa9d43f6a9,
            _:N8a09b1287d664f8db81eac391741726f,
            _:N958b4a449d0e46d5b42bf2f2f24cd44c,
            _:Na682a70e66f54e59807cab6c8f77d782,
            _:Nc9ed326e6584490d950e627739fc99a7,
            _:Nd89fa9b8b5e14772a0453288c93ec193,
            _:Neb2660598968432c8b4fb23774a99f85,
            _:Nf1c51c0ca4714b2a9dce3b7432e9b7af .

    <https://spdx.org/rdf/3/terms/Core/ProcessReadinessType/active> a owl:NamedIndividual,
            ns1:ProcessReadinessType ;
        rdfs:label "active" ;
        rdfs:comment "In use."@en .

