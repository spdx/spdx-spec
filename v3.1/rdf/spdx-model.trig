            ns5:SoftwarePurpose ;
        rdfs:label "container" ;
        rdfs:comment "The Element is a container image which can be used by a container runtime application."@en .

    <https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/data> a owl:NamedIndividual,
            ns5:SoftwarePurpose ;
