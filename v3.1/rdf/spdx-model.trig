        sh:nodeKind sh:IRI ;
        sh:property _:N684909311acf4f02a729360290fa2a28,
            _:N6f08df1bcec3404db25700514499cc60 .

    ns10:StorageAction a owl:Class ;
        rdfs:comment "Records the storage of a product."@en ;
        rdfs:subClassOf ns10:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns10:StorageProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Prescribes the storage of a product."@en ;
        rdfs:subClassOf ns10:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:Nc0fe0125c5d34546b554fa311a94e3f7 .

    ns10:TestAction a owl:Class ;
        rdfs:comment "A test action is a specific action associated with a test."@en ;
        rdfs:subClassOf ns10:UseAction ;
        sh:nodeKind sh:IRI .

    ns10:TestProcess a owl:Class ;
        rdfs:comment "Test Process defines the testing process for an element."@en ;
        rdfs:subClassOf ns10:UseProcess ;
        sh:nodeKind sh:IRI .

    ns10:TransportAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "An actual change to a product's location."@en ;
