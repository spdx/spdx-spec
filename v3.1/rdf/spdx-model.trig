    spdx: a owl:Ontology ;
        rdfs:label "System Package Data Exchange™ (SPDX®) Ontology"@en ;
        dcterms:abstract "This ontology defines the terms and relationships used in the SPDX specification to describe system packages"@en ;
        dcterms:created "2026-01-23"^^xsd:date ;
        dcterms:creator "SPDX Project"@en ;
        dcterms:license <https://spdx.org/licenses/Community-Spec-1.0.html> ;
        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns5:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns7:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N04da5f8e0da34fd7a1125f65df0484d0,
            _:N0b7131b4936544a1b48ff54b2aa825a8,
            _:N0c54c158799748cc877f9b5565089dde,
            _:N1d0c62abe35d4847970f5cf997aa5593,
            _:N1ffd3d9c8295470c8b499279b30759ba,
            _:N291580064a54437c99880e232a6ee402,
            _:N3eeec604fae04393875fc9b152b992f6,
            _:N492c6b93df324fe8bf24db72db0687bc,
            _:N56a8ea1bb0274a1e9dd95995d0e89b7a,
            _:N5bf0c0c5623744ca963d84855b2cfd0f,
            _:N82b57670c84d441da01a2ab4476b8b37,
            _:N8a7b1fc56a6e409881dd86db44f7de61,
            _:N935265f1d9cc4c78b85c489477c4b0df,
            _:Na3cea7ae40bd46598af0e8bae5ac6062,
            _:Nc81479920a674d99a75d3423821c6bd3,
