    _:N03eee9d4482e4497bcbe4b215b128099 a sh:SPARQLConstraint ;
        sh:message "When relationship is delegatedTo, to must be a Relationship whose relationshipType is invokedBy" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/delegatedTo> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS {
        ?to rdf:type/rdfs:subClassOf* <Core/Relationship> .
        ?to <Core/relationshipType> <Core/RelationshipType/invokedBy> .
    }
}""" .

