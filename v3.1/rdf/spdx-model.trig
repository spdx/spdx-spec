        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N066f352f3ac548beaac42331f31f31c9,
            _:N1457fdd1eeef4f55a10b083ee3e9c359,
