        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns9:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns3:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N05f44c46a6174d2a8524449e1722231f,
            _:N08204c7646c649f1ba7ed995f7dbca1c,
            _:N2446ab892e2e4266a46256e14dfd17d5,
