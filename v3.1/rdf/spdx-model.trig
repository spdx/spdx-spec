        rdfs:subClassOf ns2:CreateAction ;
        sh:nodeKind sh:IRI .

    ns2:ReproduceProcess a owl:Class ;
        rdfs:comment "Reproduction is the biological process by which living organisms produce offspring."@en ;
        rdfs:subClassOf ns2:CreateProcess ;
