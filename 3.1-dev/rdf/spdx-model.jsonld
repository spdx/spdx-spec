      {
        "@language": "en",
        "@value": "Other exploit catalogs."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "other"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/RelationshipType/descendantOf",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
