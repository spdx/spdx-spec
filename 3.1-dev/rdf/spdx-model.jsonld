      {
        "@id": "https://spdx.org/rdf/3.1/creationInfo_NoneLicense"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/FunctionalSafety/EvaluationResultType/pass",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/FunctionalSafety/EvaluationResultType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Indicates a successful evaluation where the requirement or condition is clearly met."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "pass"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Security/VexUnderInvestigationVulnAssessmentRelationship",
