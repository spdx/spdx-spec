    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "HarvestAction represents the act of creating a product by directly extracting goods or materials from nature."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
