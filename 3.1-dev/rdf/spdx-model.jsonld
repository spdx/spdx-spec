      {
        "@language": "en",
        "@value": "Designates a `from` Vulnerability was made available for public use or reference by each `to` Agent."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "publishedBy"
