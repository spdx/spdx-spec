      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A evidenceUUID is a universally unique identifier (UUID) assigned to an entity, item, or requirement."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifier"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Software/SbomType/runtime",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Software/SbomType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "SBOM generated through instrumenting the system running the software, to capture only components present in the system, as well as external call-outs or dynamically loaded components. In some contexts, this may also be referred to as an \"Instrumented\" or \"Dynamic\" SBOM."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "runtime"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/locationTime",
