["_:Nc961fef14ea944f7998b6c4a82e4766e", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Core/RelationshipType/availableFrom", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/relationshipType", "http://www.w3.org/2000/01/rdf-schema#comment", "Information about the relationship between two Elements.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/inspection", "http://www.w3.org/2000/01/rdf-schema#comment", "A thorough examination or checking of documentation, records, processes, or systems to confirm compliance or adherence. An inspection needs to have a defined set of acceptance criteria (e.g. a checklist), a documentation of roles involved in the inspection (e.g. to document the inspector's independence) and a clear documentation of when and how it was performed.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RequirementStatusType", "http://www.w3.org/2000/01/rdf-schema#comment", "Provide an enumerated set of requirement statuses that can provide state to a requirement.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/hasContactPoint", "http://www.w3.org/2000/01/rdf-schema#comment", "The `from` Artifact has each `to` Agent as a contact point. The use of the `hasContactPoint` type is constrained to `ContactPointRelationship` classed relationships. The type of contact (i.e. security) may be specified using a `ContactPointRelationship` element.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
