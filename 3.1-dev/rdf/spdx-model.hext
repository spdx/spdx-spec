["_:N41866e81df084fc5b0089888aeb96eaa", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Core/RelationshipType/fixedIn", "globalId", "", ""]
