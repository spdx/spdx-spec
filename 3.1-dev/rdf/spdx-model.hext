["https://spdx.org/rdf/3/terms/FunctionalSafety/evaluationBasedOn", "http://www.w3.org/2000/01/rdf-schema#comment", "Indicates the specific RequirementVerification instance on which the EvaluationResult is based.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
