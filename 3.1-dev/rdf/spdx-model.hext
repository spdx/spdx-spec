["https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasDistributionArtifact", "http://www.w3.org/2000/01/rdf-schema#comment", "The `from` Element is distributed as an artifact in each `to` Element (e.g. an RPM or archive file).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/operations", "http://www.w3.org/2000/01/rdf-schema#comment", "The element follows the Operations profile specification.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
