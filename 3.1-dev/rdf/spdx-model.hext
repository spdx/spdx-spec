["https://spdx.org/rdf/3/terms/Core/HashAlgorithm/sha1", "http://www.w3.org/2000/01/rdf-schema#comment", "SHA-1, a secure hashing algorithm, as defined in [RFC 3174](https://datatracker.ietf.org/doc/rfc3174/).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N49ae1cd293314ae899c7efc27db7cc88", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/configures> .\n    FILTER NOT EXISTS { $this rdf:type <Core/LifecycleScopedRelationship> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
