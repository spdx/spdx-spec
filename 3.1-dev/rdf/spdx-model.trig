    <https://spdx.org/rdf/3.1/terms/Core/RelationshipType/trainedOn> a owl:NamedIndividual,
            ns1:RelationshipType ;
        rdfs:label "trainedOn" ;
        rdfs:comment "The `from` Element has been trained on the `to` Element(s)."@en .

