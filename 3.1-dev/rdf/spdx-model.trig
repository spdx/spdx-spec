        rdfs:range xsd:string .

    ns4:datasetAvailability a owl:ObjectProperty ;
        rdfs:comment "Availability of a dataset."@en ;
        rdfs:range ns4:DatasetAvailabilityType .

    ns4:datasetNoise a owl:DatatypeProperty ;
        rdfs:comment "Potentially noisy elements of the dataset."@en ;
        rdfs:range xsd:string .

