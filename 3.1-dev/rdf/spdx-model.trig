        rdfs:subClassOf <https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo> ;
        sh:nodeKind sh:IRI ;
        sh:property _:Ne3ea4ea68b9b4d169e401bf6fcfe3f2c .

    ns2:ListedLicense a owl:Class,
