    ns3:externalRef a owl:ObjectProperty ;
        rdfs:comment """Points to a resource outside the scope of the SPDX 3 content
that provides additional characteristics of an Element."""@en ;
        rdfs:range ns3:ExternalRef .

    ns3:externalRefType a owl:ObjectProperty ;
        rdfs:comment "Specifies the type of the external reference."@en ;
        rdfs:range ns3:ExternalRefType .

    ns3:externalSpdxId a owl:DatatypeProperty ;
        rdfs:comment """Identifies an external Element used within an SpdxDocument but defined
external to that SpdxDocument."""@en ;
        rdfs:range xsd:anyURI .

    ns3:from a owl:ObjectProperty ;
        rdfs:comment "References the Element on the left-hand side of a relationship."@en ;
        rdfs:range ns3:Element .

    ns3:geographicPointLocation a owl:DatatypeProperty ;
        rdfs:comment "This is a set of point coordinates as defined in by the GPS standard."@en ;
        rdfs:range xsd:string .

    ns3:headquartersLocation a owl:ObjectProperty ;
        rdfs:comment "The headquartersLocation defines the location of the organization's headquarters."@en ;
        rdfs:range ns3:Location .

    ns3:identifier a owl:DatatypeProperty ;
        rdfs:comment "Uniquely identifies an external element."@en ;
        rdfs:range xsd:string .

    ns3:identifierLocator a owl:DatatypeProperty ;
        rdfs:comment "Provides the location for more information regarding an external identifier."@en ;
        rdfs:range xsd:anyURI .

    ns3:import a owl:ObjectProperty ;
        rdfs:comment "Provides an ExternalMap of Element identifiers."@en ;
