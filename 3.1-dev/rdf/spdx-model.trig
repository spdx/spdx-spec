        sh:nodeKind sh:IRI ;
        sh:property _:N0b6dec90c06144bba6ce94efb8712575,
            _:N1a280b5cc6044931b7023de744ba33c2,
            _:N2fe5cbccd3914e7bb0d5a9279b57e404,
