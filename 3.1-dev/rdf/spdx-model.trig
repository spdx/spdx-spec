        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI .

    ns10:ChangeAction a owl:Class ;
        rdfs:comment "An actual change to a product."@en ;
        rdfs:subClassOf ns10:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns10:ChangeProcess a owl:Class ;
        rdfs:comment "A prescribed change to a product."@en ;
        rdfs:subClassOf ns10:ModifyProcess ;
        sh:nodeKind sh:IRI .

    ns10:DestroyAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "The record of destruction is entered in this action."@en ;
