        rdfs:subClassOf ns8:UseProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N39ab8ba568de46a2b31d9b7e7a5f8add .

    ns8:InstantiateVirtualHardwareProcess a owl:Class ;
