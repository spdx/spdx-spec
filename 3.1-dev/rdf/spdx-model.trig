        rdfs:subClassOf ns4:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns4:StorageProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Prescribes the storage of a product."@en ;
        rdfs:subClassOf ns4:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N2546c097337f440eb18a255f236cd23d .

    ns4:TestAction a owl:Class ;
        rdfs:comment "A test action is a specific action associated with a test."@en ;
        rdfs:subClassOf ns4:UseAction ;
        sh:nodeKind sh:IRI .

    ns4:TestProcess a owl:Class ;
        rdfs:comment "Test Process defines the testing process for an element."@en ;
        rdfs:subClassOf ns4:UseProcess ;
        sh:nodeKind sh:IRI .

    ns4:TransportAction a owl:Class,
            sh:NodeShape ;
