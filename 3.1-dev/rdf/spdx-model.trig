Size of the dataset."""@en ;
        rdfs:range xsd:nonNegativeInteger .

    ns4:datasetType a owl:ObjectProperty ;
        rdfs:comment "Type of data in a dataset."@en ;
        rdfs:range ns4:DatasetType .

