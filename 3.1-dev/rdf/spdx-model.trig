        rdfs:range xsd:string .

    ns5:standardLicenseHeader a owl:DatatypeProperty ;
        rdfs:comment """Provides a License author's preferred text to indicate that a file is covered
by the License."""@en ;
        rdfs:range xsd:string .

    ns5:standardLicenseTemplate a owl:DatatypeProperty ;
