    _:N00a6395e42b44216901af2d240b2e2f3 a sh:SPARQLConstraint ;
        sh:message "When relationship is foundBy, to must be an Agent" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/foundBy> .
