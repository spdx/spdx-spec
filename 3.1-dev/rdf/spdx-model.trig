    _:N020af72cc52946fb91968a7becd7184a a sh:SPARQLConstraint ;
        sh:message "When relationship is delegatedTo, from must be an Agent" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/delegatedTo> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Agent> }
}""" .

