        sh:property _:Ne82e75ee1598427d8cb12a45df329381 .

    ns3:actionEndTime a owl:DatatypeProperty ;
        rdfs:comment "Property that describes the time at which an action stops."@en ;
        rdfs:range xsd:dateTimeStamp .

    ns3:actionLocation a owl:ObjectProperty ;
        rdfs:comment "Location of a specific action."@en ;
        rdfs:range ns3:Location .

    ns3:actionStartTime a owl:DatatypeProperty ;
        rdfs:comment "Property describing the start time of an action."@en ;
        rdfs:range xsd:dateTimeStamp .

    ns3:additionalInformation a owl:ObjectProperty ;
        rdfs:comment "Additional relevance information."@en ;
        rdfs:range ns3:DictionaryEntry .

    ns3:annotationType a owl:ObjectProperty ;
        rdfs:comment "Describes the type of annotation."@en ;
        rdfs:range ns3:AnnotationType .

    ns3:beginIntegerRange a owl:DatatypeProperty ;
        rdfs:comment "Defines the beginning of a range."@en ;
        rdfs:range xsd:positiveInteger .

    ns3:builtTime a owl:DatatypeProperty ;
        rdfs:comment "Specifies the time an artifact was built."@en ;
        rdfs:range xsd:dateTimeStamp .

