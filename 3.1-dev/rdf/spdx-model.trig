    _:Nbe8f1f87f6da4c33a57ac007a55ecfd3 a sh:SPARQLConstraint ;
        sh:message "When relationship is performedBy, from must be an Action or a Relationship of type hasInstall or hasUninstall" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/performedBy> .
    $this <Core/from> ?from .
