        rdfs:subClassOf <https://spdx.org/rdf/3.1/terms/Extension/Extension> ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:property _:N530ed2568eb74f1f9d4d1ec76a6cfe13 .

    ns5:mass a owl:DatatypeProperty ;
        rdfs:comment "Information related to physical hardware."@en ;
        rdfs:range xsd:decimal .

    <https://spdx.org/rdf/3.0.1/creationInfo_NoAssertionElement> a ns1:CreationInfo ;
