        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns7:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns4:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N362cae564df4470f8e5e30cc82974fe3,
            _:N3b740d28ed71470dba49a8dc798f4c46,
            _:N4f326a966b464fdfbfff49612f38de54,
            _:N62eb76bd4a9f44b093d8c5064d2552ad,
            _:N7afa3c78acf44d7f891c9661b532075c,
            _:N7b93634119d54ff6ab0cbe40058c2b1d,
            _:N7d1c6ec00b5049aaa3913dce5ad0ce95,
