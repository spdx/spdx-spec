        rdfs:range ns6:ConfidentialityLevelType .

    ns6:dataCollectionProcess a owl:DatatypeProperty ;
        rdfs:comment "How the dataset was collected."@en ;
        rdfs:range xsd:string .

    ns6:dataPreprocessing a owl:DatatypeProperty ;
