        sh:nodeKind sh:IRI ;
        sh:property _:N59668acb425046b5aaaa5e9ea824fc08,
            _:N8f3c66399fc04d42ab679d354985efd3 .

    ns2:OrLaterOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing this version, or any later version,
