        rdfs:range xsd:string .

    ns10:AssemblyAction a owl:Class ;
        rdfs:comment "AssemblyAction represents the event of creating a product by assembling individual components."@en ;
        rdfs:subClassOf ns10:CreateAction ;
        sh:nodeKind sh:IRI .

