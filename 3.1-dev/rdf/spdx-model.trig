    <https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/framework> a owl:NamedIndividual,
            ns6:SoftwarePurpose ;
        rdfs:label "framework" ;
        rdfs:comment "The Element is a software framework."@en .

