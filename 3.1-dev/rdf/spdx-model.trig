    ns7:dataCollectionProcess a owl:DatatypeProperty ;
        rdfs:comment "How the dataset was collected."@en ;
        rdfs:range xsd:string .

    ns7:dataPreprocessing a owl:DatatypeProperty ;
        rdfs:comment "Preprocessing steps that were applied to the raw data to create the given dataset."@en ;
        rdfs:range xsd:string .

    ns7:datasetAvailability a owl:ObjectProperty ;
        rdfs:comment "Availability of a dataset."@en ;
        rdfs:range ns7:DatasetAvailabilityType .

    ns7:datasetNoise a owl:DatatypeProperty ;
