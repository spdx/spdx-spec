        sh:nodeKind sh:IRI ;
        sh:property _:N0cfcb2f83753479db2cc3d254e5c119c,
            _:N170a1829e1a345d6b99581f76b461bbf,
            _:N3e0428c8fc2e48c69227e3fa55687bbe,
