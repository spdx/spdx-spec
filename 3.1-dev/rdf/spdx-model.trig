        sh:nodeKind sh:IRI ;
        sh:property _:N39fdb7000d33416c95473c0deccb785f,
            _:Na7b01c64da5242128c1b3a325f83e505 .

    ns2:serverAuthenticationProtocol a owl:ObjectProperty ;
