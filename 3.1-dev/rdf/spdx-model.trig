        rdfs:label "manifest" ;
        rdfs:comment "The Element is a software manifest."@en .

    <https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/model> a owl:NamedIndividual,
            ns9:SoftwarePurpose ;
