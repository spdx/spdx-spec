    <https://spdx.org/rdf/3/terms/Core/ProfileIdentifierType/build> a owl:NamedIndividual,
            ns1:ProfileIdentifierType ;
        rdfs:label "build" ;
        rdfs:comment "The element follows the Build profile specification."@en .

