        sh:nodeKind sh:IRI ;
        sh:property _:N1e82e727d7474f279671385e547320f2,
            _:N2b6c9640dbda4f8f9bb4adf56d401189,
            _:N544f5a598dba4575bbadc79560cca757,
            _:N6d6f1535fab94b31b4809923d859de43,
            _:N7f358dd8360548d6b1f2e99d483e8e4a,
