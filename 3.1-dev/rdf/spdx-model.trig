        sh:nodeKind sh:IRI ;
        sh:property _:N11a7716271b9486b946afcfbe60873d7,
            _:N14c0ae5abef84c2780e039d074c83b96,
            _:N3e9ac0cc88794f068c38e81f8c52e3ec,
