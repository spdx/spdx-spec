        sh:nodeKind sh:IRI ;
        sh:property _:N5fe1f47807a04a1c8740d7f68386d8b5 .

    ns2:WithAdditionOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing a License which has additional
text applied to it."""@en ;
