        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns9:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns3:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N057cede2db2a4a9082b69217f787ef28,
            _:N39f1958af06d44118bc75b70e7b27ff9,
            _:N416a83d53a11495fa879a365bff3add0,
            _:N4b49fe6f15954cfebf6daa6f87c17cfa,
            _:N4d6481c159184d439e4cd82ebd01a0c7,
            _:N5af8425417c44449b94364c781df93fa,
            _:N858f8fe36648424d8ed36b5b4fa64392,
            _:Naa760f556f4447a89986630794e37355,
            _:Naa8fbb67b53e4521a88caf254e237bed,
            _:Nb8894d295e9244eeb0e7f0b316ec20c3,
            _:Nbd14c5011bbd41829b7ee0a2b534250c,
            _:Nc94e469cfb0e4dd09d280a53cb513bbe,
