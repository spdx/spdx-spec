        rdfs:range ns3:ConfidentialityLevelType .

    ns3:dataCollectionProcess a owl:DatatypeProperty ;
        rdfs:comment "How the dataset was collected."@en ;
        rdfs:range xsd:string .

    ns3:dataPreprocessing a owl:DatatypeProperty ;
