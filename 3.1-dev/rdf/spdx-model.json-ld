  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ark",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "[Archival Resource Key (ARK)](https://arks.org/about/), is a Uniform Resource Identifier (URI) suited to being a persistent identifier for information objects of any type, standardized by the [ARK Identifier Scheme](https://datatracker.ietf.org/doc/draft-kunze-ark/) Internet-Draft. It consists of the \"ark:\" label followed by a Name Assigning Authority Number, a forward slash, a name, and an optional qualifier (e.g., `ark:12148/btv1b8449691v/f29`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ark"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/authorization",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Authorization specifies the permissions, rights, privileges, or benefits granted to a Role, defining what the role is authorized to access, perform, or receive."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/SupplyChain/boundaryParameter",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The boundary parameters define the area or region needed to describe a boundary."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/DictionaryEntry"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/SimpleLicensing/licenseExpression",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A string in the license expression format."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibid",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "[International Business Identifier (IBID)](https://ekys.org/business_identifiers/) is a verifiable unique identifier for legal entities as defined in the [ISO/DIS 25500-3](https://www.iso.org/standard/87705.html) draft standard. It is composed of three data elements: the International Business Registration Number (IBRN), the legal name, and the date of origin formatted as eight numeric characters (YYYYMMDD). Each element is separated by a pipe character (`|`) (e.g., `US-DE.BER:3031657|Code Management Association|19990420`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ibid"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/RelationshipType/hasSpecification",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/RelationshipType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Every `to` Element is a specification for the `from` Element (`from` hasSpecification `to`), during a LifecycleScopeType period."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "hasSpecification"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/AI/EnergyUnitType/kilowattHour",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
