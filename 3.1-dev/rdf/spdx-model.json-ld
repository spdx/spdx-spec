      {
        "@language": "en",
        "@value": "A reference to a runtime analysis report for a package."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "runtimeAnalysisReport"
      }
    ]
  },
