      {
        "@id": "https://spdx.org/rdf/3/terms/FunctionalSafety/EvaluationResultType"
      }
    ],
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@id": "https://spdx.org/rdf/3/terms/FunctionalSafety/EvaluationResultType/pass"
          },
          {
            "@id": "https://spdx.org/rdf/3/terms/FunctionalSafety/EvaluationResultType/fail"
