    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Specifies the type of a content identifier."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/AI/SafetyRiskAssessmentType/medium",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/AI/SafetyRiskAssessmentType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The third-highest level of risk posed by an AI system."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "medium"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/AI/useSensitivePersonalInformation",
