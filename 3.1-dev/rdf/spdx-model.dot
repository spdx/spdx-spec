# Nfbb63026055449e7a6b49f68c9dd28ee node1702
node1702 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nfbb63026055449e7a6b49f68c9dd28ee</B></td></tr><tr><td href='Nfbb63026055449e7a6b49f68c9dd28ee' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nfbb63026055449e7a6b49f68c9dd28ee</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is resolved, from must be a ResolutionAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
