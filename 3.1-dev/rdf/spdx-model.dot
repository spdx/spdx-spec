# Na467e9b92e1c494cbcb78f0114acceaa node783
node783 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na467e9b92e1c494cbcb78f0114acceaa</B></td></tr><tr><td href='Na467e9b92e1c494cbcb78f0114acceaa' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na467e9b92e1c494cbcb78f0114acceaa</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasTest, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasTest&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
