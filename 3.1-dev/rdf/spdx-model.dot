# N7ede3cbc3ac745e081a5122250063eea node1535
node1535 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N7ede3cbc3ac745e081a5122250063eea</B></td></tr><tr><td href='N7ede3cbc3ac745e081a5122250063eea' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N7ede3cbc3ac745e081a5122250063eea</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasUninstall, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasUninstall&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Artifact&gt; }
}&quot;</td></tr></table> > ] 
