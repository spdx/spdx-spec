# Nfed0dd634959446f8f5fd59f83775e35 node1523
node1523 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nfed0dd634959446f8f5fd59f83775e35</B></td></tr><tr><td href='Nfed0dd634959446f8f5fd59f83775e35' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nfed0dd634959446f8f5fd59f83775e35</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is underInvestigationFor, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/underInvestigationFor&gt; .
    $this &lt;Core/from&gt; ?from .
