# N598e8c65d29648839f1ce9cc849bd4bf node1181
node1181 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N598e8c65d29648839f1ce9cc849bd4bf</B></td></tr><tr><td href='N598e8c65d29648839f1ce9cc849bd4bf' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N598e8c65d29648839f1ce9cc849bd4bf</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is performedBy, from must be an Action or a Relationship of type hasInstall or hasUninstall&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/performedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
    FILTER NOT EXISTS { ?from &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasInstall&gt; }
    FILTER NOT EXISTS { ?from &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasUninstall&gt; }
