# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isci node1198
node1198 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>isci</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isci' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isci</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Standard Collection Identifier (ISCI) is a variable-length identifier standardized by [ISO 27730](https://www.iso.org/standard/44293.html) for identifying collections held by libraries, archives, museums, and other memory institutions. It consists of two parts: the identifier for the assigning organization (an ISIL) enclosed in square brackets, followed by a local collection identifier string (e.g., `[FR-751041001]Casadesus1`).&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/RelationshipType/fixedIn node1199
node1199 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>fixedIn</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipType/fixedIn' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipType/fixedIn</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A `from` /Security/Vulnerability has been fixed in each `to` Element. The use of the `fixedIn` type is constrained to `/Security/VexFixedVulnAssessmentRelationship` classed relationships.&quot;@en</td></tr></table> > ] 
