# N1990dab7fbf9438f8d8b22368b82fd9e node1140
node1140 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N1990dab7fbf9438f8d8b22368b82fd9e</B></td></tr><tr><td href='N1990dab7fbf9438f8d8b22368b82fd9e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N1990dab7fbf9438f8d8b22368b82fd9e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/fixedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
