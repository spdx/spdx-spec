# N2483c7dfacc1417c9f73c9a872d313e1 node1151
node1151 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N2483c7dfacc1417c9f73c9a872d313e1</B></td></tr><tr><td href='N2483c7dfacc1417c9f73c9a872d313e1' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N2483c7dfacc1417c9f73c9a872d313e1</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is providesSupportFor, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/providesSupportFor&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Artifact&gt; }
}&quot;</td></tr></table> > ] 
