node1054 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf057457eedcc42fb9cb175bc42ecaee3</B></td></tr><tr><td href='Nf057457eedcc42fb9cb175bc42ecaee3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf057457eedcc42fb9cb175bc42ecaee3</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:pattern</td><td align='left'>&quot;^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$&quot;</td></tr></table> > ] 
