# https://spdx.org/rdf/3/terms/Core/RelationshipType/hasSpecification node4
node4 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>hasSpecification</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipType/hasSpecification' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipType/hasSpecification</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Every `to` Element is a specification for the `from` Element (`from` hasSpecification `to`), during a LifecycleScopeType period.&quot;@en</td></tr></table> > ] 
# Ne9474e072d204d848ec87bd7e2608843 node5
node5 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne9474e072d204d848ec87bd7e2608843</B></td></tr><tr><td href='Ne9474e072d204d848ec87bd7e2608843' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne9474e072d204d848ec87bd7e2608843</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasInput, from must be a Build, DefinedProcess, or Action&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasInput&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Build/Build&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/DefinedProcess&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
}&quot;</td></tr></table> > ] 
