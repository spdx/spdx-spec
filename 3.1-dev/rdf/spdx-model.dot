# Ncc7a8355bfc8446d891f1abd696fb34f node1894
node1894 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ncc7a8355bfc8446d891f1abd696fb34f</B></td></tr><tr><td href='Ncc7a8355bfc8446d891f1abd696fb34f' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ncc7a8355bfc8446d891f1abd696fb34f</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is reportedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/reportedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
