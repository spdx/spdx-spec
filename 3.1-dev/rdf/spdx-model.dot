# N2d4e0a094e4345f2b132526f648e409e node1097
node1097 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N2d4e0a094e4345f2b132526f648e409e</B></td></tr><tr><td href='N2d4e0a094e4345f2b132526f648e409e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N2d4e0a094e4345f2b132526f648e409e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is performedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/performedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
