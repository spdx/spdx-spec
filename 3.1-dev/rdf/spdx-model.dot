# N9eedd73e2a2247f58cbc880a4cb35eb1 node489
node489 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N9eedd73e2a2247f58cbc880a4cb35eb1</B></td></tr><tr><td href='N9eedd73e2a2247f58cbc880a4cb35eb1' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N9eedd73e2a2247f58cbc880a4cb35eb1</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is verifiedBy, to must be a RequirementVerification&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/verifiedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;FunctionalSafety/RequirementVerification&gt; }
}&quot;</td></tr></table> > ] 
