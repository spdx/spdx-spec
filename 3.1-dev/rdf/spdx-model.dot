node1887 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>source</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Software/SbomType/source' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Software/SbomType/source</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;SBOM created directly from the development environment, source files, and included dependencies used to build a product artifact.&quot;@en</td></tr></table> > ] 
# N1924a136469343c185032ba6fd61f677 node1888
node1888 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N1924a136469343c185032ba6fd61f677</B></td></tr><tr><td href='N1924a136469343c185032ba6fd61f677' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N1924a136469343c185032ba6fd61f677</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is publishedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/publishedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
