node689 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>yes</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/PresenceType/yes' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/PresenceType/yes</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Indicates presence of the field.&quot;@en</td></tr></table> > ] 
