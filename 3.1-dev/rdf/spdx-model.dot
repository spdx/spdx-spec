# Nbbc0df7bb95148d28ec9e53583322b12 node1015
node1015 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nbbc0df7bb95148d28ec9e53583322b12</B></td></tr><tr><td href='Nbbc0df7bb95148d28ec9e53583322b12' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nbbc0df7bb95148d28ec9e53583322b12</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is publishedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/publishedBy&gt; .
    $this &lt;Core/to&gt; ?to .
