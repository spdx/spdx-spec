node578 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na3d5cf3dee994c2b9fdbf6b0feef6367</B></td></tr><tr><td href='Na3d5cf3dee994c2b9fdbf6b0feef6367' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na3d5cf3dee994c2b9fdbf6b0feef6367</font></td></tr><tr><td align='left'>sh:pattern</td><td align='left'>&quot;^[a-zA-Z]{2,8}(-[a-zA-Z0-9]{1,8})*$&quot;</td></tr></table> > ] 
