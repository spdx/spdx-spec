node1886 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N485a95551d8a42ccb38fc2fb60a4bc15</B></td></tr><tr><td href='N485a95551d8a42ccb38fc2fb60a4bc15' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N485a95551d8a42ccb38fc2fb60a4bc15</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
