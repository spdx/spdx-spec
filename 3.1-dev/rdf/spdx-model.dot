# N9224f6a0fc4f462f9933b6a5e14f533b node1840
node1840 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N9224f6a0fc4f462f9933b6a5e14f533b</B></td></tr><tr><td href='N9224f6a0fc4f462f9933b6a5e14f533b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N9224f6a0fc4f462f9933b6a5e14f533b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasAssessmentFor, class must be VulnAssessmentRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
