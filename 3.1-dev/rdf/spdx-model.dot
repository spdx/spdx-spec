# N587a4d7c1e634f6eb4ec98108641e298 node140
node140 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N587a4d7c1e634f6eb4ec98108641e298</B></td></tr><tr><td href='N587a4d7c1e634f6eb4ec98108641e298' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N587a4d7c1e634f6eb4ec98108641e298</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, from must be an Action or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
