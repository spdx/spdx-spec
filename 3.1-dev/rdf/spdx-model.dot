node1457 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N73669fc501a34d908e34b8b1936d1211</B></td></tr><tr><td href='N73669fc501a34d908e34b8b1936d1211' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N73669fc501a34d908e34b8b1936d1211</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;A value for Core/name is required when a value for Core/version is present&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
