# Nf90b4a2182d34152bbd94e6021ba822c node520
node520 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf90b4a2182d34152bbd94e6021ba822c</B></td></tr><tr><td href='Nf90b4a2182d34152bbd94e6021ba822c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf90b4a2182d34152bbd94e6021ba822c</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedIn, class must be VexFixedVulnAssessmentRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/fixedIn&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Security/VexFixedVulnAssessmentRelationship&gt; }
}&quot;</td></tr></table> > ] 
