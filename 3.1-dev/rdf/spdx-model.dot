# Nb28945c2b40945ab9acb97293efe5daa node1888
node1888 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb28945c2b40945ab9acb97293efe5daa</B></td></tr><tr><td href='Nb28945c2b40945ab9acb97293efe5daa' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb28945c2b40945ab9acb97293efe5daa</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasStaticLink, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasStaticLink&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
# Nf1bc1fdc6e7b4b46a29d6df1d3729502 node1889
node1889 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf1bc1fdc6e7b4b46a29d6df1d3729502</B></td></tr><tr><td href='Nf1bc1fdc6e7b4b46a29d6df1d3729502' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf1bc1fdc6e7b4b46a29d6df1d3729502</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasDeclaredLicense, to must be an AnyLicenseInfo&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasDeclaredLicense&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;SimpleLicensing/AnyLicenseInfo&gt; }
}&quot;</td></tr></table> > ] 
