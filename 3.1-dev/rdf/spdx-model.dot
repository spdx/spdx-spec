# N693d56a3add34b1396b174c44afd0ed9 node1479
node1479 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N693d56a3add34b1396b174c44afd0ed9</B></td></tr><tr><td href='N693d56a3add34b1396b174c44afd0ed9' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N693d56a3add34b1396b174c44afd0ed9</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasUninstall, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasUninstall&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Artifact&gt; }
}&quot;</td></tr></table> > ] 
# N28b039d1580142aca75a8faca0cd09c7 node1480
