# Ndea1b267d84a4f1bb5f114b4f6e8a9ce node531
node531 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ndea1b267d84a4f1bb5f114b4f6e8a9ce</B></td></tr><tr><td href='Ndea1b267d84a4f1bb5f114b4f6e8a9ce' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ndea1b267d84a4f1bb5f114b4f6e8a9ce</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is tracedToDetail, to must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/tracedToDetail&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
