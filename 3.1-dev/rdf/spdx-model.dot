node1319 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N30ec87dbbc544f488ab83e2f2cc9dca0</B></td></tr><tr><td href='N30ec87dbbc544f488ab83e2f2cc9dca0' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N30ec87dbbc544f488ab83e2f2cc9dca0</font></td></tr></table> > ] 
