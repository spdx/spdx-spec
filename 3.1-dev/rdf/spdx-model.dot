# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iscc node191
node191 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>iscc</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iscc' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iscc</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;[International Standard Content Code (ISCC)](https://iscc.io/) is a content-derived identifier standardized by [ISO 24138](https://www.iso.org/standard/77899.html) for identifying digital assets. ISCC can be used in conjunction with other schemes, such as DOI, ISAN, ISBN, ISRC, ISSN and ISWC. A standard ISCC-CODE is build from multiple ISCC-UNITs. Each unit serve a different purpose. An ISCC-CODE typically look like `ISCC:KACT4EBWK27737D2AYCJRAL5Z36G76RFRMO4554RU26HZ4ORJGIVHDI`.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel/autonomous node192
node192 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>autonomous</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel/autonomous' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel/autonomous</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Level 6 - Autonomous. The system is capable of modifying its intended domain of use or its goals without external intervention, control or oversight.&quot;@en</td></tr></table> > ] 
# N040820cd86404105bd8eb2dd7bd9f475 node193
node193 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N040820cd86404105bd8eb2dd7bd9f475</B></td></tr><tr><td href='N040820cd86404105bd8eb2dd7bd9f475' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N040820cd86404105bd8eb2dd7bd9f475</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is performedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/performedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
