# Nc90a021e3dda4a6db5c8ddb721e25223 node331
node331 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nc90a021e3dda4a6db5c8ddb721e25223</B></td></tr><tr><td href='Nc90a021e3dda4a6db5c8ddb721e25223' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nc90a021e3dda4a6db5c8ddb721e25223</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is affects, from must be a Vulnerability, Action, or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
