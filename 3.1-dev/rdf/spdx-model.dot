# Na8eda54e809f4d6181fd90b69c2ca9e9 node932
node932 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na8eda54e809f4d6181fd90b69c2ca9e9</B></td></tr><tr><td href='Na8eda54e809f4d6181fd90b69c2ca9e9' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na8eda54e809f4d6181fd90b69c2ca9e9</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasTest, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasTest&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
# N073d06118714440a8d65cc83e7707702 node933
node933 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N073d06118714440a8d65cc83e7707702</B></td></tr><tr><td href='N073d06118714440a8d65cc83e7707702' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N073d06118714440a8d65cc83e7707702</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/fixedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
