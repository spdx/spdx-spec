# N2268c6e810fa4819b0efaf071ba1bd4a node1329
node1329 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N2268c6e810fa4819b0efaf071ba1bd4a</B></td></tr><tr><td href='N2268c6e810fa4819b0efaf071ba1bd4a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N2268c6e810fa4819b0efaf071ba1bd4a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/delegatedTo&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
