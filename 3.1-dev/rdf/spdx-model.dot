node1466 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N81c68f8615194d8eb44b5dad7929f69e</B></td></tr><tr><td href='N81c68f8615194d8eb44b5dad7929f69e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N81c68f8615194d8eb44b5dad7929f69e</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:minCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
