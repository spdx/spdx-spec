node1151 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N79f7a661117249fe81bd9fe9835ac9d3</B></td></tr><tr><td href='N79f7a661117249fe81bd9fe9835ac9d3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N79f7a661117249fe81bd9fe9835ac9d3</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is runsOn, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
