node723 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nad974180f9b04b2bbc84ed25ce56a521</B></td></tr><tr><td href='Nad974180f9b04b2bbc84ed25ce56a521' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nad974180f9b04b2bbc84ed25ce56a521</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
