# N85537caed1484114b76f17352ceca464 node729
node729 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N85537caed1484114b76f17352ceca464</B></td></tr><tr><td href='N85537caed1484114b76f17352ceca464' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N85537caed1484114b76f17352ceca464</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is conformsTo, to must be an Assumption or Specification&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/conformsTo&gt; .
    $this &lt;Core/to&gt; ?to .
