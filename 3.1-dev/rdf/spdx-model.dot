# N5b7335de3e554b51924bd9aff7ea24c3 node1735
node1735 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N5b7335de3e554b51924bd9aff7ea24c3</B></td></tr><tr><td href='N5b7335de3e554b51924bd9aff7ea24c3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N5b7335de3e554b51924bd9aff7ea24c3</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is providesSupportFor, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/providesSupportFor&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Artifact&gt; }
}&quot;</td></tr></table> > ] 
