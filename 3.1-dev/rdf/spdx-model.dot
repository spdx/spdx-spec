# Nb91b6bea010d414f985ea02caaa3f852 node1609
node1609 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb91b6bea010d414f985ea02caaa3f852</B></td></tr><tr><td href='Nb91b6bea010d414f985ea02caaa3f852' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb91b6bea010d414f985ea02caaa3f852</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is providesSupportFor, from must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/providesSupportFor&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
