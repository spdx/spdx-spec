# Nfd91e409524946aa8abee12f94faee70 node1037
node1037 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nfd91e409524946aa8abee12f94faee70</B></td></tr><tr><td href='Nfd91e409524946aa8abee12f94faee70' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nfd91e409524946aa8abee12f94faee70</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is conformsTo, to must be an Assumption or Specification&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/conformsTo&gt; .
    $this &lt;Core/to&gt; ?to .
