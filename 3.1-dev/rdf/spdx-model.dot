# N12bdbcf81b0e47b38c576e4ce12e30e8 node1172
node1172 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N12bdbcf81b0e47b38c576e4ce12e30e8</B></td></tr><tr><td href='N12bdbcf81b0e47b38c576e4ce12e30e8' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N12bdbcf81b0e47b38c576e4ce12e30e8</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is doesNotAffect, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/doesNotAffect&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
