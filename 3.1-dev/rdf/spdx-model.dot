# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/vatNumber node623
node623 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>vatNumber</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/vatNumber' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/vatNumber</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Value Added Tax (VAT) number, or Goods and Services Tax (GST) number, is an identifier assigned by tax authorities that uniquely identifies a business within a specific national border or tax jurisdiction for the collection and tracking of VAT/GST.&quot;@en</td></tr></table> > ] 
