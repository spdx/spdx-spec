      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalRefType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A reference to binary artifacts related to a package."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "binaryArtifact"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/LifecycleScopeType/update",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/LifecycleScopeType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A relationship has specific context implications for a product update."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "update"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Dataset/intendedUse",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "**DEPRECATED in SPDX 3.1.**\nUse [/Core/intendedUse](../../Core/Properties/intendedUse.md) instead.\n\nThe intended use of a given dataset."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Software/sourceInfo",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
