      "https://spdx.org/rdf/3/terms/Core/IndividualElement"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An Individual Value for Element representing a set of Elements of unknown\nidentity or cardinality (number)."
