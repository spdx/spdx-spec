    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "**DEPRECATED in SPDX 3.1.**\nUse [/Core/startTime](../../Core/Properties/startTime.md) instead.\n\nProperty describing the start time of a build."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
