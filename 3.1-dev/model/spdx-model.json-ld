    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "ManufactureAction represents the act of creating a product by a manufacturing process."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
