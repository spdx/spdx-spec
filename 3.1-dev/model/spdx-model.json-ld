    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Dataset is not publicly available and can only be accessed after affirmatively accepting terms on a clickthrough webpage."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "clickthrough"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/PresenceType/yes",
    "@type": [
