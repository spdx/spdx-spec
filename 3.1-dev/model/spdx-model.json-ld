      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "webpage"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Hardware/productAgent",
    "@type": [
