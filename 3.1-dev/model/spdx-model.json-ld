      {
        "@id": "http://www.w3.org/ns/shacl#Literal"
      }
    ],
    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/version"
      }
    ]
  },
