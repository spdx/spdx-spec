      {
        "@language": "en",
        "@value": "The relationship is known to be exhaustive."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "complete"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalRefType/eolNotice",
