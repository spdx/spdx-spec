["_:N874756afd1e14488bd3ca078edb18d9b", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/hasInstall> .\n    FILTER NOT EXISTS { $this rdf:type <Core/LifecycleScopedRelationship> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["_:N29959e5e311747718df78e31814a901a", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/conformsTo> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <FunctionalSafety/Assumption> }\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Specification> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
