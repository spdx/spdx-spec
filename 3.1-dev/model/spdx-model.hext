["_:Nc9f4b94dfaa049a7a6df983d394c24a7", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/hasRoleIn> .\n    FILTER NOT EXISTS { $this rdf:type <Core/RoleRelationship> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
