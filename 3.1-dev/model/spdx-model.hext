["https://spdx.org/rdf/3/terms/Dataset/DatasetType/graph", "http://www.w3.org/2000/01/rdf-schema#comment", "Data is in the form of a graph where entries are somehow related to each other through edges, such as a social network of friends.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N7af27b1de3ef4ec7bc4df8633faebf05", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/FunctionalSafety/SafetyIntegrityLevelType/dalD", "globalId", "", ""]
