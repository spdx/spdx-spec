["_:N64bb94ac826d48e69ae13d43289edf98", "http://www.w3.org/ns/shacl#pattern", "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/RelationshipType/pretrainedOn", "http://www.w3.org/2000/01/rdf-schema#comment", "The `from` Element has been pretrained on the `to` Element(s).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
