["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibid", "http://www.w3.org/2000/01/rdf-schema#comment", "[International Business Identifier (IBID)](https://ekys.org/business_identifiers/) is a verifiable unique identifier for legal entities as defined in the [ISO/DIS 25500-3](https://www.iso.org/standard/87705.html) draft standard. It is composed of three data elements: the International Business Registration Number (IBRN), the legal name, and the date of origin formatted as eight numeric characters (YYYYMMDD). Each element is separated by a pipe character (`|`) (e.g., `US-DE.BER:3031657|Code Management Association|19990420`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalRefType/qualityAssessmentReport", "http://www.w3.org/2000/01/rdf-schema#comment", "A reference to a quality assessment for a package.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SimpleLicensing/licenseExpression", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#DatatypeProperty", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/authorization", "http://www.w3.org/2000/01/rdf-schema#comment", "Authorization specifies the permissions, rights, privileges, or benefits granted to a Role, defining what the role is authorized to access, perform, or receive.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/performedBy", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
