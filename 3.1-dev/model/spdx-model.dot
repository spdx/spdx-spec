node228 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne9f0cec54e2146e9a83935bea2f61bb3</B></td></tr><tr><td href='Ne9f0cec54e2146e9a83935bea2f61bb3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne9f0cec54e2146e9a83935bea2f61bb3</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasPrerequisite, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasPrerequisite&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
