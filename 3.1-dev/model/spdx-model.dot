node370 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>componentNotPresent</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Security/VexJustificationType/componentNotPresent' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Security/VexJustificationType/componentNotPresent</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The software is not affected because the vulnerable component is not in the product.&quot;@en</td></tr></table> > ] 
