node368 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>VexAffectedVulnAssessmentRelationship</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Security/VexAffectedVulnAssessmentRelationship' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Security/VexAffectedVulnAssessmentRelationship</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Connects a vulnerability and an element designating the element as a product
affected by the vulnerability.&quot;@en</td></tr></table> > ] 
