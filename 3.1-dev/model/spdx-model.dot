# N22f332fc80034fa2a92e51e04ede091a node1826
node1826 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N22f332fc80034fa2a92e51e04ede091a</B></td></tr><tr><td href='N22f332fc80034fa2a92e51e04ede091a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N22f332fc80034fa2a92e51e04ede091a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is serializedInArtifact, from must be a SpdxDocument&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
