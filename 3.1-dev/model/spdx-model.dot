# N8e0da09836a84cf29a5a027272ae5bbd node1715
node1715 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8e0da09836a84cf29a5a027272ae5bbd</B></td></tr><tr><td href='N8e0da09836a84cf29a5a027272ae5bbd' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8e0da09836a84cf29a5a027272ae5bbd</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, from must be an Action or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
