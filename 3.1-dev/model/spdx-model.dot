# N1393a622fe074ab1ae61547ae048daf7 node1139
node1139 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N1393a622fe074ab1ae61547ae048daf7</B></td></tr><tr><td href='N1393a622fe074ab1ae61547ae048daf7' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N1393a622fe074ab1ae61547ae048daf7</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasInput, from must be a Build, DefinedProcess, or Action&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasInput&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Build/Build&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/DefinedProcess&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
}&quot;</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalRefType/securityAdvisory node1140
node1140 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>securityAdvisory</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalRefType/securityAdvisory' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalRefType/securityAdvisory</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A reference to a published security advisory (where advisory is defined per [ISO 29147:2018](https://www.iso.org/standard/72311.html)) that may affect one or more elements, e.g., vendor advisories or specific NVD entries.&quot;@en</td></tr></table> > ] 
