# N45d591e0ef5a48b6b13eb84d93ed50ab node665
node665 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N45d591e0ef5a48b6b13eb84d93ed50ab</B></td></tr><tr><td href='N45d591e0ef5a48b6b13eb84d93ed50ab' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N45d591e0ef5a48b6b13eb84d93ed50ab</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is performedBy, from must be an Action or a Relationship of type hasInstall or hasUninstall&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
