node510 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>blake2b384</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/blake2b384' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/blake2b384</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;BLAKE2b algorithm with a digest size of 384, as defined in [RFC 7693](https://datatracker.ietf.org/doc/rfc7693/) Section 4.&quot;@en</td></tr></table> > ] 
