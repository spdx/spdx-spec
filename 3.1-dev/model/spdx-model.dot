# Nc79e52ff8ed64c5cb7365ef230a33d2b node1723
node1723 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nc79e52ff8ed64c5cb7365ef230a33d2b</B></td></tr><tr><td href='Nc79e52ff8ed64c5cb7365ef230a33d2b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nc79e52ff8ed64c5cb7365ef230a33d2b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is resolved, from must be a ResolutionAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/resolved&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;SupplyChain/ResolutionAction&gt; }
}&quot;</td></tr></table> > ] 
