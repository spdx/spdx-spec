node683 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N24a5d0db5b2b49998f329e523c380ce1</B></td></tr><tr><td href='N24a5d0db5b2b49998f329e523c380ce1' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N24a5d0db5b2b49998f329e523c380ce1</font></td></tr></table> > ] 
