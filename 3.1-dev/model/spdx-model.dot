# N8bd47357958c438e99c2abbdfbbc94b0 node2063
node2063 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8bd47357958c438e99c2abbdfbbc94b0</B></td></tr><tr><td href='N8bd47357958c438e99c2abbdfbbc94b0' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8bd47357958c438e99c2abbdfbbc94b0</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasUninstall, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasUninstall&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
