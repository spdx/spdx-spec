# Nc784d68cd442465bb528b4ebca0c8c0f node596
node596 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nc784d68cd442465bb528b4ebca0c8c0f</B></td></tr><tr><td href='Nc784d68cd442465bb528b4ebca0c8c0f' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nc784d68cd442465bb528b4ebca0c8c0f</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedIn, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/fixedIn&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
