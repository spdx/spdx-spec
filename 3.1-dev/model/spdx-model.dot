node939 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb016c849c7c3428ebec145f713bd8a0f</B></td></tr><tr><td href='Nb016c849c7c3428ebec145f713bd8a0f' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb016c849c7c3428ebec145f713bd8a0f</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasPrerequisite, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
