node252 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>hasTest</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipType/hasTest' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipType/hasTest</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Every `to` Element is a test artifact for the `from` Element (`from` hasTest `to`), during a LifecycleScopeType period.&quot;@en</td></tr></table> > ] 
