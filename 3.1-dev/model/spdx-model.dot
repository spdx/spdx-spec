node654 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N248c07c682e146a0a6235c947dbec53b</B></td></tr><tr><td href='N248c07c682e146a0a6235c947dbec53b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N248c07c682e146a0a6235c947dbec53b</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:pattern</td><td align='left'>&quot;^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$&quot;</td></tr></table> > ] 
