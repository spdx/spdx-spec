# N274be612315f4c5fb689c9bcc6dc4d7a node1148
node1148 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N274be612315f4c5fb689c9bcc6dc4d7a</B></td></tr><tr><td href='N274be612315f4c5fb689c9bcc6dc4d7a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N274be612315f4c5fb689c9bcc6dc4d7a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is resolved, to must be an OutOfSpecAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/resolved&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;SupplyChain/OutOfSpecAction&gt; }
}&quot;</td></tr></table> > ] 
