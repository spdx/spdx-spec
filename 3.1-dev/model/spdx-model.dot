# N87b849f9b4b445479da00f1bbbd80f98 node471
node471 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N87b849f9b4b445479da00f1bbbd80f98</B></td></tr><tr><td href='N87b849f9b4b445479da00f1bbbd80f98' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N87b849f9b4b445479da00f1bbbd80f98</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is serializedInArtifact, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/serializedInArtifact&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Artifact&gt; }
}&quot;</td></tr></table> > ] 
