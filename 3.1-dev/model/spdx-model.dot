node1582 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne85766c19ad042be87b0bf95f3ad7c7b</B></td></tr><tr><td href='Ne85766c19ad042be87b0bf95f3ad7c7b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne85766c19ad042be87b0bf95f3ad7c7b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasUninstall, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
