node1544 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>NoAssertionElement</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/NoAssertionElement' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/NoAssertionElement</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;An Individual Value for Element representing a set of Elements of unknown
identity or cardinality (number).&quot;@en</td></tr></table> > ] 
