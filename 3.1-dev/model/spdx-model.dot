# N1675e5b12eaa4f2eb1183483b50ff2ee node996
node996 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N1675e5b12eaa4f2eb1183483b50ff2ee</B></td></tr><tr><td href='N1675e5b12eaa4f2eb1183483b50ff2ee' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N1675e5b12eaa4f2eb1183483b50ff2ee</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is exploitCreatedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/exploitCreatedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
