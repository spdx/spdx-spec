# N42da550fe82247caa3caa7fcf4aab17c node1102
node1102 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N42da550fe82247caa3caa7fcf4aab17c</B></td></tr><tr><td href='N42da550fe82247caa3caa7fcf4aab17c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N42da550fe82247caa3caa7fcf4aab17c</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is exploitCreatedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/exploitCreatedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
