# https://spdx.org/rdf/3/terms/Core/ExternalRefType/x509Cert node1142
node1142 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>x509Cert</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalRefType/x509Cert' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalRefType/x509Cert</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A reference to an X.509 certificate as defined in [RFC 5280](https://datatracker.ietf.org/doc/rfc5280/). The primary media type shall be `application/pkix-cert`. The legacy media types `application/x-x509-ca-cert` and `application/x-x509-user-cert` may be used for backward compatibility, but shall not be used in new implementations. NOTE — RFC 5280 supersedes earlier X.509 profiles, including RFC 1422. Existing references based on RFC 1422 remain valid.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/RelationshipType/hasDocumentation node1143
node1143 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>hasDocumentation</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipType/hasDocumentation' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipType/hasDocumentation</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The `from` Element is documented by each `to` Element.&quot;@en</td></tr></table> > ] 
# N03eee9d4482e4497bcbe4b215b128099 node1144
node1144 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N03eee9d4482e4497bcbe4b215b128099</B></td></tr><tr><td href='N03eee9d4482e4497bcbe4b215b128099' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N03eee9d4482e4497bcbe4b215b128099</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, to must be a Relationship whose relationshipType is invokedBy&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/delegatedTo&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS {
        ?to rdf:type/rdfs:subClassOf* &lt;Core/Relationship&gt; .
        ?to &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    }
}&quot;</td></tr></table> > ] 
# Nb0977106f4554b0a9f6da0639fedd127 node1145
node1145 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb0977106f4554b0a9f6da0639fedd127</B></td></tr><tr><td href='Nb0977106f4554b0a9f6da0639fedd127' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb0977106f4554b0a9f6da0639fedd127</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasContactPoint, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasContactPoint&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
