node723 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>pass</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvaluationResultType/pass' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvaluationResultType/pass</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Indicates a successful evaluation where the requirement or condition is clearly met.&quot;@en</td></tr></table> > ] 
