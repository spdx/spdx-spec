# Nf56efe031d4b42f88e698d2c30e71f6c node1528
node1528 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf56efe031d4b42f88e698d2c30e71f6c</B></td></tr><tr><td href='Nf56efe031d4b42f88e698d2c30e71f6c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf56efe031d4b42f88e698d2c30e71f6c</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;A value for Core/name is required when a value for Core/version is present&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Software/version&gt; ?version .
    FILTER NOT EXISTS {
        $this &lt;Software/name&gt; ?name .
    }
}&quot;</td></tr></table> > ] 
# N4f8186e597bb42c990df0df1207704f1 node1529
node1529 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N4f8186e597bb42c990df0df1207704f1</B></td></tr><tr><td href='N4f8186e597bb42c990df0df1207704f1' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N4f8186e597bb42c990df0df1207704f1</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasHost, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasHost&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
