_:Nb85487061e7f492192d396c728e00b31 <http://www.w3.org/ns/shacl#not> _:Nd45820dcedc9419b8e8bdeb09d5138c0 .
<https://spdx.org/rdf/3/terms/Core/HashAlgorithm/md2> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://www.w3.org/2002/07/owl#NamedIndividual> .
_:Nc10100b6957a41d3bc26d3c8c5711622 <http://www.w3.org/ns/shacl#select> "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/hasRequirement> .\n    FILTER NOT EXISTS { $this rdf:type <Core/LifecycleScopedRelationship> }\n}" .
