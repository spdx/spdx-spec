        rdfs:subClassOf <https://spdx.org/rdf/3.1/terms/Extension/Extension> ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:property _:N1723de2287b94c9c97b09a94695ea68c .

    ns7:mass a owl:DatatypeProperty ;
