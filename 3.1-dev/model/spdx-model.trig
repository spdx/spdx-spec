        rdfs:subClassOf ns6:VulnAssessmentRelationship ;
        sh:nodeKind sh:IRI ;
        sh:property _:N37c19bfbc6de4d719f14f311da2d737b .

    ns6:VexAffectedVulnAssessmentRelationship a owl:Class,
            sh:NodeShape ;
