        rdfs:label "asilC" ;
        rdfs:comment "Automotive Safety Integrity Level C under ISO 26262."@en .

    <https://spdx.org/rdf/3/terms/FunctionalSafety/SafetyIntegrityLevelType/asilD> a owl:NamedIndividual,
            ns3:SafetyIntegrityLevelType ;
        rdfs:label "asilD" ;
        rdfs:comment "Automotive Safety Integrity Level D under ISO 26262."@en .

