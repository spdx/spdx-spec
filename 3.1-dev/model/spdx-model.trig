        rdfs:subClassOf ns5:CreateProcess ;
        sh:nodeKind sh:IRI .

    ns5:ResolutionAction a owl:Class ;
        rdfs:comment "Products out of specification require a resolution action. This is the action of resolution."@en ;
        rdfs:subClassOf ns5:UseAction ;
        sh:nodeKind sh:IRI .

