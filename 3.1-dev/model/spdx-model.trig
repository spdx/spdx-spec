        rdfs:range ns7:ContentIdentifierType .

    ns7:contentIdentifierValue a owl:DatatypeProperty ;
        rdfs:comment "Specifies the value of the content identifier."@en ;
        rdfs:range xsd:anyURI .

    ns7:copyrightText a owl:DatatypeProperty ;
