        rdfs:comment "The location for picking up a package or item."@en ;
        rdfs:range ns6:Location .

    ns11:pickupLocation a owl:ObjectProperty ;
        rdfs:comment "The location for picking up a package or item."@en ;
        rdfs:range ns6:Location .

