        sh:nodeKind sh:IRI .

    ns10:PlanAction a owl:Class ;
        rdfs:comment "A PlanAction involves the execution of a plan in relation to a PlanProcess."@en ;
        rdfs:subClassOf ns10:UseAction ;
        sh:nodeKind sh:IRI .

    ns10:PlanProcess a owl:Class ;
