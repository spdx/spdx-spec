    spdx: a owl:Ontology ;
        rdfs:label "System Package Data Exchange™ (SPDX®) Ontology"@en ;
        dcterms:abstract "This ontology defines the terms and relationships used in the SPDX specification to describe system packages"@en ;
        dcterms:created "2026-01-23"^^xsd:date ;
        dcterms:creator "SPDX Project"@en ;
        dcterms:license <https://spdx.org/licenses/Community-Spec-1.0.html> ;
        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns7:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns4:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N08ddb347f05748318f3c129d69309166,
            _:N0a252c4c3d93468484e9d6ee8b039182,
            _:N1dbab7c498ad44ada0995d9be80388a7,
            _:N314d45f0042d4c1b8caffddb11c44a10,
            _:N44545b1d992f43578203b1197574270a,
            _:N4d10465c0ddc44838e3c7a95f99240dd,
            _:N5cb4a13e5e0e4241b51504160c6e5987,
