        rdfs:range xsd:string .

    ns1:standardName a owl:DatatypeProperty ;
        rdfs:comment "The name of a relevant standard that may apply to an artifact."@en ;
        rdfs:range xsd:string .

    ns1:statement a owl:DatatypeProperty ;
