    <https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType/report> a owl:NamedIndividual,
            ns2:EvidenceType ;
        rdfs:label "report" ;
        rdfs:comment "Structured documentation of test results, inspections, or analyses."@en .

