    <https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/software> a owl:NamedIndividual,
            ns1:ProfileIdentifierType ;
        rdfs:label "software" ;
        rdfs:comment "The element follows the Software profile specification."@en .

