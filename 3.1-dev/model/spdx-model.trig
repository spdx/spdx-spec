        rdfs:subClassOf <https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo> ;
        sh:nodeKind sh:IRI ;
        sh:property _:N63ef9423918f4417a27b8008845c7b40 .

    ns6:ListedLicense a owl:Class,
