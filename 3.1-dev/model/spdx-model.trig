        sh:nodeKind sh:IRI ;
        sh:property _:N64cfc89e9d4f4f1c883bc8ddca2c82a4 .

    ns9:DestroyProcess a owl:Class ;
        rdfs:comment "The destruction process is defined in this process."@en ;
