        sh:nodeKind sh:IRI ;
        sh:property _:Nbe8642a9b0d744618fbbcab3b982b09f,
            _:Ne03b669f0bc249418902d73adccb4eb4,
            _:Nfa6b7144ba164b1b99402cba95c5a0fd .

