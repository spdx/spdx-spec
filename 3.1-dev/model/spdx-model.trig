        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N3bf59cdaff7a4afbaaaf190415ae0de6,
            _:N8636a3e55c684d7db9bc1ae2fcd648f0,
