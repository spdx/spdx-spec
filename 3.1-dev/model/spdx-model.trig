        sh:nodeKind sh:IRI ;
        sh:property _:Nf8035486311f4b7da1cb620c8b6456aa .

    ns6:WithAdditionOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing a License which has additional
text applied to it."""@en ;
