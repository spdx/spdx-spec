    ns5:provider a owl:ObjectProperty ;
        rdfs:comment "The provider of a SoftwareService."@en ;
        rdfs:range ns1:Agent .

    ns5:serverAuthenticationProtocol a owl:ObjectProperty ;
        rdfs:comment "Authentication protocol used by a server."@en ;
        rdfs:range ns5:AuthenticationProtocolType .

