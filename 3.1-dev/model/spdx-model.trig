    _:N6e6aaaa9c16746e29687587f16865978 a sh:SPARQLConstraint ;
        sh:message "When relationship is tracedToDetail, from must be a Requirement" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/tracedToDetail> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Requirement> }
}""" .

