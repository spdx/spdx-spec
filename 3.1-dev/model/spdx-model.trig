        rdfs:subClassOf ns8:CreateProcess ;
        sh:nodeKind sh:IRI .

    ns8:OutOfSpecAction a owl:Class ;
        rdfs:comment "An out of specification action is defined in this class."@en ;
        rdfs:subClassOf ns8:UseAction ;
        sh:nodeKind sh:IRI .

    ns8:PlanAction a owl:Class ;
        rdfs:comment "A PlanAction involves the execution of a plan in relation to a PlanProcess."@en ;
        rdfs:subClassOf ns8:UseAction ;
        sh:nodeKind sh:IRI .

    ns8:PlanProcess a owl:Class ;
        rdfs:comment "Process plans outline the stages of implementation or use related to a process."@en ;
        rdfs:subClassOf ns8:UseProcess ;
        sh:nodeKind sh:IRI .

    ns8:ReproduceAction a owl:Class ;
