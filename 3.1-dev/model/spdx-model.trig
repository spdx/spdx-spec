            ns6:SoftwarePurpose ;
        rdfs:label "executable" ;
        rdfs:comment "The Element is an Artifact that can be run on a computer."@en .

    <https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/file> a owl:NamedIndividual,
