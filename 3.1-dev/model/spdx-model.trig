        sh:nodeKind sh:IRI ;
        sh:property _:N135d5ad2a38041128d6be48db1d4a1ea,
            _:N579f9f3430174cda85838f42c9c3871c,
            _:N613721494fcf4aad974eb303b83b21bb,
