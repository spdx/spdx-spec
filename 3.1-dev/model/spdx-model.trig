            ns6:LifecycleScopeType ;
        rdfs:label "design" ;
        rdfs:comment "A relationship has specific context implications during an element's design."@en .

    <https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType/development> a owl:NamedIndividual,
            ns6:LifecycleScopeType ;
