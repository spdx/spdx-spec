    <https://spdx.org/rdf/3/terms/FunctionalSafety/SafetyIntegrityLevelType/dalB> a owl:NamedIndividual,
            ns8:SafetyIntegrityLevelType ;
        rdfs:label "dalB" ;
        rdfs:comment "Design Assurance Level B for aviation software assurance."@en .

    <https://spdx.org/rdf/3/terms/FunctionalSafety/SafetyIntegrityLevelType/dalC> a owl:NamedIndividual,
            ns8:SafetyIntegrityLevelType ;
        rdfs:label "dalC" ;
        rdfs:comment "Design Assurance Level C for aviation software assurance."@en .

    <https://spdx.org/rdf/3/terms/FunctionalSafety/SafetyIntegrityLevelType/dalD> a owl:NamedIndividual,
            ns8:SafetyIntegrityLevelType ;
        rdfs:label "dalD" ;
        rdfs:comment "Design Assurance Level D for aviation software assurance."@en .

    <https://spdx.org/rdf/3/terms/FunctionalSafety/SafetyIntegrityLevelType/dalE> a owl:NamedIndividual,
            ns8:SafetyIntegrityLevelType ;
        rdfs:label "dalE" ;
        rdfs:comment "Design Assurance Level E for aviation software assurance."@en .

    <https://spdx.org/rdf/3/terms/FunctionalSafety/SafetyIntegrityLevelType/noAssertion> a owl:NamedIndividual,
            ns8:SafetyIntegrityLevelType ;
        rdfs:label "noAssertion" ;
