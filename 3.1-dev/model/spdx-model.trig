        sh:nodeKind sh:IRI ;
        sh:property _:N21550dec461f4398aa70eee79f9e89a5,
            _:Nba8243052e5149308a75c4ed89824b77 .

    ns2:serverAuthenticationProtocol a owl:ObjectProperty ;
        rdfs:comment "Authentication protocol used by a server."@en ;
