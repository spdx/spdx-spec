    ns3:AbstractPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Refers to an abstract, conceptual software entity."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N1994034d9be4470eb2568f139dd53ce4,
            _:N1f602ee9422445a2b2e3adb653f779d8,
