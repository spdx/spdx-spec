        rdfs:comment "When a CVSS score is between 9.0 - 10.0."@en .

    <https://spdx.org/rdf/3/terms/Security/CvssSeverityType/high> a owl:NamedIndividual,
            ns2:CvssSeverityType ;
        rdfs:label "high" ;
