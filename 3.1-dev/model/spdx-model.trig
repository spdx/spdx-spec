        rdfs:range xsd:string .

    ns6:datasetAvailability a owl:ObjectProperty ;
        rdfs:comment "Availability of a dataset."@en ;
        rdfs:range ns6:DatasetAvailabilityType .

    ns6:datasetNoise a owl:DatatypeProperty ;
