        sh:nodeKind sh:IRI ;
        sh:property _:N414a5a2c15b043ee8e0ee598ab3af435,
            _:N495a6ae7b2a943388fd631d22be4c8f6,
            _:N8292a8c285814ce998fc43ce8de4f0c2,
            _:Na13debdc31904d6c91cd546e01224c3c,
            _:Na651e8eaedef4139947dde48080121e5,
            _:Na9f52a1bbfd64bf68dcb84967adcd6c0,
            _:Ne94316dd1ef1424a8f9fc3a4da4911c5,
            _:Nf3611057bb3c46a6ba60b4c437021458,
            _:Nf8d23233890b4088aad5c963ba874ef4 .

