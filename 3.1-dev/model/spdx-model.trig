        sh:path ns1:city .

    _:Nffe75e726e364446945364f4c58ca0e9 a sh:SPARQLConstraint ;
        sh:message "When relationship is hasDynamicLink, class must be LifecycleScopedRelationship" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/hasDynamicLink> .
    FILTER NOT EXISTS { $this rdf:type <Core/LifecycleScopedRelationship> }
}""" .

