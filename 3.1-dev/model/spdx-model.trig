        sh:nodeKind sh:IRI ;
        sh:property _:Nd548f58bc801462d9b6f48972cd515df .

    ns9:TestAction a owl:Class ;
        rdfs:comment "A test action is a specific action associated with a test."@en ;
        rdfs:subClassOf ns9:UseAction ;
        sh:nodeKind sh:IRI .

