        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N15b84d23f5a84799906f07369f5b25d2,
            _:N2c6fd52f5b974f289b5758c6c4b7dc21,
