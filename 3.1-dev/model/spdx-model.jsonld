  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/issn",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "[International Standard Serial Number (ISSN)](https://www.issn.org/understanding-the-issn/what-is-an-issn/) is an eight-digit identifier for serial publications and other continuing resources standardized by [ISO 3297](https://www.iso.org/standard/84536.html). It consists of two groups of four digits separated by a hyphen, where the final character is a check digit that may be an \"X\". The hyphen is retained when the identifier is stored electronically to maintain the standard 9-character string format (e.g., `1464-3693`). The ISSN is media-specific; the same journal title may be assigned different identifiers for its physical and digital versions."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "issn"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/AnnotationType",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Specifies the type of an annotation."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/definitionSource",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "It is the authoritative or credible entity, document, or body of knowledge that provides the meaning of a type, ensuring accuracy, context, and standardization."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/Specification"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType/clickthrough",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Dataset is not publicly available and can only be accessed after affirmatively accepting terms on a clickthrough webpage."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "clickthrough"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/socialMedia",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Core/ExternalRefType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A reference to a social media channel for a package."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "socialMedia"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/typeFromSource",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "typeFromSource is a value used to define an item within the definitionSource."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Dataset/DatasetType/timeseries",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Dataset/DatasetType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Data is recorded in an ordered sequence of timestamped entries, such as the price of a stock over the course of a day."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "timeseries"
      }
    ]
  },
