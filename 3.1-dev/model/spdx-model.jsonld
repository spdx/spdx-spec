    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "https://spdx.org/rdf/3/terms/Extension/Extension is an abstract class and should not be instantiated directly. Instantiate a subclass instead."
      }
    ],
