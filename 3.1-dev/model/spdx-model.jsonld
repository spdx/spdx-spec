      {
        "@language": "en",
        "@value": "The Element is a test used to verify functionality on a software element."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "test"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/statement",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
