    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ProfileIdentifierType/extension",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ProfileIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
