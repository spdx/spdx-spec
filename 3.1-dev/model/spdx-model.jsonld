      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/phoneNumber",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Phone number; A string of decimal digits that uniquely indicates the network termination point defined in [RFC 3966](https://datatracker.ietf.org/doc/rfc3966/) Section 5."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "phoneNumber"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/locator",
    "@type": [
