        "@value": "Provides information about the completeness of relationships."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/RelationshipCompleteness"
      }
    ]
  },
