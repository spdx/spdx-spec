      {
        "@language": "en",
        "@value": "Provides information about the primary purpose of the software artifact."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Software/SoftwarePurpose"
      }
    ]
  },
