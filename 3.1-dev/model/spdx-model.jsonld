    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A mathematical algorithm that maps data of arbitrary size to a bit string."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/postalName",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The name of the recipient expressed in text."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isan",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "[International Standard Audiovisual Number (ISAN)](https://www.isan.org/about/#what_is_isan) is a unique 24-digit hexadecimal identifier for audiovisual works standardized by [ISO 15706](https://www.iso.org/standard/83124.html). The ISAN remains persistent for a work regardless of its distribution format or its use. To facilitate human readability, the \"ISAN\" label, grouping hyphens, and two check characters are included (e.g., `ISAN 0000-0000-3A8D-0000-Z-0000-0000-6`); however, these elements shall be omitted when the identifier is stored electronically (e.g., `000000003A8D000000000000`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "isan"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/RelationshipType/copiedTo",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/RelationshipType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The `from` Element has been copied to each `to` Element."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "copiedTo"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Security/score",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Provides a numerical (0-10) representation of the severity of a vulnerability."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/roleQualification",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "roleQualification specifies the requirements, criteria, or conditions that must be met for an entity to be considered qualified to fulfill a particular role."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/Requirement"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibid",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "[International Business Identifier (IBID)](https://ekys.org/business_identifiers/) is a verifiable unique identifier for legal entities as defined in the [ISO/DIS 25500-3](https://www.iso.org/standard/87705.html) draft standard. It is composed of three data elements: the International Business Registration Number (IBRN), the legal name, and the date of origin formatted as eight numeric characters (YYYYMMDD). Each element is separated by a pipe character (`|`) (e.g., `US-DE.BER:3031657|Code Management Association|19990420`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ibid"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalRefType/securityOther",
