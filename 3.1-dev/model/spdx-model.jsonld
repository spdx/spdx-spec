      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/PositiveIntegerRange"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
