["_:N209c40419721414baa93415b22e2bcdd", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3.1/terms/Software/sourceInfo", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ibid", "http://www.w3.org/2000/01/rdf-schema#comment", "[International Business Identifier (IBID)](https://ekys.org/business_identifiers/) is a verifiable unique identifier for legal entities as defined in the [ISO/DIS 25500-3](https://www.iso.org/standard/87705.html) draft standard. It is composed of three data elements: the International Business Registration Number (IBRN), the legal name, and the date of origin formatted as eight numeric characters (YYYYMMDD). Each element is separated by a pipe character (`|`) (e.g., `US-DE.BER:3031657|Code Management Association|19990420`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/nuget", "http://www.w3.org/2000/01/rdf-schema#comment", "A reference to a NuGet package. The package locator format is defined in the [NuGet documentation](https://docs.nuget.org) and looks like `package/version`.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/SimpleLicensing/licenseText", "http://www.w3.org/2000/01/rdf-schema#comment", "Identifies the full text of a License or Addition.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nca1ed91f02d643df81d41c9da9418d31", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/bom", "globalId", "", ""]
