["https://spdx.org/rdf/3/terms/Core/SupportType/deployed", "http://www.w3.org/2000/01/rdf-schema#comment", "In addition to being supported by the supplier, the software is known to have been deployed and is in use. For a software as a service provider, this implies the software is now available as a service.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/NoneLicense", "http://www.w3.org/2002/07/owl#sameAs", "https://spdx.org/rdf/3/terms/Licensing/None", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Build/configSourceDigest", "http://www.w3.org/2000/01/rdf-schema#comment", "Property that describes the digest of the build configuration file used to\ninvoke a build.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
