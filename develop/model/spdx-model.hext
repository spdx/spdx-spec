["https://spdx.org/rdf/3/terms/SupplyChain/CreateProcess", "http://www.w3.org/2000/01/rdf-schema#comment", "The CreateProcess refers to the abstract process class that can be used to represent the process of creation of a product.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/LifecycleScopeType/other", "http://www.w3.org/2000/01/rdf-schema#label", "other", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["_:N96b6b3a701c2410fa5da78146c1760f2", "http://www.w3.org/ns/shacl#maxCount", "1", "http://www.w3.org/2001/XMLSchema#integer", "", ""]
["https://spdx.org/rdf/3/terms/Core/RoleRelationship", "http://www.w3.org/2000/01/rdf-schema#comment", "RoleRelationship represents a relationship between an entity holding a role and the scope or context in which that role applies. The givenRole property specifies the role assigned.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalRefType/releaseNotes", "http://www.w3.org/2000/01/rdf-schema#label", "releaseNotes", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3/terms/Hardware/category", "http://www.w3.org/2000/01/rdf-schema#comment", "The category describes the hardware item in a DefinedType.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
