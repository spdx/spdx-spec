["https://spdx.org/rdf/3.1/terms/Dataset/DatasetType/text", "http://www.w3.org/2000/01/rdf-schema#comment", "Data consists of unstructured text, such as a book, a Wikipedia article (without images), or a transcript.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N6eacbb2368ea4bc9968c078d04d85880", "http://www.w3.org/ns/shacl#class", "https://spdx.org/rdf/3.1/terms/Core/ContactPointRelationship", "globalId", "", ""]
