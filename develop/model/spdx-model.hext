["https://spdx.org/rdf/3.1/terms/Core/processReadiness", "http://www.w3.org/2000/01/rdf-schema#comment", "processReadiness describes the readiness of a process.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
