["https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel/fullAutomation", "http://www.w3.org/2000/01/rdf-schema#comment", "Level 5 - Full automation. The system is capable of performing its entire mission without external intervention.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
