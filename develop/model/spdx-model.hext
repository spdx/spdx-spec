["https://spdx.org/rdf/3/terms/SupplyChain/plannedInspectionLocation", "http://www.w3.org/2000/01/rdf-schema#comment", "A planned location where a good, product, or material is inspected.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/implementedBy", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
