["_:N2b0cb38f4a124b468b20afa3a75a423d", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/tracedToDetail> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Requirement> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
