["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/nli", "http://www.w3.org/2000/01/rdf-schema#comment", "[Natural Location Identifier (NLI)](https://eccma.org/enli-eccma-natural-location-identifier/) is a 14- or 15-character alphanumeric string standardized by [ISO 8000-118](https://www.iso.org/standard/85428.html) that uniquely identifies a three-dimensional geographic point location. The identifier is generated from geodetic coordinates and elevation data. For electronic storage, the `ISO.NLI:` prefix shall be retained (e.g., `ISO.NLI:41TS8M-A8ELTQ-H2`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N60812ece36be4b8885d2b94a60685c22", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "http://www.w3.org/1999/02/22-rdf-syntax-ns#nil", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/describes", "http://www.w3.org/2000/01/rdf-schema#label", "describes", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibid", "http://www.w3.org/2000/01/rdf-schema#comment", "[International Business Identifier (IBID)](https://ekys.org/business_identifiers/) is a verifiable unique identifier for legal entities as defined in the [ISO/DIS 25500-3](https://www.iso.org/standard/87705.html) draft standard. It is composed of three data elements: the International Business Registration Number (IBRN), the legal name, and the date of origin formatted as eight numeric characters (YYYYMMDD). Each element is separated by a pipe character (`|`) (e.g., `US-DE.BER:3031657|Code Management Association|19990420`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalRefType/securityFix", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Core/ExternalRefType", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/Location", "http://www.w3.org/2000/01/rdf-schema#comment", "Location is used to define the location, address or coordinates of a place.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/HashAlgorithm/md5", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Core/HashAlgorithm", "globalId", "", ""]
