  {
    "@id": "https://spdx.org/rdf/3/terms/Dataset/ConfidentialityLevelType/green",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Dataset/ConfidentialityLevelType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Community wide. The dataset shall be shared only within a community of peers and partners."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "green"
      }
    ]
  },
