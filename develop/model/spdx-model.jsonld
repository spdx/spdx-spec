    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Specifies the type of responsibility held over an asset, property, or entity."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Dataset/DatasetAvailabilityType/clickthrough",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
