    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An authoritative or credible entity, document, or body of knowledge\nthat provides the meaning of an `additionalInformation` key and/or its values,\nensuring accuracy, context, and standardization."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/Specification"
      }
    ]
  },
  {
