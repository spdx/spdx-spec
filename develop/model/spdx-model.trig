        sh:nodeKind sh:IRI ;
        sh:property _:N05ae83f04cdd4c7d83750e6cb59e845b,
            _:N4782432043d84b1c8be98b446040f80c,
            _:N5ffe16051ee84589a57ba654f85f400c,
            _:N62efb3736de649e3861395ea221a7e62,
            _:N6f907081c5c241d98897a7eb1ef3e96c,
            _:N8148b02a7ae64a859f3c13d71b667de6,
            _:N9b98942335684a15a33a2780eec5aaca,
            _:Nbaab8c5e33af4addb59fd1efd97402ce,
            _:Nc97bd06135374445a6cbfad6bd52604a .

