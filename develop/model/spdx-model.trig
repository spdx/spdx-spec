        sh:nodeKind sh:IRI ;
        sh:property _:N78aed2aa286c4d41a1755cca3932120c,
            _:Nf039ea0ab377479aa0a7da8901ed85d3 .

    ns8:additionText a owl:DatatypeProperty ;
        rdfs:comment "Identifies the full text of a LicenseAddition."@en ;
        rdfs:range xsd:string .

