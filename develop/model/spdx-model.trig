        rdfs:subClassOf ns8:CreateProcess ;
        sh:nodeKind sh:IRI .

    ns8:ManufactureAction a owl:Class ;
        rdfs:comment "ManufactureAction represents the act of creating a product by a manufacturing process."@en ;
        rdfs:subClassOf ns8:CreateAction ;
        sh:nodeKind sh:IRI .

    ns8:ManufactureProcess a owl:Class ;
