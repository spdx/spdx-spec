    _:N0332b09d285b4b48b174e034db210e27 a sh:SPARQLConstraint ;
        sh:message "When relationship is hasContactPoint, class must be ContactPointRelationship" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
