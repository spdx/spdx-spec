    _:N0354f0bc935f4f96b54747a6ba8dc200 a sh:SPARQLConstraint ;
        sh:message "When relationship is tracedToDetail, from must be a Requirement" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
