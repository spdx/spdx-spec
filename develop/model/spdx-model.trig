        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N4be11426600945429b8e4a6160c085b4,
            _:N5313d8b2713b4d709ea513e4e11dd8a5,
