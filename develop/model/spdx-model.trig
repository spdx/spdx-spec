        rdfs:range ns5:ConfidentialityLevelType .

    ns5:dataCollectionProcess a owl:DatatypeProperty ;
        rdfs:comment "How the dataset was collected."@en ;
        rdfs:range xsd:string .

    ns5:dataPreprocessing a owl:DatatypeProperty ;
