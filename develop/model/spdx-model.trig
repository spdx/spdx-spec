        sh:nodeKind sh:IRI ;
        sh:property _:N229d6e7ecabc4987adf6351c3225975c,
            _:N4f46c680885046a7952d516efa81f1d9 .

    ns3:serverAuthenticationProtocol a owl:ObjectProperty ;
