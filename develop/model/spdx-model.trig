            _:Nf43e89aa865b4204a0f6d6fc08ede4b5 .

    ns2:provider a owl:ObjectProperty ;
        rdfs:comment "The provider of a SoftwareService."@en ;
        rdfs:range ns1:Agent .

    ns2:serverAuthenticationProtocol a owl:ObjectProperty ;
        rdfs:comment "Authentication protocol used by a server."@en ;
        rdfs:range ns2:AuthenticationProtocolType .

    ns2:serviceHostingCountry a owl:DatatypeProperty ;
