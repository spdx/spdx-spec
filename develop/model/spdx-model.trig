        sh:nodeKind sh:IRI ;
        sh:property _:N0e79a67d0d5f4ea1bfba55a574f603b3,
            _:Nfb9d38f44bf041cebee1797d46b51492 .

    ns8:additionText a owl:DatatypeProperty ;
        rdfs:comment "Identifies the full text of a LicenseAddition."@en ;
        rdfs:range xsd:string .

