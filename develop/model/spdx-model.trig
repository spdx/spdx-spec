    ns4:HarvestAction a owl:Class ;
        rdfs:comment "HarvestAction represents the act of creating a product by directly extracting goods or materials from nature."@en ;
        rdfs:subClassOf ns4:CreateAction ;
        sh:nodeKind sh:IRI .

