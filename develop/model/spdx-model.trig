        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns7:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns5:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0c23e6dcad4d43c3bea3a05597133cb2,
            _:N24f71d9f0e74474ca5e6897df447b9bd,
            _:N27eb805039a84d128f4ed7937f2be253,
            _:N37cf35102f364cb88d517b2c5a959389,
