            _:Nd78860a64d2a49418937c22c567d319e .

    <https://spdx.org/rdf/3/terms/Core/ProcessReadinessType/active> a owl:NamedIndividual,
            ns1:ProcessReadinessType ;
        rdfs:label "active" ;
        rdfs:comment "In use."@en .

