        sh:nodeKind sh:IRI ;
        sh:property _:N005b2efab7944277b4df78bd43f2f45e,
            _:N1110ee04242a48a79963ba06b4ba8227 .

    ns6:ListedLicenseException a owl:Class,
            sh:NodeShape ;
