            sh:NodeShape ;
        rdfs:comment "A prescribed change to a product's location."@en ;
        rdfs:subClassOf ns8:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N4d67ad9c6ca84015ae29240b33734247,
            _:N644e87c0659443b1af0f7d43a121d8f0,
