        rdfs:range xsd:string .

    ns3:datasetAvailability a owl:ObjectProperty ;
        rdfs:comment "Availability of a dataset."@en ;
        rdfs:range ns3:DatasetAvailabilityType .

    ns3:datasetNoise a owl:DatatypeProperty ;
