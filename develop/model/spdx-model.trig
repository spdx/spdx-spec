        rdfs:subClassOf ns10:CreateProcess ;
        sh:nodeKind sh:IRI .

    ns10:OutOfSpecAction a owl:Class ;
        rdfs:comment "An out of specification action is defined in this class."@en ;
        rdfs:subClassOf ns10:UseAction ;
        sh:nodeKind sh:IRI .

    ns10:PlanAction a owl:Class ;
        rdfs:comment "A PlanAction involves the execution of a plan in relation to a PlanProcess."@en ;
        rdfs:subClassOf ns10:UseAction ;
        sh:nodeKind sh:IRI .

    ns10:PlanProcess a owl:Class ;
        rdfs:comment "Process plans outline the stages of implementation or use related to a process."@en ;
        rdfs:subClassOf ns10:UseProcess ;
        sh:nodeKind sh:IRI .

    ns10:ReproduceAction a owl:Class ;
