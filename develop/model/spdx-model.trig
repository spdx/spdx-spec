        rdfs:comment "The result of applying a hash algorithm to an Element."@en ;
        rdfs:range xsd:string .

    ns1:key a owl:DatatypeProperty ;
        rdfs:comment "A key used in a generic key-value pair."@en ;
        rdfs:range xsd:string .

