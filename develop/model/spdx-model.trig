        rdfs:subClassOf ns7:CreateAction ;
        sh:nodeKind sh:IRI .

    ns7:ReproduceProcess a owl:Class ;
        rdfs:comment "Reproduction is the biological process by which living organisms produce offspring."@en ;
        rdfs:subClassOf ns7:CreateProcess ;
        sh:nodeKind sh:IRI .

