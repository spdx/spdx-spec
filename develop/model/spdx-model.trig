        sh:nodeKind sh:IRI .

    ns9:ChangeProcess a owl:Class ;
        rdfs:comment "A prescribed change to a product."@en ;
        rdfs:subClassOf ns9:ModifyProcess ;
        sh:nodeKind sh:IRI .

    ns9:DestroyAction a owl:Class,
