        rdfs:label "qm" ;
        rdfs:comment "Quality management level."@en .

    <https://spdx.org/rdf/3/terms/FunctionalSafety/SafetyIntegrityLevelType/sil1> a owl:NamedIndividual,
            ns6:SafetyIntegrityLevelType ;
