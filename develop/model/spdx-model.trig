SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/conformsTo> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <FunctionalSafety/Assumption> }
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Specification> }
}""" .

