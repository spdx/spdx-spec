        rdfs:range ns5:ConfidentialityLevelType .

    ns5:dataCollectionProcess a owl:DatatypeProperty ;
        rdfs:comment "How the dataset was collected."@en ;
        rdfs:range xsd:string .

    ns5:dataPreprocessing a owl:DatatypeProperty ;
        rdfs:comment "Preprocessing steps that were applied to the raw data to create the given dataset."@en ;
        rdfs:range xsd:string .

    ns5:datasetAvailability a owl:ObjectProperty ;
        rdfs:comment "Availability of a dataset."@en ;
        rdfs:range ns5:DatasetAvailabilityType .

    ns5:datasetNoise a owl:DatatypeProperty ;
        rdfs:comment "Potentially noisy elements of the dataset."@en ;
        rdfs:range xsd:string .

