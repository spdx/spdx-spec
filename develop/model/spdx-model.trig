    _:Nfe1f9fc46ff3443d97cd6ef8894b4cbb a sh:SPARQLConstraint ;
        sh:message "When relationship is resolved, from must be a ResolutionAction" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/resolved> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <SupplyChain/ResolutionAction> }
}""" .

