    _:N00e512a85af4401aba4707492907579a a sh:SPARQLConstraint ;
        sh:message "When relationship is performedBy, to must be an Agent" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/performedBy> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Agent> }
}""" .

