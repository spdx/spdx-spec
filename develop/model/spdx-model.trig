        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI .

    ns8:ChangeAction a owl:Class ;
        rdfs:comment "An actual change to a product."@en ;
        rdfs:subClassOf ns8:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns8:ChangeProcess a owl:Class ;
        rdfs:comment "A prescribed change to a product."@en ;
        rdfs:subClassOf ns8:ModifyProcess ;
        sh:nodeKind sh:IRI .

    ns8:DestroyAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "The record of destruction is entered in this action."@en ;
