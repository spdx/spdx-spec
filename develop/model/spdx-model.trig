        sh:nodeKind sh:IRI ;
        sh:property _:Ne80cc565205742629009fe7c85a5b60d .

    ns7:TestAction a owl:Class ;
        rdfs:comment "A test action is a specific action associated with a test."@en ;
        rdfs:subClassOf ns7:UseAction ;
        sh:nodeKind sh:IRI .

