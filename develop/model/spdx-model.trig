            _:Ned489288086e4f7cb06c01c1b03c4f56 .

    ns9:serverKeyValidationProtocol a owl:ObjectProperty ;
        rdfs:comment "Key validation protocol used during the authentication of servers or services over a network."@en ;
        rdfs:range ns9:KeyValidationProtocolType .

