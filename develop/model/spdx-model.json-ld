      "https://spdx.org/rdf/3/terms/Core/SupportType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "There is no support for the artifact from the supplier, consumer assumes any support obligations."
      }
    ],
