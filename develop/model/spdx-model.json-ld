    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An independent party has audited the agent, but it has not been formally certified. Offers more confidence than self-declaration; suitable for controlled production use."
      }
    ],
