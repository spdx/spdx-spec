  {
    "@id": "https://spdx.org/rdf/3/terms/Software/packageUrl",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Provides a place for the SPDX data creator to record the Package-URL\nfor a software Package."
