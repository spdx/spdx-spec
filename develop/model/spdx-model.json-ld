      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "configuration"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/RelationshipType/hasDeclaredLicense",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
