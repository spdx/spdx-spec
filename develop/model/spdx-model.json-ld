      {
        "@id": "https://spdx.org/rdf/3/terms/Security/VulnAssessmentRelationship"
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
