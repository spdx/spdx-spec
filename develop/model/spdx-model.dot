# N8bf487e71ff840079476b2fcff78af0a node1089
node1089 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8bf487e71ff840079476b2fcff78af0a</B></td></tr><tr><td href='N8bf487e71ff840079476b2fcff78af0a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8bf487e71ff840079476b2fcff78af0a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;A value for Core/name is required when a value for Core/version is present&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/version&gt; ?version .
    FILTER NOT EXISTS {
        $this &lt;Core/name&gt; ?name .
    }
}&quot;</td></tr></table> > ] 
# N58cebc24ba894f9e89d870068e502ee6 node1090
