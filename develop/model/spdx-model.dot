node80 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb72ed282f0f04c63a455c102782bc24e</B></td></tr><tr><td href='Nb72ed282f0f04c63a455c102782bc24e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb72ed282f0f04c63a455c102782bc24e</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:minCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
