# N75c6bfdc34ea4ba890a7c2776c8bb290 node1725
node1725 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N75c6bfdc34ea4ba890a7c2776c8bb290</B></td></tr><tr><td href='N75c6bfdc34ea4ba890a7c2776c8bb290' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N75c6bfdc34ea4ba890a7c2776c8bb290</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasAssociatedVulnerability, to must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasAssociatedVulnerability&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
