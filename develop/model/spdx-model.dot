# Nd4a9148d515f436b9cda4262c5277bdc node604
node604 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nd4a9148d515f436b9cda4262c5277bdc</B></td></tr><tr><td href='Nd4a9148d515f436b9cda4262c5277bdc' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nd4a9148d515f436b9cda4262c5277bdc</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedIn, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
