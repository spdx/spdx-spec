# N69d9c59bed464866833d8fcfea9917eb node481
node481 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N69d9c59bed464866833d8fcfea9917eb</B></td></tr><tr><td href='N69d9c59bed464866833d8fcfea9917eb' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N69d9c59bed464866833d8fcfea9917eb</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/createdBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
