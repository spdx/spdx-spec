node1889 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>runtime</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/LifecycleScopeType/runtime' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/LifecycleScopeType/runtime</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A relationship has specific context implications during the execution phase of an element.&quot;@en</td></tr></table> > ] 
