node214 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>working</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/AI/AgentMemoryMode/working' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/AI/AgentMemoryMode/working</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Short-lived, context-scoped information used within a single reasoning session or conversation turn.&quot;@en</td></tr></table> > ] 
