# N059db81488054158b89bf733e8e04800 node1248
node1248 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N059db81488054158b89bf733e8e04800</B></td></tr><tr><td href='N059db81488054158b89bf733e8e04800' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N059db81488054158b89bf733e8e04800</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasResolution, to must be an OutOfSpecAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
