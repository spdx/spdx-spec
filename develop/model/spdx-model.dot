# N57b9adf785594929b441480da84a1216 node14
node14 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N57b9adf785594929b441480da84a1216</B></td></tr><tr><td href='N57b9adf785594929b441480da84a1216' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N57b9adf785594929b441480da84a1216</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasOptionalDependency, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
