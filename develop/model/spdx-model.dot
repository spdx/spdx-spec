node877 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nc9f5231502dd4b59bb40d0b2c7eae9b8</B></td></tr><tr><td href='Nc9f5231502dd4b59bb40d0b2c7eae9b8' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nc9f5231502dd4b59bb40d0b2c7eae9b8</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;https://spdx.org/rdf/3/terms/SupplyChain/UseProcess is an abstract class and should not be instantiated directly. Instantiate a subclass instead.&quot;@en</td></tr></table> > ] 
