# Nd397c48917874ec0895b85f59ae9ba52 node1021
node1021 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nd397c48917874ec0895b85f59ae9ba52</B></td></tr><tr><td href='Nd397c48917874ec0895b85f59ae9ba52' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nd397c48917874ec0895b85f59ae9ba52</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is serializedInArtifact, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/serializedInArtifact&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Artifact&gt; }
