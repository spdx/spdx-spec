node1798 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8cc1c86d4e0c431d8583f24f5257f960</B></td></tr><tr><td href='N8cc1c86d4e0c431d8583f24f5257f960' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8cc1c86d4e0c431d8583f24f5257f960</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:pattern</td><td align='left'>&quot;^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(\.(0|[1-9][0-9]*))?$&quot;</td></tr></table> > ] 
