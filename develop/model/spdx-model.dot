# N57890d7c38ae48318e94f56009f5d487 node1415
node1415 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N57890d7c38ae48318e94f56009f5d487</B></td></tr><tr><td href='N57890d7c38ae48318e94f56009f5d487' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N57890d7c38ae48318e94f56009f5d487</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is underInvestigationFor, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
