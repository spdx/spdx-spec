node1965 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ndf6af397372d46e78434a54e75ec13ed</B></td></tr><tr><td href='Ndf6af397372d46e78434a54e75ec13ed' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ndf6af397372d46e78434a54e75ec13ed</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is exploitCreatedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
