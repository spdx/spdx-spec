# N8cd43603dfb14f2b85207f18a3488f28 node1522
node1522 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8cd43603dfb14f2b85207f18a3488f28</B></td></tr><tr><td href='N8cd43603dfb14f2b85207f18a3488f28' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8cd43603dfb14f2b85207f18a3488f28</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasDynamicLink, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
