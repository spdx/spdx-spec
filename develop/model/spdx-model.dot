# Nb82458e70f184d3eacf2645222d8b686 node1452
node1452 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb82458e70f184d3eacf2645222d8b686</B></td></tr><tr><td href='Nb82458e70f184d3eacf2645222d8b686' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb82458e70f184d3eacf2645222d8b686</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is resolved, from must be a ResolutionAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/resolved&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;SupplyChain/ResolutionAction&gt; }
