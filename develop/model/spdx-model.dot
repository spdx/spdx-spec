# N71f9343c088f4ae9b2bd0cb9e6155cb2 node139
node139 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N71f9343c088f4ae9b2bd0cb9e6155cb2</B></td></tr><tr><td href='N71f9343c088f4ae9b2bd0cb9e6155cb2' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N71f9343c088f4ae9b2bd0cb9e6155cb2</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasInstall, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasInstall&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
