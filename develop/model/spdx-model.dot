# N996717c23ad941f68341eba8f1dd2cd4 node1693
node1693 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N996717c23ad941f68341eba8f1dd2cd4</B></td></tr><tr><td href='N996717c23ad941f68341eba8f1dd2cd4' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N996717c23ad941f68341eba8f1dd2cd4</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;A value for Core/name is required when a value for Core/version is present&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Software/version&gt; ?version .
    FILTER NOT EXISTS {
        $this &lt;Software/name&gt; ?name .
    }
}&quot;</td></tr></table> > ] 
