# N43ffa14fef704a3c8109dabb5dbfd771 node1951
node1951 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N43ffa14fef704a3c8109dabb5dbfd771</B></td></tr><tr><td href='N43ffa14fef704a3c8109dabb5dbfd771' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N43ffa14fef704a3c8109dabb5dbfd771</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is republishedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/republishedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
