# N6c6dfc9bb69c470cb0d026fd06194708 node1517
node1517 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N6c6dfc9bb69c470cb0d026fd06194708</B></td></tr><tr><td href='N6c6dfc9bb69c470cb0d026fd06194708' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N6c6dfc9bb69c470cb0d026fd06194708</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasInput, from must be a Build, DefinedProcess, or Action&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasInput&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Build/Build&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/DefinedProcess&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
}&quot;</td></tr></table> > ] 
# N84edca8aa85944fc9a4e98813e3c4112 node1518
node1518 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N84edca8aa85944fc9a4e98813e3c4112</B></td></tr><tr><td href='N84edca8aa85944fc9a4e98813e3c4112' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N84edca8aa85944fc9a4e98813e3c4112</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasProvidedDependency, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasProvidedDependency&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
