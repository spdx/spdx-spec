# Nafe5ab5b44f94c2cad0d591654ca67ba node1029
node1029 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nafe5ab5b44f94c2cad0d591654ca67ba</B></td></tr><tr><td href='Nafe5ab5b44f94c2cad0d591654ca67ba' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nafe5ab5b44f94c2cad0d591654ca67ba</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is republishedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/republishedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
