node984 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Extension</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Extension/Extension' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Extension/Extension</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A characterization of some aspect of an Element that is associated with the Element in a generalized fashion.&quot;@en</td></tr></table> > ] 
