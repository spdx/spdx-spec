# N7b5b316fd1014363aa080f3f30eba04d node1066
node1066 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N7b5b316fd1014363aa080f3f30eba04d</B></td></tr><tr><td href='N7b5b316fd1014363aa080f3f30eba04d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N7b5b316fd1014363aa080f3f30eba04d</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is invokedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
