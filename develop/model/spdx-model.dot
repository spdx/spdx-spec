node270 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne71d10b4c6c046e3a7a85bbff25837e4</B></td></tr><tr><td href='Ne71d10b4c6c046e3a7a85bbff25837e4' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne71d10b4c6c046e3a7a85bbff25837e4</font></td></tr></table> > ] 
