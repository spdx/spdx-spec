# N147953bbfd3a41fcafcb6fcfdae44834 node1485
node1485 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N147953bbfd3a41fcafcb6fcfdae44834</B></td></tr><tr><td href='N147953bbfd3a41fcafcb6fcfdae44834' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N147953bbfd3a41fcafcb6fcfdae44834</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is runsOn, to must be a Hardware&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/runsOn&gt; .
    $this &lt;Core/to&gt; ?to .
