# N815bb9ee07e44166a728f90961e07fe6 node1039
node1039 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N815bb9ee07e44166a728f90961e07fe6</B></td></tr><tr><td href='N815bb9ee07e44166a728f90961e07fe6' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N815bb9ee07e44166a728f90961e07fe6</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is coordinatedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/coordinatedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
