# Ndcf1c81f2ace4270bc905ed71071c364 node620
node620 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ndcf1c81f2ace4270bc905ed71071c364</B></td></tr><tr><td href='Ndcf1c81f2ace4270bc905ed71071c364' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ndcf1c81f2ace4270bc905ed71071c364</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is affects, from must be a Vulnerability, Action, or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/affects&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/DefinedProcess&gt; }
}&quot;</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/FunctionalSafety/EvaluationResultType/inconclusive node621
node621 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>inconclusive</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/FunctionalSafety/EvaluationResultType/inconclusive' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/FunctionalSafety/EvaluationResultType/inconclusive</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Inconclusive refers to a result or outcome from a verification, test, or analysis that cannot be clearly classified as either positive (successful, pass) or negative (failed, reject). An inconclusive result means there was not enough clear evidence, data, or signal to make a definitive determination, and further investigation or additional testing is necessary. An inconclusive result always shall need a comment on it.&quot;@en</td></tr></table> > ] 
