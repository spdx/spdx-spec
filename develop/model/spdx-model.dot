# N10c323abcf6843b4ac0f52855cc95c6e node953
node953 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N10c323abcf6843b4ac0f52855cc95c6e</B></td></tr><tr><td href='N10c323abcf6843b4ac0f52855cc95c6e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N10c323abcf6843b4ac0f52855cc95c6e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is serializedInArtifact, from must be a SpdxDocument&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/serializedInArtifact&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/SpdxDocument&gt; }
}&quot;</td></tr></table> > ] 
