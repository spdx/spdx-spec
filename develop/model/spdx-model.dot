node1774 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nce433a8b866849a19b01b29733df322a</B></td></tr><tr><td href='Nce433a8b866849a19b01b29733df322a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nce433a8b866849a19b01b29733df322a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;A value for Core/name is required when a value for Core/version is present&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
