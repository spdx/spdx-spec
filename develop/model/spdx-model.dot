# N87bef5f9bfe5409abb7851f587692905 node969
node969 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N87bef5f9bfe5409abb7851f587692905</B></td></tr><tr><td href='N87bef5f9bfe5409abb7851f587692905' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N87bef5f9bfe5409abb7851f587692905</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is republishedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/republishedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
