# N56c2ddcacc0545f3b6658c964f143e25 node822
node822 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N56c2ddcacc0545f3b6658c964f143e25</B></td></tr><tr><td href='N56c2ddcacc0545f3b6658c964f143e25' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N56c2ddcacc0545f3b6658c964f143e25</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is reportedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
