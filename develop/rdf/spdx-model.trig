        sh:nodeKind sh:IRI ;
        sh:property _:N1455b4dfb0c54109a64ef51773ebd433,
            _:N2f9bdd1c0afb493299fabeb9a7146dab,
            _:Nb35be5b050eb409191ddc58437a9a400 .

