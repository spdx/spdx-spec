        rdfs:subClassOf ns4:UseProcess ;
        sh:nodeKind sh:IRI .

    ns4:ReproduceAction a owl:Class ;
        rdfs:comment "Reproduction is the biological process by which organisms generate new individuals of the same species."@en ;
        rdfs:subClassOf ns4:CreateAction ;
        sh:nodeKind sh:IRI .

    ns4:ReproduceProcess a owl:Class ;
