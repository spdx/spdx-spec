    _:N00a9cf7e0820491e890154da6ee50d84 a sh:SPARQLConstraint ;
        sh:message "When relationship is hasAssessmentFor, from must be a Vulnerability" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/hasAssessmentFor> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }
}""" .

