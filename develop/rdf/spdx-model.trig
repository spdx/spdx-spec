    spdx: a owl:Ontology ;
        rdfs:label "System Package Data Exchange™ (SPDX®) Ontology"@en ;
        dcterms:abstract "This ontology defines the terms and relationships used in the SPDX specification to describe system packages"@en ;
        dcterms:created "2026-01-23"^^xsd:date ;
        dcterms:creator "SPDX Project"@en ;
        dcterms:license <https://spdx.org/licenses/Community-Spec-1.0.html> ;
        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns3:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns7:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N122b0d0790934603a7ac2951de0f6959,
            _:N1cd3e03229c44733849be41f6879dba7,
            _:N53b149da88494bd496f52e7390cb859e,
            _:N59b21d51a5bc4658a97e2479374a1402,
            _:N64069c8b120a4ff1b716036ce0d558fc,
            _:N6e871fb9cd5a43feb824c4450902ded9,
            _:N7201f80c7e774b63b0b91661610a2696,
            _:N82e4f904de2e4e3790eeea8ccf279ab7,
            _:N8e9c7eb8c72848dab30dab0350e94586,
            _:N95d32ba842ce43038ece6f1aa52f6513,
            _:N96bdc6afc2dd4d018ad2396dfaed71be,
            _:Na5e71c68ba45490283857a18fc93733e,
            _:Nd339edaf50704b7d9160826f72268c99,
            _:Nd9feb4d003d7418c8febacb312c42622,
