    ns5:WithAdditionOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing a License which has additional
text applied to it."""@en ;
        rdfs:subClassOf <https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo> ;
        sh:nodeKind sh:IRI ;
        sh:property _:Ne2d18bbb85cd42fdba73a8a8f02b7f05,
            _:Nfb9fca8622f14062a2bbc44f31bbb4c8 .

    ns5:additionText a owl:DatatypeProperty ;
