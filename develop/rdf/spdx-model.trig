        rdfs:comment "The Element is the evidence that a specification or requirement has been fulfilled."@en .

    <https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/executable> a owl:NamedIndividual,
            ns2:SoftwarePurpose ;
