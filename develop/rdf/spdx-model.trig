        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0be58f2f65dc4ddc8b7655ed37f92248,
            _:N5ce251b5f2004de29fbca71cee09d296,
