        rdfs:label "riskAssessment" ;
        rdfs:comment "A reference to a risk assessment for a package."@en .

    <https://spdx.org/rdf/3/terms/Core/ExternalRefType/runtimeAnalysisReport> a owl:NamedIndividual,
