        sh:nodeKind sh:IRI ;
        sh:property _:N5f565a68f96c48c787edaf8196d0b56f .

    ns11:TestAction a owl:Class ;
        rdfs:comment "A test action is a specific action associated with a test."@en ;
        rdfs:subClassOf ns11:UseAction ;
        sh:nodeKind sh:IRI .

    ns11:TestProcess a owl:Class ;
        rdfs:comment "Test Process defines the testing process for an element."@en ;
        rdfs:subClassOf ns11:UseProcess ;
        sh:nodeKind sh:IRI .

