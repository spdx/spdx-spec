        rdfs:subClassOf ns7:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N51058e8dbe0245d9ab771d7f21e22470,
            _:Nd48351c7c85443f9979e4f00493c977d,
