        rdfs:subClassOf ns9:UseAction ;
        sh:nodeKind sh:IRI .

    ns9:TestProcess a owl:Class ;
        rdfs:comment "Test Process defines the testing process for an element."@en ;
        rdfs:subClassOf ns9:UseProcess ;
        sh:nodeKind sh:IRI .

