        sh:nodeKind sh:IRI ;
        sh:property _:N25aac71058d14978a59a1190426881d3,
            _:N2d825cae09e841a99f1558227df42fa7 .

    ns8:ListedLicenseException a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A license exception that is listed on the SPDX Exceptions list."@en ;
