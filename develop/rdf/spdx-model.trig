        sh:nodeKind sh:IRI ;
        sh:property _:N0fe2ff835e0749fc8f4a7fc587970b46,
            _:Nadb1ed5c474246d690df0f9beec993aa .

    ns10:additionText a owl:DatatypeProperty ;
