            _:N5253b02a82c14c85b2e275396d77d912 .

    ns10:serverKeyValidationProtocol a owl:ObjectProperty ;
        rdfs:comment "Key validation protocol used during the authentication of servers or services over a network."@en ;
        rdfs:range ns10:KeyValidationProtocolType .

