        rdfs:subClassOf <https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo> ;
        sh:nodeKind sh:IRI ;
        sh:property _:N80e64b9324a843d5bc9b6e38f4caba7b .

