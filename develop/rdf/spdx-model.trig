        sh:nodeKind sh:IRI ;
        sh:property _:N3ac64db0e0334ce7a39e2af284bb3de4,
            _:Na22495ba8d0c4ab8ba8ac57ce662de04 .

    ns9:serverAuthenticationProtocol a owl:ObjectProperty ;
