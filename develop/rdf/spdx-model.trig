        sh:nodeKind sh:IRI ;
        sh:property _:N0522f5b1c3dc4f7395bbba6e4aade3f0,
            _:N651c5755c13f46cbb66adc2235e88a21 .

    ns4:additionText a owl:DatatypeProperty ;
