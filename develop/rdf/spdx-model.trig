        sh:nodeKind sh:IRI ;
        sh:property _:N785690863e8f48c699b34c6b0404ea5a .

    ns2:BoundaryDefinitionProcess a owl:Class ;
        rdfs:comment "The Boundary Definition Process refers to the process class used to produce boundaries."@en ;
        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI .

    ns2:ChangeAction a owl:Class ;
        rdfs:comment "An actual change to a product."@en ;
        rdfs:subClassOf ns2:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns2:ChangeProcess a owl:Class ;
        rdfs:comment "A prescribed change to a product."@en ;
        rdfs:subClassOf ns2:ModifyProcess ;
        sh:nodeKind sh:IRI .

    ns2:DestroyAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "The record of destruction is entered in this action."@en ;
