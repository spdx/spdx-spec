    ns5:intendedUse a owl:DatatypeProperty ;
        rdfs:comment """**DEPRECATED in SPDX 3.1.**
Use [/Core/intendedUse](../../Core/Properties/intendedUse.md) instead.

The intended use of a given dataset."""@en ;
        rdfs:range xsd:string .

