instead.

Size of the dataset."""@en ;
        rdfs:range xsd:nonNegativeInteger .

    ns8:datasetType a owl:ObjectProperty ;
        rdfs:comment "Type of data in a dataset."@en ;
        rdfs:range ns8:DatasetType .

    ns8:datasetUpdateMechanism a owl:DatatypeProperty ;
        rdfs:comment "Mechanism to update the dataset."@en ;
        rdfs:range xsd:string .

    ns8:hasSensitivePersonalInformation a owl:ObjectProperty ;
