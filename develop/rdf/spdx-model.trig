    _:N05883d4c9e6d4fe6a028f49d407cfd57 a sh:SPARQLConstraint ;
        sh:message "When relationship is createdBy, to must be an Agent" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/createdBy> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Agent> }
}""" .

