    _:N0651a7eace874aa9bf8ba45df48a5a36 a sh:SPARQLConstraint ;
        sh:message "When relationship is publishedBy, from must be a Vulnerability" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/publishedBy> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }
}""" .

