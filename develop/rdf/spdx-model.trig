        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns6:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns2:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N09cb6bb2d2f444029289eda5c5e320f4,
            _:N1484fc37a2524efabb9ef7a25c2c1894,
            _:N2afa07581eb74a209e9e8e12716724f9,
            _:N464ab3e004bb46b193aa6d4a6a0d341d,
