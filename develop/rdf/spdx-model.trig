        sh:nodeKind sh:IRI ;
        sh:property _:N045972eed5684ebda6a2e764e81d0ba9,
            _:N64b3e659507348e5a37996420c252a92 .

    ns5:additionText a owl:DatatypeProperty ;
        rdfs:comment "Identifies the full text of a LicenseAddition."@en ;
        rdfs:range xsd:string .

    ns5:isDeprecatedAdditionId a owl:DatatypeProperty ;
        rdfs:comment "Specifies whether an additional text identifier has been marked as deprecated."@en ;
