        sh:nodeKind sh:IRI ;
        sh:property _:N3d5c5c884156404b9229154052fedabe,
            _:N441d4e0bc46c43f6a3b491dbf889b884,
            _:Nf7cecebac2764467aa5ececf0fb18f0f .

