            sh:NodeShape ;
        rdfs:comment "Software provided as a service over a network."@en ;
        rdfs:subClassOf ns1:Artifact ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0c38bd26152c4b9a9eeb22e15e0282c3,
            _:N23f56ce34d3f4613a584b75c8f9fdc2e .

    ns10:serverAuthenticationProtocol a owl:ObjectProperty ;
        rdfs:comment "Authentication protocol used by a server."@en ;
