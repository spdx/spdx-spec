        rdfs:comment "MD4 message-digest algorithm, as defined in [RFC 1186](https://datatracker.ietf.org/doc/rfc1186/)."@en .

    <https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/md5> a owl:NamedIndividual,
            ns1:HashAlgorithm ;
        rdfs:label "md5" ;
