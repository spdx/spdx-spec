        sh:nodeKind sh:IRI ;
        sh:property _:N590e79d0e8e1447cb284e2fa583fc673,
            _:N7722921cb2434177b231c6244f237c2a .

    ns9:serverAuthenticationProtocol a owl:ObjectProperty ;
