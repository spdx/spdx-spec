        rdfs:subClassOf ns10:UseProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N1de6bd6ec47c494da3ab2a9df5b5c95b .

    ns10:InstantiateVirtualHardwareProcess a owl:Class ;
