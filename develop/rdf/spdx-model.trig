            ns7:ExploitCatalogType ;
        rdfs:label "other" ;
        rdfs:comment "Other exploit catalogs."@en .

    ns7:ExploitCatalogVulnAssessmentRelationship a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Provides an exploit assessment of a vulnerability."@en ;
        rdfs:subClassOf ns7:VulnAssessmentRelationship ;
        sh:nodeKind sh:IRI ;
        sh:property _:N44f5f175430e4628b1019097303ff18f,
            _:Nc782d871c2b04a218fb3f40e173f7c4a,
