        rdfs:range ns1:PositiveIntegerRange .

    ns6:packageUrl a owl:DatatypeProperty ;
        rdfs:comment """Provides a place for the SPDX data creator to record the Package-URL
for a software Package."""@en ;
        rdfs:range xsd:anyURI .

