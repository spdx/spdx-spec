        rdfs:range <https://spdx.org/rdf/3/terms/Extension/CdxPropertyEntry> .

    ns3:Assumption a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A distinct unit representing a constraint associated with an item's use in a system."@en ;
        rdfs:subClassOf ns2:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N11d7c57230954f36a55528e9ea8e86ae,
            _:Nd18201df7804471da79b51a445e42589,
