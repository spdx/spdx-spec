        rdfs:range xsd:string .

    ns4:AbstractPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Refers to an abstract, conceptual software entity."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N289507756f2547988373d77e14116fe2,
            _:N4bdae86c9e9d49539d99d865c6dda1df,
