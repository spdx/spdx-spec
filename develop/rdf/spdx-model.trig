        sh:nodeKind sh:IRI ;
        sh:property _:N26aabd774034484aaf00949c5745a0c6,
            _:Nab44e84eee39465789eb0154d35a99fa .

    ns7:OrLaterOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing this version, or any later version,
of the indicated License."""@en ;
        rdfs:subClassOf ns7:ExtendableLicense ;
        sh:nodeKind sh:IRI ;
        sh:property _:Ncf10959f442f42a6a9bf94bca8dcca94 .

    ns7:WithAdditionOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing a License which has additional
text applied to it."""@en ;
