SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/assumes> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <FunctionalSafety/Assumption> }
}""" .
