        sh:nodeKind sh:IRI ;
        sh:property _:N05caeb0d01b84e0fa596f34f3993f548,
            _:N7d18512ace26428aa9fb300ac1bbbba7 .

    ns10:serverAuthenticationProtocol a owl:ObjectProperty ;
