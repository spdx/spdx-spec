["https://spdx.org/rdf/3.1/terms/SupplyChain/transportRoute", "http://www.w3.org/2000/01/rdf-schema#comment", "A transport route refers to the specific path or network used to move people, goods, data, or resources from one location to another.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/created", "http://www.w3.org/2000/01/rdf-schema#comment", "Identifies when the Element was originally created.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
