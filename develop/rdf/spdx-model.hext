["_:N52763b92382e4bfba3016cf5ffb03d7c", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Core/HashAlgorithm/sha384", "globalId", "", ""]
