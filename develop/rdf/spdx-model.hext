["_:N20fafc3da8494cf2a6600c3d9d1cb00e", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Core/RelationshipType/invokedBy", "globalId", "", ""]
