    <rdfs:comment xml:lang="en">Property that describes the URI of the build configuration source file.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Core/PresenceType">
    <rdfs:comment xml:lang="en">Categories of presence or absence.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Core/identifierLocator">
    <rdfs:comment xml:lang="en">Provides the location for more information regarding an external identifier.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Core/actionLocation">
    <rdfs:comment xml:lang="en">Location of a specific action.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Location"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/hsCodes">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>hsCodes</rdfs:label>
    <rdfs:comment xml:lang="en">The [Harmonized System (HS)](https://www.wcoomd.org/en/topics/nomenclature/overview/what-is-the-harmonized-system.aspx) of tariff nomenclature is an internationally standardized system of names and numbers, defined by the World Customs Organization, used to classify traded products.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/ExpandedLicensing/LicenseAddition">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">Abstract class for additional text intended to be added to a License, but
which is not itself a standalone License.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/Core/Element"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N7457273ea47b42b884f93ee3000cd039">
        <sh:path rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <sh:not>
          <rdf:Description rdf:nodeID="N2165362a3a83444fb2a4c632ef258d4b">
            <sh:hasValue rdf:resource="https://spdx.org/rdf/3/terms/ExpandedLicensing/LicenseAddition"/>
          </rdf:Description>
        </sh:not>
        <sh:message xml:lang="en">https://spdx.org/rdf/3/terms/ExpandedLicensing/LicenseAddition is an abstract class and should not be instantiated directly. Instantiate a subclass instead.</sh:message>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nff76ccb7982e429eb11ee26ea4a4041e">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/ExpandedLicensing/additionText"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nca838c50d1e14c248fb3aa64aa7ffeec">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/ExpandedLicensing/isDeprecatedAdditionId"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
