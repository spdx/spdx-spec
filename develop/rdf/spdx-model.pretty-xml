  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/evidenceCategory">
    <rdfs:comment xml:lang="en">evidenceCategory refers to a category of documented or observable proof.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/HarvestAction">
    <rdfs:comment xml:lang="en">HarvestAction represents the act of creating a product by directly extracting goods or materials from nature.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/SupplyChain/CreateAction"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Core/statement">
    <rdfs:comment xml:lang="en">Commentary on an assertion that an annotator has made.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
