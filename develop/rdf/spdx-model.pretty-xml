    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/firmware">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Software/SoftwarePurpose"/>
    <rdfs:label>firmware</rdfs:label>
