    <sh:property>
      <rdf:Description rdf:nodeID="N7660c5a4d196478383ab9da9a1b6d11c">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/SupplyChain/plannedPickupLocation"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/Location"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nb767039a48254885836602b04818692c">
