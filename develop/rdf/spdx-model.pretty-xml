          </rdf:Description>
        </sh:not>
        <sh:message xml:lang="en">https://spdx.org/rdf/3/terms/Core/DefinedProcess is an abstract class and should not be instantiated directly. Instantiate a subclass instead.</sh:message>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N38c44afa6a824ca0a68fad9a537a23ff">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/processReadiness"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/ProcessReadinessType"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
