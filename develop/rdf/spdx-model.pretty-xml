  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Software/downloadLocation">
    <rdfs:comment xml:lang="en">Identifies the download Uniform Resource Identifier for the package at the time
that the document was created.</rdfs:comment>
