  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Security/CvssSeverityType/low">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Security/CvssSeverityType"/>
    <rdfs:label>low</rdfs:label>
