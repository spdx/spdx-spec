      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N3e25a79100a040939d4c14846aba0786">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/ExpandedLicensing/standardAdditionTemplate"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
