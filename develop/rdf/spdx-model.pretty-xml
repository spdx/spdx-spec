  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/library">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Software/SoftwarePurpose"/>
    <rdfs:label>library</rdfs:label>
    <rdfs:comment xml:lang="en">The Element is a software library.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/LifecycleScopeType/other">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/LifecycleScopeType"/>
    <rdfs:label>other</rdfs:label>
    <rdfs:comment xml:lang="en">A relationship has other specific context information necessary to capture that the above set of enumerations does not handle.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceRelationship">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">EvidenceRelationship defines the association between pieces of evidence and EvaluationResult.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/Core/Relationship"/>
