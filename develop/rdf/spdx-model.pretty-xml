    <rdfs:label>sil1</rdfs:label>
    <rdfs:comment xml:lang="en">Safety Integrity Level 1 under IEC 61508.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/sourceArtifact">
