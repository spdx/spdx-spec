    <rdfs:label>hasProvidedDependency</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element has a dependency on each `to` Element, dependency is not in the distributed artifact, but assumed to be provided, during a LifecycleScopeType period.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Security/ExploitCatalogType/kev">
