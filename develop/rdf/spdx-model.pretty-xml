          <rdf:Description rdf:about="https://spdx.org/rdf/3/terms/Core/SpecificationType/other"/>
        </sh:in>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
