  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/productMetadata">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>productMetadata</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to additional product metadata such as a reference within an organization's product catalog.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Core/authorization">
    <rdfs:comment xml:lang="en">Authorization specifies the permissions, rights, privileges, or benefits granted to a Role, defining what the role is authorized to access, perform, or receive.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/module">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Software/SoftwarePurpose"/>
    <rdfs:label>module</rdfs:label>
    <rdfs:comment xml:lang="en">The Element is a module of a piece of software.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/doi">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>doi</rdfs:label>
    <rdfs:comment xml:lang="en">[Digital Object Identifier (DOI)](https://www.doi.org/the-identifier/what-is-a-doi/) is a unique, [ISO 26324](https://www.iso.org/standard/88862.html)-standardized identifier for physical, digital, or abstract objects, formatted as a prefix and suffix separated by a forward slash (e.g., `10.1000/182`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Software/contentIdentifier">
    <rdfs:comment xml:lang="en">A canonical, unique, immutable identifier of the artifact content, that may be
used for verifying its identity and/or integrity.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Software/ContentIdentifier"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipCompleteness/noAssertion">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipCompleteness"/>
    <rdfs:label>noAssertion</rdfs:label>
    <rdfs:comment xml:lang="en">No assertion can be made about the completeness of the relationship.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ContactType/support">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ContactType"/>
    <rdfs:label>support</rdfs:label>
    <rdfs:comment xml:lang="en">A contact point for support.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Dataset/intendedUse">
    <rdfs:comment xml:lang="en">**DEPRECATED in SPDX 3.1.**
Use [/Core/intendedUse](../../Core/Properties/intendedUse.md) instead.

The intended use of a given dataset.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/SimpleLicensing/customIdToLicense">
    <rdfs:comment xml:lang="en">Maps a "LicenseRef-" string for a custom license or a "AdditionRef-" string for
a custom license addition to a `CustomLicense`, a `CustomLicenseAddition`, or a
`SimpleLicensingText`.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/ElementMap"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/ExpandedLicensing/subjectExtendableLicense">
    <rdfs:comment xml:lang="en">A License participating in a 'with addition' model.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/ExpandedLicensing/ExtendableLicense"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Core/ProcessReadinessType">
    <rdfs:comment xml:lang="en">The ProcessReadinessType is defined by the enumeration.</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel/assistiveAutomation">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel"/>
    <rdfs:label>assistiveAutomation</rdfs:label>
    <rdfs:comment xml:lang="en">Level 1 - Assistive automation. The system assists an operator.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/componentAnalysisReport">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>componentAnalysisReport</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to a Software Composition Analysis (SCA) report.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Core/locationHint">
    <rdfs:comment xml:lang="en">Provides an indication of where to retrieve an external Element.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/certificationReport">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>certificationReport</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to a certification report for a package from an accredited/independent body.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/AI/useSensitivePersonalInformation">
    <rdfs:comment xml:lang="en">Records if sensitive personal information is used during model training or
could be used during the inference.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/PresenceType"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Software/SbomType/design">
