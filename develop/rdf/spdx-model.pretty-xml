        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Hardware/bulkQuantity"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/UnitOfMeasure"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Core/Specification">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">A specification is a detailed description of the design, requirements,
or features of a product, process, system or regulatory framework.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/Core/Artifact"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="Na4fd40b55843448a940f83efee41af76">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/specType"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/SpecificationType"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
