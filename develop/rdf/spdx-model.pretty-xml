        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/SupplyChain/currentResponsibleAgent"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/Agent"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Ndf46c17f910c49d1a8c83582d2c7dc8a">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/SupplyChain/previousResponsibleAgent"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/Agent"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N01373868bcba4a6faf6efb947791139b">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/SupplyChain/responsibilityChangedOn"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/Element"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Necb0bb22716441c6ac8a9263b3511ee6">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/SupplyChain/responsibilityCategory"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/SupplyChain/ResponsibilityType"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:in rdf:parseType="Collection">
          <rdf:Description rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/ResponsibilityType/custody"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/ResponsibilityType/ownership"/>
        </sh:in>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType">
    <rdfs:comment xml:lang="en">The type of external reference.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/validState">
    <rdfs:comment xml:lang="en">The valid state for StateProcess.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/SupplyChain/State"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Security/VexJustificationType/vulnerableCodeCannotBeControlledByAdversary">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Security/VexJustificationType"/>
    <rdfs:label>vulnerableCodeCannotBeControlledByAdversary</rdfs:label>
    <rdfs:comment xml:lang="en">The vulnerable component is present, and the component contains the vulnerable code. However, vulnerable code is used in such a way that an attacker cannot mount any anticipated attack.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/affects">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>affects</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` /Security/Vulnerability, Action or DefinedProcess affects each `to` Element.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/AI/SafetyRiskAssessmentType/high">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/AI/SafetyRiskAssessmentType"/>
    <rdfs:label>high</rdfs:label>
    <rdfs:comment xml:lang="en">The second-highest level of risk posed by an AI system.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/SupportType/support">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/SupportType"/>
    <rdfs:label>support</rdfs:label>
    <rdfs:comment xml:lang="en">The artifact has been released, and is supported from the supplier. There is a validUntilDate that can provide additional information about the duration of support.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Operations/exportClassification">
    <rdfs:comment xml:lang="en">Expression for the export control classification.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/packageUrl">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>packageUrl</rdfs:label>
    <rdfs:comment xml:lang="en">Package-URL (PURL), as defined in [ECMA-427](https://ecma-international.org/publications-and-standards/standards/ecma-427/).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/testedOn">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>testedOn</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element has been tested on the `to` Element(s).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Operations/projectSponsor">
    <rdfs:comment xml:lang="en">Sponsor of the project.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Agent"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/BoundaryDefinitionProcess">
    <rdfs:comment xml:lang="en">The Boundary Definition Process refers to the process class used to produce boundaries.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/Core/DefinedProcess"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/AI/informationAboutTraining">
    <rdfs:comment xml:lang="en">Information about different steps of the training process.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Core/prefix">
    <rdfs:comment xml:lang="en">A substitute for a URI.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/socialMedia">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>socialMedia</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to a social media channel for a package.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Security/SsvcDecisionType/act">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Security/SsvcDecisionType"/>
    <rdfs:label>act</rdfs:label>
    <rdfs:comment xml:lang="en">The vulnerability requires attention from the organization's internal, supervisory-level and leadership-level individuals. Necessary actions include requesting assistance or information about the vulnerability, as well as publishing a notification either internally and/or externally. Typically, internal groups would meet to determine the overall response and then execute agreed upon actions. CISA recommends remediating Act vulnerabilities as soon as possible.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Core/identifier">
    <rdfs:comment xml:lang="en">Uniquely identifies an external element.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/swhid">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>swhid</rdfs:label>
    <rdfs:comment xml:lang="en">SoftWare Hash IDentifier, a persistent intrinsic identifier for digital artifacts, such as files, trees (also known as directories or folders), commits, and other objects typically found in version control systems. The format of the identifiers is defined in the [SWHID specification](https://www.swhid.org/swhid-specification/v1.2/) ([ISO/IEC 18670](https://www.iso.org/standard/89985.html)). They typically look like `swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2`.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Core/postOfficeBoxNumber">
    <rdfs:comment xml:lang="en">The number that identifies a PO box. A PO box is a box in a post office or other postal service location assigned to an organization where postal items may be kept.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Operations/exportingCountry">
    <rdfs:comment xml:lang="en">Country for which export controls must be taken into account.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/urlScheme">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>urlScheme</rdfs:label>
    <rdfs:comment xml:lang="en">[Uniform Resource Identifier (URI) Schemes](https://www.iana.org/assignments/uri-schemes/uri-schemes.xhtml). The scheme used in order to locate a resource.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/mailingList">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>mailingList</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to the mailing list used by the maintainer for a package.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Dataset/ConfidentialityLevelType/red">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Dataset/ConfidentialityLevelType"/>
    <rdfs:label>red</rdfs:label>
    <rdfs:comment xml:lang="en">For named recipients only. The dataset is highly confidential and shall be shared only with named recipients.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/other">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>other</rdfs:label>
    <rdfs:comment xml:lang="en">Used when the type does not match any of the other options.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Dataset/DatasetType/text">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Dataset/DatasetType"/>
    <rdfs:label>text</rdfs:label>
    <rdfs:comment xml:lang="en">Data consists of unstructured text, such as a book, a Wikipedia article (without images), or a transcript.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/AI/energyQuantity">
    <rdfs:comment xml:lang="en">Energy quantity.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Operations/Project">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">Temporary endeavor with a beginning and an end and that must be used to create a unique product, service or result.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/Core/Bundle"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="Na4530c3ac54d4ba8b5f08eb1c9b1c2de">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/endTime"/>
        <sh:pattern>^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T(([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]|23:59:60)Z$</sh:pattern>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N0e9bd947fb8c43f395beaac3755602f2">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/startTime"/>
        <sh:pattern>^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T(([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]|23:59:60)Z$</sh:pattern>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nfc5f4ff2728e46bd81cfc2f2f62df29b">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Operations/projectTitle"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N447ea545b7db4244aa6b7fe8629862f3">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Operations/projectContract"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nfbee7461149642c98659ba488396e7e3">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Operations/projectSponsor"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/Agent"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N483720ae116443bda1162df9cd66ca13">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Operations/projectOwner"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/Agent"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/finetunedOn">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>finetunedOn</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element has been finetuned on the `to` Element(s).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iswc">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>iswc</rdfs:label>
    <rdfs:comment xml:lang="en">[International Standard Musical Work Code (ISWC)](https://www.iswc.org/iswc) is an 11-character unique identifier standardized by [ISO 15707](https://www.iso.org/standard/83125.html) for musical works (compositions) as distinct from specific recordings. While the "ISWC" label and grouping separators (dots and hyphens) are used for human readability, they shall be omitted when the identifier is stored electronically (e.g., `T0017812031`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Core/city">
    <rdfs:comment xml:lang="en">City is a specific name used to define a locality.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/plannedDropoffLocation">
    <rdfs:comment xml:lang="en">A location where a package or an item will be dropped off or delivered.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Location"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Core/DictionaryEntry">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">A key with an associated value.</rdfs:comment>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N03f02241b5604e9fbe8fd5a02b69bf2d">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/key"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Ne6ac91c1204448818f97c36c399b1391">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/value"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Core/typeFromSource">
    <rdfs:comment xml:lang="en">typeFromSource is a value used to define an item within the definitionSource.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/specification">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Software/SoftwarePurpose"/>
    <rdfs:label>specification</rdfs:label>
    <rdfs:comment xml:lang="en">The Element is a plan, guideline or strategy how to create, perform or analyze an application.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/other">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>other</rdfs:label>
    <rdfs:comment xml:lang="en">Every `to` Element is related to the `from` Element where the relationship type is not described by any of the SPDX relationship types (this relationship is directionless).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ContactType/other">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ContactType"/>
    <rdfs:label>other</rdfs:label>
    <rdfs:comment xml:lang="en">A generic contact point to be used when the contact type does not match any of the other options.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/ReproduceProcess">
    <rdfs:comment xml:lang="en">Reproduction is the biological process by which living organisms produce offspring.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/SupplyChain/CreateProcess"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/verificationMethod">
    <rdfs:comment xml:lang="en">verificationMethod refers to the specific approach used for a checking an element's conformance with its requirements.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/metrics">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>metrics</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to metrics related to a package such as OpenSSF scorecards.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Dataset/DatasetType/categorical">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Dataset/DatasetType"/>
    <rdfs:label>categorical</rdfs:label>
    <rdfs:comment xml:lang="en">Data that is classified into a discrete number of categories, such as the eye color of a population of people.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Core/requirementStatement">
    <rdfs:comment xml:lang="en">A textual expression describing the actual need defined by the requirement.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/HashAlgorithm/blake2b512">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/HashAlgorithm"/>
    <rdfs:label>blake2b512</rdfs:label>
    <rdfs:comment xml:lang="en">BLAKE2b algorithm with a digest size of 512, as defined in [RFC 7693](https://datatracker.ietf.org/doc/rfc7693/) Section 4.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType/observation">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType"/>
    <rdfs:label>observation</rdfs:label>
    <rdfs:comment xml:lang="en">Documentation of direct monitoring or witnessing of the demonstration of processes, tests, or any kind of system responses during a specified timeframe under specified environmental conditions.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ProcessReadinessType/obsoleted">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ProcessReadinessType"/>
    <rdfs:label>obsoleted</rdfs:label>
    <rdfs:comment xml:lang="en">Superseded or not valid at present.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Extension/cdxProperty">
    <rdfs:comment xml:lang="en">Provides a map of a property name to a value.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Extension/CdxPropertyEntry"/>
