  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/webpage">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>webpage</rdfs:label>
    <rdfs:comment xml:lang="en">A Uniform Resource Locator (URL) that can be used to locate a resource, as defined in [RFC 9110](https://datatracker.ietf.org/doc/rfc9110/) Section 4.2.1 or Section 4.2.2. It may include an optional fragment identifier as specified in [RFC 3986](https://datatracker.ietf.org/doc/rfc3986) Section 3.5.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Security/decisionType">
    <rdfs:comment xml:lang="en">Provide the enumeration of possible decisions in the
