    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Requirement> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="N4a3a6f815a044b208f7c50437bfa6866">
        <sh:message>When relationship is underInvestigationFor, from must be a Vulnerability</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/underInvestigationFor> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="Ne2b67cfb7bea4f32a660a26f17c65b29">
        <sh:message>When relationship is underInvestigationFor, class must be VexUnderInvestigationVulnAssessmentRelationship</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/underInvestigationFor> .
    FILTER NOT EXISTS { $this rdf:type <Security/VexUnderInvestigationVulnAssessmentRelationship> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="N7159211b722a42b58908951baf07711d">
        <sh:message>When relationship is usesTool, class must be LifecycleScopedRelationship</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/usesTool> .
    FILTER NOT EXISTS { $this rdf:type <Core/LifecycleScopedRelationship> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="N3b3661ccc0954af8a5e460ba314b472e">
        <sh:message>When relationship is verifiedBy, from must be a Requirement</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/verifiedBy> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Requirement> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="N4ade440b5f61434fae645dbad39d13e3">
        <sh:message>When relationship is verifiedBy, to must be a RequirementVerification</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/verifiedBy> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <FunctionalSafety/RequirementVerification> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/HashAlgorithm/sha512">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/HashAlgorithm"/>
    <rdfs:label>sha512</rdfs:label>
    <rdfs:comment xml:lang="en">SHA-2 with a digest length of 512, as defined in [RFC 6234](https://datatracker.ietf.org/doc/rfc6234/).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Security/CvssV4VulnAssessmentRelationship">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
