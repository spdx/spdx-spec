    <rdfs:label>hasRoleIn</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element has a role in the `to` Element. The use of the hasRoleIn is constrained to `RoleRelationship` classed relationships.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/reportedBy">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>reportedBy</rdfs:label>
    <rdfs:comment xml:lang="en">Designates a `from` /Security/Vulnerability was first reported to a project, vendor, or tracking database for formal identification by each `to` Agent.</rdfs:comment>
  </owl:NamedIndividual>
