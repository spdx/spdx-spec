  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Core/Bom">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">A container for a grouping of SPDX 3 content characterizing details
(provenance, composition, licensing, etc.) about a product.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/Core/Bundle"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="N26599d15f3724867a7fc4d97e43fb806">
        <sh:message>A value for Core/name is required when a value for Core/version is present</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Software/version> ?version .
    FILTER NOT EXISTS {
        $this <Software/name> ?name .
    }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:property>
      <rdf:Description rdf:nodeID="N1d769a2ee8be466595a438c3fbbcaf1c">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/version"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/hasInstall">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>hasInstall</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element has each `to` Artifact installed (placed into position for use) into it during a LifecycleScopeType period. To express the Agent doing the install, link this relationship as the `from` in `performedBy`.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/plannedStorageLocation">
    <rdfs:comment xml:lang="en">A planned location where a good, product, or material is stored.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Location"/>
  </owl:ObjectProperty>
