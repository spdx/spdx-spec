    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>riskAssessment</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to a risk assessment for a package.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/patchedBy">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>patchedBy</rdfs:label>
    <rdfs:comment xml:lang="en">Every `to` Element is a patch for the `from` Element (`from` patchedBy `to`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/UseAction">
    <rdfs:comment xml:lang="en">The action of product use.</rdfs:comment>
