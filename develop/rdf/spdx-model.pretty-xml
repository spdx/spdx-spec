          <rdf:Description rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/test"/>
        </sh:in>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N367f58d402fe442d83e243b3221691e7">
