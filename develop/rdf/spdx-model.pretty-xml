      <rdf:Description rdf:nodeID="Nd9a78861b3bd495e80662fa138484138">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/AI/interactionTemplateString"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N46904985227044b097af3e74915a5657">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/AI/interactionTemplateDictionary"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/DictionaryEntry"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Core/standardName">
    <rdfs:comment xml:lang="en">The name of a standard applicable to an artifact.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/LifecycleScopeType/runtime">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/LifecycleScopeType"/>
    <rdfs:label>runtime</rdfs:label>
    <rdfs:comment xml:lang="en">A relationship has specific context implications during the execution phase of an element.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/plannedPickupLocation">
    <rdfs:comment xml:lang="en">A location where a package or an item will be picked up.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Location"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/EvaluationResultType/fail">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/FunctionalSafety/EvaluationResultType"/>
    <rdfs:label>fail</rdfs:label>
