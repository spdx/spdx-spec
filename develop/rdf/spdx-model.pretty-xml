      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N6da647fe7ca9476c96b465dfa0b94c7d">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/definitionSource"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/Specification"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
