    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="Nfaf311e9d058433db645741dda6b9e82">
        <sh:message>When relationship is affects, from must be a Vulnerability, Action, or DefinedProcess</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/affects> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Action> }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/DefinedProcess> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="N2c674c74d21a418c9abba9d71c0e35c8">
        <sh:message>When relationship is assumes, to must be an Assumption</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/assumes> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <FunctionalSafety/Assumption> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="N868310ee40544c63937543fda99c33ec">
        <sh:message>When relationship is configures, class must be LifecycleScopedRelationship</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/configures> .
    FILTER NOT EXISTS { $this rdf:type <Core/LifecycleScopedRelationship> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="N86cc773d77864155bf12fb7cf85fe94c">
        <sh:message>When relationship is conformsTo, to must be an Assumption or Specification</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/conformsTo> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <FunctionalSafety/Assumption> }
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Specification> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="N3309a54177be40efaecf8910b807f4d7">
        <sh:message>When relationship is coordinatedBy, from must be a Vulnerability</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/coordinatedBy> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="N5f51fccef86b480c8f576affde1bd228">
        <sh:message>When relationship is createdBy, from must be an Action or DefinedProcess</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/createdBy> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Action> }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/DefinedProcess> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="N3fa62c3571354f6d8539d1b616fcca00">
        <sh:message>When relationship is createdBy, to must be an Agent</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/createdBy> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Agent> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="N91b7e72a474f495696305121948531c6">
        <sh:message>When relationship is delegatedTo, from must be an Agent</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/delegatedTo> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Agent> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="Nf4159f3995a9465a8fb7adfecc2b122f">
        <sh:message>When relationship is delegatedTo, to must be a Relationship whose relationshipType is invokedBy</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/delegatedTo> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS {
        ?to rdf:type/rdfs:subClassOf* <Core/Relationship> .
        ?to <Core/relationshipType> <Core/RelationshipType/invokedBy> .
    }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="N4697cd799e0942ada4fff7192d6ebe07">
        <sh:message>When relationship is delegatedTo, class must be LifecycleScopedRelationship</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/delegatedTo> .
    FILTER NOT EXISTS { $this rdf:type <Core/LifecycleScopedRelationship> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="Na083e9219870416d9c88fd7bc49913a4">
        <sh:message>When relationship id dependsOn, class must be LifecycleScopedRelationship</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/dependsOn> .
    FILTER NOT EXISTS { $this rdf:type <Core/LifecycleScopedRelationship> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="N42242bfeba444635841a61b9634473d3">
        <sh:message>When relationship is doesNotAffect, from must be a Vulnerability</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/doesNotAffect> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="Nf100385e962e44b4aea5e2154937379a">
        <sh:message>When relationship is doesNotAffect, class must be VexNotAffectedVulnAssessmentRelationship</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/doesNotAffect> .
    FILTER NOT EXISTS { $this rdf:type <Security/VexNotAffectedVulnAssessmentRelationship> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="N0be079f03bd34867825edacb064f1982">
        <sh:message>When relationship is exploitCreatedBy, to must be an Agent</sh:message>
