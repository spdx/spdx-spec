  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/fixedIn">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>fixedIn</rdfs:label>
