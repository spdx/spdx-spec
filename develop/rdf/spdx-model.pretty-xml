    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Specification"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/ExpandedLicensing/ExtendableLicense">
