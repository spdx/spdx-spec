        <sh:message>When relationship is republishedBy, to must be an Agent</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/republishedBy> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Agent> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="Nbd86b0fd272745e18d564462db063b32">
        <sh:message>When relationship is resolved, from must be a ResolutionAction</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/resolved> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <SupplyChain/ResolutionAction> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="N1189eee16e1a4f6ba12aa67b9691c9c4">
        <sh:message>When relationship is resolved, to must be an OutOfSpecAction</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/resolved> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <SupplyChain/OutOfSpecAction> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="N66a05133e4114e799c0155224782ea18">
        <sh:message>When relationship is runsOn, to must be a Hardware</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/runsOn> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Hardware/Hardware> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="Ndf747cf5f80144a78dc6fabadf8992f9">
        <sh:message>When relationship is runsOn, class must be LifecycleScopedRelationship</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/runsOn> .
    FILTER NOT EXISTS { $this rdf:type <Core/LifecycleScopedRelationship> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="Nf15babd217ee40cba08074da1fd9b676">
        <sh:message>When relationship is serializedInArtifact, from must be a SpdxDocument</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/serializedInArtifact> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/SpdxDocument> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="N48c31c90c1744de8a401f7fb0c59799d">
        <sh:message>When relationship is serializedInArtifact, to must be an Artifact</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/serializedInArtifact> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Artifact> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="N61718a19353846c9b08c8da461426cf9">
        <sh:message>When relationship is tracedToDetail, from must be a Requirement</sh:message>
        <sh:select><![CDATA[BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/tracedToDetail> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Requirement> }
}]]></sh:select>
      </sh:SPARQLConstraint>
    </sh:sparql>
    <sh:sparql>
      <sh:SPARQLConstraint rdf:nodeID="N7d29893288b04df7866b4255379ae595">
