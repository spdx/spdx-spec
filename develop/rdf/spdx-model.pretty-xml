    <rdfs:label>conformsTo</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element conforms to each `to` /FunctionalSafety/Assumption or Specification.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/securityOther">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>securityOther</rdfs:label>
