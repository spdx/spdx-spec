        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/resolved">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>resolved</rdfs:label>
    <rdfs:comment xml:lang="en">The `to` /SupplyChain/OutOfSpecAction is resolved in the `from` /SupplyChain/ResolutionAction.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/hasResolution">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>hasResolution</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` /SupplyChain/ResolutionAction points to the `to` /SupplyChain/OutOfSpecAction that is addressed.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isbn">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>isbn</rdfs:label>
    <rdfs:comment xml:lang="en">[International Standard Book Number (ISBN)](https://www.isbn-international.org/content/isbn-users-manual/29) is a unique numeric identifier for monographic publications standardized by [ISO 2108](https://www.iso.org/standard/65483.html). It consists of either 10 digits (for assignments prior to January 1, 2007) or 13 digits. A 13-digit ISBN is composed of five parts: a GS1 prefix, a registration group, a registrant, a publication element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., `9780198836063`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/verificationPrecondition">
    <rdfs:comment xml:lang="en">Verification preconditions are initial criteria that are to be met prior to initiating the verification method.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/underInvestigationFor">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>underInvestigationFor</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` /Security/Vulnerability impact is being investigated for each `to` Element. The use of the `underInvestigationFor` type is constrained to `/Security/VexUnderInvestigationVulnAssessmentRelationship` classed relationships.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Core/Organization">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">A group of people who work together in an organized way for a shared purpose.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/Core/Agent"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N8c87a63aa19d42a2b06a446105205103">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/headquartersLocation"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/Location"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/other">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>other</rdfs:label>
    <rdfs:comment xml:lang="en">Used when the type does not match any of the other options.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Core/assignedBy">
    <rdfs:comment xml:lang="en">assignedBy identifies the agent that grants or assigns the role to the target element.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Agent"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Core/HashAlgorithm">
    <rdfs:comment xml:lang="en">A mathematical algorithm that maps data of arbitrary size to a bit string.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Core/namespace">
    <rdfs:comment xml:lang="en">Provides an unambiguous mechanism for conveying a URI fragment portion of an
Element ID.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Core/SpdxDocument">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">A collection of SPDX Elements that could potentially be serialized.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/Core/ElementCollection"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N6de5d9a5b6f14c49a81b5c63b8a4754e">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/import"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalMap"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nf70da7fbe1f04bdbb216a1568c1af4da">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/namespaceMap"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/NamespaceMap"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nc1e99534644342d581f858831dd1d10c">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/dataLicense"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/SimpleLicensing/AnyLicenseInfo"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Core/roleQualification">
    <rdfs:comment xml:lang="en">roleQualification specifies the requirements, criteria, or conditions that must be met for an entity to be considered qualified to fulfill a particular role.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Requirement"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/SpecificationType/regulation">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/SpecificationType"/>
    <rdfs:label>regulation</rdfs:label>
    <rdfs:comment xml:lang="en">A mandatory legal specification issued by a governmental or regulatory authority. Compliance is enforceable by law.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/runsOn">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>runsOn</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element (the instructions) runs on each `to` /Hardware/Hardware (processing element), during a LifecycleScopeType period.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Build/configSourceEntrypoint">
    <rdfs:comment xml:lang="en">Property describes the invocation entrypoint of a build.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/BoundaryCrossingAction">
    <rdfs:comment xml:lang="en">An action of crossing a boundary is defined in this class.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/SupplyChain/UseAction"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Operations/assessedElement">
    <rdfs:comment xml:lang="en">Specifies an Element as subject of an assessment.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Element"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/hasEvidence">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>hasEvidence</rdfs:label>
    <rdfs:comment xml:lang="en">Every `to` Element is considered as evidence for the `from` Element (`from` hasEvidence `to`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/hasOptionalComponent">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>hasOptionalComponent</rdfs:label>
    <rdfs:comment xml:lang="en">Every `to` Element is an optional component of the `from` Element (`from` hasOptionalComponent `to`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Software/sourceInfo">
    <rdfs:comment xml:lang="en">Records any relevant background information or additional comments
about the origin of the package.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/AI/metric">
    <rdfs:comment xml:lang="en">Metric used to evaluate the AI model.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/DictionaryEntry"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Software/primaryPurpose">
    <rdfs:comment xml:lang="en">Provides information about the primary purpose of the software artifact.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Software/SoftwarePurpose"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/issn">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>issn</rdfs:label>
    <rdfs:comment xml:lang="en">[International Standard Serial Number (ISSN)](https://www.issn.org/understanding-the-issn/what-is-an-issn/) is an eight-digit identifier for serial publications and other continuing resources standardized by [ISO 3297](https://www.iso.org/standard/84536.html). It consists of two groups of four digits separated by a hyphen, where the final character is a check digit that may be an "X". The hyphen is retained when the identifier is stored electronically to maintain the standard 9-character string format (e.g., `1464-3693`). The ISSN is media-specific; the same journal title may be assigned different identifiers for its physical and digital versions.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/review">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType"/>
    <rdfs:label>review</rdfs:label>
    <rdfs:comment xml:lang="en">A examination or checking of documentation, records, processes, or systems to confirm compliance or adherence with an upper level requirement. Typically done as peer review, offline review or review meeting.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Dataset/sensor">
    <rdfs:comment xml:lang="en">Describes a sensor used for collecting the data.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/DictionaryEntry"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Dataset/ConfidentialityLevelType">
    <rdfs:comment xml:lang="en">Confidentiality level.</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/contains">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>contains</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element contains each `to` Element.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/SafetyIntegrityLevelType/dalC">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/FunctionalSafety/SafetyIntegrityLevelType"/>
    <rdfs:label>dalC</rdfs:label>
    <rdfs:comment xml:lang="en">Design Assurance Level C for aviation software assurance.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Operations/projectTitle">
    <rdfs:comment xml:lang="en">Title of the project.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Dataset/ConfidentialityLevelType/amberStrict">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Dataset/ConfidentialityLevelType"/>
    <rdfs:label>amberStrict</rdfs:label>
    <rdfs:comment xml:lang="en">Limited distribution - organization only. The dataset shall be shared only with specific organizations on a need-to-know basis.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Core/created">
    <rdfs:comment xml:lang="en">Identifies when the Element was originally created.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Security/VexNotAffectedVulnAssessmentRelationship">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">Links a vulnerability and one or more elements designating the latter as products
not affected by the vulnerability.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/Security/VexVulnAssessmentRelationship"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="Ne8e49f6cabee4da59e7ac4fc1d03a2f9">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Security/justificationType"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Security/VexJustificationType"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:in rdf:parseType="Collection">
          <rdf:Description rdf:about="https://spdx.org/rdf/3/terms/Security/VexJustificationType/componentNotPresent"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3/terms/Security/VexJustificationType/vulnerableCodeNotPresent"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3/terms/Security/VexJustificationType/vulnerableCodeCannotBeControlledByAdversary"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3/terms/Security/VexJustificationType/vulnerableCodeNotInExecutePath"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3/terms/Security/VexJustificationType/inlineMitigationsAlreadyExist"/>
        </sh:in>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N2f15f133edeb4e6f8a03340ac9c698c2">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Security/impactStatement"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N9fc115eb32854c30bb56752246af98ea">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Security/impactStatementTime"/>
        <sh:pattern>^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T(([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]|23:59:60)Z$</sh:pattern>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Service/serviceHostingCountry">
    <rdfs:comment xml:lang="en">Specifies a country code where a software service is hosted.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/SupportType/noAssertion">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/SupportType"/>
    <rdfs:label>noAssertion</rdfs:label>
    <rdfs:comment xml:lang="en">No assertion about the type of support is made. This is considered the default if no other support type is used.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/swhid">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Software/ContentIdentifierType"/>
    <rdfs:label>swhid</rdfs:label>
    <rdfs:comment xml:lang="en">SoftWare Hash IDentifier, a persistent intrinsic identifier for digital artifacts, such as files, trees (also known as directories or folders), commits, and other objects typically found in version control systems. The format of the identifiers is defined in the [SWHID specification](https://www.swhid.org/swhid-specification/v1.2/) ([ISO/IEC 18670](https://www.iso.org/standard/89985.html)). They typically look like `swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2`.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/phoneNumber">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>phoneNumber</rdfs:label>
    <rdfs:comment xml:lang="en">Phone number; A string of decimal digits that uniquely indicates the network termination point defined in [RFC 3966](https://datatracker.ietf.org/doc/rfc3966/) Section 5.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/destructionPerformedBy">
    <rdfs:comment xml:lang="en">This is the agent that performed the act of destroying the item.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Agent"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Software/SbomType">
    <rdfs:comment xml:lang="en">Provides a set of values to be used to describe the common types of SBOMs that
tools may create.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/assumptionUID">
    <rdfs:comment xml:lang="en">An assumptionUID is a unique identifier assigned to an Assumption item.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifier"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/patch">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Software/SoftwarePurpose"/>
    <rdfs:label>patch</rdfs:label>
    <rdfs:comment xml:lang="en">The Element contains a set of changes to update, fix, or improve another Element.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Operations/assessmentResult">
    <rdfs:comment xml:lang="en">Specifies an Element as subject of an assessment.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Operations/ExportControlClassification"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Core/responsibility">
    <rdfs:comment xml:lang="en">Describes the specific responsibility of a Role.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Requirement"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/HashAlgorithm/blake2b256">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/HashAlgorithm"/>
    <rdfs:label>blake2b256</rdfs:label>
    <rdfs:comment xml:lang="en">BLAKE2b algorithm with a digest size of 256, as defined in [RFC 7693](https://datatracker.ietf.org/doc/rfc7693/) Section 4.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/HashAlgorithm/md4">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/HashAlgorithm"/>
    <rdfs:label>md4</rdfs:label>
    <rdfs:comment xml:lang="en">MD4 message-digest algorithm, as defined in [RFC 1186](https://datatracker.ietf.org/doc/rfc1186/).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Software/SbomType/runtime">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Software/SbomType"/>
    <rdfs:label>runtime</rdfs:label>
    <rdfs:comment xml:lang="en">SBOM generated through instrumenting the system running the software, to capture only components present in the system, as well as external call-outs or dynamically loaded components. In some contexts, this may also be referred to as an "Instrumented" or "Dynamic" SBOM.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Software/attributionText">
    <rdfs:comment xml:lang="en">Provides a place for the SPDX data creator to record acknowledgement text for
a software Package, File or Snippet.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Software/homePage">
    <rdfs:comment xml:lang="en">A place for the SPDX document creator to record a website that serves as the
package's home page.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/qualityAssessmentReport">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>qualityAssessmentReport</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to a quality assessment for a package.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/eolNotice">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>eolNotice</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to the End Of Sale (EOS) and/or End Of Life (EOL) information related to a package.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType">
    <rdfs:comment xml:lang="en">Enumeration of verification types.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Core/creationInfo">
    <rdfs:comment xml:lang="en">Provides information about the creation of the Element.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/CreationInfo"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Hardware/dimensions">
    <rdfs:comment xml:lang="en">Information related to hardware dimension.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Hardware/Dimensions"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Build/buildType">
    <rdfs:comment xml:lang="en">A buildType is a hint that is used to indicate the toolchain, platform, or
infrastructure that the build was invoked on.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/hasUninstall">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>hasUninstall</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element has each `to` Artifact uninstalled (removed from position for use) from it during a LifecycleScopeType period. To express the Agent doing the uninstall, link this relationship as the `from` in `performedBy`.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Core/headquartersLocation">
    <rdfs:comment xml:lang="en">A location of the organization's headquarters.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Location"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Security/SsvcDecisionType/attend">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Security/SsvcDecisionType"/>
    <rdfs:label>attend</rdfs:label>
    <rdfs:comment xml:lang="en">The vulnerability requires attention from the organization's internal, supervisory-level individuals. Necessary actions include requesting assistance or information about the vulnerability, and may involve publishing a notification either internally and/or externally. CISA recommends remediating Attend vulnerabilities sooner than standard update timelines.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ismn">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>ismn</rdfs:label>
    <rdfs:comment xml:lang="en">[International Standard Music Number (ISMN)](https://ismn-international.org/ismn/the-ismn/) is a unique numeric identifier for printed music (notated music) standardized by [ISO 10957](https://www.iso.org/standard/83122.html). It consists of either 10 characters (starting with the letter "M" for assignments prior to January 1, 2008) or 13 digits. A 13-digit ISMN is composed of four parts: the GS1 prefix `979-0`, a registrant element, an item element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., `9790006538424`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Core/relationshipType">
    <rdfs:comment xml:lang="en">Information about the relationship between two Elements.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel/partialAutomation">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel"/>
    <rdfs:label>partialAutomation</rdfs:label>
    <rdfs:comment xml:lang="en">Level 2 - Partial automation or task automation. Some sub-functions of the system are fully automated while the system remain under control of an external agent. The system can perform actions for an approved task without requiring the agent's continuous direct control.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType/recording">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType"/>
    <rdfs:label>recording</rdfs:label>
    <rdfs:comment xml:lang="en">Captured datastream like audio, video, or any other kind of continuous electronic capture of events, behavior or conditions.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Core/description">
    <rdfs:comment xml:lang="en">Provides a detailed description of the Element.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Core/externalRef">
    <rdfs:comment xml:lang="en">Points to a resource outside the scope of the SPDX 3 content
that provides additional characteristics of an Element.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRef"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Operations/assessmentContext">
    <rdfs:comment xml:lang="en">Sets the context for an assessment by specifying the related project.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Operations/Project"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/configures">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>configures</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element is a configuration applied to each `to` Element, during a LifecycleScopeType period.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Security/ExploitCatalogType">
    <rdfs:comment xml:lang="en">Specifies the exploit catalog type.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Core/RequirementStatusType">
    <rdfs:comment xml:lang="en">Provide an enumerated set of requirement statuses that can provide state to a requirement.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/responsibilityChangedOn">
    <rdfs:comment xml:lang="en">The element that has its responsibility changed.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Element"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/ResponsibilityType/custody">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/SupplyChain/ResponsibilityType"/>
    <rdfs:label>custody</rdfs:label>
    <rdfs:comment xml:lang="en">Custody refers to the responsibility, control, and safekeeping of an asset, person, or legal entity. It involves both physical possession and legal accountability over something.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/LifecycleScopeType/build">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/LifecycleScopeType"/>
    <rdfs:label>build</rdfs:label>
    <rdfs:comment xml:lang="en">A relationship has specific context implications during an element's build phase, during development.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Core/packageVerificationCodeExcludedFile">
    <rdfs:comment xml:lang="en">The relative file name of a file to be excluded from the
`PackageVerificationCode`.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Core/createdBy">
    <rdfs:comment xml:lang="en">Identifies who or what created the Element.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Agent"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Extension/cdxPropName">
    <rdfs:comment xml:lang="en">A name used in a CdxPropertyEntry name-value pair.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Hardware/VirtualHardwareModelType">
    <rdfs:comment xml:lang="en">Specifies the type of simulation model used to represent virtual hardware.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Core/to">
    <rdfs:comment xml:lang="en">References an Element on the right-hand side of a relationship.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Element"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/SupportType/deployed">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/SupportType"/>
    <rdfs:label>deployed</rdfs:label>
    <rdfs:comment xml:lang="en">In addition to being supported by the supplier, the software is known to have been deployed and is in use. For a software as a service provider, this implies the software is now available as a service.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/ExpandedLicensing/subjectLicense">
    <rdfs:comment xml:lang="en">A License participating in an 'or later' model.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/ExpandedLicensing/License"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/currentResponsibleAgent">
    <rdfs:comment xml:lang="en">This is the individual, business, or organization who currently manages or responsible for the goods, services, or assets.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Agent"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Security/vectorString">
    <rdfs:comment xml:lang="en">Specifies the CVSS vector string for a vulnerability.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/locatedAt">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>locatedAt</rdfs:label>
    <rdfs:comment xml:lang="en">`from` Element located at a specific `to` Location. A time period is optional.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Core/elementValue">
    <rdfs:comment xml:lang="en">A value used in a key-value pair with a generic key that refers to an Element</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Element"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/coordinatedBy">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>coordinatedBy</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` /Security/Vulnerability is coordinatedBy the `to` Agent(s) (vendor, researcher, or consumer agent).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Hardware/centerOfMass">
    <rdfs:comment xml:lang="en">A point representing the mean position of the matter in a body or system.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Hardware/Dimensions"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Security/actionStatementTime">
    <rdfs:comment xml:lang="en">Records the time when a recommended action was communicated in a VEX statement
to mitigate a vulnerability.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Security/VexJustificationType/componentNotPresent">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Security/VexJustificationType"/>
    <rdfs:label>componentNotPresent</rdfs:label>
    <rdfs:comment xml:lang="en">The software is not affected because the vulnerable component is not in the product.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Dataset/datasetAvailability">
    <rdfs:comment xml:lang="en">Availability of a dataset.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Dataset/DatasetAvailabilityType"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/hasDocumentation">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>hasDocumentation</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element is documented by each `to` Element.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/HashAlgorithm/sha1">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/HashAlgorithm"/>
    <rdfs:label>sha1</rdfs:label>
    <rdfs:comment xml:lang="en">SHA-1, a secure hashing algorithm, as defined in [RFC 3174](https://datatracker.ietf.org/doc/rfc3174/).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isci">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>isci</rdfs:label>
    <rdfs:comment xml:lang="en">International Standard Collection Identifier (ISCI) is a variable-length identifier standardized by [ISO 27730](https://www.iso.org/standard/44293.html) for identifying collections held by libraries, archives, museums, and other memory institutions. It consists of two parts: the identifier for the assigning organization (an ISIL) enclosed in square brackets, followed by a local collection identifier string (e.g., `[FR-751041001]Casadesus1`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/ReproduceAction">
    <rdfs:comment xml:lang="en">Reproduction is the biological process by which organisms generate new individuals of the same species.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/SupplyChain/CreateAction"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Software/SbomType/source">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Software/SbomType"/>
    <rdfs:label>source</rdfs:label>
    <rdfs:comment xml:lang="en">SBOM created directly from the development environment, source files, and included dependencies used to build a product artifact.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/InspectionAction">
    <rdfs:comment xml:lang="en">An inspection action refers to a specific activity or set of activities performed during an inspection to examine, verify, or evaluate an item, process, or system.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/SupplyChain/UseAction"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Core/element">
    <rdfs:comment xml:lang="en">Refers to one or more Elements that are part of an ElementCollection.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Element"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/evidenceUID">
    <rdfs:comment xml:lang="en">A evidenceUID is a unique identifier assigned to an entity, item,
or requirement.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifier"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Dataset/datasetSize">
    <rdfs:comment xml:lang="en">**DEPRECATED in SPDX 3.1.**
Use [/Software/artifactSize](../../Software/Properties/artifactSize.md)
instead.

Size of the dataset.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/LifecycleScopeType/test">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/LifecycleScopeType"/>
    <rdfs:label>test</rdfs:label>
    <rdfs:comment xml:lang="en">A relationship has specific context implications during an element's testing phase, during development.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Dataset/DatasetAvailabilityType/registration">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Dataset/DatasetAvailabilityType"/>
    <rdfs:label>registration</rdfs:label>
    <rdfs:comment xml:lang="en">Dataset is not publicly available and an email registration is required before accessing the dataset, although without an affirmative acceptance of terms.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Core/postalName">
    <rdfs:comment xml:lang="en">The name of the recipient expressed in text.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Core/namespaceMap">
    <rdfs:comment xml:lang="en">Provides a NamespaceMap of prefixes and associated namespace partial URIs applicable to an SpdxDocument and independent of any specific serialization format or instance.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/NamespaceMap"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/HashAlgorithm/sha256">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/HashAlgorithm"/>
    <rdfs:label>sha256</rdfs:label>
    <rdfs:comment xml:lang="en">SHA-2 with a digest length of 256, as defined in [RFC 6234](https://datatracker.ietf.org/doc/rfc6234/).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/hasHost">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>hasHost</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` /Build/Build was run on the `to` Element during a LifecycleScopeType period (e.g. the host that the build runs on).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Core/Bundle">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">A collection of Elements that have a shared context.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/Core/ElementCollection"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N28be1403f1e940cca6492e7cd8320d12">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/context"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Core/rootElement">
    <rdfs:comment xml:lang="en">This property is used to denote the root Element(s) of a tree of elements contained in a BOM.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Element"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/ExpandedLicensing/isFsfLibre">
    <rdfs:comment xml:lang="en">Specifies whether the License is listed as free by the
Free Software Foundation (FSF).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Core/scope">
    <rdfs:comment xml:lang="en">Capture the scope of information about a specific relationship between elements.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/LifecycleScopeType"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Core/locationTime">
    <rdfs:comment xml:lang="en">A known location is specified at this time.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/ExpandedLicensing/CustomLicense">
    <rdfs:comment xml:lang="en">A license that is not listed on the SPDX License List.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/ExpandedLicensing/License"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType">
    <rdfs:comment xml:lang="en">Information about the relationship between two Elements.</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/inspection">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType"/>
    <rdfs:label>inspection</rdfs:label>
    <rdfs:comment xml:lang="en">A thorough examination or checking of documentation, records, processes, or systems to confirm compliance or adherence. An inspection needs to have a defined set of acceptance criteria (e.g. a checklist), a documentation of roles involved in the inspection (e.g. to document the inspector's independence) and a clear documentation of when and how it was performed.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Hardware/zAxisLength">
    <rdfs:comment xml:lang="en">The length along the z-axis.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/UnitOfMeasure"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Dataset/DatasetType/timeseries">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Dataset/DatasetType"/>
    <rdfs:label>timeseries</rdfs:label>
    <rdfs:comment xml:lang="en">Data is recorded in an ordered sequence of timestamped entries, such as the price of a stock over the course of a day.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/AI/limitation">
    <rdfs:comment xml:lang="en">Limitation of the AI software.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/plannedPreviousResponsibleAgent">
    <rdfs:comment xml:lang="en">This is the planned individual, business, or organization who was previously managing or responsible for the goods, services, or assets.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Agent"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Dataset/DatasetType/graph">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Dataset/DatasetType"/>
    <rdfs:label>graph</rdfs:label>
    <rdfs:comment xml:lang="en">Data is in the form of a graph where entries are somehow related to each other through edges, such as a social network of friends.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Software/FileKindType">
    <rdfs:comment xml:lang="en">Enumeration of the different kinds of SPDX file.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Core/endTime">
    <rdfs:comment xml:lang="en">The point in time when an element or an action ends,
becomes no longer applicable, or becomes no longer valid.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/publishedBy">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>publishedBy</rdfs:label>
    <rdfs:comment xml:lang="en">Designates a `from` /Security/Vulnerability was made available for public use or reference by each `to` Agent.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Hardware/virtualHardwareModel">
    <rdfs:comment xml:lang="en">Information related to virtual hardware simulation.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Hardware/VirtualHardwareModelType"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Hardware/additionalInformation">
    <rdfs:comment xml:lang="en">Additional relevance information.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/DictionaryEntry"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Core/ContactType">
    <rdfs:comment xml:lang="en">An enumeration of contact types.</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Dataset/DatasetType/audio">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Dataset/DatasetType"/>
    <rdfs:label>audio</rdfs:label>
