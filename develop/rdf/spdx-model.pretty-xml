    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Software/SoftwarePurpose"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/securityAdversaryModel">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>securityAdversaryModel</rdfs:label>
