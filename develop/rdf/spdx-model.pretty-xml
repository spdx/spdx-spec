          <rdf:Description rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType/recording"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType/observation"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType/other"/>
        </sh:in>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/verificationUID">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>verificationUID</rdfs:label>
    <rdfs:comment xml:lang="en">The unique identifier used by a verification management system or any other lifecycle management tool to uniquely identify a verification item.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Software/ContentIdentifierType">
    <rdfs:comment xml:lang="en">Specifies the type of a content identifier.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType">
    <rdfs:comment xml:lang="en">EvidenceType refers to categories of documented or observable proof used to verify compliance, qualification, or performance</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/PresenceType/noAssertion">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/PresenceType"/>
    <rdfs:label>noAssertion</rdfs:label>
    <rdfs:comment xml:lang="en">Makes no assertion about the field.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/x509Cert">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>x509Cert</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to an X.509 certificate as defined in [RFC 5280](https://datatracker.ietf.org/doc/rfc5280/). The primary media type shall be `application/pkix-cert`. The legacy media types `application/x-x509-ca-cert` and `application/x-x509-user-cert` may be used for backward compatibility, but shall not be used in new implementations. NOTE — RFC 5280 supersedes earlier X.509 profiles, including RFC 1422. Existing references based on RFC 1422 remain valid.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/executable">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Software/SoftwarePurpose"/>
    <rdfs:label>executable</rdfs:label>
    <rdfs:comment xml:lang="en">The Element is an Artifact that can be run on a computer.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/LifecycleScopeType/design">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/LifecycleScopeType"/>
    <rdfs:label>design</rdfs:label>
    <rdfs:comment xml:lang="en">A relationship has specific context implications during an element's design.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Service/SoftwareService">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">Software provided as a service over a network.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/Core/Artifact"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N2ef22e9f408c47c99d81328a600a7ebf">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Service/serverKeyValidationProtocol"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Service/KeyValidationProtocolType"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:in rdf:parseType="Collection">
          <rdf:Description rdf:about="https://spdx.org/rdf/3/terms/Service/KeyValidationProtocolType/ocsp"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3/terms/Service/KeyValidationProtocolType/crl"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3/terms/Service/KeyValidationProtocolType/other"/>
        </sh:in>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N85be53a2af044c698be165b1955fc7c4">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Service/serviceHostingCountry"/>
        <sh:pattern>^[A-Z]{3}$</sh:pattern>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/AI/EnergyConsumptionDescription">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">The class that helps note down the quantity of energy consumption and the unit
used for measurement.</rdfs:comment>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
