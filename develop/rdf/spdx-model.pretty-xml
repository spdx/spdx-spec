        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N82f00ed6aacc443c9ec1f319ea831095">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/AI/energyUnit"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/AI/EnergyUnitType"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
