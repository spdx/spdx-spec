<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:dcterms="http://purl.org/dc/terms/"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:ns2="https://spdx.org/rdf/3/terms/Hardware/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:ns3="https://spdx.org/rdf/3/terms/Software/"
  xmlns:sh="http://www.w3.org/ns/shacl#"
  xmlns:ns4="https://spdx.org/rdf/3/terms/Dataset/"
  xmlns:ns1="https://spdx.org/rdf/3/terms/Core/"
  xmlns:ns5="https://spdx.org/rdf/3/terms/AI/"
  xmlns:omg-ann="https://www.omg.org/spec/Commons/AnnotationVocabulary/"
  xmlns:ns6="https://spdx.org/rdf/3/terms/Service/"
  xmlns:ns7="https://spdx.org/rdf/3/terms/Security/"
  xmlns:ns8="https://spdx.org/rdf/3/terms/ExpandedLicensing/"
  xmlns:ns9="https://spdx.org/rdf/3/terms/FunctionalSafety/"
  xmlns:ns10="https://spdx.org/rdf/3/terms/SupplyChain/"
>
  <owl:Ontology rdf:about="https://spdx.org/rdf/3/terms/">
    <owl:versionIRI rdf:resource="https://spdx.org/rdf/3/terms/"/>
    <rdfs:label xml:lang="en">System Package Data Exchange™ (SPDX®) Ontology</rdfs:label>
    <dcterms:abstract xml:lang="en">This ontology defines the terms and relationships used in the SPDX specification to describe system packages</dcterms:abstract>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-01-23</dcterms:created>
    <dcterms:creator xml:lang="en">SPDX Project</dcterms:creator>
    <dcterms:license rdf:resource="https://spdx.org/licenses/Community-Spec-1.0.html"/>
    <dcterms:references rdf:resource="https://spdx.dev/specifications/"/>
    <dcterms:title xml:lang="en">System Package Data Exchange (SPDX) Ontology</dcterms:title>
    <omg-ann:copyright xml:lang="en">Copyright (C) 2026 SPDX Project</omg-ann:copyright>
  </owl:Ontology>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Operations/exportControlClassificationResult">
    <rdfs:comment xml:lang="en">Provides the result of an export control assessment.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Operations/ExportControlClassification"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/NoneElement">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/IndividualElement"/>
    <ns1:creationInfo>
      <ns1:CreationInfo rdf:about="https://spdx.org/rdf/3.1/creationInfo_NoneElement">
        <rdfs:comment xml:lang="en">This individual element was defined by the spec.</rdfs:comment>
        <ns1:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2026-01-23T03:01:00Z</ns1:created>
        <ns1:createdBy rdf:resource="https://spdx.org/rdf/3/terms/Core/SpdxOrganization"/>
        <ns1:specVersion>3.1</ns1:specVersion>
      </ns1:CreationInfo>
    </ns1:creationInfo>
    <rdfs:comment xml:lang="en">An Individual Value for Element representing a set of Elements with
cardinality (number/count) of zero.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/ExpandedLicensing/NoneLicense">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/ExpandedLicensing/IndividualLicensingInfo"/>
    <ns1:creationInfo>
      <ns1:CreationInfo rdf:about="https://spdx.org/rdf/3.1/creationInfo_NoneLicense">
        <rdfs:comment xml:lang="en">This individual element was defined by the spec.</rdfs:comment>
        <ns1:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2026-01-23T03:01:00Z</ns1:created>
        <ns1:createdBy rdf:resource="https://spdx.org/rdf/3/terms/Core/SpdxOrganization"/>
        <ns1:specVersion>3.1</ns1:specVersion>
      </ns1:CreationInfo>
    </ns1:creationInfo>
    <rdfs:comment xml:lang="en">An Individual Value for License where the SPDX data creator determines that no
license is present.</rdfs:comment>
    <owl:sameAs rdf:resource="https://spdx.org/rdf/3/terms/Licensing/None"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/NoAssertionElement">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/IndividualElement"/>
    <ns1:creationInfo>
      <ns1:CreationInfo rdf:about="https://spdx.org/rdf/3.1/creationInfo_NoAssertionElement">
        <rdfs:comment xml:lang="en">This individual element was defined by the spec.</rdfs:comment>
        <ns1:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2026-01-23T03:01:00Z</ns1:created>
        <ns1:createdBy rdf:resource="https://spdx.org/rdf/3/terms/Core/SpdxOrganization"/>
        <ns1:specVersion>3.1</ns1:specVersion>
      </ns1:CreationInfo>
    </ns1:creationInfo>
    <rdfs:comment xml:lang="en">An Individual Value for Element representing a set of Elements of unknown
identity or cardinality (number).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/ExpandedLicensing/NoAssertionLicense">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/ExpandedLicensing/IndividualLicensingInfo"/>
    <ns1:creationInfo>
      <ns1:CreationInfo rdf:about="https://spdx.org/rdf/3.1/creationInfo_NoAssertionLicense">
        <rdfs:comment xml:lang="en">This individual element was defined by the spec.</rdfs:comment>
        <ns1:created rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTimeStamp">2026-01-23T03:01:00Z</ns1:created>
        <ns1:createdBy rdf:resource="https://spdx.org/rdf/3/terms/Core/SpdxOrganization"/>
        <ns1:specVersion>3.1</ns1:specVersion>
      </ns1:CreationInfo>
    </ns1:creationInfo>
    <rdfs:comment xml:lang="en">An Individual Value for License when no assertion can be made about its actual
value.</rdfs:comment>
    <owl:sameAs rdf:resource="https://spdx.org/rdf/3/terms/Licensing/NoAssertion"/>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Extension/CdxPropertiesExtension">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">A type of extension consisting of a list of name value pairs.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/Extension/Extension"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="Na999badc66234950bfbd0017dd9f444d">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Extension/cdxProperty"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Extension/CdxPropertyEntry"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Core/Regulation">
    <rdfs:comment xml:lang="en">Regulation represents a rule or directive maintained by an authority.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/Core/Specification"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/AI/modelExplainability">
    <rdfs:comment xml:lang="en">Methods that can be used to explain the results from the AI model.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Security/SsvcVulnAssessmentRelationship">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">Provides an SSVC assessment for a vulnerability.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/Security/VulnAssessmentRelationship"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N18b0c3a843e94be5babf24b88203c361">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Security/decisionType"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Security/SsvcDecisionType"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:in rdf:parseType="Collection">
          <rdf:Description rdf:about="https://spdx.org/rdf/3/terms/Security/SsvcDecisionType/act"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3/terms/Security/SsvcDecisionType/attend"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3/terms/Security/SsvcDecisionType/track"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3/terms/Security/SsvcDecisionType/trackStar"/>
        </sh:in>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/hasRequirement">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>hasRequirement</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element has a requirement on each `to` Element, during a LifecycleScopeType period.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/SpecificationType/other">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/SpecificationType"/>
    <rdfs:label>other</rdfs:label>
    <rdfs:comment xml:lang="en">Any specification that does not fall under any of the other entries.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/AI/SafetyRiskAssessmentType/medium">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/AI/SafetyRiskAssessmentType"/>
    <rdfs:label>medium</rdfs:label>
    <rdfs:comment xml:lang="en">The third-highest level of risk posed by an AI system.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Operations/exportControlSpecification">
    <rdfs:comment xml:lang="en">Specification basis for the export control classification.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/Specification"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Security/VexAffectedVulnAssessmentRelationship">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">Connects a vulnerability and an element designating the element as a product
affected by the vulnerability.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/Security/VexVulnAssessmentRelationship"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N942c36a388be425eba881c24863109b0">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Security/actionStatement"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N9388121655cb4efe9a7920131a783f9e">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Security/actionStatementTime"/>
        <sh:pattern>^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T(([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]|23:59:60)Z$</sh:pattern>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel/notAutomated">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel"/>
    <rdfs:label>notAutomated</rdfs:label>
    <rdfs:comment xml:lang="en">Level 0 - Not automated. No automation. The operator fully controls the system.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Security/CvssV2VulnAssessmentRelationship">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">Provides a CVSS version 2.0 assessment for a vulnerability.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/Security/VulnAssessmentRelationship"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N1232d940e4e5469d859b728729779630">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Security/score"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N15e60f3a46aa4b06a0e283a382af07a9">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Security/vectorString"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/ExpandedLicensing/standardAdditionTemplate">
    <rdfs:comment xml:lang="en">Identifies the full text of a LicenseAddition, in SPDX templating format.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/requirementUID">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>requirementUID</rdfs:label>
    <rdfs:comment xml:lang="en">The unique identifier used by a requirements management or any other lifecycle management tool to uniquely identify a requirement item.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/vulnerabilityDisclosureReport">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>vulnerabilityDisclosureReport</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to a Vulnerability Disclosure Report (VDR) which provides the software supplier's analysis and findings describing the impact (or lack of impact) that reported vulnerabilities have on packages or products in the supplier's SBOM as defined in [NIST SP 800-161 Cybersecurity Supply Chain Risk Management Practices for Systems and Organizations](https://csrc.nist.gov/pubs/sp/800/161/r1/final).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/bower">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>bower</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to a Bower package. The package locator format, looks like `package#version`, is defined in the "install" section of [Bower API documentation](https://bower.io/docs/api/#install).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Build/buildEndTime">
    <rdfs:comment xml:lang="en">**DEPRECATED in SPDX 3.1.**
Use [/Core/endTime](../../Core/Properties/endTime.md) instead.

Property that describes the time at which a build stops.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/SafetyIntegrityLevelType/asilD">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/FunctionalSafety/SafetyIntegrityLevelType"/>
    <rdfs:label>asilD</rdfs:label>
    <rdfs:comment xml:lang="en">Automotive Safety Integrity Level D under ISO 26262.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Security/CvssSeverityType/high">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Security/CvssSeverityType"/>
    <rdfs:label>high</rdfs:label>
    <rdfs:comment xml:lang="en">When a CVSS score is between 7.0 - 8.9.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/duns">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>duns</rdfs:label>
    <rdfs:comment xml:lang="en">[Data Universal Numbering System (D-U-N-S) Number](https://www.dnb.com/en-us/smb/duns.html) is a unique nine-digit identifier, issued by Dun &amp; Bradstreet, that identifies a business entity, often on a location-specific basis.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/providesSupportFor">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>providesSupportFor</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Agent provides support for each `to` Artifact. The use of the `providesSupportFor` type is constrained to `SupportRelationship` classed relationships.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/documentation">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Software/SoftwarePurpose"/>
    <rdfs:label>documentation</rdfs:label>
    <rdfs:comment xml:lang="en">The Element is documentation.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Hardware/category">
    <rdfs:comment xml:lang="en">The category describes the hardware item in a DefinedType.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/DefinedType"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Dataset/DatasetType/other">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Dataset/DatasetType"/>
    <rdfs:label>other</rdfs:label>
    <rdfs:comment xml:lang="en">Data is of a type not included in this list.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Core/startTime">
    <rdfs:comment xml:lang="en">The point in time when an element or an action starts,
becomes applicable, or becomes valid.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iban">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>iban</rdfs:label>
    <rdfs:comment xml:lang="en">International Bank Account Number (IBAN) is a system for identifying bank accounts across national borders standardized by [ISO 13616](https://www.iso.org/standard/81090.html). It consists of up to 34 alphanumeric characters, including a country code, two check digits, and a basic bank account number. While spaces may be inserted for human readability, they must be omitted when used for electronic data exchange (e.g., `IE64IRCE92050112345678`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/issueTracker">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>issueTracker</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to the issue tracker for a package.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipCompleteness/complete">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipCompleteness"/>
    <rdfs:label>complete</rdfs:label>
    <rdfs:comment xml:lang="en">The relationship is known to be exhaustive.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ProcessReadinessType/other">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ProcessReadinessType"/>
    <rdfs:label>other</rdfs:label>
    <rdfs:comment xml:lang="en">Other.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/HashAlgorithm/blake2b384">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/HashAlgorithm"/>
    <rdfs:label>blake2b384</rdfs:label>
    <rdfs:comment xml:lang="en">BLAKE2b algorithm with a digest size of 384, as defined in [RFC 7693](https://datatracker.ietf.org/doc/rfc7693/) Section 4.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/hasContactPoint">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>hasContactPoint</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Artifact has each `to` Agent as a contact point. The use of the `hasContactPoint` type is constrained to `ContactPointRelationship` classed relationships. The type of contact can be specified using a `contactType` property on the `to` Agent.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Core/RoleRelationship">
