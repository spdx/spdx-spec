        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifier"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nc83dcc0a8b3c422197c459294960ea00">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/FunctionalSafety/evidenceCategory"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType"/>
