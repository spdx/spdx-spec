    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType"/>
    <rdfs:label>test</rdfs:label>
    <rdfs:comment xml:lang="en">Conducting controlled tests, experiments or simulations to verify that specific requirements regarding performance, functionality, robustness, etc. are met.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Software/SbomType/deployed">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Software/SbomType"/>
    <rdfs:label>deployed</rdfs:label>
    <rdfs:comment xml:lang="en">SBOM provides an inventory of software that is present on a system. This may be an assembly of other SBOMs that combines analysis of configuration options, and examination of execution behavior in a (potentially simulated) deployment environment.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Build/parameter">
