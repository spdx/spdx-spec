    <sh:property>
      <rdf:Description rdf:nodeID="N01951ea71d8348d4b7a4b32e14889543">
        <sh:path rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <sh:not>
          <rdf:Description rdf:nodeID="N1013baf4ae1f4483bcc995ea93718893">
            <sh:hasValue rdf:resource="https://spdx.org/rdf/3/terms/SupplyChain/UseAction"/>
          </rdf:Description>
        </sh:not>
        <sh:message xml:lang="en">https://spdx.org/rdf/3/terms/SupplyChain/UseAction is an abstract class and should not be instantiated directly. Instantiate a subclass instead.</sh:message>
      </rdf:Description>
    </sh:property>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Software/artifactSize">
    <rdfs:comment xml:lang="en">Identifies the size of a software Artifact, in bytes.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/evaluation">
    <rdfs:comment xml:lang="en">Evaluation is an outcome considering results of a verification.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/FunctionalSafety/EvaluationResultType"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/SimpleLicensing/SimpleLicensingText">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">A license or a license addition that is not listed on the SPDX License List.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/Core/Element"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
