  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Core/CreationInfo">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">Provides information about the creation of the Element.</rdfs:comment>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N3529fea4586741b49f14f35df1b0ddda">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/specVersion"/>
        <sh:pattern>^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(\.(0|[1-9][0-9]*))?$</sh:pattern>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nbf6063fb258f47758aa6c61fd232ef0f">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/comment"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N49946d7f20e8423ebb6fdcee46917078">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/created"/>
        <sh:pattern>^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T(([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]|23:59:60)Z$</sh:pattern>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N17905112bd0c46f4b93dcc4988f045c7">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/createdBy"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/Agent"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Ncce38619d81f4391af2899b1d7b4a19e">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/createdUsing"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/Tool"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
      </rdf:Description>
    </sh:property>
  </owl:Class>
