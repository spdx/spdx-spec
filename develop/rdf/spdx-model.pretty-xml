    <rdfs:label>cwe</rdfs:label>
    <rdfs:comment xml:lang="en">[Common Weakness Enumeration](https://csrc.nist.gov/glossary/term/common_weakness_enumeration). A reference to a source of software flaws defined within the official [CWE List](https://cwe.mitre.org/data/) that conforms to the [CWE specification](https://cwe.mitre.org/).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/hasDeletedFile">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>hasDeletedFile</rdfs:label>
    <rdfs:comment xml:lang="en">Every `to` Element is a file deleted from the `from` Element (`from` hasDeletedFile `to`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/hasExample">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>hasExample</rdfs:label>
    <rdfs:comment xml:lang="en">Every `to` Element is an example for the `from` Element (`from` hasExample `to`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/AI/SafetyRiskAssessmentType/low">
