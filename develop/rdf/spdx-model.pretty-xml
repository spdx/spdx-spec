            <sh:hasValue rdf:resource="https://spdx.org/rdf/3/terms/SupplyChain/CreateAction"/>
          </rdf:Description>
        </sh:not>
        <sh:message xml:lang="en">https://spdx.org/rdf/3/terms/SupplyChain/CreateAction is an abstract class and should not be instantiated directly. Instantiate a subclass instead.</sh:message>
      </rdf:Description>
