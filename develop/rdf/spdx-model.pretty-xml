      <rdf:Description rdf:nodeID="Nd4628afdc10444c1b4a838470208f18b">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/SimpleLicensing/licenseText"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType/log">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType"/>
    <rdfs:label>log</rdfs:label>
    <rdfs:comment xml:lang="en">Time-stamped records capturing system or operational data recorded as usually as a response to specific triggers in a specified environment.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Core/Role">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">A Role defines a specific position, function, or capacity that an entity may assume within any relevant context.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/Core/Element"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N074c82784a954bd5aa3a0e75ab57020c">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/referenceSpecification"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/DefinedType"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N1a32cb4709ff4efb94e5afe958aa126d">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/roleQualification"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/Requirement"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nd4ce729ba48246279b4d6e1f173a2ae4">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/authorization"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N0b0b0174c36a413d9ecbeee2f513d02c">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/responsibility"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/Requirement"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ProfileIdentifierType/build">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ProfileIdentifierType"/>
    <rdfs:label>build</rdfs:label>
    <rdfs:comment xml:lang="en">The element follows the Build profile specification.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/ExpandedLicensing/seeAlso">
    <rdfs:comment xml:lang="en">Contains a URL where the License or LicenseAddition can be found in use.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Security/VexFixedVulnAssessmentRelationship">
    <rdfs:comment xml:lang="en">Links a vulnerability and elements representing products (in the VEX sense) where
a fix has been applied and are no longer affected.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/Security/VexVulnAssessmentRelationship"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/hasConcludedLicense">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>hasConcludedLicense</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Artifact is concluded by the SPDX data creator to be governed by each `to` /SimpleLicensing/AnyLicenseInfo. If the `to` of an Artifact's `hasConcludedLicense` is not the same as the `to` of its `hasDeclaredLicense`, a written explanation should be provided in the comment field of the `hasConcludedLicense` relationship.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Dataset/ConfidentialityLevelType/green">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Dataset/ConfidentialityLevelType"/>
    <rdfs:label>green</rdfs:label>
    <rdfs:comment xml:lang="en">Community wide. The dataset shall be shared only within a community of peers and partners.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/responsibilityCategory">
    <rdfs:comment xml:lang="en">responsibilityCategory classifies the nature or domain of a responsibility transfer.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/SupplyChain/ResponsibilityType"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/modifiedBy">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>modifiedBy</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element is modified by each `to` Element.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/altWebPage">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>altWebPage</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to an alternative web page.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/SpecificationType/specification">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/SpecificationType"/>
    <rdfs:label>specification</rdfs:label>
    <rdfs:comment xml:lang="en">A specification is a detailed document (or set of documents) that describes the requirements, design, behavior, or other characteristics of a system, component, or process so that all stakeholders have a clear, unambiguous reference.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/hasVariant">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>hasVariant</rdfs:label>
    <rdfs:comment xml:lang="en">Every `to` Element is a variant the `from` Element (`from` hasVariant `to`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isan">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>isan</rdfs:label>
    <rdfs:comment xml:lang="en">[International Standard Audiovisual Number (ISAN)](https://www.isan.org/about/#what_is_isan) is a unique 24-digit hexadecimal identifier for audiovisual works standardized by [ISO 15706](https://www.iso.org/standard/83124.html). The ISAN remains persistent for a work regardless of its distribution format or its use. To facilitate human readability, the "ISAN" label, grouping hyphens, and two check characters are included (e.g., `ISAN 0000-0000-3A8D-0000-Z-0000-0000-6`); however, these elements shall be omitted when the identifier is stored electronically (e.g., `000000003A8D000000000000`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/binaryArtifact">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>binaryArtifact</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to binary artifacts related to a package.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel">
    <rdfs:comment xml:lang="en">Defines the level of automation a system possesses.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/StorageAction">
    <rdfs:comment xml:lang="en">Records the storage of a product.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/SupplyChain/ModifyAction"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Security/locator">
    <rdfs:comment xml:lang="en">Provides the location of an exploit catalog.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/AnnotationType/other">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/AnnotationType"/>
    <rdfs:label>other</rdfs:label>
    <rdfs:comment xml:lang="en">Used to store extra information about an Element which is not part of a review (e.g. extra information provided during the creation of the Element).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType">
    <rdfs:comment xml:lang="en">Specifies the type of an external identifier.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Core/geographicPointLocation">
    <rdfs:comment xml:lang="en">A set of geographic point location coordinates.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/vulnerabilityExploitabilityAssessment">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>vulnerabilityExploitabilityAssessment</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to a Vulnerability Exploitability eXchange (VEX) statement which provides information on whether a product is impacted by a specific vulnerability in an included package and, if affected, whether there are actions recommended to remediate. See also [NTIA VEX one-page summary](https://ntia.gov/files/ntia/publications/vex_one-page_summary.pdf).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/delegatedTo">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>delegatedTo</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Agent is delegating an action to the Agent of the `to` Relationship (which shall be of type invokedBy), during a LifecycleScopeType period (e.g. the `to` invokedBy Relationship is being done on behalf of `from`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/AI/interactionTemplateString">
    <rdfs:comment xml:lang="en">A string containing the template format used to structure interactions with the AI model.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Dataset/knownBias">
    <rdfs:comment xml:lang="en">Records the biases that the dataset is known to encompass.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/republishedBy">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>republishedBy</rdfs:label>
    <rdfs:comment xml:lang="en">Designates a `from` /Security/Vulnerability's details were tracked, aggregated, and/or enriched to improve context (i.e. NVD) by each `to` Agent.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/StateProcess">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">This process is used to determine the state of an affected Element.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/SupplyChain/UseProcess"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="Nece7d023815f487390646f8e78b2973a">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/SupplyChain/validState"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/SupplyChain/State"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:Class rdf:about="https://spdx.org/rdf/3/terms/Core/Action">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">Class that describes an action that has occurred.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3/terms/Core/Artifact"/>
    <sh:property>
      <rdf:Description rdf:nodeID="Nf2abd2091b3a44dc911dd6fbd497fe96">
        <sh:path rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <sh:not>
          <rdf:Description rdf:nodeID="Nbf2f3c92f6d0420aacf1cef5a1bce743">
            <sh:hasValue rdf:resource="https://spdx.org/rdf/3/terms/Core/Action"/>
          </rdf:Description>
        </sh:not>
        <sh:message xml:lang="en">https://spdx.org/rdf/3/terms/Core/Action is an abstract class and should not be instantiated directly. Instantiate a subclass instead.</sh:message>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N9cfa407b3e444e7da070e5abeb2fb25a">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/actionLocation"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/Location"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N9b0d118363a24fce81bc3e28e7a29111">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/additionalInformation"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Core/DictionaryEntry"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N7caf7f6e61a94c1484e22e7a3609e022">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/endTime"/>
        <sh:pattern>^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T(([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]|23:59:60)Z$</sh:pattern>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N5850a4fd472548ffbbaca71d66e40dd0">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Core/startTime"/>
        <sh:pattern>^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T(([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]|23:59:60)Z$</sh:pattern>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/support">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>support</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to the software support channel or other support information for a package.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/Security/actionStatement">
    <rdfs:comment xml:lang="en">Provides advise on how to mitigate or remediate a vulnerability when a VEX product
is affected by it.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/altDownloadLocation">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>altDownloadLocation</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to an alternative download location.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/LifecycleScopeType/decommission">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/LifecycleScopeType"/>
    <rdfs:label>decommission</rdfs:label>
    <rdfs:comment xml:lang="en">A relationship has specific context implications for a product's retirement and/or decommissioning.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/FunctionalSafety/SafetyIntegrityLevelType/dalB">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/FunctionalSafety/SafetyIntegrityLevelType"/>
    <rdfs:label>dalB</rdfs:label>
    <rdfs:comment xml:lang="en">Design Assurance Level B for aviation software assurance.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/mavenCentral">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>mavenCentral</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to a Maven repository artifact. The artifact locator format is defined in the [Maven documentation](https://maven.apache.org/guides/mini/guide-naming-conventions.html) and looks like `groupId:artifactId[:version]`.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/gtin">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>gtin</rdfs:label>
    <rdfs:comment xml:lang="en">[Global Trade Item Number (GTIN)](https://www.gs1.org/standards/id-keys/gtin) is a number, assigned by GS1, that uniquely identifies a trade item (product or service).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/tracedToDetail">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>tracedToDetail</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Requirement is refined and further elaborated by each `to` Requirement, which contains more detailed implementation information.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Software/SbomType/analyzed">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Software/SbomType"/>
    <rdfs:label>analyzed</rdfs:label>
    <rdfs:comment xml:lang="en">SBOM generated through analysis of artifacts (e.g., executables, packages, containers, and virtual machine images) after its build. Such analysis generally requires a variety of heuristics. In some contexts, this may also be referred to as a "3rd party" SBOM.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/securityThreatModel">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>securityThreatModel</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to the [security threat model](https://en.wikipedia.org/wiki/Threat_model) for the package.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/deviceDriver">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Software/SoftwarePurpose"/>
    <rdfs:label>deviceDriver</rdfs:label>
    <rdfs:comment xml:lang="en">The Element represents software that controls hardware devices.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Dataset/DatasetType/structured">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Dataset/DatasetType"/>
    <rdfs:label>structured</rdfs:label>
    <rdfs:comment xml:lang="en">Data is stored in tabular format or retrieved from a relational database.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/Core/externalRefType">
    <rdfs:comment xml:lang="en">Specifies the type of the external reference.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
  </owl:ObjectProperty>
