        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N29d58b0f2ab047c3856d1529efb97518">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/ExpandedLicensing/licenseXml"/>
