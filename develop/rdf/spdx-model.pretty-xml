        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N7ffb2d360b3a4d3f883daa6d76123068">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/SimpleLicensing/customIdToUri"/>
