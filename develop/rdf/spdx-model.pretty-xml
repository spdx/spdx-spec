    <rdfs:label>hasAddedFile</rdfs:label>
    <rdfs:comment xml:lang="en">Every `to` Element is a file added to the `from` Element (`from` hasAddedFile `to`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/hasStaticLink">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>hasStaticLink</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element statically links in each `to` Element, during a LifecycleScopeType period.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3/terms/AI/typeOfModel">
    <rdfs:comment xml:lang="en">Type of the model used in the AI software.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
