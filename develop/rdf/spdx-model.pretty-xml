  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/HashAlgorithm/sha3_384">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/HashAlgorithm"/>
    <rdfs:label>sha3_384</rdfs:label>
