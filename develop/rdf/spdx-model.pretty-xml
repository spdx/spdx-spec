      <rdf:Description rdf:nodeID="N17991dd20a1f4153bd1bc216d64b28ff">
        <sh:path rdf:resource="https://spdx.org/rdf/3/terms/Software/contentIdentifierType"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3/terms/Software/ContentIdentifierType"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
