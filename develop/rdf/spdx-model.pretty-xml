  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3/terms/SupplyChain/plannedCurrentResponsibleAgent">
    <rdfs:comment xml:lang="en">This is the planned individual, business, or organization who currently manages or responsible for the goods, services, or assets.</rdfs:comment>
