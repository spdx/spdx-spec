    <rdfs:label>hasMetadata</rdfs:label>
    <rdfs:comment xml:lang="en">Every `to` Element is metadata about the `from` Element (`from` hasMetadata `to`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/hasTest">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/RelationshipType"/>
    <rdfs:label>hasTest</rdfs:label>
    <rdfs:comment xml:lang="en">Every `to` Element is a test artifact for the `from` Element (`from` hasTest `to`), during a LifecycleScopeType period.</rdfs:comment>
  </owl:NamedIndividual>
