  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/vatNumber">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>vatNumber</rdfs:label>
    <rdfs:comment xml:lang="en">Value Added Tax (VAT) number, or Goods and Services Tax (GST) number, is an identifier assigned by tax authorities that uniquely identifies a business within a specific national border or tax jurisdiction for the collection and tracking of VAT/GST.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/RelationshipType/describes">
