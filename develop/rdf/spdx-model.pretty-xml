  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/nli">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>nli</rdfs:label>
    <rdfs:comment xml:lang="en">[Natural Location Identifier (NLI)](https://eccma.org/enli-eccma-natural-location-identifier/) is a 14- or 15-character alphanumeric string standardized by [ISO 8000-118](https://www.iso.org/standard/85428.html) that uniquely identifies a three-dimensional geographic point location. The identifier is generated from geodetic coordinates and elevation data. For electronic storage, the `ISO.NLI:` prefix shall be retained (e.g., `ISO.NLI:41TS8M-A8ELTQ-H2`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ExternalRefType/secureSoftwareAttestation">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ExternalRefType"/>
    <rdfs:label>secureSoftwareAttestation</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to information assuring that the software is developed using security practices as defined by [NIST SP 800-218 Secure Software Development Framework (SSDF) Version 1.1](https://csrc.nist.gov/pubs/sp/800/218/final) or [CISA Secure Software Development Attestation Form](https://www.cisa.gov/resources-tools/resources/secure-software-development-attestation-form).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3/terms/Core/ProfileIdentifierType/supplyChain">
    <rdf:type rdf:resource="https://spdx.org/rdf/3/terms/Core/ProfileIdentifierType"/>
    <rdfs:label>supplyChain</rdfs:label>
