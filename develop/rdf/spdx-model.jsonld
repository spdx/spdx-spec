      {
        "@language": "en",
        "@value": "The element follows the Service profile specification."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "service"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType/design",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A relationship has specific context implications during an element's design."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "design"
      }
    ]
  },
  {
