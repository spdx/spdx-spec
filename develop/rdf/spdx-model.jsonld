        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/republishedBy> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }\n}"
