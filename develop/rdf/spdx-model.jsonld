  {
    "@id": "https://spdx.org/rdf/3/terms/Core/SupportType/noAssertion",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/SupportType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "No assertion about the type of support is made. This is considered the default if no other support type is used."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "noAssertion"
      }
    ]
  },
