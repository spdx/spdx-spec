  },
  {
    "@id": "_:Nf927a813e2b3491fb395ae232aae5305",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "At least one of Core/country, Core/city, Core/streetAddress, Core/geographicPointLocation, or Core/name is required"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    FILTER NOT EXISTS { $this <Core/country> ?country . }\n    FILTER NOT EXISTS { $this <Core/city> ?city . }\n    FILTER NOT EXISTS { $this <Core/streetAddress> ?streetAddress . }\n    FILTER NOT EXISTS { $this <Core/geographicPointLocation> ?point . }\n    FILTER NOT EXISTS { $this <Core/name> ?name . }\n}"
      }
    ]
  },
