      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "releaseNotes"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/ExpandedLicensing/subjectAddition",
