    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A contact point for support."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "support"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Security/statusNotes",
