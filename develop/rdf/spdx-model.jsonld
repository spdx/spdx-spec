  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/isbn",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "[International Standard Book Number (ISBN)](https://www.isbn-international.org/content/isbn-users-manual/29) is a unique numeric identifier for monographic publications standardized by [ISO 2108](https://www.iso.org/standard/65483.html). It consists of either 10 digits (for assignments prior to January 1, 2007) or 13 digits. A 13-digit ISBN is composed of five parts: a GS1 prefix, a registration group, a registrant, a publication element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., `9780198836063`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "isbn"
      }
    ]
  },
