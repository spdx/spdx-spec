# https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/x509Cert node729
node729 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>x509Cert</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/x509Cert' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/x509Cert</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A reference to an X.509 certificate as defined in [RFC 1422](https://datatracker.ietf.org/doc/rfc1422/). The media type shall be one of application/x-x509-ca-cert or application/x-x509-user-cert.&quot;@en</td></tr></table> > ] 
