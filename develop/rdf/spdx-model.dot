node1477 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N277f2c36cc5a4df5aa5d12d276d636fe</B></td></tr><tr><td href='N277f2c36cc5a4df5aa5d12d276d636fe' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N277f2c36cc5a4df5aa5d12d276d636fe</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is affects, from must be a Vulnerability, Action, or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
