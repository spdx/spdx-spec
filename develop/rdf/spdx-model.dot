node665 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>specification</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/SpecificationType/specification' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/SpecificationType/specification</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A specification is a detailed document (or set of documents) that describes the requirements, design, behavior, or other characteristics of a system, component, or process so that all stakeholders have a clear, unambiguous reference.&quot;@en</td></tr></table> > ] 
