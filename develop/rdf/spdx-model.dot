# https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/swhid node1294
node1294 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>swhid</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/swhid' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/swhid</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;SoftWare Hash IDentifier, a persistent intrinsic identifier for digital artifacts, such as files, trees (also known as directories or folders), commits, and other objects typically found in version control systems. The format of the identifiers is defined in the [SWHID specification](https://www.swhid.org/swhid-specification/v1.2/) ([ISO/IEC 18670](https://www.iso.org/standard/89985.html)). They typically look like `swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2`.&quot;@en</td></tr></table> > ] 
# N83cce6a6b3e14c209cf8fac73bd6261e node1295
node1295 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N83cce6a6b3e14c209cf8fac73bd6261e</B></td></tr><tr><td href='N83cce6a6b3e14c209cf8fac73bd6261e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N83cce6a6b3e14c209cf8fac73bd6261e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasHost, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasHost&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
