node1345 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>diskImage</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/diskImage' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/diskImage</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The Element refers to a disk image that can be written to a disk, booted in a VM, etc. A disk image typically contains most or all of the components necessary to boot, such as bootloaders, kernels, firmware, userspace, etc.&quot;@en</td></tr></table> > ] 
