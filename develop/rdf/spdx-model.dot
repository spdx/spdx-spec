node255 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>reportedBy</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipType/reportedBy' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipType/reportedBy</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Designates a `from` /Security/Vulnerability was first reported to a project, vendor, or tracking database for formal identification by each `to` Agent.&quot;@en</td></tr></table> > ] 
