# Nae54d624e01143c59a8479b2bd368754 node1040
node1040 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nae54d624e01143c59a8479b2bd368754</B></td></tr><tr><td href='Nae54d624e01143c59a8479b2bd368754' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nae54d624e01143c59a8479b2bd368754</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, from must be an Action or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
