# Nf4af7568c2b44a92bfdaaaeb401bdfc3 node1798
node1798 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf4af7568c2b44a92bfdaaaeb401bdfc3</B></td></tr><tr><td href='Nf4af7568c2b44a92bfdaaaeb401bdfc3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf4af7568c2b44a92bfdaaaeb401bdfc3</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is doesNotAffect, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/doesNotAffect&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
