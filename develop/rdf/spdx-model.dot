node460 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>specVersion</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/specVersion' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/specVersion</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Provides a reference number that can be used to understand how to parse and
interpret an Element.&quot;@en</td></tr></table> > ] 
