# N6150870298b247f2b95afcd7e0c69eb6 node1596
node1596 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N6150870298b247f2b95afcd7e0c69eb6</B></td></tr><tr><td href='N6150870298b247f2b95afcd7e0c69eb6' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N6150870298b247f2b95afcd7e0c69eb6</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is tracedToDetail, to must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/tracedToDetail&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
