# Nd30ec0987bd64a8c815ce2993cbcfdd3 node15
node15 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nd30ec0987bd64a8c815ce2993cbcfdd3</B></td></tr><tr><td href='Nd30ec0987bd64a8c815ce2993cbcfdd3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nd30ec0987bd64a8c815ce2993cbcfdd3</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasContactPoint, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasContactPoint&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
