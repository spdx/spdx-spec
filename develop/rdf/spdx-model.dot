# Nc5ff0cd983b6429988fd87e697f70001 node1077
node1077 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nc5ff0cd983b6429988fd87e697f70001</B></td></tr><tr><td href='Nc5ff0cd983b6429988fd87e697f70001' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nc5ff0cd983b6429988fd87e697f70001</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is doesNotAffect, class must be VexNotAffectedVulnAssessmentRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/doesNotAffect&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Security/VexNotAffectedVulnAssessmentRelationship&gt; }
}&quot;</td></tr></table> > ] 
