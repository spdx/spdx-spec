# N69e6216e1e91477490d0b5be8a4ef144 node1553
node1553 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N69e6216e1e91477490d0b5be8a4ef144</B></td></tr><tr><td href='N69e6216e1e91477490d0b5be8a4ef144' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N69e6216e1e91477490d0b5be8a4ef144</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
