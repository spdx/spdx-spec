# N4944c0e892054b67a42e6cf2d70632e0 node1369
node1369 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N4944c0e892054b67a42e6cf2d70632e0</B></td></tr><tr><td href='N4944c0e892054b67a42e6cf2d70632e0' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N4944c0e892054b67a42e6cf2d70632e0</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is invokedBy, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
