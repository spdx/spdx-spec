# Nbb77d4d6810f4a909b6c9938cdefd547 node1715
node1715 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nbb77d4d6810f4a909b6c9938cdefd547</B></td></tr><tr><td href='Nbb77d4d6810f4a909b6c9938cdefd547' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nbb77d4d6810f4a909b6c9938cdefd547</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is tracedToDetail, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
