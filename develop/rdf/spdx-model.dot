# N26b6af0732924988b287f9eb79f2ecf3 node15
node15 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N26b6af0732924988b287f9eb79f2ecf3</B></td></tr><tr><td href='N26b6af0732924988b287f9eb79f2ecf3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N26b6af0732924988b287f9eb79f2ecf3</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasAssociatedVulnerability, to must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasAssociatedVulnerability&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
