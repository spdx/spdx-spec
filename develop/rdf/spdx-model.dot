node922 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N2fbb750f422b4597b456b7e029390530</B></td></tr><tr><td href='N2fbb750f422b4597b456b7e029390530' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N2fbb750f422b4597b456b7e029390530</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:pattern</td><td align='left'>&quot;^[^\/]+\/[^\/]+$&quot;</td></tr></table> > ] 
