# Nd3384dbcfc7348bba8f8a8433c70ab56 node1039
node1039 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nd3384dbcfc7348bba8f8a8433c70ab56</B></td></tr><tr><td href='Nd3384dbcfc7348bba8f8a8433c70ab56' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nd3384dbcfc7348bba8f8a8433c70ab56</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is invokedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
