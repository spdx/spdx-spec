node912 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>fixedIn</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipType/fixedIn' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipType/fixedIn</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A `from` /Security/Vulnerability has been fixed in each `to` Element. The use of the `fixedIn` type is constrained to `/Security/VexFixedVulnAssessmentRelationship` classed relationships.&quot;@en</td></tr></table> > ] 
