node1242 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>decisionProcess</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/SupplyChain/decisionProcess' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/SupplyChain/decisionProcess</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;This is how the currentState of an affected Element is found.&quot;@en</td></tr></table> > ] 
