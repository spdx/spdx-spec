# N6a47c18d6935450681e0ec7f2bfd5398 node1106
node1106 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N6a47c18d6935450681e0ec7f2bfd5398</B></td></tr><tr><td href='N6a47c18d6935450681e0ec7f2bfd5398' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N6a47c18d6935450681e0ec7f2bfd5398</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/fixedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
