# N10890e26f6db44dea1237081dc60b5c0 node937
node937 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N10890e26f6db44dea1237081dc60b5c0</B></td></tr><tr><td href='N10890e26f6db44dea1237081dc60b5c0' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N10890e26f6db44dea1237081dc60b5c0</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasHost, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasHost&gt; .
