node764 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>creationInfo_NoneLicense</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/creationInfo_NoneLicense' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/creationInfo_NoneLicense</font></td></tr><tr><td align='left'>ns1:created</td><td align='left'>&quot;2026-01-23T03:01:00Z&quot;^^xsd:dateTimeStamp</td></tr><tr><td align='left'>ns1:specVersion</td><td align='left'>&quot;3.1&quot;</td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;This individual element was defined by the spec.&quot;@en</td></tr></table> > ] 
