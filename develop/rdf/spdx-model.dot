# Nab773b2cc5664c0ea13c3bb8f4dd5e09 node2040
node2040 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nab773b2cc5664c0ea13c3bb8f4dd5e09</B></td></tr><tr><td href='Nab773b2cc5664c0ea13c3bb8f4dd5e09' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nab773b2cc5664c0ea13c3bb8f4dd5e09</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is foundBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/foundBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
