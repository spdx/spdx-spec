# Ne706658d2d764fa9ad7e7c3658116cfb node1659
node1659 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne706658d2d764fa9ad7e7c3658116cfb</B></td></tr><tr><td href='Ne706658d2d764fa9ad7e7c3658116cfb' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne706658d2d764fa9ad7e7c3658116cfb</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is performedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/performedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
