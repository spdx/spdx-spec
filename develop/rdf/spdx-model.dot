# https://spdx.org/rdf/3/terms/ node138
node138 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>System Package Data Exchange™ (SPDX®) Ontology</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/</font></td></tr><tr><td align='left'>dcterms:abstract</td><td align='left'>&quot;This ontology defines the terms and relationships used in the SPDX specification to describe system packages&quot;@en</td></tr><tr><td align='left'>dcterms:created</td><td align='left'>&quot;2026-01-23&quot;^^xsd:date</td></tr><tr><td align='left'>dcterms:creator</td><td align='left'>&quot;SPDX Project&quot;@en</td></tr><tr><td align='left'>dcterms:title</td><td align='left'>&quot;System Package Data Exchange (SPDX) Ontology&quot;@en</td></tr><tr><td align='left'>omg-ann:copyright</td><td align='left'>&quot;Copyright (C) 2026 SPDX Project&quot;@en</td></tr></table> > ] 
# Nbef1debf22f54d28a0334ac287187d62 node139
node139 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nbef1debf22f54d28a0334ac287187d62</B></td></tr><tr><td href='Nbef1debf22f54d28a0334ac287187d62' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nbef1debf22f54d28a0334ac287187d62</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/delegatedTo&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
# N755f201278c047afae045fb02f4d4c4e node140
node140 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N755f201278c047afae045fb02f4d4c4e</B></td></tr><tr><td href='N755f201278c047afae045fb02f4d4c4e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N755f201278c047afae045fb02f4d4c4e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, to must be a Relationship whose relationshipType is invokedBy&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/delegatedTo&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS {
        ?to rdf:type/rdfs:subClassOf* &lt;Core/Relationship&gt; .
        ?to &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    }
}&quot;</td></tr></table> > ] 
