        "@value": "A reference to the mailing list used by the maintainer for a package."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "mailingList"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Security/impactStatement",
