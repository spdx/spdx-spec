    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Availability of a dataset."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/prefix",
