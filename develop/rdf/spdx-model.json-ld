    "http://www.w3.org/ns/shacl#path": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/elementValue"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/PresenceType/yes",
    "@type": [
