        "@value": "[MD6 hash function](https://people.csail.mit.edu/rivest/pubs/RABCx08.pdf)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "md6"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Operations/exportingCountry",
    "@type": [
