  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ProcessReadinessType/obsoleted",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ProcessReadinessType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
