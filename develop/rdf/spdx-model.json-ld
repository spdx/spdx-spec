  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Security/VexFixedVulnAssessmentRelationship",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links a vulnerability and elements representing products (in the VEX sense) where\na fix has been applied and are no longer affected."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Security/VexVulnAssessmentRelationship"
      }
    ],
