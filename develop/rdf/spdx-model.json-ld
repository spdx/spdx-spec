    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Unlimited. Subject to standard copyright rules, the dataset may be shared freely, without restriction."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "clear"
      }
    ]
  },
  {
