    <https://spdx.org/rdf/3.0/terms/Core/ExternalRefType/securityOther> a owl:NamedIndividual,
            ns2:ExternalRefType ;
        rdfs:label "securityOther" ;
        rdfs:comment "A reference to related security information of unspecified type."@en .

    <https://spdx.org/rdf/3.0/terms/Core/ExternalRefType/securityPenTestReport> a owl:NamedIndividual,
            ns2:ExternalRefType ;
