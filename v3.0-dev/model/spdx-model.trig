            ns6:CvssSeverityType ;
        rdfs:label "critical" ;
        rdfs:comment "When a CVSS score is between 9.0 - 10.0."@en .

    <https://spdx.org/rdf/3.0/terms/Security/CvssSeverityType/high> a owl:NamedIndividual,
            ns6:CvssSeverityType ;
        rdfs:label "high" ;
        rdfs:comment "When a CVSS score is between 7.0 - 8.9."@en .

    <https://spdx.org/rdf/3.0/terms/Security/CvssSeverityType/low> a owl:NamedIndividual,
            ns6:CvssSeverityType ;
        rdfs:label "low" ;
        rdfs:comment "When a CVSS score is between 0.1 - 3.9."@en .

    <https://spdx.org/rdf/3.0/terms/Security/CvssSeverityType/medium> a owl:NamedIndividual,
            ns6:CvssSeverityType ;
        rdfs:label "medium" ;
        rdfs:comment "When a CVSS score is between 4.0 - 6.9."@en .

    <https://spdx.org/rdf/3.0/terms/Security/CvssSeverityType/none> a owl:NamedIndividual,
            ns6:CvssSeverityType ;
        rdfs:label "none" ;
        rdfs:comment "When a CVSS score is 0.0."@en .

