["_:Nfc17f9ae07964372a91cb362cad4e083", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/hasUninstall> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Artifact> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["_:Nbfe8de277e2c46978f2b545d33d8df6e", "http://www.w3.org/ns/shacl#message", "When relationship is republishedBy, to must be an Agent", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3/terms/Build/buildEndTime", "http://www.w3.org/2000/01/rdf-schema#range", "http://www.w3.org/2001/XMLSchema#dateTimeStamp", "globalId", "", ""]
["_:Na8331782f47f4ba08fa6da3e4ff27f58", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/conformsTo> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <FunctionalSafety/Assumption> }\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Specification> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
