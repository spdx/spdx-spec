["_:N44fa5eecd7cb4737abc52eb7bfc4d021", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/republishedBy> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
