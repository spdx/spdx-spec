["https://spdx.org/rdf/3.1/terms/SupplyChain/ModifyAction", "http://www.w3.org/2000/01/rdf-schema#comment", "An actual alteration of a product.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
