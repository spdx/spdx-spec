["_:Ncde48ea16a5f4702a9beafe3231181e1", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Core/RelationshipType/hasRequirement", "globalId", "", ""]
