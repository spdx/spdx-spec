["https://spdx.org/rdf/3.1/terms/SupplyChain/current", "http://www.w3.org/2000/01/rdf-schema#comment", "This is the individual, business, or organization who currently manages goods, services, or assets.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
