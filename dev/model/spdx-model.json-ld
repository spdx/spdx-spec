    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Specifies the type of the external identifier."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/ExpandedLicensing/standardLicenseHeader",
