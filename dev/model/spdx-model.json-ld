    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Specifies the CVSS qualitative severity rating of a vulnerability in relation to a piece of software."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Security/CvssSeverityType"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/FunctionalSafety/verificationUUID",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A verificationUUID is a universally unique identifier (UUID) assigned to a Verification item."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifier"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/postOfficeBoxNumber",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The number that identifies a PO box. A PO box is a box in a post office or other postal service location assigned to an organization where postal items may be kept."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Hardware/category",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The category describes the hardware item in a DefinedType."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/DefinedType"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/operations",
