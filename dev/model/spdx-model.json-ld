    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "sha3_256"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Security/VexJustificationType/vulnerableCodeCannotBeControlledByAdversary",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
