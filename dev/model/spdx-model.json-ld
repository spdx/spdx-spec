    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Every `to` Element is metadata about the `from` Element (`from` hasMetadata `to`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
