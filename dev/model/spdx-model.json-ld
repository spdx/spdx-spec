    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An element of hardware and/or software utilized to carry out a particular function."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
