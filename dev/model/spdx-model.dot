# Nd6383df49ddf4434b7cf10e73a360735 node660
node660 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nd6383df49ddf4434b7cf10e73a360735</B></td></tr><tr><td href='Nd6383df49ddf4434b7cf10e73a360735' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nd6383df49ddf4434b7cf10e73a360735</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is tracedToDetail, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
