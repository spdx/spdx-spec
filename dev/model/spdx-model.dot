node2 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>endTime</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/endTime' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/endTime</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The point in time when an element or an action ends,
becomes no longer applicable, or becomes no longer valid.&quot;@en</td></tr></table> > ] 
# Nedf7487a748744e19e02208fdd6b81a9 node3
node3 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nedf7487a748744e19e02208fdd6b81a9</B></td></tr><tr><td href='Nedf7487a748744e19e02208fdd6b81a9' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nedf7487a748744e19e02208fdd6b81a9</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is providesSupportFor, from must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/providesSupportFor&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
# Nd0c7239d8c92420aa147b1d4204a0825 node4
node4 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nd0c7239d8c92420aa147b1d4204a0825</B></td></tr><tr><td href='Nd0c7239d8c92420aa147b1d4204a0825' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nd0c7239d8c92420aa147b1d4204a0825</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is invokedBy, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
