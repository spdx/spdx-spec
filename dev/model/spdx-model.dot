# N0690aa2fce5d436c9aad09a77599fbb9 node1500
node1500 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N0690aa2fce5d436c9aad09a77599fbb9</B></td></tr><tr><td href='N0690aa2fce5d436c9aad09a77599fbb9' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N0690aa2fce5d436c9aad09a77599fbb9</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;At least one of Core/country, Core/city, Core/streetAddress, Core/geographicPointLocation, or Core/name is required&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    FILTER NOT EXISTS { $this &lt;Core/country&gt; ?country . }
    FILTER NOT EXISTS { $this &lt;Core/city&gt; ?city . }
    FILTER NOT EXISTS { $this &lt;Core/streetAddress&gt; ?streetAddress . }
    FILTER NOT EXISTS { $this &lt;Core/geographicPointLocation&gt; ?point . }
    FILTER NOT EXISTS { $this &lt;Core/name&gt; ?name . }
}&quot;</td></tr></table> > ] 
