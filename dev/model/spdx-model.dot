# Ndb0d408283894776a09790cddd568e6a node1798
node1798 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ndb0d408283894776a09790cddd568e6a</B></td></tr><tr><td href='Ndb0d408283894776a09790cddd568e6a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ndb0d408283894776a09790cddd568e6a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, to must be a Relationship whose relationshipType is invokedBy&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
