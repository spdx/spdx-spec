# Ncb7e4617a2714a3bb094c820b321b88d node940
node940 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ncb7e4617a2714a3bb094c820b321b88d</B></td></tr><tr><td href='Ncb7e4617a2714a3bb094c820b321b88d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ncb7e4617a2714a3bb094c820b321b88d</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasResolution, to must be an OutOfSpecAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasResolution&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;SupplyChain/OutOfSpecAction&gt; }
