# Nead9d89b53464c2bb81ad66dbd29f537 node1614
node1614 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nead9d89b53464c2bb81ad66dbd29f537</B></td></tr><tr><td href='Nead9d89b53464c2bb81ad66dbd29f537' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nead9d89b53464c2bb81ad66dbd29f537</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;A value for Core/name is required when a value for Core/version is present&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
