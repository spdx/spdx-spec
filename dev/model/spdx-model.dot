# N3a447454063a436da0afe475a6d9e6de node1409
node1409 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N3a447454063a436da0afe475a6d9e6de</B></td></tr><tr><td href='N3a447454063a436da0afe475a6d9e6de' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N3a447454063a436da0afe475a6d9e6de</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/delegatedTo&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
