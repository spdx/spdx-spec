node1228 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N752be38db32c4fe19c8d2eb965af1acb</B></td></tr><tr><td href='N752be38db32c4fe19c8d2eb965af1acb' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N752be38db32c4fe19c8d2eb965af1acb</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:pattern</td><td align='left'>&quot;^[A-Z]{3}$&quot;</td></tr></table> > ] 
