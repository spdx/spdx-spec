# Nb12345e9389248c19d3ee822b9eb658c node1411
node1411 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb12345e9389248c19d3ee822b9eb658c</B></td></tr><tr><td href='Nb12345e9389248c19d3ee822b9eb658c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb12345e9389248c19d3ee822b9eb658c</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is reportedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
