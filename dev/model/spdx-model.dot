node847 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N5053f1583f174ed783a234cbe0b3b704</B></td></tr><tr><td href='N5053f1583f174ed783a234cbe0b3b704' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N5053f1583f174ed783a234cbe0b3b704</font></td></tr></table> > ] 
