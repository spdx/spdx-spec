# N1cbccb24a6bd436e949b075c909f96f3 node1363
node1363 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N1cbccb24a6bd436e949b075c909f96f3</B></td></tr><tr><td href='N1cbccb24a6bd436e949b075c909f96f3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N1cbccb24a6bd436e949b075c909f96f3</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is underInvestigationFor, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/underInvestigationFor&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
