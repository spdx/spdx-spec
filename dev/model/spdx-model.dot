node1060 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>sensor</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Dataset/DatasetType/sensor' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Dataset/DatasetType/sensor</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Data is recorded from a physical sensor, such as a thermometer reading or biometric device.&quot;@en</td></tr></table> > ] 
