# N878906f5d0fb4b55a80be897ce6a23e2 node684
node684 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N878906f5d0fb4b55a80be897ce6a23e2</B></td></tr><tr><td href='N878906f5d0fb4b55a80be897ce6a23e2' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N878906f5d0fb4b55a80be897ce6a23e2</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is performedBy, from must be an Action&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/performedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
}&quot;</td></tr></table> > ] 
