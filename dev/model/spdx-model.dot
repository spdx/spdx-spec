# N89d933092ceb42b1b01ca1cb4113007a node1896
node1896 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N89d933092ceb42b1b01ca1cb4113007a</B></td></tr><tr><td href='N89d933092ceb42b1b01ca1cb4113007a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N89d933092ceb42b1b01ca1cb4113007a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedIn, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/fixedIn&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
