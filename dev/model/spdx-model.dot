node846 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ndca406caf0cc448aac4c5a74c54661e6</B></td></tr><tr><td href='Ndca406caf0cc448aac4c5a74c54661e6' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ndca406caf0cc448aac4c5a74c54661e6</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:minCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
