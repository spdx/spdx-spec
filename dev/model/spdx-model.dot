node301 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N0c16f58a96bd4d1b85f99b64783a4d00</B></td></tr><tr><td href='N0c16f58a96bd4d1b85f99b64783a4d00' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N0c16f58a96bd4d1b85f99b64783a4d00</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:minCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
