# N597c9d3c25c64ae4be5ac6f747797b4d node1372
node1372 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N597c9d3c25c64ae4be5ac6f747797b4d</B></td></tr><tr><td href='N597c9d3c25c64ae4be5ac6f747797b4d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N597c9d3c25c64ae4be5ac6f747797b4d</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is reportedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
