# N1d97ca658175471fae087ab30bdf2700 node1321
node1321 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N1d97ca658175471fae087ab30bdf2700</B></td></tr><tr><td href='N1d97ca658175471fae087ab30bdf2700' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N1d97ca658175471fae087ab30bdf2700</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/createdBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
# Na24ccbe6baf9401e91de635b361aa4b6 node1322
node1322 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na24ccbe6baf9401e91de635b361aa4b6</B></td></tr><tr><td href='Na24ccbe6baf9401e91de635b361aa4b6' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na24ccbe6baf9401e91de635b361aa4b6</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;A value for Core/name is required when a value for Core/version is present&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Software/version&gt; ?version .
    FILTER NOT EXISTS {
        $this &lt;Software/name&gt; ?name .
    }
}&quot;</td></tr></table> > ] 
