# Nf16c11e3714b4635986cfa9a7b2a398e node10
node10 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf16c11e3714b4635986cfa9a7b2a398e</B></td></tr><tr><td href='Nf16c11e3714b4635986cfa9a7b2a398e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf16c11e3714b4635986cfa9a7b2a398e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is reportedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/reportedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
