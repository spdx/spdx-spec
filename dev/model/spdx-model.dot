# N640a4a98fd0a40ccb97064e174d71409 node1948
node1948 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N640a4a98fd0a40ccb97064e174d71409</B></td></tr><tr><td href='N640a4a98fd0a40ccb97064e174d71409' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N640a4a98fd0a40ccb97064e174d71409</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is serializedInArtifact, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/serializedInArtifact&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Artifact&gt; }
}&quot;</td></tr></table> > ] 
