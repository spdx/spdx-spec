# N08151974fe344f32bc0a537286616a5a node709
node709 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N08151974fe344f32bc0a537286616a5a</B></td></tr><tr><td href='N08151974fe344f32bc0a537286616a5a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N08151974fe344f32bc0a537286616a5a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is resolved, from must be a ResolutionAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/resolved&gt; .
    $this &lt;Core/from&gt; ?from .
