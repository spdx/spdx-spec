node945 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>hyperparameter</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/AI/hyperparameter' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/AI/hyperparameter</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Hyperparameter used to build the AI model contained in the AI package.&quot;@en</td></tr></table> > ] 
