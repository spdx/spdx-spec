# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibrn node1320
node1320 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>ibrn</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibrn' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibrn</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;[International Business Registration Number (IBRN)](https://ekys.org/business_identifiers/) is a unique identifier for legal entities standardized by [ISO 8000-116](https://www.iso.org/standard/75117.html). It is composed of two parts: a jurisdiction prefix and a local authoritative legal entity identifier (ALEI), separated by a colon. The prefix contains an ISO 3166 country code, an optional subdivision code, and a register code (e.g., `US-DE.BER:3031657`).&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibid node1321
node1321 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>ibid</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibid' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibid</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;[International Business Identifier (IBID)](https://ekys.org/business_identifiers/) is a verifiable unique identifier for legal entities as defined in the [ISO/DIS 25500-3](https://www.iso.org/standard/87705.html) draft standard. It is composed of three data elements: the International Business Registration Number (IBRN), the legal name, and the date of origin formatted as eight numeric characters (YYYYMMDD). Each element is separated by a pipe character (`|`) (e.g., `US-DE.BER:3031657|Code Management Association|19990420`).&quot;@en</td></tr></table> > ] 
