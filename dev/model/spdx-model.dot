# Nd177ba0c3a1d4f7f88cc5075c8c5414e node1607
node1607 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nd177ba0c3a1d4f7f88cc5075c8c5414e</B></td></tr><tr><td href='Nd177ba0c3a1d4f7f88cc5075c8c5414e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nd177ba0c3a1d4f7f88cc5075c8c5414e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, to must be a Relationship whose relationshipType is invokedBy&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
