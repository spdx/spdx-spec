# Nc41082488c6c4ce295f76676b6ff4347 node844
node844 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nc41082488c6c4ce295f76676b6ff4347</B></td></tr><tr><td href='Nc41082488c6c4ce295f76676b6ff4347' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nc41082488c6c4ce295f76676b6ff4347</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is implementedBy, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/implementedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
