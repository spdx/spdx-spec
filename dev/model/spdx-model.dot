node1291 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>hasVariant</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipType/hasVariant' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipType/hasVariant</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Every `to` Element is a variant the `from` Element (`from` hasVariant `to`).&quot;@en</td></tr></table> > ] 
