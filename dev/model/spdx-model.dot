# N8f396a4d48c54c629ffaecd9b3314e58 node1212
node1212 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8f396a4d48c54c629ffaecd9b3314e58</B></td></tr><tr><td href='N8f396a4d48c54c629ffaecd9b3314e58' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8f396a4d48c54c629ffaecd9b3314e58</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is republishedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/republishedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ecli node1213
