# N61f4c01bfff04704b95ad6ed26e83f74 node1573
node1573 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N61f4c01bfff04704b95ad6ed26e83f74</B></td></tr><tr><td href='N61f4c01bfff04704b95ad6ed26e83f74' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N61f4c01bfff04704b95ad6ed26e83f74</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is configures, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/configures&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
