# Nbb1ebf47951247d6a1f1588cd89a6a68 node1288
node1288 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nbb1ebf47951247d6a1f1588cd89a6a68</B></td></tr><tr><td href='Nbb1ebf47951247d6a1f1588cd89a6a68' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nbb1ebf47951247d6a1f1588cd89a6a68</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is serializedInArtifact, from must be a SpdxDocument&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/serializedInArtifact&gt; .
    $this &lt;Core/from&gt; ?from .
