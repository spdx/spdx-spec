node533 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8a06fe1b380049e9b1ce48921c6daa34</B></td></tr><tr><td href='N8a06fe1b380049e9b1ce48921c6daa34' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8a06fe1b380049e9b1ce48921c6daa34</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:pattern</td><td align='left'>&quot;^[A-Z]{3}$&quot;</td></tr></table> > ] 
