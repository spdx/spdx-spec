# N84ed898e4f6f4fe9b32e75c7568711bd node586
node586 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N84ed898e4f6f4fe9b32e75c7568711bd</B></td></tr><tr><td href='N84ed898e4f6f4fe9b32e75c7568711bd' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N84ed898e4f6f4fe9b32e75c7568711bd</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/createdBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
