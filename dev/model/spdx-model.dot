# Na2cfc66e6ec2458aa3f42880c2388f97 node1084
node1084 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na2cfc66e6ec2458aa3f42880c2388f97</B></td></tr><tr><td href='Na2cfc66e6ec2458aa3f42880c2388f97' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na2cfc66e6ec2458aa3f42880c2388f97</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is assumes, to must be an Assumption&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/assumes&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;FunctionalSafety/Assumption&gt; }
}&quot;</td></tr></table> > ] 
