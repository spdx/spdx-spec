# Na269746d005d4ab9adb44013d1ca3fe0 node1156
node1156 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na269746d005d4ab9adb44013d1ca3fe0</B></td></tr><tr><td href='Na269746d005d4ab9adb44013d1ca3fe0' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na269746d005d4ab9adb44013d1ca3fe0</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is tracedToDetail, to must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
