# N510c5db907d7430c96e2a6ff45c3540b node251
node251 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N510c5db907d7430c96e2a6ff45c3540b</B></td></tr><tr><td href='N510c5db907d7430c96e2a6ff45c3540b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N510c5db907d7430c96e2a6ff45c3540b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasTest, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasTest&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
