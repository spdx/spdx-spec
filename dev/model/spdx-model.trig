        rdfs:subClassOf ns3:CreateAction ;
        sh:nodeKind sh:IRI .

    ns3:ReproduceProcess a owl:Class ;
        rdfs:comment "Reproduction is the biological process by which living organisms produce offspring."@en ;
        rdfs:subClassOf ns3:CreateProcess ;
