        sh:nodeKind sh:IRI ;
        sh:property _:N96d6dcb8348e4235b96f07c1478ac907,
            _:Ne6000aee731048b3b1cef71d5c221bb8 .

    ns4:ListedLicenseException a owl:Class,
            sh:NodeShape ;
