        sh:nodeKind sh:IRI ;
        sh:property _:N22ff522910664cffbe1ae09468df10a8,
            _:N2bbc32e0afe44a40b93450a9c31a304e,
            _:N4d41224e4c5b43a297dafbd87d544059 .

