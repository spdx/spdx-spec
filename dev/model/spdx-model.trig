        rdfs:range ns4:ConfidentialityLevelType .

    ns4:dataCollectionProcess a owl:DatatypeProperty ;
        rdfs:comment "How the dataset was collected."@en ;
        rdfs:range xsd:string .

    ns4:dataPreprocessing a owl:DatatypeProperty ;
