            _:Nf91599dd1ac14c14aa810e2db4fbe8a3 .

    ns5:StateAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "This is the state of an affected Element at a specific moment in time."@en ;
        rdfs:subClassOf ns5:UseAction ;
        sh:nodeKind sh:IRI ;
        sh:property _:Nc34cfa7e9e46436797c83c3d81880224,
            _:Nebb70fe6fda54005a47d5e4e4e8218f5 .

    ns5:StorageAction a owl:Class ;
        rdfs:comment "Records the storage of a product."@en ;
        rdfs:subClassOf ns5:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns5:StorageProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Prescribes the storage of a product."@en ;
        rdfs:subClassOf ns5:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:Ne8b8ca0c0e5f42f5932db41b5c494167 .

    ns5:TestAction a owl:Class ;
        rdfs:comment "A test action is a specific action associated with a test."@en ;
        rdfs:subClassOf ns5:UseAction ;
        sh:nodeKind sh:IRI .

    ns5:TestProcess a owl:Class ;
        rdfs:comment "Test Process defines the testing process for an element."@en ;
        rdfs:subClassOf ns5:UseProcess ;
        sh:nodeKind sh:IRI .

    ns5:TransportAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "An actual change to a product's location."@en ;
        rdfs:subClassOf ns5:ModifyAction ;
        sh:nodeKind sh:IRI ;
        sh:property _:N1dbd38193590420b8623d61ffef41c25,
            _:N34da5d3b24774112a21aeb06331f3392,
            _:Nb06f1ba3ce4f4bb1a1e6394a57067af2 .

    ns5:TransportProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A prescribed change to a product's location."@en ;
        rdfs:subClassOf ns5:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N34abb87d1cf6426ea4dea55e2dc911f4,
            _:N6f3eb3faa3f64337bf03552729346584,
