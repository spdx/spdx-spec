        sh:nodeKind sh:IRI ;
        sh:property _:N14a6177bd8f5465d964031d5a6008867,
            _:N4647af2c36ac468a802e9cbd9ac53c53,
            _:N5cd96596d7ff41cc9095d644339c165d,
            _:N649d11128ad94ec2a20acbee09ef9100,
            _:N8fa580731fd84240999a39fe4f774c0a,
            _:N923d2d7361144646ba95ce66d778141e,
            _:Nd5ca457eaa334b26988ece630927a972,
            _:Ne03fde97ebae486bbc02729d8d583a73,
            _:Nf0fe74ad76e44372af62d27e03222e6a .

