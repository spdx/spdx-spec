        rdfs:label "cycle" ;
        rdfs:comment "Simulation architectures with precise cycle-level accuracy."@en .

    <https://spdx.org/rdf/3/terms/Hardware/VirtualHardwareModelType/function> a owl:NamedIndividual,
            ns8:VirtualHardwareModelType ;
