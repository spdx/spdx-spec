        sh:nodeKind sh:IRI ;
        sh:property _:N6f6b3342b14a43d5a4a29f6b8ba6349f,
            _:N8b570d3c89674360bb8a86ff78c96cf2 .

    ns4:OrLaterOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing this version, or any later version,
of the indicated License."""@en ;
