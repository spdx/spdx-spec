    ns7:isDeprecatedLicenseId a owl:DatatypeProperty ;
        rdfs:comment """Specifies whether a license or additional text identifier has been marked as
deprecated."""@en ;
        rdfs:range xsd:boolean .

    ns7:isFsfLibre a owl:DatatypeProperty ;
