        sh:nodeKind sh:IRI ;
        sh:property _:N0c1e4bfce07a43d382ceddb849df3c9f,
            _:N13ce21d876b24dd88bbf7b1bf6b5f729,
            _:N347e039b72854a46974de647ac9dfe65,
