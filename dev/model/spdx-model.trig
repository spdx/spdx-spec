        sh:nodeKind sh:IRI ;
        sh:property _:N16e5cc648548427ca74edb5199657dcb,
            _:N7477b4d9a4e8462dbde7b52fbf1bec99 .

    ns3:additionText a owl:DatatypeProperty ;
