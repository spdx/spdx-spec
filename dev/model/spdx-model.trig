XML format."""@en ;
        rdfs:range xsd:string .

    ns4:listVersionAdded a owl:DatatypeProperty ;
        rdfs:comment """Specifies the SPDX License List version in which this ListedLicense or
ListedLicenseException identifier was first added."""@en ;
        rdfs:range xsd:string .

