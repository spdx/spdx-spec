        rdfs:subClassOf ns10:License ;
        sh:nodeKind sh:IRI .

    ns10:CustomLicenseAddition a owl:Class ;
        rdfs:comment "A license addition that is not listed on the SPDX Exceptions List."@en ;
        rdfs:subClassOf ns10:LicenseAddition ;
        sh:nodeKind sh:IRI .

