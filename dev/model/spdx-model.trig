        sh:nodeKind sh:IRI .

    ns11:ReproduceAction a owl:Class ;
        rdfs:comment "Reproduction is the biological process by which organisms generate new individuals of the same species."@en ;
        rdfs:subClassOf ns11:CreateAction ;
        sh:nodeKind sh:IRI .

    ns11:ReproduceProcess a owl:Class ;
