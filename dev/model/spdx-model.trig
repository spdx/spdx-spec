        rdfs:range ns5:RequirementVerification .

    ns5:evidenceCategory a owl:ObjectProperty ;
        rdfs:comment "evidenceCategory refers to a category of documented or observable proof."@en ;
        rdfs:range ns5:EvidenceType .

