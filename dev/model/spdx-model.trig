        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns7:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns2:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0dcaf8912f6d4ad097b501c5f32dd06b,
            _:N143259ab797d484aacd6dfce5d5eade7,
            _:N22f6ab48d77f4b45b42092923a723891,
            _:N2aacba20331c40249f6dfbc509e8514e,
            _:N31aca83db1a648dd9dde9ebfd655e4ff,
