        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns5:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns7:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N051e2547bc3f4ac3986a9180937261dd,
            _:N06df6b0c9c394cf39870b77af1179ab3,
            _:N0755eaf4c69a4e3b820eec40f91021da,
            _:N1b824555ef50452097dd5fa5efbe9e01,
            _:N56f29523ee474c6585ee228bbf3e52b1,
            _:N7b9d101646c643e8a49c659725bf54d7,
            _:N9ba035807e7540f5bdf66358a71f445b,
            _:N9f1d59d0a90c434faace7729cc3c3d83,
            _:Nbe05e22088814c32ac7ec68bbc26a442,
            _:Nc280c3f20fb94782a04f7f2827704e23,
            _:Ncd16ead64b364d5b99b7919b4d847646,
            _:Nd4a8a01f2ced4f4aa9f1db5295a8806a,
