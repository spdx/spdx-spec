        rdfs:subClassOf <https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo> ;
        sh:nodeKind sh:IRI ;
        sh:property _:Neefeef6144e54a87bcb31f63e260e212 .

    ns10:ListedLicense a owl:Class,
            sh:NodeShape ;
