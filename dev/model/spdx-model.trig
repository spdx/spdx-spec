        sh:nodeKind sh:IRI .

    ns6:OutOfSpecAction a owl:Class ;
        rdfs:comment "An out of specification action is defined in this class."@en ;
        rdfs:subClassOf ns6:UseAction ;
        sh:nodeKind sh:IRI .

    ns6:PlanAction a owl:Class ;
