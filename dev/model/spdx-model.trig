            _:Nf75882bcfe8b43989afe20096f914737 .

    ns6:serverKeyValidationProtocol a owl:ObjectProperty ;
        rdfs:comment "Key validation protocol used during the authentication of servers or services over a network."@en ;
        rdfs:range ns6:KeyValidationProtocolType .

