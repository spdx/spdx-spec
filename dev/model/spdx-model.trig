            ns4:SoftwarePurpose ;
        rdfs:label "requirement" ;
        rdfs:comment "The Element provides a requirement needed as input for another Element."@en .

    <https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/source> a owl:NamedIndividual,
            ns4:SoftwarePurpose ;
        rdfs:label "source" ;
