      {
        "@language": "en",
        "@value": "Every `to` Element is an optional component of the `from` Element (`from` hasOptionalComponent `to`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "hasOptionalComponent"
      }
    ]
