  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Security/ExploitCatalogType/kev",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Security/ExploitCatalogType"
    ],
