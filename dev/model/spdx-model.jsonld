      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/ExpandedLicensing/NoAssertionLicense",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/ExpandedLicensing/IndividualLicensingInfo"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An Individual Value for License when no assertion can be made about its actual\nvalue."
      }
    ],
