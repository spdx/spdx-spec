        "@value": "The point in time when an element or an action starts,\nbecomes applicable, or becomes valid."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTimeStamp"
      }
    ]
  },
