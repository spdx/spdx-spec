    ]
  },
  {
    "@id": "_:Nc2960cb6035f421dbf260199b5639516",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Security/VexJustificationType"
      }
    ],
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@id": "https://spdx.org/rdf/3/terms/Security/VexJustificationType/componentNotPresent"
          },
          {
            "@id": "https://spdx.org/rdf/3/terms/Security/VexJustificationType/vulnerableCodeNotPresent"
          },
          {
            "@id": "https://spdx.org/rdf/3/terms/Security/VexJustificationType/vulnerableCodeCannotBeControlledByAdversary"
          },
          {
