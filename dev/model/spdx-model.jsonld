        "@language": "en",
        "@value": "Dataset is not publicly available and an email registration is required before accessing the dataset, although without an affirmative acceptance of terms."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "registration"
      }
    ]
  },
