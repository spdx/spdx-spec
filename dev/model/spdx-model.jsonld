    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The element follows the Lite profile specification."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "lite"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Operations/assessmentResult",
