  {
    "@id": "https://spdx.org/rdf/3.1/terms/Security/vectorString",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Specifies the CVSS vector string for a vulnerability."
      }
    ],
