  {
    "@id": "https://spdx.org/rdf/3.1/terms/Security/VexJustificationType/vulnerableCodeNotPresent",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Security/VexJustificationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The product is not affected because the code underlying the vulnerability is not present in the product."
