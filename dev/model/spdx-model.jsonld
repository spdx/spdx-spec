      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:Nd5fc1e479519445482e093d59150954e"
      },
      {
        "@id": "_:N3647d887b18745ff96d2c13ff2c13279"
      }
    ]
  },
  {
    "@id": "_:Nd5fc1e479519445482e093d59150954e",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "https://spdx.org/rdf/3.1/terms/Core/Location is an abstract class and should not be instantiated directly. Instantiate a subclass instead."
      }
    ],
    "http://www.w3.org/ns/shacl#not": [
