      "https://spdx.org/rdf/3.1/terms/Core/RelationshipCompleteness"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "No assertion can be made about the completeness of the relationship."
