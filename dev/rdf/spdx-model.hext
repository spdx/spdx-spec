["_:N2a5746e832234eb3a7f298796aec6d40", "http://www.w3.org/ns/shacl#message", "https://spdx.org/rdf/3/terms/Security/VulnAssessmentRelationship is an abstract class and should not be instantiated directly. Instantiate a subclass instead.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
