["https://spdx.org/rdf/3/terms/Core/locationTime", "http://www.w3.org/2000/01/rdf-schema#comment", "A known location is specified at this time.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/locatedAt", "http://www.w3.org/2000/01/rdf-schema#label", "locatedAt", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3/terms/Dataset/DatasetType/text", "http://www.w3.org/2000/01/rdf-schema#comment", "Data consists of unstructured text, such as a book, a Wikipedia article (without images), or a transcript.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/manifest", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Software/SoftwarePurpose", "globalId", "", ""]
