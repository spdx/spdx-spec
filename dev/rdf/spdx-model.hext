["_:N64fca2c3f5c0444086e1a4d90739e0ed", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/serializedInArtifact> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/SpdxDocument> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
