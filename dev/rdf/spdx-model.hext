["_:N406be3fefac64eff864b4783d3cb3edd", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/providesSupportFor> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Artifact> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
