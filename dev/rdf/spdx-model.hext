["https://spdx.org/rdf/3/terms/Software/FileKindType/symlink", "http://www.w3.org/2000/01/rdf-schema#comment", "This file represents a symbolic link (soft link).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
