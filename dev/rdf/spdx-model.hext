["https://spdx.org/rdf/3/terms/Core/ExternalRefType/nuget", "http://www.w3.org/2000/01/rdf-schema#comment", "A reference to a NuGet package. The package locator format is defined in the [NuGet documentation](https://docs.nuget.org) and looks like `package/version`.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nf9a7c451974442598825a77dfc8c584f", "http://www.w3.org/ns/shacl#nodeKind", "http://www.w3.org/ns/shacl#Literal", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isni", "http://www.w3.org/2000/01/rdf-schema#comment", "[International Standard Name Identifier (ISNI)](https://isni.org/page/what-is-isni/) is a unique identifier used to distinguish the public identities of parties involved in the creation, production, and distribution of media content. Standardized by [ISO 27729](https://www.iso.org/standard/87177.html), it consists of 16 characters\u201415 digits plus a final check character\u2014and is often represented as a URI, such as `https://isni.org/isni/000000012146438X`.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipCompleteness/incomplete", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/evidenceUID", "http://www.w3.org/2000/01/rdf-schema#comment", "The unique identifier used by a reporting management system or any other lifecycle management tool to uniquely identify an evidence relationship item.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
