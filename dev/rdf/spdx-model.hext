["https://spdx.org/rdf/3/terms/Security/decisionType", "http://www.w3.org/2000/01/rdf-schema#range", "https://spdx.org/rdf/3/terms/Security/SsvcDecisionType", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/EvaluationResultType/inconclusive", "http://www.w3.org/2000/01/rdf-schema#comment", "Inconclusive refers to a result or outcome from a verification, test, or analysis that cannot be clearly classified as either positive (successful, pass) or negative (failed, reject). An inconclusive result means there was not enough clear evidence, data, or signal to make a definitive determination, and further investigation or additional testing is necessary. An inconclusive result always shall need a comment on it.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/doi", "http://www.w3.org/2000/01/rdf-schema#comment", "[Digital Object Identifier (DOI)](https://www.doi.org/the-identifier/what-is-a-doi/) is a unique, [ISO 26324](https://www.iso.org/standard/88862.html)-standardized identifier for physical, digital, or abstract objects, formatted as a prefix and suffix separated by a forward slash (e.g., `10.1000/182`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N5f35868e70fa4cd9a26019ab66893250", "http://www.w3.org/ns/shacl#nodeKind", "http://www.w3.org/ns/shacl#IRI", "globalId", "", ""]
