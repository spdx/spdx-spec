["https://spdx.org/rdf/3/terms/Software/SbomType/runtime", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Software/SbomType", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Operations/participationAgreement", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#ObjectProperty", "globalId", "", ""]
