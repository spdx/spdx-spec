# N5f75bc77880c4b3cbb5843f53a4df07c node1111
node1111 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N5f75bc77880c4b3cbb5843f53a4df07c</B></td></tr><tr><td href='N5f75bc77880c4b3cbb5843f53a4df07c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N5f75bc77880c4b3cbb5843f53a4df07c</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/fixedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
