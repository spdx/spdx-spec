# Nb8f5c5ce47d44f9d96b12718e3c72acf node1658
node1658 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb8f5c5ce47d44f9d96b12718e3c72acf</B></td></tr><tr><td href='Nb8f5c5ce47d44f9d96b12718e3c72acf' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb8f5c5ce47d44f9d96b12718e3c72acf</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasSpecification, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasSpecification&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
