# N526e6be3ad33411a8df7830981facc22 node730
node730 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N526e6be3ad33411a8df7830981facc22</B></td></tr><tr><td href='N526e6be3ad33411a8df7830981facc22' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N526e6be3ad33411a8df7830981facc22</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is serializedInArtifact, from must be a SpdxDocument&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
