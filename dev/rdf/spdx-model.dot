node1355 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>query</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Dataset/DatasetAvailabilityType/query' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Dataset/DatasetAvailabilityType/query</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Dataset is publicly available, but not all at once, and can only be accessed through queries which return parts of the dataset.&quot;@en</td></tr></table> > ] 
