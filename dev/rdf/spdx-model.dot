# Nde54b912d72846049b4a7154931d28a8 node1678
node1678 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nde54b912d72846049b4a7154931d28a8</B></td></tr><tr><td href='Nde54b912d72846049b4a7154931d28a8' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nde54b912d72846049b4a7154931d28a8</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is invokedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    $this &lt;Core/to&gt; ?to .
