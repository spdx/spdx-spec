# Nfab356ddab69464a887cab9e31cc3d2e node1014
node1014 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nfab356ddab69464a887cab9e31cc3d2e</B></td></tr><tr><td href='Nfab356ddab69464a887cab9e31cc3d2e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nfab356ddab69464a887cab9e31cc3d2e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is publishedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/publishedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
