node903 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N932459f5e0174f8f8196bc1205ba9fa5</B></td></tr><tr><td href='N932459f5e0174f8f8196bc1205ba9fa5' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N932459f5e0174f8f8196bc1205ba9fa5</font></td></tr><tr><td align='left'>sh:minCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
