# Nfd45cadb4fa74bba9e53895367d9da60 node1723
node1723 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nfd45cadb4fa74bba9e53895367d9da60</B></td></tr><tr><td href='Nfd45cadb4fa74bba9e53895367d9da60' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nfd45cadb4fa74bba9e53895367d9da60</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship id dependsOn, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/dependsOn&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
