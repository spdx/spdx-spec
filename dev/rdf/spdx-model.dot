# Nc6b6f80b9a9243b7a91038e8ba8d3dcf node1345
node1345 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nc6b6f80b9a9243b7a91038e8ba8d3dcf</B></td></tr><tr><td href='Nc6b6f80b9a9243b7a91038e8ba8d3dcf' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nc6b6f80b9a9243b7a91038e8ba8d3dcf</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasConcludedLicense, to must be an AnyLicenseInfo&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasConcludedLicense&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;SimpleLicensing/AnyLicenseInfo&gt; }
}&quot;</td></tr></table> > ] 
