# N02e74d862c5e48d2a65f37137d983abf node539
node539 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N02e74d862c5e48d2a65f37137d983abf</B></td></tr><tr><td href='N02e74d862c5e48d2a65f37137d983abf' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N02e74d862c5e48d2a65f37137d983abf</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is invokedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
# N8c295e7757c74d8fbbebba216c4bb435 node540
node540 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8c295e7757c74d8fbbebba216c4bb435</B></td></tr><tr><td href='N8c295e7757c74d8fbbebba216c4bb435' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8c295e7757c74d8fbbebba216c4bb435</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is implementedBy, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/implementedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
