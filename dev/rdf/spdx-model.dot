node819 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>formalStandard</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/SpecificationType/formalStandard' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/SpecificationType/formalStandard</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A formal standard is a standard ratified by a recognized standards-development organization and published as a normative reference.&quot;@en</td></tr></table> > ] 
