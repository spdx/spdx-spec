# Ne2b7b9612f6c4fd8bfcd39979f56fbba node1350
node1350 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne2b7b9612f6c4fd8bfcd39979f56fbba</B></td></tr><tr><td href='Ne2b7b9612f6c4fd8bfcd39979f56fbba' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne2b7b9612f6c4fd8bfcd39979f56fbba</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is providesSupportFor, from must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/providesSupportFor&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
# N7adba0dbf10c487e8ed540d08e1c405d node1351
node1351 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N7adba0dbf10c487e8ed540d08e1c405d</B></td></tr><tr><td href='N7adba0dbf10c487e8ed540d08e1c405d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N7adba0dbf10c487e8ed540d08e1c405d</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, to must be a Relationship whose relationshipType is invokedBy&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/delegatedTo&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS {
        ?to rdf:type/rdfs:subClassOf* &lt;Core/Relationship&gt; .
        ?to &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    }
}&quot;</td></tr></table> > ] 
