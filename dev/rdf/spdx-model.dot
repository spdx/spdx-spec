# Nfb5571a934fe42b0a14cd40142648dc3 node1519
node1519 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nfb5571a934fe42b0a14cd40142648dc3</B></td></tr><tr><td href='Nfb5571a934fe42b0a14cd40142648dc3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nfb5571a934fe42b0a14cd40142648dc3</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasContactPoint, class must be ContactPointRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasContactPoint&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/ContactPointRelationship&gt; }
}&quot;</td></tr></table> > ] 
# Nb1390efabe874fc6bb7b041af5062608 node1520
node1520 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb1390efabe874fc6bb7b041af5062608</B></td></tr><tr><td href='Nb1390efabe874fc6bb7b041af5062608' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb1390efabe874fc6bb7b041af5062608</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is serializedInArtifact, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/serializedInArtifact&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Artifact&gt; }
}&quot;</td></tr></table> > ] 
