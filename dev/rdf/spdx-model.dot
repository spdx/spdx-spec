# N14325b004a564078971038ca3b9f6893 node124
node124 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N14325b004a564078971038ca3b9f6893</B></td></tr><tr><td href='N14325b004a564078971038ca3b9f6893' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N14325b004a564078971038ca3b9f6893</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is verifiedBy, to must be a RequirementVerification&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/verifiedBy&gt; .
    $this &lt;Core/to&gt; ?to .
