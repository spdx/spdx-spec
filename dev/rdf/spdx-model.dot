node1500 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N78b7737763474e35ae7d85edc019cb8a</B></td></tr><tr><td href='N78b7737763474e35ae7d85edc019cb8a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N78b7737763474e35ae7d85edc019cb8a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasAssociatedVulnerability, to must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
