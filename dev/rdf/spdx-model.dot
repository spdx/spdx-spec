node931 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>dataPreprocessing</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Dataset/dataPreprocessing' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Dataset/dataPreprocessing</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Preprocessing steps that were applied to the raw data to create the given dataset.&quot;@en</td></tr></table> > ] 
