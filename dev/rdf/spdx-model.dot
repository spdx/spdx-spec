# Nb68052d0b40f4e33948210c9592796c9 node1764
node1764 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb68052d0b40f4e33948210c9592796c9</B></td></tr><tr><td href='Nb68052d0b40f4e33948210c9592796c9' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb68052d0b40f4e33948210c9592796c9</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is performedBy, from must be an Action&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/performedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
}&quot;</td></tr></table> > ] 
