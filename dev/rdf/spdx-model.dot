# Ndacea069b1e94c3488adb2e3bee356d3 node1761
node1761 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ndacea069b1e94c3488adb2e3bee356d3</B></td></tr><tr><td href='Ndacea069b1e94c3488adb2e3bee356d3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ndacea069b1e94c3488adb2e3bee356d3</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is coordinatedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
