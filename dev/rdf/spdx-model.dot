# Nd266f9830c064c328485028ea25e2c2c node1059
node1059 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nd266f9830c064c328485028ea25e2c2c</B></td></tr><tr><td href='Nd266f9830c064c328485028ea25e2c2c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nd266f9830c064c328485028ea25e2c2c</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, from must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/delegatedTo&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
