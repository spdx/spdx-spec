# Nb52e4c10c2774f15ba9e6f3455e57b6b node347
node347 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb52e4c10c2774f15ba9e6f3455e57b6b</B></td></tr><tr><td href='Nb52e4c10c2774f15ba9e6f3455e57b6b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb52e4c10c2774f15ba9e6f3455e57b6b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is performedBy, from must be an Action or a Relationship of type hasInstall or hasUninstall&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/performedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
    FILTER NOT EXISTS { ?from &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasInstall&gt; }
    FILTER NOT EXISTS { ?from &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasUninstall&gt; }
}&quot;</td></tr></table> > ] 
