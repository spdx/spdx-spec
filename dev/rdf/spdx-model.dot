# Ne75a5b751fef402093a44b196ab7d3ac node1663
node1663 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne75a5b751fef402093a44b196ab7d3ac</B></td></tr><tr><td href='Ne75a5b751fef402093a44b196ab7d3ac' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne75a5b751fef402093a44b196ab7d3ac</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is tracedToDetail, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/tracedToDetail&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
