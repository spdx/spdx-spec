node143 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N171d9a5e95e040cb9bed86e510e89215</B></td></tr><tr><td href='N171d9a5e95e040cb9bed86e510e89215' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N171d9a5e95e040cb9bed86e510e89215</font></td></tr><tr><td align='left'>sh:minCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
