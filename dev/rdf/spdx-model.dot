node178 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>intendedUse</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/intendedUse' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/intendedUse</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The intendedUse property is designed to capture a summary of how or for what item or artifact is meant to be used for.&quot;@en</td></tr></table> > ] 
