    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "hasAddedFile"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/blake2b512",
    "@type": [
