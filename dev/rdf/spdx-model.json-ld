    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Provide an enumerated set of requirement statuses that can provide state to a requirement."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/RelationshipType/dependsOn",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
