      {
        "@value": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T(([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]|23:59:60)Z$"
      }
    ]
  },
  {
    "@id": "_:N598af8b1a25c45649b320467eb25bb7b",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "When relationship is affects, from must be a Vulnerability, Action, or DefinedProcess"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/affects> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Action> }\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/DefinedProcess> }\n}"
      }
    ]
  },
  {
    "@id": "_:N14aa491fad0349fa962e0cbdfa45da46",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "When relationship is assumes, to must be an Assumption"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/assumes> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <FunctionalSafety/Assumption> }\n}"
      }
    ]
  },
  {
    "@id": "_:N00af78542561422bbea71faa62ef40c2",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "When relationship is configures, class must be LifecycleScopedRelationship"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/configures> .\n    FILTER NOT EXISTS { $this rdf:type <Core/LifecycleScopedRelationship> }\n}"
      }
    ]
  },
  {
    "@id": "_:Nb6f807e5f113442088019299126600c3",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "When relationship is conformsTo, to must be an Assumption or Specification"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/conformsTo> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <FunctionalSafety/Assumption> }\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Specification> }\n}"
      }
    ]
  },
  {
    "@id": "_:N7e412aae8ef34fb589364a5824ca94ec",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "When relationship is coordinatedBy, from must be a Vulnerability"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/coordinatedBy> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }\n}"
      }
    ]
  },
  {
    "@id": "_:Nea7b736eb095489ca7f00897e54ac898",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "When relationship is createdBy, from must be an Action or DefinedProcess"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/createdBy> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Action> }\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/DefinedProcess> }\n}"
      }
    ]
  },
  {
    "@id": "_:N72c298144bfc4cada8364e628e625659",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "When relationship is createdBy, to must be an Agent"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/createdBy> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Agent> }\n}"
      }
    ]
  },
  {
    "@id": "_:Nfaee0ef3a00e421593d2db257e95e2ae",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "When relationship is delegatedTo, from must be an Agent"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/delegatedTo> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Agent> }\n}"
      }
    ]
  },
  {
    "@id": "_:N2ec6fff0cd1a49299dc5d45d430727b9",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "When relationship is delegatedTo, to must be a Relationship whose relationshipType is invokedBy"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/delegatedTo> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS {\n        ?to rdf:type/rdfs:subClassOf* <Core/Relationship> .\n        ?to <Core/relationshipType> <Core/RelationshipType/invokedBy> .\n    }\n}"
      }
    ]
  },
  {
