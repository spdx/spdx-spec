    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Every `to` Element is a file added to the `from` Element (`from` hasAddedFile `to`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
