      {
        "@language": "en",
        "@value": "Provides a reference number that can be used to understand how to parse and\ninterpret an Element."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
