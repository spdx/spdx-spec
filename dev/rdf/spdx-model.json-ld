    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Specifies an Element contained in a piece of software where a vulnerability was\nfound."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
