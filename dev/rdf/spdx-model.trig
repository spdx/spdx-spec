        rdfs:range xsd:string .

    ns8:datasetAvailability a owl:ObjectProperty ;
        rdfs:comment "Availability of a dataset."@en ;
        rdfs:range ns8:DatasetAvailabilityType .

    ns8:datasetNoise a owl:DatatypeProperty ;
        rdfs:comment "Potentially noisy elements of the dataset."@en ;
        rdfs:range xsd:string .

