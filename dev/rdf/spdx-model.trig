        rdfs:subClassOf <https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo> ;
        sh:nodeKind sh:IRI ;
        sh:property _:N9591c9bfc6e4495288b52e631eba52f6 .

    ns4:ListedLicense a owl:Class,
