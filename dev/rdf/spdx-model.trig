    _:N001396dc235e49feab385277f5f0722c a sh:SPARQLConstraint ;
        sh:message "When relationship is doesNotAffect, class must be VexNotAffectedVulnAssessmentRelationship" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/doesNotAffect> .
    FILTER NOT EXISTS { $this rdf:type <Security/VexNotAffectedVulnAssessmentRelationship> }
}""" .

