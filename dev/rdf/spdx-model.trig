        sh:nodeKind sh:IRI ;
        sh:property _:N969cc4aea7f14f55ba9f47f667675589,
            _:N98ba34ab9b694e058858d730a46e0252,
            _:Nb45f92ccb8074405abc625891e66bf54 .

