        sh:nodeKind sh:IRI ;
        sh:property _:N16a88ce2fb424c25be35b5d630fda339,
            _:N562c3a60d4e84c9b883c4bd0fcd0971e,
            _:N5ceedd7b59514c4696c3a9a7137e1b7c,
