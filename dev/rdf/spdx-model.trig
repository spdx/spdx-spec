        rdfs:range ns8:ContentIdentifierType .

    ns8:contentIdentifierValue a owl:DatatypeProperty ;
        rdfs:comment "Specifies the value of the content identifier."@en ;
        rdfs:range xsd:anyURI .

    ns8:copyrightText a owl:DatatypeProperty ;
