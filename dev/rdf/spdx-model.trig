    _:N040624670e1e4af9ae2eaf6b90e3fabd a sh:SPARQLConstraint ;
        sh:message "When relationship is invokedBy, to must be an Agent" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
