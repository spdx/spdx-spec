        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N256fbd82baf342e2a71801ac7b7aa721 .

    <https://spdx.org/rdf/3/terms/SimpleLicensing/customIdToLicense> a owl:ObjectProperty ;
