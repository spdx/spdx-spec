        sh:nodeKind sh:IRI ;
        sh:property _:N0dd50c8eddb44e688fad996e5a099ede,
            _:N18b95978b5fa426aaaeea61e34b08b3b,
            _:N23ac9725a2d84e39ba308badf82da31b,
            _:N308a931e1c9a48c3b16a627ec9b92314,
            _:Nb8ea69d29cba4adc9065619a84578492,
            _:Nbb489338ec634d19b2b0239a5d047e2d,
            _:Nc89e860e14f0438d8c71499c41759377,
            _:Nda0c698a20e74140b1d913f6c61af632,
            _:Nf6e7979be7464cccbc2e684a770d0218 .

