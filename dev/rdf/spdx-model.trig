    <https://spdx.org/rdf/3/terms/AI/AgentMemoryMode/episodic> a owl:NamedIndividual,
            ns7:AgentMemoryMode ;
        rdfs:label "episodic" ;
        rdfs:comment "Records of past events, interactions, or task executions that provide experiential context for future reasoning."@en .

    <https://spdx.org/rdf/3/terms/AI/AgentMemoryMode/external> a owl:NamedIndividual,
            ns7:AgentMemoryMode ;
        rdfs:label "external" ;
        rdfs:comment "Information persisted in an external store (database, file system, vector store) and retrieved on demand."@en .

    <https://spdx.org/rdf/3/terms/AI/AgentMemoryMode/inCache> a owl:NamedIndividual,
            ns7:AgentMemoryMode ;
        rdfs:label "inCache" ;
        rdfs:comment "Precomputed key-value attention caches enabling efficient reuse of prior computations."@en .

    <https://spdx.org/rdf/3/terms/AI/AgentMemoryMode/inContext> a owl:NamedIndividual,
            ns7:AgentMemoryMode ;
        rdfs:label "inContext" ;
        rdfs:comment "Information retained within the active context window of the underlying language model."@en .

    <https://spdx.org/rdf/3/terms/AI/AgentMemoryMode/inWeights> a owl:NamedIndividual,
            ns7:AgentMemoryMode ;
        rdfs:label "inWeights" ;
        rdfs:comment "Knowledge encoded in model parameters through pretraining or fine-tuning; not updated at runtime."@en .

    <https://spdx.org/rdf/3/terms/AI/AgentMemoryMode/procedural> a owl:NamedIndividual,
            ns7:AgentMemoryMode ;
        rdfs:label "procedural" ;
        rdfs:comment "Encoded skills, plans, or behavioral patterns that guide the agent's execution strategy."@en .

    <https://spdx.org/rdf/3/terms/AI/AgentMemoryMode/semantic> a owl:NamedIndividual,
            ns7:AgentMemoryMode ;
        rdfs:label "semantic" ;
        rdfs:comment "Factual or conceptual knowledge stored for retrieval and inference (e.g., vector embeddings, knowledge graphs)."@en .

    <https://spdx.org/rdf/3/terms/AI/AgentMemoryMode/working> a owl:NamedIndividual,
            ns7:AgentMemoryMode ;
        rdfs:label "working" ;
        rdfs:comment "Short-lived, context-scoped information used within a single reasoning session or conversation turn."@en .

    <https://spdx.org/rdf/3/terms/AI/AgentTrustLevel/certified> a owl:NamedIndividual,
            ns7:AgentTrustLevel ;
        rdfs:label "certified" ;
        rdfs:comment "A recognized standards or certification body has formally verified the agent against defined criteria. Appropriate for high-stakes or regulated deployments."@en .

    <https://spdx.org/rdf/3/terms/AI/AgentTrustLevel/selfDeclared> a owl:NamedIndividual,
            ns7:AgentTrustLevel ;
        rdfs:label "selfDeclared" ;
        rdfs:comment "The agent's developer or operator has described its behavior, but no one else has checked those claims. Suitable for internal or sandboxed use where the declaring party is trusted."@en .

    <https://spdx.org/rdf/3/terms/AI/AgentTrustLevel/thirdPartyReviewed> a owl:NamedIndividual,
            ns7:AgentTrustLevel ;
        rdfs:label "thirdPartyReviewed" ;
        rdfs:comment "An independent party has audited the agent, but it has not been formally certified. Offers more confidence than self-declaration; suitable for controlled production use."@en .

    <https://spdx.org/rdf/3/terms/AI/AgentTrustLevel/unverified> a owl:NamedIndividual,
            ns7:AgentTrustLevel ;
        rdfs:label "unverified" ;
        rdfs:comment "No review has been performed. The agent's identity, capabilities, and behavior are entirely unconfirmed. Treat with maximum caution and restrict access accordingly."@en .

    <https://spdx.org/rdf/3/terms/AI/EnergyUnitType/kilowattHour> a owl:NamedIndividual,
            ns7:EnergyUnitType ;
        rdfs:label "kilowattHour" ;
        rdfs:comment "Kilowatt-hour."@en .

    <https://spdx.org/rdf/3/terms/AI/EnergyUnitType/megajoule> a owl:NamedIndividual,
            ns7:EnergyUnitType ;
        rdfs:label "megajoule" ;
        rdfs:comment "Megajoule."@en .

    <https://spdx.org/rdf/3/terms/AI/EnergyUnitType/other> a owl:NamedIndividual,
            ns7:EnergyUnitType ;
        rdfs:label "other" ;
        rdfs:comment "Any other units of energy measurement."@en .

    ns7:InteractionTemplate a owl:Class,
            sh:NodeShape ;
        rdfs:comment "An artifact that defines the structure, formatting, and variable placeholders for AI model interactions."@en ;
        rdfs:subClassOf ns1:Artifact ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0c06df6e47e244f4a960a300f586f5e8,
            _:Nfeb7a1676d7641bba61368228835f638 .

    ns7:agentCapability a owl:ObjectProperty ;
        rdfs:comment """Describes a specific domain task or goal the agent is designed to perform,
optionally noting the autonomy level at which it is exercised."""@en ;
        rdfs:range xsd:string .

    ns7:agentCommunicationProtocol a owl:ObjectProperty ;
        rdfs:comment """Identifies a standardized communication protocol implemented by the AI agent
for interacting with external tools, data sources, or other agents."""@en ;
        rdfs:range ns1:Specification .

    ns7:agentMemoryMode a owl:ObjectProperty ;
        rdfs:comment "Indicates the memory category or storage mechanism used by the AI agent."@en ;
        rdfs:range ns7:AgentMemoryMode .

    ns7:agentTrustLevel a owl:ObjectProperty ;
        rdfs:comment """Indicates the degree of external verification applied to the AI agent's
identity, behavioral claims, and declared capabilities."""@en ;
        rdfs:range ns7:AgentTrustLevel .

    ns7:autonomyType a owl:ObjectProperty ;
        rdfs:comment """**DEPRECATED in SPDX 3.1.**
Use [/Core/isoAutomationLevel](../../Core/Properties/isoAutomationLevel.md)
instead.

Indicates whether the system can perform a decision or action without human
involvement or guidance."""@en ;
        rdfs:range ns1:PresenceType .

    ns7:domain a owl:DatatypeProperty ;
        rdfs:comment "Domain in which the AI package can be used."@en ;
        rdfs:range xsd:string .

    ns7:energyConsumption a owl:ObjectProperty ;
        rdfs:comment "Energy consumption incurred by an AI model."@en ;
        rdfs:range ns7:EnergyConsumption .

    ns7:energyQuantity a owl:DatatypeProperty ;
        rdfs:comment "Energy quantity."@en ;
        rdfs:range xsd:decimal .

    ns7:energyUnit a owl:ObjectProperty ;
        rdfs:comment "Unit in which energy is measured."@en ;
        rdfs:range ns7:EnergyUnitType .

    ns7:finetuningEnergyConsumption a owl:ObjectProperty ;
        rdfs:comment """Energy consumed when finetuning the AI model that is
being used in the AI system."""@en ;
        rdfs:range ns7:EnergyConsumptionDescription .

    ns7:hyperparameter a owl:ObjectProperty ;
        rdfs:comment "Hyperparameter used to build the AI model contained in the AI package."@en ;
        rdfs:range ns1:DictionaryEntry .

    ns7:inferenceEnergyConsumption a owl:ObjectProperty ;
        rdfs:comment """Energy consumed during inference time by an AI model
that is being used in the AI system."""@en ;
        rdfs:range ns7:EnergyConsumptionDescription .

    ns7:informationAboutApplication a owl:DatatypeProperty ;
        rdfs:comment "Information about the AI software, not including the model description."@en ;
        rdfs:range xsd:string .

    ns7:informationAboutTraining a owl:DatatypeProperty ;
        rdfs:comment "Information about different steps of the training process."@en ;
        rdfs:range xsd:string .

    ns7:interactionTemplateDictionary a owl:ObjectProperty ;
        rdfs:comment "A Dictionary containing the template format used to structure interactions with the AI model."@en ;
        rdfs:range ns1:DictionaryEntry .

    ns7:interactionTemplateString a owl:DatatypeProperty ;
        rdfs:comment "A string containing the template format used to structure interactions with the AI model."@en ;
        rdfs:range xsd:string .

    ns7:metric a owl:ObjectProperty ;
        rdfs:comment "Metric used to evaluate the AI model."@en ;
        rdfs:range ns1:DictionaryEntry .

    ns7:metricDecisionThreshold a owl:ObjectProperty ;
        rdfs:comment """Threshold that was used for computation of a metric described in
the metric field."""@en ;
        rdfs:range ns1:DictionaryEntry .

    ns7:modelDataPreprocessing a owl:DatatypeProperty ;
        rdfs:comment "Preprocessing steps applied to the training data before the model training."@en ;
        rdfs:range xsd:string .

    ns7:modelExplainability a owl:DatatypeProperty ;
        rdfs:comment "Methods that can be used to explain the results from the AI model."@en ;
        rdfs:range xsd:string .

    ns7:standardCompliance a owl:DatatypeProperty ;
        rdfs:comment """**DEPRECATED in SPDX 3.1.**
Use [/Core/Relationship](../../Core/Classes/Relationship.md)
with "conformsTo" relationship type instead.

A standard with which the artifact complies."""@en ;
        rdfs:range xsd:string .

    ns7:trainingEnergyConsumption a owl:ObjectProperty ;
        rdfs:comment """Energy consumed when training the AI model that is
being used in the AI system."""@en ;
        rdfs:range ns7:EnergyConsumptionDescription .

    ns7:typeOfModel a owl:DatatypeProperty ;
        rdfs:comment "Type of the model used in the AI software."@en ;
        rdfs:range xsd:string .

    ns7:useSensitivePersonalInformation a owl:ObjectProperty ;
        rdfs:comment """Records if sensitive personal information is used during model training or
could be used during the inference."""@en ;
        rdfs:range ns1:PresenceType .

    <https://spdx.org/rdf/3/terms/Build/Build> a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Class that describes a build instance of software/artifacts."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0701ad6f4f88434b9aab989be7f19394,
            _:N16d7eb532b5444db86ad1cdeea8f13d1,
            _:N3282e73ab8914a1096d017c73343772c,
