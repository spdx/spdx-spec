        rdfs:subClassOf ns9:UseProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:Na1e7e4dd72584f90a13375688ee4bb4f .

    ns9:InstantiateVirtualHardwareProcess a owl:Class ;
