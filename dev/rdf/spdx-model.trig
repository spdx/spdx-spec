        sh:nodeKind sh:IRI ;
        sh:property _:N2062dc09a42f421c9e6d01d1bd9ceaf7,
            _:N226855bd66544e51a32801c8238c22f9,
            _:N3a3ee7eeae204d6bb8f7176804788f19,
            _:N57f405d7997e4c9db37717fae0da9cb8,
            _:N5ba633b6635c4fa7b5bf66edea649ba3,
            _:N77ac0726e19941648b9913d4d4dafd33,
            _:N8a7977c4b90842e0b1c13f30aafc18fc,
