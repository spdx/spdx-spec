            sh:NodeShape ;
        rdfs:comment "A prescribed change to a product's location."@en ;
        rdfs:subClassOf ns10:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N17f6937970be445583d0fc2da98f1147,
            _:Nb8c3f957b4754269bb5e0799efdfafab,
