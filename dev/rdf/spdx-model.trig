        rdfs:range xsd:string .

    ns3:AbstractPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Refers to an abstract, conceptual software entity."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N151a791172a54974995671ebb55bf05d,
            _:N421c1eeea9ce4833ac2f844df1fad981,
