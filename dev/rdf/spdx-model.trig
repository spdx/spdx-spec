        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns7:AIAgent a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Specifies an AI agent and its associated metadata."@en ;
        rdfs:subClassOf ns1:SoftwareAgent ;
        sh:nodeKind sh:IRI ;
