        sh:nodeKind sh:IRI ;
        sh:property _:N0959f84a531643c8b1f525811cbc7908,
            _:N3ce30f3f6ed04be5bf0a074f5043f9bb,
            _:N9117058780974559b2857ae0a97d2ba0 .

