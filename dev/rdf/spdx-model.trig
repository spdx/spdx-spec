            _:Nc64740172572477c8f08d72c486905aa,
            _:Ne75570a32e0443dea2062e64031579b7 .

    ns1:Person a owl:Class ;
        rdfs:comment "An individual human being."@en ;
        rdfs:subClassOf ns1:Agent ;
        sh:nodeKind sh:IRI .

    ns1:PhysicalLocation a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A physical location is a tangible, geographically identifiable place where objects, people, or assets exist or operate."@en ;
