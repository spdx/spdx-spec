        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns9:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns4:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N03f56e81d3c249e2b991b766178d950d,
            _:N0e24077fce5e41fa823119be5f200c96,
            _:N2f8be6ee521648afae2995d4ef247eed,
            _:N3dbd7060a6b04548aa1dfafa361c5eb3,
            _:N3fb6a4b0bd5143a9aaf618a28ea9a80b,
            _:N5939e746e6bc4c5f958bc097651bdaa4,
            _:N5d5d6925eb3449df9780163e37ed8cc6,
