    ns4:StateAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "This is the state of an affected Element at a specific moment in time."@en ;
        rdfs:subClassOf ns4:UseAction ;
        sh:nodeKind sh:IRI ;
        sh:property _:Na9890d0319cb48c28dd6dacf5748cb09,
            _:Nabe6b06175bf4762be62c4324b8e873c .

    ns4:StorageAction a owl:Class ;
        rdfs:comment "Records the storage of a product."@en ;
        rdfs:subClassOf ns4:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns4:StorageProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Prescribes the storage of a product."@en ;
        rdfs:subClassOf ns4:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N5e8407fddd96475ba8969672651369ce .

    ns4:TestAction a owl:Class ;
        rdfs:comment "A test action is a specific action associated with a test."@en ;
        rdfs:subClassOf ns4:UseAction ;
        sh:nodeKind sh:IRI .

    ns4:TestProcess a owl:Class ;
        rdfs:comment "Test Process defines the testing process for an element."@en ;
        rdfs:subClassOf ns4:UseProcess ;
        sh:nodeKind sh:IRI .

    ns4:TransportAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "An actual change to a product's location."@en ;
