        sh:property _:N5c7326b329f243448c7697739cf3a116,
            _:N75e998eec0734fada87f7db3ad8b528f .

    ns9:StorageAction a owl:Class ;
        rdfs:comment "Records the storage of a product."@en ;
        rdfs:subClassOf ns9:ModifyAction ;
        sh:nodeKind sh:IRI .

