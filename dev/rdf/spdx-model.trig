        rdfs:subClassOf ns8:UseProcess ;
        sh:nodeKind sh:IRI .

    ns8:ReproduceAction a owl:Class ;
        rdfs:comment "Reproduction is the biological process by which organisms generate new individuals of the same species."@en ;
        rdfs:subClassOf ns8:CreateAction ;
        sh:nodeKind sh:IRI .

    ns8:ReproduceProcess a owl:Class ;
        rdfs:comment "Reproduction is the biological process by which living organisms produce offspring."@en ;
        rdfs:subClassOf ns8:CreateProcess ;
        sh:nodeKind sh:IRI .

    ns8:ResolutionAction a owl:Class ;
