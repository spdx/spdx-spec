    _:N036954452ccc43b2b4674bb2d32cef75 a sh:SPARQLConstraint ;
        sh:message "When relationship is providesSupportFor, to must be an Artifact" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/providesSupportFor> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Artifact> }
}""" .

