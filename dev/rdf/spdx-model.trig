        sh:nodeKind sh:IRI ;
        sh:property _:N33d64e02cbdc43c8a4bdc13aff16b91d,
            _:N85b215f959d2463c8283c78e08d09e5b,
            _:Nc18ff8981b8445449e5e49faa44173f6 .

