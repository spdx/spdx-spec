        sh:nodeKind sh:IRI ;
        sh:property _:N31865bb44e6d4ca1a5581fd3bfff035d,
            _:N3dfbd9ad81994cdb9c995e39e244c9ec,
            _:N401de5e6f43a4d95ae9c0fde76de6700,
