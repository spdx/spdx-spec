            sh:NodeShape ;
        rdfs:comment "A prescribed change to a product's location."@en ;
        rdfs:subClassOf ns10:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N8fe3aca5912e44fd87f897421fb5e858,
            _:N96e87928b06b4baf809f7edb7ff55244,
