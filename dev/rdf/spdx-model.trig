        sh:nodeKind sh:IRI ;
        sh:property _:N043b6c25f7f549e3ae7c46ecf5d27044,
            _:N3bce895423ce4fe284087abbbfa7cd81,
            _:N43cc0197796844638fc5efae3c48d4ea,
            _:N5058e30bf7df4868883fa9df041d7cfd,
            _:N79e3a94c6b8d45528c5645620be2c531,
