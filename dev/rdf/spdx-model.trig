        sh:nodeKind sh:IRI ;
        sh:property _:N18c1bef1ad3e4f4697a9fcce3aafcedd .

    ns6:BoundaryDefinitionProcess a owl:Class ;
        rdfs:comment "The Boundary Definition Process refers to the process class used to produce boundaries."@en ;
        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI .

    ns6:ChangeAction a owl:Class ;
        rdfs:comment "An actual change to a product."@en ;
        rdfs:subClassOf ns6:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns6:ChangeProcess a owl:Class ;
        rdfs:comment "A prescribed change to a product."@en ;
        rdfs:subClassOf ns6:ModifyProcess ;
        sh:nodeKind sh:IRI .

    ns6:DestroyAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "The record of destruction is entered in this action."@en ;
