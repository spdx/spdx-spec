    ns9:serialNumber a owl:DatatypeProperty ;
        rdfs:comment "Identifier for specific product is called a serial number."@en ;
        rdfs:range xsd:string .

    ns9:virtualHardwareModel a owl:DatatypeProperty ;
        rdfs:comment "Information related to virtual hardware simulation."@en ;
        rdfs:range ns9:VirtualHardwareModelType .

    ns9:xAxisLength a owl:ObjectProperty ;
