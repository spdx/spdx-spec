    <https://spdx.org/rdf/3.1/terms/Core/RelationshipType/validatedOn> a owl:NamedIndividual,
            ns1:RelationshipType ;
        rdfs:label "validatedOn" ;
        rdfs:comment "The `from` Element has been validated on the `to` Element(s)."@en .

