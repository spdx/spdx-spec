        rdfs:subClassOf ns4:VulnAssessmentRelationship ;
        sh:nodeKind sh:IRI ;
        sh:property _:N5021626ac16d48f7b719bbdfe61c102f .

    ns4:VexAffectedVulnAssessmentRelationship a owl:Class,
