            _:Ndbafa8e13ce84faca57ca1a6b2748e55 .

    ns4:ResponsibilityChangeProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "ResponsibilityChangeProcess refers to the process of transferring responsibility from one party to another."@en ;
        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N823407b02fe84ecb8d52627323d17f07,
            _:Nad4ce3cda10b49ac80da1ed6e5cf9da1,
