        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/delegatedTo> .\n    FILTER NOT EXISTS { $this rdf:type <Core/LifecycleScopedRelationship> }\n}"
      }
    ]
  },
  {
    "@id": "_:N38644adf745c42a08c508522cb8a79e7",
