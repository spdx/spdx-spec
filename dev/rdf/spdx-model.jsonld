      {
        "@id": "_:Nee07e44967514460951b42a911a5a1ba"
      }
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "_:N80eae32cdd0f47a2bc750217697a290c"
      }
    ]
  },
  {
    "@id": "_:N80eae32cdd0f47a2bc750217697a290c",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A value for Core/name is required when a value for Core/version is present"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Software/version> ?version .\n    FILTER NOT EXISTS {\n        $this <Software/name> ?name .\n    }\n}"
      }
    ]
  },
