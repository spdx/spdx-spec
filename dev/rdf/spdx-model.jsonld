      {
        "@language": "en",
        "@value": "Megajoule."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "megajoule"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/algorithm",
