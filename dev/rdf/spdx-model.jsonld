    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An Individual Value for Element representing a set of Elements of unknown\nidentity or cardinality (number)."
      }
    ],
    "https://spdx.org/rdf/3/terms/Core/creationInfo": [
      {
        "@id": "https://spdx.org/rdf/3.1/creationInfo_NoAssertionElement"
      }
    ]
  },
  {
