    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A verificationUID is a unique identifier assigned to a Verification item."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
