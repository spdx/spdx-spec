# https://spdx.org/rdf/3.1/terms/SimpleLicensing/customIdToUri node1674
node1674 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>customIdToUri</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/SimpleLicensing/customIdToUri' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/SimpleLicensing/customIdToUri</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;**DEPRECATED in SPDX 3.1.**
