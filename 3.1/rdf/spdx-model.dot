node1380 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>text</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Dataset/DatasetType/text' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Dataset/DatasetType/text</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Data consists of unstructured text, such as a book, a Wikipedia article (without images), or a transcript.&quot;@en</td></tr></table> > ] 
