# Nc4667ebcb6fc46a6b68d75cd24d40ebd node1297
node1297 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nc4667ebcb6fc46a6b68d75cd24d40ebd</B></td></tr><tr><td href='Nc4667ebcb6fc46a6b68d75cd24d40ebd' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nc4667ebcb6fc46a6b68d75cd24d40ebd</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is doesNotAffect, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
