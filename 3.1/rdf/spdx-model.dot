node1026 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N14f704d47172454e8628c12bfebb2906</B></td></tr><tr><td href='N14f704d47172454e8628c12bfebb2906' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N14f704d47172454e8628c12bfebb2906</font></td></tr><tr><td align='left'>sh:minCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
