# N025c969064bd481d9a498d18c981fb5c node715
node715 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N025c969064bd481d9a498d18c981fb5c</B></td></tr><tr><td href='N025c969064bd481d9a498d18c981fb5c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N025c969064bd481d9a498d18c981fb5c</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasConcludedLicense, to must be an AnyLicenseInfo&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasConcludedLicense&gt; .
    $this &lt;Core/to&gt; ?to .
