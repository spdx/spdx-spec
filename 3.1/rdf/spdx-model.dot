node1207 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nd0e613441b064b0b94e53336be1c40d8</B></td></tr><tr><td href='Nd0e613441b064b0b94e53336be1c40d8' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nd0e613441b064b0b94e53336be1c40d8</font></td></tr></table> > ] 
