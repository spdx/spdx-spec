node1302 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8b525a5300234aa2a7c71ead0385238e</B></td></tr><tr><td href='N8b525a5300234aa2a7c71ead0385238e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8b525a5300234aa2a7c71ead0385238e</font></td></tr></table> > ] 
