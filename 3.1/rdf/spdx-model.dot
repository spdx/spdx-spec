# Nb983795b9ba24cc2bd47c33546f58e75 node1085
node1085 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb983795b9ba24cc2bd47c33546f58e75</B></td></tr><tr><td href='Nb983795b9ba24cc2bd47c33546f58e75' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb983795b9ba24cc2bd47c33546f58e75</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is republishedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/republishedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
