# N700eae6e95b24aaa8f98ea272f0715ac node1540
node1540 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N700eae6e95b24aaa8f98ea272f0715ac</B></td></tr><tr><td href='N700eae6e95b24aaa8f98ea272f0715ac' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N700eae6e95b24aaa8f98ea272f0715ac</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is usesTool, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/usesTool&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalRefType/vulnerabilityExploitabilityAssessment node1541
