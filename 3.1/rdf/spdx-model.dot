# Nec308958ef6d47eaa1cf5a55e8e3c460 node1408
node1408 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nec308958ef6d47eaa1cf5a55e8e3c460</B></td></tr><tr><td href='Nec308958ef6d47eaa1cf5a55e8e3c460' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nec308958ef6d47eaa1cf5a55e8e3c460</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasContactPoint, class must be ContactPointRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasContactPoint&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/ContactPointRelationship&gt; }
}&quot;</td></tr></table> > ] 
# N14ce220f5a7c4ef9919440fd47ddef19 node1409
node1409 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N14ce220f5a7c4ef9919440fd47ddef19</B></td></tr><tr><td href='N14ce220f5a7c4ef9919440fd47ddef19' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N14ce220f5a7c4ef9919440fd47ddef19</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasAssessmentFor, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasAssessmentFor&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
