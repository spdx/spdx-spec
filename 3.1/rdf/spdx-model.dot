node1398 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N46634989d7724a0da26398059a029bfc</B></td></tr><tr><td href='N46634989d7724a0da26398059a029bfc' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N46634989d7724a0da26398059a029bfc</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:minCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
