node1346 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>observation</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType/observation' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType/observation</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Documentation of direct monitoring or witnessing of the demonstration of processes, tests, or any kind of system responses during a specified timeframe under specified environmental conditions.&quot;@en</td></tr></table> > ] 
