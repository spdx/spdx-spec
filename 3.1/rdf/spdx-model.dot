# N80ad56c44b9b466e8980e0e5604c29bd node1542
node1542 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N80ad56c44b9b466e8980e0e5604c29bd</B></td></tr><tr><td href='N80ad56c44b9b466e8980e0e5604c29bd' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N80ad56c44b9b466e8980e0e5604c29bd</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasResolution, from must be a ResolutionAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
