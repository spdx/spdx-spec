node1027 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N54007b9d720e4bfdb874e2d2e0126e4a</B></td></tr><tr><td href='N54007b9d720e4bfdb874e2d2e0126e4a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N54007b9d720e4bfdb874e2d2e0126e4a</font></td></tr></table> > ] 
