# N33864137ce7048df846d3837af3f08e5 node1871
node1871 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N33864137ce7048df846d3837af3f08e5</B></td></tr><tr><td href='N33864137ce7048df846d3837af3f08e5' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N33864137ce7048df846d3837af3f08e5</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasOptionalDependency, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasOptionalDependency&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
# N3ec66b06a9224a7a9b9a9d5aa5732723 node1872
