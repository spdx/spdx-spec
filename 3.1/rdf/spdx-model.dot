# Ncd9df7e78c084db182b1cbf78f58eb88 node1309
node1309 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ncd9df7e78c084db182b1cbf78f58eb88</B></td></tr><tr><td href='Ncd9df7e78c084db182b1cbf78f58eb88' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ncd9df7e78c084db182b1cbf78f58eb88</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is invokedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
