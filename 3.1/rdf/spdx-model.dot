node1792 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N99da080bef154002b302e9cc22c954a9</B></td></tr><tr><td href='N99da080bef154002b302e9cc22c954a9' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N99da080bef154002b302e9cc22c954a9</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasPrerequisite, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
