# Nef188399807a45b9a1fd5b5aaf1eeaf7 node1767
node1767 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nef188399807a45b9a1fd5b5aaf1eeaf7</B></td></tr><tr><td href='Nef188399807a45b9a1fd5b5aaf1eeaf7' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nef188399807a45b9a1fd5b5aaf1eeaf7</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is conformsTo, to must be an Assumption or Specification&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/conformsTo&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;FunctionalSafety/Assumption&gt; }
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Specification&gt; }
}&quot;</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Security/SsvcDecisionType/trackStar node1768
