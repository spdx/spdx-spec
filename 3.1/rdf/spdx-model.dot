node1094 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N3500ba51ce9e43228d4571ba345d5eee</B></td></tr><tr><td href='N3500ba51ce9e43228d4571ba345d5eee' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N3500ba51ce9e43228d4571ba345d5eee</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;https://spdx.org/rdf/3/terms/Security/VulnAssessmentRelationship is an abstract class and should not be instantiated directly. Instantiate a subclass instead.&quot;@en</td></tr></table> > ] 
