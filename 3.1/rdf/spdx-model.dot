# Nc9f4225461464f25a607bd1c51986718 node1365
node1365 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nc9f4225461464f25a607bd1c51986718</B></td></tr><tr><td href='Nc9f4225461464f25a607bd1c51986718' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nc9f4225461464f25a607bd1c51986718</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is runsOn, to must be a Hardware&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
