node1424 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>modelDataPreprocessing</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/AI/modelDataPreprocessing' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/AI/modelDataPreprocessing</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Preprocessing steps applied to the training data before the model training.&quot;@en</td></tr></table> > ] 
