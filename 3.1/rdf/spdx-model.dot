# N90eee98ef52f48e594d156c80ce4e45e node1234
node1234 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N90eee98ef52f48e594d156c80ce4e45e</B></td></tr><tr><td href='N90eee98ef52f48e594d156c80ce4e45e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N90eee98ef52f48e594d156c80ce4e45e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, from must be an Action or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
