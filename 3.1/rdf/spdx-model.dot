# N64a9f8d693104189988e13dcd932568a node1623
node1623 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N64a9f8d693104189988e13dcd932568a</B></td></tr><tr><td href='N64a9f8d693104189988e13dcd932568a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N64a9f8d693104189988e13dcd932568a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is providesSupportFor, from must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
