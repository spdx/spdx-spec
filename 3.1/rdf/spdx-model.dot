node333 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>development</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/SupportType/development' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/SupportType/development</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The artifact is in active development and is not considered ready for formal support from the supplier.&quot;@en</td></tr></table> > ] 
