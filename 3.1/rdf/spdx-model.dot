# N4aaee0d79fad4dc9b3aef5c8165b0d59 node195
node195 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N4aaee0d79fad4dc9b3aef5c8165b0d59</B></td></tr><tr><td href='N4aaee0d79fad4dc9b3aef5c8165b0d59' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N4aaee0d79fad4dc9b3aef5c8165b0d59</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is tracedToDetail, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/tracedToDetail&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
# N28c1cecf7a9b43b39bea108f5df5761e node196
