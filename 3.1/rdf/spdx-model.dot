# N102b6a9c3ccd48f5b8509e4866ffb72d node782
node782 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N102b6a9c3ccd48f5b8509e4866ffb72d</B></td></tr><tr><td href='N102b6a9c3ccd48f5b8509e4866ffb72d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N102b6a9c3ccd48f5b8509e4866ffb72d</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is resolved, from must be a ResolutionAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/resolved&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;SupplyChain/ResolutionAction&gt; }
}&quot;</td></tr></table> > ] 
