# N46a4b1e6b5024ba5be70dc39704c4228 node1906
node1906 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N46a4b1e6b5024ba5be70dc39704c4228</B></td></tr><tr><td href='N46a4b1e6b5024ba5be70dc39704c4228' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N46a4b1e6b5024ba5be70dc39704c4228</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is republishedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
