# Nf20dee20f8b54c88b4bca01495746727 node975
node975 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf20dee20f8b54c88b4bca01495746727</B></td></tr><tr><td href='Nf20dee20f8b54c88b4bca01495746727' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf20dee20f8b54c88b4bca01495746727</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, from must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/delegatedTo&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
