node318 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N0453610832af4e30afce3b343f7dd8e0</B></td></tr><tr><td href='N0453610832af4e30afce3b343f7dd8e0' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N0453610832af4e30afce3b343f7dd8e0</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is providesSupportFor, class must be SupportRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
