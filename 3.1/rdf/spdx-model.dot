node1378 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N47d34a6d14df4d6a9b6eb3d3a909271b</B></td></tr><tr><td href='N47d34a6d14df4d6a9b6eb3d3a909271b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N47d34a6d14df4d6a9b6eb3d3a909271b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;A value for Core/name is required when a value for Core/version is present&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
