node945 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf3df10f3ce49449ba6f12576e77d0fe7</B></td></tr><tr><td href='Nf3df10f3ce49449ba6f12576e77d0fe7' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf3df10f3ce49449ba6f12576e77d0fe7</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is affects, from must be a Vulnerability, Action, or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
