# N3b5fbacb9e9b40ed8b2fc64a413d9163 node1887
node1887 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N3b5fbacb9e9b40ed8b2fc64a413d9163</B></td></tr><tr><td href='N3b5fbacb9e9b40ed8b2fc64a413d9163' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N3b5fbacb9e9b40ed8b2fc64a413d9163</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is verifiedBy, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
