# N4e823c7cc44c4c8b85e660e836f0a409 node1381
node1381 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N4e823c7cc44c4c8b85e660e836f0a409</B></td></tr><tr><td href='N4e823c7cc44c4c8b85e660e836f0a409' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N4e823c7cc44c4c8b85e660e836f0a409</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/fixedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
