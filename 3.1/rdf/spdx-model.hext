["https://spdx.org/rdf/3/terms/AI/EnergyUnitType/kilowattHour", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/AI/EnergyUnitType", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/PhysicalLocation", "http://www.w3.org/2000/01/rdf-schema#comment", "A physical location is a tangible, geographically identifiable place where objects, people, or assets exist or operate.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ProfileIdentifierType/build", "http://www.w3.org/2000/01/rdf-schema#comment", "The element follows the Build profile specification.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
