["https://spdx.org/rdf/3/terms/Core/assignedBy", "http://www.w3.org/2000/01/rdf-schema#comment", "assignedBy identifies the agent that grants or assigns the role to the target element.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
