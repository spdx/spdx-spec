["https://spdx.org/rdf/3.1/terms/Operations/projectEndTime", "http://www.w3.org/2000/01/rdf-schema#comment", "Time when the project ends or is planned to end.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
