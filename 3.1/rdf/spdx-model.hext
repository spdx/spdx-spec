["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/isbn", "http://www.w3.org/2000/01/rdf-schema#comment", "[International Standard Book Number (ISBN)](https://www.isbn-international.org/content/isbn-users-manual/29) is a unique numeric identifier for monographic publications standardized by [ISO 2108](https://www.iso.org/standard/65483.html). It consists of either 10 digits (for assignments prior to January 1, 2007) or 13 digits. A 13-digit ISBN is composed of five parts: a GS1 prefix, a registration group, a registrant, a publication element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., `9780198836063`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Security/VexAffectedVulnAssessmentRelationship", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/ns/shacl#NodeShape", "globalId", "", ""]
["_:Nb5275e59446e42bcabb9ad0bee92ce77", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:N0e65467198974145833670aabe210c7b", "localId", "", ""]
["https://spdx.org/rdf/3.1/terms/Dataset/ConfidentialityLevelType/amber", "http://www.w3.org/2000/01/rdf-schema#label", "amber", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/Specification", "http://www.w3.org/ns/shacl#nodeKind", "http://www.w3.org/ns/shacl#IRI", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Security/SsvcDecisionType/act", "http://www.w3.org/2000/01/rdf-schema#comment", "The vulnerability requires attention from the organization's internal, supervisory-level and leadership-level individuals. Necessary actions include requesting assistance or information about the vulnerability, as well as publishing a notification either internally and/or externally. Typically, internal groups would meet to determine the overall response and then execute agreed upon actions. CISA recommends remediating Act vulnerabilities as soon as possible.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Dataset/DatasetType/noAssertion", "http://www.w3.org/2000/01/rdf-schema#label", "noAssertion", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/RelationshipType/resolved", "http://www.w3.org/2000/01/rdf-schema#comment", "The `to` OutOfSpecAction is resolved in the `from` ResolutionAction.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/Requirement", "http://www.w3.org/ns/shacl#nodeKind", "http://www.w3.org/ns/shacl#IRI", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/module", "http://www.w3.org/2000/01/rdf-schema#comment", "The Element is a module of a piece of software.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
