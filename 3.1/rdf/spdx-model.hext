["_:N0c79e606d2aa41f38bfcca84b3c74c93", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/library", "globalId", "", ""]
