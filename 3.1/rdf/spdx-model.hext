["https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel/autonomous", "http://www.w3.org/2000/01/rdf-schema#comment", "Level 6 - Autonomous. The system is capable of modifying its intended domain of use or its goals without external intervention, control or oversight.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N90036818aba94a4dbe45b31d3179679d", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/application", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ark", "http://www.w3.org/2000/01/rdf-schema#comment", "[Archival Resource Key (ARK)](https://arks.org/about/), is a Uniform Resource Identifier (URI) suited to being a persistent identifier for information objects of any type, standardized by the [ARK Identifier Scheme](https://datatracker.ietf.org/doc/draft-kunze-ark/) Internet-Draft. It consists of the \"ark:\" label followed by a Name Assigning Authority Number, a forward slash, a name, and an optional qualifier (e.g., `ark:12148/btv1b8449691v/f29`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/purchaseOrder", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
