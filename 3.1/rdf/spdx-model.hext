["_:N015cc6f404ec464ba85c75544c1e1885", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/cpe23", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvaluationResultType/inconclusive", "http://www.w3.org/2000/01/rdf-schema#comment", "Inconclusive refers to a result or outcome from a verification, test, or analysis that cannot be clearly classified as either positive (successful, pass) or negative (failed, reject). An inconclusive result means there was not enough clear evidence, data, or signal to make a definitive determination, and further investigation or additional testing is necessary. An inconclusive result always shall need a comment on it.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/isni", "http://www.w3.org/2000/01/rdf-schema#comment", "[International Standard Name Identifier (ISNI)](https://isni.org/page/what-is-isni/) is a unique identifier used to distinguish the public identities of parties involved in the creation, production, and distribution of media content. Standardized by [ISO 27729](https://www.iso.org/standard/87177.html), it consists of 16 characters\u201415 digits plus a final check character\u2014and is often represented as a URI, such as `https://isni.org/isni/000000012146438X`.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nd9a14fcc99f84e649e960876987ab65d", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:Na8ee9231230b425294c9285a2e055a2c", "localId", "", ""]
