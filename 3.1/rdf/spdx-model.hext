["https://spdx.org/rdf/3/terms/Core/UnitOfMeasure", "http://www.w3.org/2000/01/rdf-schema#comment", "A class that represents a measured quantity paired with a unit of measure from the QUDT ontology.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/locatedAt", "http://www.w3.org/2000/01/rdf-schema#comment", "`from` Element located at a specific `to` Location. A time period is optional.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
