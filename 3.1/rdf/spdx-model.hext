["https://spdx.org/rdf/3/terms/Core/NamespaceMap", "http://www.w3.org/2000/01/rdf-schema#comment", "A mapping between prefixes and namespace partial URIs.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Security/locator", "http://www.w3.org/2000/01/rdf-schema#comment", "Provides the location of an exploit catalog.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
