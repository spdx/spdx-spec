["https://spdx.org/rdf/3/terms/FunctionalSafety/SafetyIntegrityLevelType/sil3", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
