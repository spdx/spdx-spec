      }
    ]
  },
  {
    "@id": "_:N7cd628eb46c4455eadc95c3207b3a69a",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "https://spdx.org/rdf/3/terms/Security/VulnAssessmentRelationship is an abstract class and should not be instantiated directly. Instantiate a subclass instead."
      }
    ],
