  {
    "@id": "https://spdx.org/rdf/3/terms/Hardware/Dimensions",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Dimensions generally refer to measurable extents or attributes that define the size, shape, or scale of an object, system, or concept."
