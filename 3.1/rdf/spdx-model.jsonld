    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "AssemblyAction represents the event of creating a product by assembling individual components."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3/terms/SupplyChain/CreateAction"
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
