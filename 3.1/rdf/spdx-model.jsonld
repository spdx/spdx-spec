      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "lei"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/SupplyChain/AssemblyProcess",
