        "@language": "en",
        "@value": "Indicates a failed evaluation where the requirement or condition is not met."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "fail"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/algorithm",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
