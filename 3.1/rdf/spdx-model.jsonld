      "https://spdx.org/rdf/3/terms/Core/RequirementStatusType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A requirement has been approved by stakeholder, and can be include in traceability."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "active"
      }
    ]
  },
