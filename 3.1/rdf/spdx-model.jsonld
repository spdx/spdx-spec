  {
    "@id": "https://spdx.org/rdf/3/terms/Core/RelationshipType/hasDeclaredLicense",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/RelationshipType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The `from` Artifact was discovered to actually contain each `to` /SimpleLicensing/AnyLicenseInfo (for example, as detected by automated tooling)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
