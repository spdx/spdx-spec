  {
    "@id": "https://spdx.org/rdf/3/terms/Core/externalIdentifier",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Provides a reference to a resource outside the scope of SPDX 3 content\nthat uniquely identifies an Element."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifier"
      }
