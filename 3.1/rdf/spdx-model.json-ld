        "@id": "http://www.w3.org/ns/shacl#BlankNodeOrIRI"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:N8cad5e54dee041d5b18ad8ddf8879960"
