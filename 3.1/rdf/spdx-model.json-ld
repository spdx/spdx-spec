      "https://spdx.org/rdf/3/terms/Security/VexJustificationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The software is not affected because the vulnerable component is not in the product."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "componentNotPresent"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel/fullAutomation",
