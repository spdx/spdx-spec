        sh:nodeKind sh:IRI ;
        sh:property _:N1fc296cbbfcd411d9398a49818f78025,
            _:N394823d74a1e47b28bedfe1dd91084e2,
            _:N9c0f735f5f4d47f8ae91181eb2859b46,
