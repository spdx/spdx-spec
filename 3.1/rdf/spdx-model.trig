        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns7:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns2:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N1116134cedb14ec9990908bf1565145c,
            _:N1cf05c4fc0f44441bffbe6f9c4187ca5,
            _:N2929301130f74d8abf5b796ca99bd378,
            _:N51afd67414a14114bba6e684ddcc5f3b,
            _:N5f13f6369fa0494081bc5625d4bda163,
            _:N6dd9f8581f5a435e883023ccba623cc9,
