    <https://spdx.org/rdf/3/terms/SimpleLicensing/licenseListVersion> a owl:DatatypeProperty ;
        rdfs:comment "The version of the SPDX License List used in the license expression."@en ;
        rdfs:range xsd:string .

    ns6:AbstractPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Refers to an abstract, conceptual software entity."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N32369afcbef84801980373944d18bf27,
            _:N62dd4f37631845eab278b37795858053,
