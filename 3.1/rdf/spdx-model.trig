    <https://spdx.org/rdf/3/terms/Service/KeyValidationProtocolType/ocsp> a owl:NamedIndividual,
            ns9:KeyValidationProtocolType ;
        rdfs:label "ocsp" ;
        rdfs:comment "Online Certificate Status Protocol, or OCSP, is a common scheme used to maintain the security of a server and other network resources as defined in [RFC 2560](https://datatracker.ietf.org/doc/rfc2560/)"@en .

    <https://spdx.org/rdf/3/terms/Service/KeyValidationProtocolType/other> a owl:NamedIndividual,
            ns9:KeyValidationProtocolType ;
