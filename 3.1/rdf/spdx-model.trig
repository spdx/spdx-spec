    _:N04c90eb140494631b1b38372561ff903 a sh:SPARQLConstraint ;
        sh:message "When relationship is hasInstall, to must be an Artifact" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/hasInstall> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Artifact> }
}""" .

