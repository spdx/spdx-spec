    ns8:EvaluationResult a owl:Class,
            sh:NodeShape ;
        rdfs:comment "EvaluationResult is the result of an evaluation."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N77cac37ce9ca46b6be718a55c4874aeb,
            _:Nbcfaf4ff8a174830bf1f8499033b0558,
