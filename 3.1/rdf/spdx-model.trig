        sh:nodeKind sh:IRI ;
        sh:property _:N079268e94ec54996bfcfc212d9cd2169,
            _:N09ab34c64d0c4b5abd247ddca2172283,
            _:N1058f260fd234ee28ddde71653316a3b,
            _:N1c6dd6689ed44baebf71ca10ab449482,
