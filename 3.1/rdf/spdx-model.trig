    _:N04ee92ee0c8847b7a209ba27488c7791 a sh:SPARQLConstraint ;
        sh:message "When relationship is conformsTo, to must be an Assumption or Specification" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/conformsTo> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <FunctionalSafety/Assumption> }
