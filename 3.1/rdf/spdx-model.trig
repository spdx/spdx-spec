    ns3:CustomLicense a owl:Class ;
        rdfs:comment "A license that is not listed on the SPDX License List."@en ;
        rdfs:subClassOf ns3:License ;
        sh:nodeKind sh:IRI .

    ns3:CustomLicenseAddition a owl:Class ;
