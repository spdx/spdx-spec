        sh:nodeKind sh:IRI ;
        sh:property _:N09380c27d688441db1a224392f6db8d2,
            _:N13c094bf75504aaeb34dfb5fa71d49c6,
            _:N46742019a4fb4676b1bc1d23ec014ed4,
