        sh:nodeKind sh:IRI ;
        sh:property _:N0eb8c220bcc844e08b6fab4ac8e5a769,
            _:N2a6a7c8c70c244aea6d7cb439fe7c044,
            _:N4b3921443f4e4176972b30f77c19da45,
