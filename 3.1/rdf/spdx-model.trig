        rdfs:subClassOf ns4:CreateProcess ;
        sh:nodeKind sh:IRI .

    ns4:OutOfSpecAction a owl:Class ;
        rdfs:comment "An out of specification action is defined in this class."@en ;
        rdfs:subClassOf ns4:UseAction ;
        sh:nodeKind sh:IRI .

    ns4:PlanAction a owl:Class ;
        rdfs:comment "A PlanAction involves the execution of a plan in relation to a PlanProcess."@en ;
        rdfs:subClassOf ns4:UseAction ;
        sh:nodeKind sh:IRI .

    ns4:PlanProcess a owl:Class ;
