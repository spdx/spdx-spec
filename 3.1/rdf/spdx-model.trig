    _:N086da6e2cc514ff7b859688df3767991 a sh:SPARQLConstraint ;
        sh:message "When relationship is usesTool, class must be LifecycleScopedRelationship" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/usesTool> .
    FILTER NOT EXISTS { $this rdf:type <Core/LifecycleScopedRelationship> }
}""" .

    _:N090c36b89a75489390daf1d01ea8d75f a sh:SPARQLConstraint ;
        sh:message "When relationship is fixedIn, class must be VexFixedVulnAssessmentRelationship" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/fixedIn> .
    FILTER NOT EXISTS { $this rdf:type <Security/VexFixedVulnAssessmentRelationship> }
}""" .

    _:N0929cd99196646b98a8124cc2f786a2d a sh:SPARQLConstraint ;
        sh:message "When relationship is hasDeclaredLicense, to must be an AnyLicenseInfo" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/hasDeclaredLicense> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <SimpleLicensing/AnyLicenseInfo> }
}""" .

