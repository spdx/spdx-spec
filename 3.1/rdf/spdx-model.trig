        sh:nodeKind sh:IRI ;
        sh:property _:N8f6609b860b8458aa2f01c651ba5b1f7,
            _:Ncebed3e1b8e442fdbb1e01de66fdbc01 .

    ns7:OrLaterOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing this version, or any later version,
of the indicated License."""@en ;
