            sh:NodeShape ;
        rdfs:comment "A license or addition that is not listed on the SPDX License List."@en ;
        rdfs:subClassOf ns6:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N963cc61707e54e5daedf85ecbcf9ef19 .

    <https://spdx.org/rdf/3.1/terms/SimpleLicensing/customIdToUri> a owl:ObjectProperty ;
        rdfs:comment """Maps a LicenseRef or AdditionRef string for a Custom License or a Custom
License Addition to its URI ID."""@en ;
        rdfs:range ns6:DictionaryEntry .

    <https://spdx.org/rdf/3.1/terms/SimpleLicensing/licenseExpression> a owl:DatatypeProperty ;
