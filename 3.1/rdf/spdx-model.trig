        sh:nodeKind sh:IRI ;
        sh:property _:N2f8a71ea81844f78911e0d7bb5646b6b,
            _:N48724a060e994f7abffe03175ba4b035 .

    ns7:additionText a owl:DatatypeProperty ;
        rdfs:comment "Identifies the full text of a LicenseAddition."@en ;
        rdfs:range xsd:string .

    ns7:isDeprecatedAdditionId a owl:DatatypeProperty ;
        rdfs:comment "Specifies whether an additional text identifier has been marked as deprecated."@en ;
