        sh:nodeKind sh:IRI ;
        sh:property _:N0aa30fa98d1749b09da5f277dd974a79,
            _:N0d25a4da1af04af598d1986e2884bd46,
            _:N2d1eb0648b064770998c6d65e036f349,
            _:N34986c8854044e23a8dabb838a8097ab,
            _:N7920d7260a0c49b187f06972391463ce,
