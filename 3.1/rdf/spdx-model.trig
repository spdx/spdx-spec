        sh:nodeKind sh:IRI ;
        sh:property _:N30a7fcc5465f4063a4625f7f8470f4d3,
            _:N5b2730508c094e91b28d5a25bd3823b7,
            _:N6265cdbe8b3641d8b72906fdf6c33791,
