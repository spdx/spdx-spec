        sh:nodeKind sh:IRI ;
        sh:property _:N09501b3e79b5440aae61a46cb780aba8,
            _:N1d1dbfcfb1c3444db6896bac0f8f0837,
            _:N238c4842cf6445249bc6d26f61be14ad,
