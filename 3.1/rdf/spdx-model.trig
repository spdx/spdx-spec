        sh:nodeKind sh:IRI ;
        sh:property _:N57cda535a42b4bc79d574f4552e0e494,
            _:N6b95a80ececd477f85e4bf2df0f02fd5,
            _:N71fefd25a2a540588c5c02fedd4623ea .

    ns3:provider a owl:ObjectProperty ;
        rdfs:comment "The provider of a SoftwareService."@en ;
        rdfs:range ns6:Agent .

    ns3:serverAuthenticationProtocol a owl:ObjectProperty ;
        rdfs:comment "Authentication protocol used by a server."@en ;
        rdfs:range ns3:AuthenticationProtocolType .

    ns3:serviceHostingCountry a owl:DatatypeProperty ;
        rdfs:comment "Specifies a country code where a software service is hosted."@en ;
        rdfs:range xsd:string .

    <https://spdx.org/rdf/3.1/terms/SimpleLicensing/LicenseExpression> a owl:Class,
            sh:NodeShape ;
