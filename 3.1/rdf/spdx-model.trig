        rdfs:label "staticAnalysisReport" ;
        rdfs:comment "A reference to a static analysis report for a package."@en .

    <https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/support> a owl:NamedIndividual,
            ns6:ExternalRefType ;
        rdfs:label "support" ;
