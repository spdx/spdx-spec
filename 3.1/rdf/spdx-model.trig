        sh:property _:N9f5858217c944c058659c96ddf0211c0 .

    ns7:CustomLicense a owl:Class ;
        rdfs:comment "A license that is not listed on the SPDX License List."@en ;
        rdfs:subClassOf ns7:License ;
        sh:nodeKind sh:IRI .

    ns7:CustomLicenseAddition a owl:Class ;
        rdfs:comment "A license addition that is not listed on the SPDX Exceptions List."@en ;
        rdfs:subClassOf ns7:LicenseAddition ;
        sh:nodeKind sh:IRI .

    ns7:DisjunctiveLicenseSet a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing a set of licensing information where
only one of the elements applies."""@en ;
        rdfs:subClassOf <https://spdx.org/rdf/3/terms/SimpleLicensing/AnyLicenseInfo> ;
        sh:nodeKind sh:IRI ;
        sh:property _:N49562c84816b47eaa06cf1966e508579 .

    ns7:ListedLicense a owl:Class,
