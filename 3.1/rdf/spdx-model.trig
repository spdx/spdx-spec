    _:N028cada4842a4386b1b9bdb4224b7cb5 a sh:SPARQLConstraint ;
        sh:message "When relationship is runsOn, to must be a Hardware" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/runsOn> .
