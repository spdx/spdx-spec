            sh:NodeShape ;
        rdfs:comment "Software provided as a service over a network."@en ;
        rdfs:subClassOf ns1:Artifact ;
        sh:nodeKind sh:IRI ;
        sh:property _:N5009857fa8e243228b7790f7da19f08e,
            _:Nbaa552bb63a04af4870072b52bea4fc8 .

    ns5:serverAuthenticationProtocol a owl:ObjectProperty ;
