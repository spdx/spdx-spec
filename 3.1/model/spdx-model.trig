            ns5:SoftwarePurpose ;
        rdfs:label "firmware" ;
        rdfs:comment "The Element provides low level control over a device's hardware."@en .

    <https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/framework> a owl:NamedIndividual,
            ns5:SoftwarePurpose ;
        rdfs:label "framework" ;
