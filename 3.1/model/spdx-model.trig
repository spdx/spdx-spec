        sh:nodeKind sh:IRI ;
        sh:property _:Na73fc61aab7a4846a95187805de18207 .

    ns3:BoundaryDefinitionProcess a owl:Class ;
        rdfs:comment "The Boundary Definition Process refers to the process class used to produce boundaries."@en ;
        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI .

    ns3:ChangeAction a owl:Class ;
        rdfs:comment "An actual change to a product."@en ;
        rdfs:subClassOf ns3:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns3:ChangeProcess a owl:Class ;
        rdfs:comment "A prescribed change to a product."@en ;
        rdfs:subClassOf ns3:ModifyProcess ;
        sh:nodeKind sh:IRI .

    ns3:DestroyAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "The record of destruction is entered in this action."@en ;
