        sh:property _:N6496a5e4d96e4839977372bc531ccdae,
            _:Nf91cb8a92fbb485e809763ebf4d45a7f .

    ns10:ListedLicenseException a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A license exception that is listed on the SPDX Exceptions list."@en ;
