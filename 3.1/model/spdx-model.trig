            sh:NodeShape ;
        rdfs:comment "Provides an exploit assessment of a vulnerability."@en ;
        rdfs:subClassOf ns9:VulnAssessmentRelationship ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0f203c93addd4d1db0ca77ff33cdfc19,
