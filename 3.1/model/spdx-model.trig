    ns2:inLanguage a owl:DatatypeProperty ;
        rdfs:comment "Specifies a human language used within the content of an Element or a property."@en ;
        rdfs:range xsd:string .

    ns2:intendedUse a owl:DatatypeProperty ;
        rdfs:comment "The intendedUse property is designed to capture a summary of how or for what item or artifact is meant to be used for."@en ;
        rdfs:range xsd:string .

    ns2:issuingAuthority a owl:DatatypeProperty ;
        rdfs:comment "An entity that is authorized to issue identification credentials."@en ;
