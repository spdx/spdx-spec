        sh:nodeKind sh:IRI ;
        sh:property _:N244e7e5ec5074bcc828a5c957e38d9db,
            _:N3d7fe047fcb74a26b8b77546649a1014,
            _:N60d447f84b354396b1f8aedac281f112 .

    ns4:TransportProcess a owl:Class,
            sh:NodeShape ;
