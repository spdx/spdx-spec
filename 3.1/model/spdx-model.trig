        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns7:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns2:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N1885b67882c6476885c8f3ea014f9076,
            _:N196d2c113a104dea9a1fedb7d678b3d3,
            _:N1e028f881b1e48e6b355d309d70b46d2,
            _:N242422507c124a5399eef20001f0542b,
            _:N57d456acf67c437195edcf2a5177b7d5,
            _:N5e5b188910754102a4d5606c9d7bbe25,
            _:N79d3ca99ee90455a9f228ebc3f34db09,
            _:N9d93953b928748d3a32b5ec0ff42639b,
            _:Na284b86bab3246a796880520b0f7f0fc,
            _:Nbdbf55f622eb4dbea07e1bc018506253,
            _:Nbeb3b80033f2401db212f2917e98be35,
            _:Nce69ab701d7c46bf86eac7a377cdd14e,
