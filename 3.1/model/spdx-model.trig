        rdfs:range ns1:UnitOfMeasure .

    ns5:category a owl:ObjectProperty ;
        rdfs:comment "The category describes the hardware item in a DefinedType."@en ;
        rdfs:range ns1:DefinedType .

    ns5:centerOfMass a owl:ObjectProperty ;
