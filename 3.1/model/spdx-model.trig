        sh:nodeKind sh:IRI ;
        sh:property _:N10ee31972dd74922bc4aa63c828894bc,
            _:N61276cf2d76946a7bd5e4ac1fa69cab5 .

    ns7:additionText a owl:DatatypeProperty ;
