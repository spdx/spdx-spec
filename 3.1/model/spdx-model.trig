    _:N00af27abd6e54b30bbff2a2838c6f102 a sh:SPARQLConstraint ;
        sh:message "When relationship is underInvestigationFor, from must be a Vulnerability" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/underInvestigationFor> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }
}""" .

