    ns3:packageVersion a owl:DatatypeProperty ;
        rdfs:comment "Identify the version of a package."@en ;
        rdfs:range xsd:string .

    ns3:primaryPurpose a owl:ObjectProperty ;
        rdfs:comment "Provides information about the primary purpose of the software artifact."@en ;
        rdfs:range ns3:SoftwarePurpose .

    ns3:sbomType a owl:ObjectProperty ;
