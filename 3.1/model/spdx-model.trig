        sh:nodeKind sh:IRI ;
        sh:property _:N02fb6497a0d64e4f8cc0c6fcc2c26f14,
            _:N09d13c72dc774203a725ecc8f5c315e4,
            _:N1ab610b854664563adc138aa5d45a3db,
            _:N1befff3cfd2d4ff4b110ef552b4eb279,
            _:N242627b0d8c348acae53fa95c55211b9,
            _:N715e106727954ed09ff5816fadea4205,
