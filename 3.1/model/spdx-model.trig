        sh:nodeKind sh:IRI .

    ns6:CustomLicenseAddition a owl:Class ;
        rdfs:comment "A license addition that is not listed on the SPDX Exceptions List."@en ;
        rdfs:subClassOf ns6:LicenseAddition ;
        sh:nodeKind sh:IRI .

    ns6:DisjunctiveLicenseSet a owl:Class,
