        rdfs:subClassOf <https://spdx.org/rdf/3/terms/SimpleLicensing/AnyLicenseInfo> ;
        sh:nodeKind sh:IRI ;
        sh:property _:N071c8aad411f4521bf2ac30a4fa3e57d,
