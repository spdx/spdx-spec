        sh:nodeKind sh:IRI ;
        sh:property _:N802d99c623ca4d4897e6aa613e502304,
            _:Nf9496479aa214119aa81f38a0bade91d .

    ns8:serverAuthenticationProtocol a owl:ObjectProperty ;
