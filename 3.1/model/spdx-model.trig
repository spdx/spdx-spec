    ns5:Assumption a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A distinct unit representing a constraint associated with an item's use in a system."@en ;
        rdfs:subClassOf ns3:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N23dc263c77fd4619b61b14609a61b3aa,
            _:N8cdf576bf9f247339a272a0ec2f1530c,
