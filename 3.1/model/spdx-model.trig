        rdfs:range ns1:MeasureOfLength .

    ns9:yAxisLength a owl:ObjectProperty ;
        rdfs:comment "Information related to hardware dimension."@en ;
        rdfs:range ns1:MeasureOfLength .

    ns9:zAxisLength a owl:ObjectProperty ;
        rdfs:comment "Information related to hardware dimension."@en ;
        rdfs:range ns1:MeasureOfLength .

