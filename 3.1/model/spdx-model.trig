        sh:nodeKind sh:IRI ;
        sh:property _:N246d1314cc2c4205a44ca79aef9cc9b5,
            _:N54f6b97f00c6411ba2e41c6d05c50a44,
            _:N6dc86a14f41e4affad08264cda0a66b1,
            _:Na52826a1c7bc456fa884471ebe658660,
            _:Nadf42a4632474497893ed71cbd929f8b,
