        sh:nodeKind sh:IRI ;
        sh:property _:N25de645932a64ab6974a276bdb7359e9,
            _:N7b52cc1215314ca788518ade674ab255,
            _:N7d8da955bff742d880be02ddaa4bc61d,
            _:N9b5a52ea52ee4b06bc174c6a85293ecd,
            _:Na4ca54a8b789412aa355cf253499ab9b,
            _:Nb46e70ed97e54b85a1aa3a8f5f49c3d9,
            _:Nc2a5e1b1517e491abf71b9d7145fa65b,
            _:Ncd039e0089b748989f68340ce0e7ad76,
            _:Nf0648c8fbdfa452f929165ed924fecf7 .

