        sh:nodeKind sh:IRI ;
        sh:property _:N4ebd5b980da448f698e90cb02b27f51f,
            _:Ndbeb2f4871a147809d957892adea05cd .

    ns6:serverAuthenticationProtocol a owl:ObjectProperty ;
        rdfs:comment "Authentication protocol used by a server."@en ;
