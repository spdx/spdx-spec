        rdfs:range xsd:nonNegativeInteger .

    ns5:datasetType a owl:ObjectProperty ;
        rdfs:comment "Type of data in a dataset."@en ;
        rdfs:range ns5:DatasetType .

    ns5:datasetUpdateMechanism a owl:DatatypeProperty ;
        rdfs:comment "Mechanism to update the dataset."@en ;
        rdfs:range xsd:string .

    ns5:hasSensitivePersonalInformation a owl:ObjectProperty ;
