        rdfs:range ns1:Location .

    ns7:plannedPickupLocation a owl:ObjectProperty ;
        rdfs:comment "A location where a package or an item will be picked up."@en ;
        rdfs:range ns1:Location .

    ns7:plannedPreviousResponsibleAgent a owl:ObjectProperty ;
