            sh:NodeShape ;
        rdfs:comment "A prescribed change to a product's location."@en ;
        rdfs:subClassOf ns5:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0c00805588164e54a7d6ceabec072ded,
            _:N2668fecdaed24ec2a99e34289d8a1a5e,
