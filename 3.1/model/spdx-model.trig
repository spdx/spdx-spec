            ns8:EvidenceType ;
        rdfs:label "other" ;
        rdfs:comment "Any other relevant type of proof or documentation not covered above."@en .

    <https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType/recording> a owl:NamedIndividual,
            ns8:EvidenceType ;
        rdfs:label "recording" ;
