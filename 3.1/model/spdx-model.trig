        rdfs:range ns2:ConfidentialityLevelType .

    ns2:dataCollectionProcess a owl:DatatypeProperty ;
        rdfs:comment "Describes how the dataset was collected."@en ;
        rdfs:range xsd:string .

    ns2:dataPreprocessing a owl:DatatypeProperty ;
        rdfs:comment "Describes the preprocessing steps that were applied to the raw data to create the given dataset."@en ;
        rdfs:range xsd:string .

    ns2:datasetAvailability a owl:ObjectProperty ;
        rdfs:comment "The field describes the availability of a dataset."@en ;
        rdfs:range ns2:DatasetAvailabilityType .

    ns2:datasetNoise a owl:DatatypeProperty ;
        rdfs:comment "Describes potentially noisy elements of the dataset."@en ;
        rdfs:range xsd:string .

    ns2:datasetSize a owl:DatatypeProperty ;
        rdfs:comment """Captures the size of the dataset.

Deprecated in SPDX 3.1.
Use [artifactSize](../../Software/Properties/artifactSize.md) instead."""@en ;
        rdfs:range xsd:nonNegativeInteger .

    ns2:datasetType a owl:ObjectProperty ;
        rdfs:comment "Describes the type of the given dataset."@en ;
        rdfs:range ns2:DatasetType .

    ns2:datasetUpdateMechanism a owl:DatatypeProperty ;
        rdfs:comment "Describes a mechanism to update the dataset."@en ;
        rdfs:range xsd:string .

    ns2:hasSensitivePersonalInformation a owl:ObjectProperty ;
        rdfs:comment "Describes if any sensitive personal information is present in the dataset."@en ;
        rdfs:range ns3:PresenceType .

    ns2:inLanguage a owl:DatatypeProperty ;
        rdfs:comment "Specifies a human language used within a dataset."@en ;
        rdfs:range xsd:string .

    ns2:intendedUse a owl:DatatypeProperty ;
        rdfs:comment "Describes what the given dataset should be used for."@en ;
        rdfs:range xsd:string .

    ns2:knownBias a owl:DatatypeProperty ;
        rdfs:comment "Records the biases that the dataset is known to encompass."@en ;
        rdfs:range xsd:string .

    ns2:sensor a owl:ObjectProperty ;
        rdfs:comment "Describes a sensor used for collecting the data."@en ;
        rdfs:range ns3:DictionaryEntry .

