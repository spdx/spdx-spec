        sh:nodeKind sh:IRI ;
        sh:property _:N3d382d5b55194a21bf086ec3f2620adb,
            _:Nd9c5f8a2af0847b8acd0354c87bf8079 .

    ns2:serverKeyValidationProtocol a owl:ObjectProperty ;
        rdfs:comment "Key validation protocol used during the authentication of servers or services over a network."@en ;
        rdfs:range ns2:KeyValidationProtocolType .

    ns2:serviceHostingCountry a owl:DatatypeProperty ;
        rdfs:comment "Specifies a country code where a software service is hosted."@en ;
        rdfs:range xsd:string .

