            sh:NodeShape ;
        rdfs:comment "An SPDX Element containing an SPDX license expression string."@en ;
        rdfs:subClassOf <https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo> ;
        sh:nodeKind sh:IRI ;
        sh:property _:N01d68c21841247f8969a3b943e032d2a,
