        sh:nodeKind sh:IRI ;
        sh:property _:N1adae60e22ac4a1287b5cb2e8a5d5b85,
            _:N5349878c3a1c431fbc6b30f4df088966,
            _:N6055f9ab423f4714a1e5f6a539ad6f46,
            _:N64f7a48144b0428f885cd6f0a5d3414a,
            _:N9088e07ba7f941d59f7e15612f03c911,
            _:Nac348b3f6fbb4eba85c99ee4095d44d9,
            _:Nd4fca5218d164951a84104e9ebdf2612,
            _:Ne730eb08e34844c8865ad97165b54134,
            _:Nf9ef79d6344447f58cd6c67d22adf41f .

