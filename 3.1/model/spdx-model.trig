            _:Nd2a5692bf28643b8a6b53b9fc75bd266 .

    ns7:VexUnderInvestigationVulnAssessmentRelationship a owl:Class ;
        rdfs:comment """Designates elements as products where the impact of a vulnerability is being
investigated."""@en ;
        rdfs:subClassOf ns7:VexVulnAssessmentRelationship ;
        sh:nodeKind sh:IRI .

    ns7:Vulnerability a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Specifies a vulnerability and its associated information."@en ;
