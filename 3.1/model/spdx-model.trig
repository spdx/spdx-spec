    ns2:InspectionProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Inspection Process defines specific various processes needed to satisfy the inspection requirements for a specific product or service."@en ;
        rdfs:subClassOf ns2:UseProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N122fee9f864846e3b410407cba9cd2ad .

    ns2:InstantiateVirtualHardwareProcess a owl:Class ;
