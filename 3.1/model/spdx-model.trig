            ns1:HashAlgorithm ;
        rdfs:label "blake2b384" ;
        rdfs:comment "BLAKE2b algorithm with a digest size of 384, as defined in [RFC 7693](https://datatracker.ietf.org/doc/rfc7693/) Section 4."@en .

