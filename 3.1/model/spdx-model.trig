    ns6:EvaluationResult a owl:Class,
            sh:NodeShape ;
        rdfs:comment "EvaluationResult is the result of an evaluation."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N2d842979ed1c43e9961dd26b5dae105c,
            _:N638129ee57cb4c97bef5a7ef212251d9,
