    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A planned location where a good, product, or material is stored."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/Location"
      }
    ]
  },
  {
