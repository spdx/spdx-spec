    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Products or commodities produced as a bulk unit are called bulk products. Commodities are often sold in bulk."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Hardware/Hardware"
      }
