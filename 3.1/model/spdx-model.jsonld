        "@language": "en",
        "@value": "Specifies the type of an annotation."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/SupplyChain/InspectionAction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An inspection action refers to a specific activity or set of activities performed during an inspection to examine, verify, or evaluate an item, process, or system."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3/terms/SupplyChain/UseAction"
      }
    ],
