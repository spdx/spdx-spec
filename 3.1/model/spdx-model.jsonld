      {
        "@value": "video"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/AI/SafetyRiskAssessmentType/high",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/AI/SafetyRiskAssessmentType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
