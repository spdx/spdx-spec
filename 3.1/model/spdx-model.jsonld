      "https://spdx.org/rdf/3/terms/Core/ExternalRefType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A reference to metrics related to package such as OpenSSF scorecards."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "metrics"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Security/CvssSeverityType/critical",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Security/CvssSeverityType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "When a CVSS score is between 9.0 - 10.0."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "critical"
      }
    ]
  },
