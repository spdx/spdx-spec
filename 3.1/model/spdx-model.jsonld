    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Requirements can be categorized into various types based on their focus, purpose, and scope."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/SupplyChain/ResponsibilityType"
      }
    ]
  },
  {
