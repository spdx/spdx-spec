  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/orcidid",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "[Open Researcher and Contributor ID (ORCID) iD](https://info.orcid.org/what-is-orcid/) is a unique identifier for authors and contributors in scholarly communication; as a subset of the International Standard Name Identifier (ISNI), it typically appears as a URI such as `https://orcid.org/0000-0002-1825-0097`."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "orcidid"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel/autonomous",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Level 6 - Autonomous. The system is capable of modifying its intended domain of use or its goals without external intervention, control or oversight."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "autonomous"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/diskImage",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Software/SoftwarePurpose"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The Element refers to a disk image that can be written to a disk, booted in a VM, etc. A disk image typically contains most or all of the components necessary to boot, such as bootloaders, kernels, firmware, userspace, etc."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "diskImage"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/AnnotationType",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Specifies the type of an annotation."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/SupplyChain/current",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "This is the individual, business, or organization who currently manages goods, services, or assets."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/Agent"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/RelationshipType/hasInput",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/RelationshipType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The `from` /Build/Build, DefinedProcess or Action element has each `to` Element as an input."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "hasInput"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/glue",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "[GLobal Unique Enterprise (GLUE) Identifiers](https://datatracker.ietf.org/doc/draft-ietf-spice-glue-id/), as defined by the IETF Internet-Draft, is expressed as a GLUE URI, a Uniform Resource Identifier that standardizes the representation of existing organizational entity identifiers."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "glue"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/RelationshipType/conformsTo",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/RelationshipType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The `from` Element conforms to each `to` /FunctionalSafety/Assumption or Specification."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "conformsTo"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Dataset/ConfidentialityLevelType/clear",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Dataset/ConfidentialityLevelType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
