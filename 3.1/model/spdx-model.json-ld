    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An Organization representing the SPDX Project."
      }
    ],
    "http://www.w3.org/2002/07/owl#sameAs": [
      {
        "@id": "https://spdx.org/"
      }
    ],
    "https://spdx.org/rdf/3.1/terms/Core/creationInfo": [
      {
        "@id": "https://spdx.org/rdf/3.1/creationInfo_SpdxOrganization"
      }
    ]
  },
