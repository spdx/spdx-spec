        "@value": "Describes if a given file is a directory or non-directory kind of file."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Software/FileKindType"
      }
