    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A location where a package or an item is being dropped off or delivered."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/Location"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Software/sourceInfo",
    "@type": [
