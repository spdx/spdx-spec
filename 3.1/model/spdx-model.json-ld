      }
    ]
  },
  {
    "@id": "_:N0a3ccc43ecb24eaa991ab291eef6e15f",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Security/CvssSeverityType"
      }
    ],
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@id": "https://spdx.org/rdf/3/terms/Security/CvssSeverityType/critical"
          },
          {
            "@id": "https://spdx.org/rdf/3/terms/Security/CvssSeverityType/high"
          },
          {
            "@id": "https://spdx.org/rdf/3/terms/Security/CvssSeverityType/medium"
