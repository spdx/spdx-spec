    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The element follows the Security profile specification."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "security"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Software/homePage",
