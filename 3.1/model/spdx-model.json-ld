    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The name of the recipient expressed in text."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/assessment",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A systematic examination of a system, process, or outcome to evaluate compliance of specific work products with a specific expectation with a specification, regulation or standard. Often involves judgement and a rationale of this judgement."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "assessment"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Security/ExploitCatalogType/kev",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Security/ExploitCatalogType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "CISA's Known Exploited Vulnerability (KEV) catalog."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "kev"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalRefType/securityAdvisory",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalRefType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A reference to a published security advisory (where advisory as defined per [ISO 29147:2018](https://www.iso.org/standard/72311.html)) that may affect one or more elements, e.g., vendor advisories or specific NVD entries."
