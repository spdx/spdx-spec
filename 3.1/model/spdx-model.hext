["https://spdx.org/rdf/3.1/terms/Service/SoftwareService", "http://www.w3.org/2000/01/rdf-schema#comment", "Software provided as a service over a network.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
