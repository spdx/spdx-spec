["_:Ne096aeba752e4fb691602d14017c720f", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/hasInput> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Build/Build> }\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/DefinedProcess> }\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Action> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifier", "http://www.w3.org/ns/shacl#property", "_:Na6958e6bfbd642f4b2b496633f4a8181", "localId", "", ""]
