["_:N6100902a8a57461a8a9b98bd9c11cf4c", "http://www.w3.org/ns/shacl#message", "https://spdx.org/rdf/3/terms/SupplyChain/UseProcess is an abstract class and should not be instantiated directly. Instantiate a subclass instead.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
