["_:Nb9022022137d436fa64c9322c01c5142", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/hasHost> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Build/Build> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iswc", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
