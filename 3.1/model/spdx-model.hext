["_:Nba5ce6bf316a47efac7a972e7af85abf", "http://www.w3.org/ns/shacl#class", "https://spdx.org/rdf/3/terms/Core/SpdxDocument", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isbn", "http://www.w3.org/2000/01/rdf-schema#comment", "[International Standard Book Number (ISBN)](https://www.isbn-international.org/content/isbn-users-manual/29) is a unique numeric identifier for monographic publications standardized by [ISO 2108](https://www.iso.org/standard/65483.html). It consists of either 10 digits (for assignments prior to January 1, 2007) or 13 digits. A 13-digit ISBN is composed of five parts: a GS1 prefix, a registration group, a registrant, a publication element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., `9780198836063`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel/notAutomated", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel", "globalId", "", ""]
["_:Nba0be04256d04316ad7a58c55c526775", "http://www.w3.org/ns/shacl#datatype", "http://www.w3.org/2001/XMLSchema#string", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/externalRef", "http://www.w3.org/2000/01/rdf-schema#comment", "Points to a resource outside the scope of the SPDX 3 content\nthat provides additional characteristics of an Element.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SimpleLicensing/customIdToLicense", "http://www.w3.org/2000/01/rdf-schema#comment", "Maps a \"LicenseRef-\" string for a custom license or a \"AdditionRef-\" string for\na custom license addition to a `CustomLicense`, a `CustomLicenseAddition`, or a\n`SimpleLicensingText`.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
