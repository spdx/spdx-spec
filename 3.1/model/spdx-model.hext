["https://spdx.org/rdf/3.1/terms/Dataset/DatasetType/image", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3.1/terms/Dataset/DatasetType", "globalId", "", ""]
["_:N1e9ae9a2d01b4c97932b95300c96e99f", "http://www.w3.org/ns/shacl#or", "_:N97d406b4effd4fbb82ef0f27711b2a34", "localId", "", ""]
