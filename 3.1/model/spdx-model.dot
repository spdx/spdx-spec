# N3685bf6d01fb42d9aef7bf464d72608b node1261
node1261 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N3685bf6d01fb42d9aef7bf464d72608b</B></td></tr><tr><td href='N3685bf6d01fb42d9aef7bf464d72608b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N3685bf6d01fb42d9aef7bf464d72608b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, from must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/delegatedTo&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
