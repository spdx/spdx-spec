# N30ca3aa6385840c98b05c16ce26126fa node1177
node1177 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N30ca3aa6385840c98b05c16ce26126fa</B></td></tr><tr><td href='N30ca3aa6385840c98b05c16ce26126fa' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N30ca3aa6385840c98b05c16ce26126fa</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is resolved, to must be an OutOfSpecAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/resolved&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;SupplyChain/OutOfSpecAction&gt; }
}&quot;</td></tr></table> > ] 
