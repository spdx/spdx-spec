# N4e61545457ec4a69af511a7f77643907 node1650
node1650 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N4e61545457ec4a69af511a7f77643907</B></td></tr><tr><td href='N4e61545457ec4a69af511a7f77643907' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N4e61545457ec4a69af511a7f77643907</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasInput, from must be a Build, DefinedProcess, or Action&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasInput&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Build/Build&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/DefinedProcess&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
}&quot;</td></tr></table> > ] 
