# https://spdx.org/rdf/3/terms/Core/ExternalRefType/x509Cert node342
node342 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>x509Cert</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalRefType/x509Cert' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalRefType/x509Cert</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A reference to an X.509 certificate as defined in [RFC 5280](https://datatracker.ietf.org/doc/rfc5280/). The primary media type shall be `application/pkix-cert`. The legacy media types `application/x-x509-ca-cert` and `application/x-x509-user-cert` may be used for backward compatibility, but shall not be used in new implementations. NOTE — RFC 5280 supersedes earlier X.509 profiles, including RFC 1422. Existing references based on RFC 1422 remain valid.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Security/SsvcDecisionType/act node343
node343 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>act</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Security/SsvcDecisionType/act' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Security/SsvcDecisionType/act</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The vulnerability requires attention from the organization&#x27;s internal, supervisory-level and leadership-level individuals. Necessary actions include requesting assistance or information about the vulnerability, as well as publishing a notification either internally and/or externally. Typically, internal groups would meet to determine the overall response and then execute agreed upon actions. CISA recommends remediating Act vulnerabilities as soon as possible.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Security/SsvcDecisionType node344
node344 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>SsvcDecisionType</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Security/SsvcDecisionType' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Security/SsvcDecisionType</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Specifies the SSVC decision type.&quot;@en</td></tr></table> > ] 
