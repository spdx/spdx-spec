# N859f8e3d82cc4424b3acb706227c528b node1856
node1856 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N859f8e3d82cc4424b3acb706227c528b</B></td></tr><tr><td href='N859f8e3d82cc4424b3acb706227c528b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N859f8e3d82cc4424b3acb706227c528b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is conformsTo, to must be an Assumption or Specification&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
