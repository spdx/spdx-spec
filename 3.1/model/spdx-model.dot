# Ncfb2da72f4b14bf98f5ead7fafd96466 node1348
node1348 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ncfb2da72f4b14bf98f5ead7fafd96466</B></td></tr><tr><td href='Ncfb2da72f4b14bf98f5ead7fafd96466' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ncfb2da72f4b14bf98f5ead7fafd96466</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasUninstall, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasUninstall&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Artifact&gt; }
}&quot;</td></tr></table> > ] 
