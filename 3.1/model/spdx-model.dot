node1131 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N95b7d1ce6e8c449f9fae3927ef44792f</B></td></tr><tr><td href='N95b7d1ce6e8c449f9fae3927ef44792f' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N95b7d1ce6e8c449f9fae3927ef44792f</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:pattern</td><td align='left'>&quot;^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$&quot;</td></tr></table> > ] 
