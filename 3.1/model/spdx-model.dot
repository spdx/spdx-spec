# https://spdx.org/rdf/3/terms/Core/RelationshipType/describes node1560
node1560 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>describes</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipType/describes' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipType/describes</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The `from` Element describes each `to` Element. To denote the root(s) of a tree of elements in a collection, the rootElement property shall be used.&quot;@en</td></tr></table> > ] 
