# https://spdx.org/rdf/3.1/terms/SupplyChain/ResponsibilityType/custody node669
node669 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>custody</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/SupplyChain/ResponsibilityType/custody' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/SupplyChain/ResponsibilityType/custody</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Custody refers to the responsibility, control, and safekeeping of an asset, person, or legal entity. It involves both physical possession and legal authority over something or someone.&quot;@en</td></tr></table> > ] 
