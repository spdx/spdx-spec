# Ncdf43da4415d48ac87936e13c85a66e7 node1398
node1398 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ncdf43da4415d48ac87936e13c85a66e7</B></td></tr><tr><td href='Ncdf43da4415d48ac87936e13c85a66e7' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ncdf43da4415d48ac87936e13c85a66e7</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasResolution, from must be a ResolutionAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
