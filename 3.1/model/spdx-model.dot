node113 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N231292d16a754e73aa8f9accf537053f</B></td></tr><tr><td href='N231292d16a754e73aa8f9accf537053f' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N231292d16a754e73aa8f9accf537053f</font></td></tr><tr><td align='left'>sh:pattern</td><td align='left'>&quot;^[A-Z]{3}$&quot;</td></tr></table> > ] 
