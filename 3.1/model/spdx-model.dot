# Nc10874d4d4fd4f68ba09275598eb3417 node487
node487 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nc10874d4d4fd4f68ba09275598eb3417</B></td></tr><tr><td href='Nc10874d4d4fd4f68ba09275598eb3417' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nc10874d4d4fd4f68ba09275598eb3417</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasProvidedDependency, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasProvidedDependency&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
