node11 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>NamedIndividual</B></td></tr><tr><td href='http://www.w3.org/2002/07/owl#NamedIndividual' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>http://www.w3.org/2002/07/owl#NamedIndividual</font></td></tr></table> > ] 
