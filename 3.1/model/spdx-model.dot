# Nd5f76e8b49fc4536aa918674135c9145 node1334
node1334 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nd5f76e8b49fc4536aa918674135c9145</B></td></tr><tr><td href='Nd5f76e8b49fc4536aa918674135c9145' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nd5f76e8b49fc4536aa918674135c9145</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasResolution, from must be a ResolutionAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasResolution&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;SupplyChain/ResolutionAction&gt; }
}&quot;</td></tr></table> > ] 
