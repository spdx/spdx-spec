node1252 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N92c7770e27634ca59df668640bae756a</B></td></tr><tr><td href='N92c7770e27634ca59df668640bae756a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N92c7770e27634ca59df668640bae756a</font></td></tr></table> > ] 
