node180 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N64026034414342c58fc2fdfbcc00f14c</B></td></tr><tr><td href='N64026034414342c58fc2fdfbcc00f14c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N64026034414342c58fc2fdfbcc00f14c</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:minCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
