node472 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N7f907dedaaf84fbfad8b0de6d467e405</B></td></tr><tr><td href='N7f907dedaaf84fbfad8b0de6d467e405' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N7f907dedaaf84fbfad8b0de6d467e405</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:pattern</td><td align='left'>&quot;^\d\d\d\d-\d\d-\d\dT\d\d:\d\d:\d\dZ$&quot;</td></tr></table> > ] 
