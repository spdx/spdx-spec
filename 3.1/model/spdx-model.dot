# N4c20c686dfc743b892345f738929e49b node1861
node1861 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N4c20c686dfc743b892345f738929e49b</B></td></tr><tr><td href='N4c20c686dfc743b892345f738929e49b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N4c20c686dfc743b892345f738929e49b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasSpecification, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasSpecification&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
# N8a4c4d9a45eb4c47b63a110331cee0b4 node1862
node1862 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8a4c4d9a45eb4c47b63a110331cee0b4</B></td></tr><tr><td href='N8a4c4d9a45eb4c47b63a110331cee0b4' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8a4c4d9a45eb4c47b63a110331cee0b4</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is resolved, to must be an OutOfSpecAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/resolved&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;SupplyChain/OutOfSpecAction&gt; }
}&quot;</td></tr></table> > ] 
