# Na062b34e12d44c9d81b884f0dc5ff588 node23
node23 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na062b34e12d44c9d81b884f0dc5ff588</B></td></tr><tr><td href='Na062b34e12d44c9d81b884f0dc5ff588' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na062b34e12d44c9d81b884f0dc5ff588</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasProvidedDependency, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasProvidedDependency&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
# Nfb5d714a42b0481ea6b10ccbc3d14533 node24
node24 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nfb5d714a42b0481ea6b10ccbc3d14533</B></td></tr><tr><td href='Nfb5d714a42b0481ea6b10ccbc3d14533' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nfb5d714a42b0481ea6b10ccbc3d14533</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is affects, from must be a Vulnerability, Action, or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/affects&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/DefinedProcess&gt; }
}&quot;</td></tr></table> > ] 
