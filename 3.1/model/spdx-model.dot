node388 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>conditionalAutomation</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel/conditionalAutomation' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel/conditionalAutomation</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Level 3 - Conditional automation. The system can propose strategies and then automatically execute the approved plan, with an external agent being ready to take over when necessary.&quot;@en</td></tr></table> > ] 
