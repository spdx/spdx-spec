# https://spdx.org/rdf/3/terms/Core/Relationship node6
node6 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Relationship</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/Relationship' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/Relationship</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Describes a relationship between one or more elements.&quot;@en</td></tr></table> > ] 
# Nb137f3cbd816435eb3b4188e3ab7af53 node7
node7 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb137f3cbd816435eb3b4188e3ab7af53</B></td></tr><tr><td href='Nb137f3cbd816435eb3b4188e3ab7af53' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb137f3cbd816435eb3b4188e3ab7af53</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is performedBy, from must be an Action or a Relationship of type hasInstall or hasUninstall&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/performedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
    FILTER NOT EXISTS { ?from &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasInstall&gt; }
    FILTER NOT EXISTS { ?from &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasUninstall&gt; }
}&quot;</td></tr></table> > ] 
