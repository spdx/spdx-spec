node1494 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>scrapingScript</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType/scrapingScript' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType/scrapingScript</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Dataset provider is not making available the underlying data and the dataset shall be reassembled, typically using the provided script for scraping the data.&quot;@en</td></tr></table> > ] 
