# Naa95451133be4822a6f92aaa06b2f3b5 node1331
node1331 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Naa95451133be4822a6f92aaa06b2f3b5</B></td></tr><tr><td href='Naa95451133be4822a6f92aaa06b2f3b5' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Naa95451133be4822a6f92aaa06b2f3b5</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is publishedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/publishedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
