# Nb087c04e4f5b480687a2187a87045763 node1734
node1734 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb087c04e4f5b480687a2187a87045763</B></td></tr><tr><td href='Nb087c04e4f5b480687a2187a87045763' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb087c04e4f5b480687a2187a87045763</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is exploitCreatedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/exploitCreatedBy&gt; .
    $this &lt;Core/to&gt; ?to .
