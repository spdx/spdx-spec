# https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/isci node77
node77 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>isci</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/isci' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/isci</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;International Standard Collection Identifier (ISCI) is a variable-length identifier standardized by [ISO 27730](https://www.iso.org/standard/44293.html) for identifying collections held by libraries, archives, museums, and other memory institutions. It consists of two parts: the identifier for the assigning organization (an ISIL) enclosed in square brackets, followed by a local collection identifier string (e.g., `[FR-751041001]Casadesus1`).&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ibid node78
node78 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>ibid</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ibid' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ibid</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;[International Business Identifier (IBID)](https://ekys.org/business_identifiers/) is a verifiable unique identifier for legal entities as defined in the [ISO/DIS 25500-3](https://www.iso.org/standard/87705.html) draft standard. It is composed of three data elements: the International Business Registration Number (IBRN), the legal name, and the date of origin formatted as eight numeric characters (YYYYMMDD). Each element is separated by a pipe character (`|`) (e.g., `US-DE.BER:3031657|Code Management Association|19990420`).&quot;@en</td></tr></table> > ] 
