_:N2090f5d4fadb47ddaf91e8da4b673869 <http://www.w3.org/ns/shacl#select> "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/doesNotAffect> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }\n}" .
