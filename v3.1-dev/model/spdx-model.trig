        rdfs:subClassOf <https://spdx.org/rdf/3/terms/SimpleLicensing/AnyLicenseInfo> ;
        sh:nodeKind sh:IRI ;
        sh:property _:N02425ab31e174d22b37dd8e55b9cdf6c .

    ns10:ListedLicense a owl:Class,
