        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N16faa60a54d04538821f5fe27c0dc8af,
            _:N261dc4a32bff4ad69c002bde06df33a7,
