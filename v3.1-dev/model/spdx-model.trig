        sh:nodeKind sh:IRI ;
        sh:property _:N7f5e54fec3e440819a188d500e55214e,
            _:Ne825367c3bdf47059eb8db17afe46b83 .

    ns10:serverAuthenticationProtocol a owl:ObjectProperty ;
