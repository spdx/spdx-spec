        rdfs:comment "The name of the recipient expressed in text."@en ;
        rdfs:range xsd:string .

    ns1:prefix a owl:DatatypeProperty ;
        rdfs:comment "A substitute for a URI."@en ;
        rdfs:range xsd:string .

    ns1:processRationale a owl:DatatypeProperty ;
