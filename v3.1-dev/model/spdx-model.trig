            sh:NodeShape ;
        rdfs:comment "Provides an exploit assessment of a vulnerability."@en ;
        rdfs:subClassOf ns3:VulnAssessmentRelationship ;
        sh:nodeKind sh:IRI ;
        sh:property _:N32ab336167f548c18c385e2f0c823c14,
