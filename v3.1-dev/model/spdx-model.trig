investigated."""@en ;
        rdfs:subClassOf ns5:VexVulnAssessmentRelationship ;
        sh:nodeKind sh:IRI .

    ns5:Vulnerability a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Specifies a vulnerability and its associated information."@en ;
