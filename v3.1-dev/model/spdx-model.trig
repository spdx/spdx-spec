        rdfs:label "complete" ;
        rdfs:comment "The relationship is known to be exhaustive."@en .

    <https://spdx.org/rdf/3.1/terms/Core/RelationshipCompleteness/incomplete> a owl:NamedIndividual,
            ns4:RelationshipCompleteness ;
        rdfs:label "incomplete" ;
