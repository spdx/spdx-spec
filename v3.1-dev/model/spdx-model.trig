        sh:nodeKind sh:IRI ;
        sh:property _:N30c4b2a7c5444e6292b3f8b7a6e6626a,
            _:N56bacde83b1541448af17f65fb5214ae,
            _:N6dd8cfc330464b87bddc41f4e1b85a0e,
