    _:Nffdefd39f44b4c58b5ed6d490f3399c4 a sh:SPARQLConstraint ;
        sh:message "When relationship is hasUninstall, class must be LifecycleScopedRelationship" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
