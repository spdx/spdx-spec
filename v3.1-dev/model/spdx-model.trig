        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0dbf3abf9b1c4522a7a01cbcb0ca0dff,
            _:N2c1a9809887c48ad84be6b5ce4048900,
