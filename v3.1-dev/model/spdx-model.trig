        sh:nodeKind sh:IRI ;
        sh:property _:N555ddc3cb7c14aee9029df7c4ffe0ffa .

    ns4:DestroyProcess a owl:Class ;
        rdfs:comment "The destruction process is defined in this process."@en ;
