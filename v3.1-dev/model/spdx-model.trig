        sh:nodeKind sh:IRI ;
        sh:property _:N16ee8525b9c64cffb6f2d9871ab644d1 .

    ns8:WithAdditionOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing a License which has additional
text applied to it."""@en ;
