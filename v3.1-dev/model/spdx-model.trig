        rdfs:subClassOf ns7:VulnAssessmentRelationship ;
        sh:nodeKind sh:IRI ;
        sh:property _:N3d7c145e0bad43cb8850cd6f9701d8cc .

    ns7:VexAffectedVulnAssessmentRelationship a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Connects a vulnerability and an element designating the element as a product
affected by the vulnerability."""@en ;
