            sh:NodeShape ;
        rdfs:comment "Software provided as a service over a network."@en ;
        rdfs:subClassOf ns1:Artifact ;
        sh:nodeKind sh:IRI ;
        sh:property _:N2ed742b9dbf744a8ac271182b21c0589,
            _:N74e6ca8e8c07451c8972f8c3dc89c873 .

    ns7:serverAuthenticationProtocol a owl:ObjectProperty ;
        rdfs:comment "Authentication protocol used by a server."@en ;
