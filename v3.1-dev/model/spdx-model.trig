        sh:nodeKind sh:IRI ;
        sh:property _:N1455cac17c9041f59a44c0cef973b16e,
            _:N7301e496d1e64fee87b1d6a2999b89bb .

    ns10:serverAuthenticationProtocol a owl:ObjectProperty ;
