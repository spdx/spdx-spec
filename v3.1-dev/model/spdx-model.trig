        rdfs:subClassOf ns11:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns11:StorageProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Prescribes the storage of a product."@en ;
        rdfs:subClassOf ns11:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N503c790ebde146baa1ce606c87e93cce .

    ns11:TestAction a owl:Class ;
        rdfs:comment "A test action is a specific action associated with a test."@en ;
        rdfs:subClassOf ns11:UseAction ;
        sh:nodeKind sh:IRI .

    ns11:TestProcess a owl:Class ;
        rdfs:comment "Test Process defines the testing process for an element."@en ;
        rdfs:subClassOf ns11:UseProcess ;
        sh:nodeKind sh:IRI .

    ns11:TransportAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "An actual change to a product's location."@en ;
