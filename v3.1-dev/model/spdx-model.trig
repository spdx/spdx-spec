        sh:property _:N5cbf50a7caab47c5b301a97a67781500,
            _:Nd9491a7e3a9f429faa89d29fce1be11c .

    ns6:StorageAction a owl:Class ;
        rdfs:comment "Records the storage of a product."@en ;
        rdfs:subClassOf ns6:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns6:StorageProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Prescribes the storage of a product."@en ;
        rdfs:subClassOf ns6:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N6dfcfa2d3afb48a69bb973a1c40cd669 .

    ns6:TestAction a owl:Class ;
        rdfs:comment "A test action is a specific action associated with a test."@en ;
        rdfs:subClassOf ns6:UseAction ;
        sh:nodeKind sh:IRI .

    ns6:TestProcess a owl:Class ;
        rdfs:comment "Test Process defines the testing process for an element."@en ;
        rdfs:subClassOf ns6:UseProcess ;
        sh:nodeKind sh:IRI .

