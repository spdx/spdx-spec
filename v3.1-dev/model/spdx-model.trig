        sh:nodeKind sh:IRI ;
        sh:property _:N125bf99d3b9643949e9a3dda31c39b8e,
            _:N1e3985090fb8464683f2ba419ee27e03,
            _:N2bf4944863d64fd788fa7d0bf0b69727,
