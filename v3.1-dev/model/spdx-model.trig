        rdfs:range <https://spdx.org/rdf/3/terms/Extension/CdxPropertyEntry> .

    ns6:Assumption a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A distinct unit representing a constraint associated with an item's use in a system."@en ;
        rdfs:subClassOf ns3:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N949de955d9d24193a1152969f56279d5,
            _:N94bcd32a09e749fa9e21a9127e041eaf,
