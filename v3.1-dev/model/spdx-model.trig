    ns3:CustomLicenseAddition a owl:Class ;
        rdfs:comment "A license addition that is not listed on the SPDX Exceptions List."@en ;
        rdfs:subClassOf ns3:LicenseAddition ;
        sh:nodeKind sh:IRI .

