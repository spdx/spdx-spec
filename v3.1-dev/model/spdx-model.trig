        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns7:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns3:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N04901d3a8bed40508d1c61ea9ca78d9b,
            _:N2a43dd762446431891bd7bbbd93e1d1e,
            _:N2e223d290f804e3d9efd65a2ec060293,
            _:N5fa6fdbb12324e649a9396563cb99a29,
            _:N7e0ada37c09a473bbc029aca6d5bdd56,
            _:N8eee3dbbf5b64fe29d2e184d3e5dfe76,
            _:N9909b00335b6495c87f2da2738e80dfe,
            _:N9e2f1ac53e294794a9f12b7a06809d1c,
            _:Na60098e1128941e189334dc6c39be0d9,
            _:Nae63c181325c4b1cae2fb5c5565ba053,
            _:Nc7d5f832cdf34a5fb599385649963573,
            _:Nd3a3e9ef54484caca97af6e6d0076f7a,
