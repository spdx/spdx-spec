        sh:nodeKind sh:IRI ;
        sh:property _:N06c70559da594e58a350499cda853b2b,
            _:N1189ecd03c04422eb28f26c5338c60d5 .

    ns2:serverAuthenticationProtocol a owl:ObjectProperty ;
