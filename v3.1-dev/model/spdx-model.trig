        rdfs:subClassOf ns4:UseAction ;
        sh:nodeKind sh:IRI .

    ns4:ResponsibilityChangeAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "ResponsibilityChangeAction refers to the transfer of responsibility from one party to another."@en ;
