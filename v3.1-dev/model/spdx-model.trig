        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0474ffbe21964a928e894d37dee2cc53,
            _:N4b9b0a5588804e52bf69e8f8a3a2abaf,
