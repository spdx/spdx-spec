        rdfs:range ns6:RequirementVerification .

    ns6:evidenceCategory a owl:ObjectProperty ;
        rdfs:comment "evidenceCategory refers to a category of documented or observable proof."@en ;
        rdfs:range ns6:EvidenceType .

