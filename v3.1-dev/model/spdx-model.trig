        sh:nodeKind sh:IRI ;
        sh:property _:Nb58dd7d7cd814a38a97eea7a0e1cc61d .

    ns7:TestAction a owl:Class ;
        rdfs:comment "A test action is a specific action associated with a test."@en ;
        rdfs:subClassOf ns7:UseAction ;
        sh:nodeKind sh:IRI .

