    ns3:OutOfSpecAction a owl:Class ;
        rdfs:comment "An out of specification action is defined in this class."@en ;
        rdfs:subClassOf ns3:UseAction ;
        sh:nodeKind sh:IRI .

    ns3:PlanAction a owl:Class ;
