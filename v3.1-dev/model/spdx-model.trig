        rdfs:subClassOf ns5:License ;
        sh:nodeKind sh:IRI .

    ns5:CustomLicenseAddition a owl:Class ;
        rdfs:comment "A license addition that is not listed on the SPDX Exceptions List."@en ;
        rdfs:subClassOf ns5:LicenseAddition ;
        sh:nodeKind sh:IRI .

    ns5:DisjunctiveLicenseSet a owl:Class,
            sh:NodeShape ;
