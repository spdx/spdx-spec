            _:Ne461eb3081854a82a8ed8f2d7ed1cca4 .

    ns8:serverKeyValidationProtocol a owl:ObjectProperty ;
        rdfs:comment "Key validation protocol used during the authentication of servers or services over a network."@en ;
        rdfs:range ns8:KeyValidationProtocolType .

