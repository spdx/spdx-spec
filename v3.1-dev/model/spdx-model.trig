        sh:nodeKind sh:IRI ;
        sh:property _:N0e7282536b294b26a637305e5f7d2f86,
            _:N1f76a93e92a6405baeec1942c772187c,
            _:N6417842538694ebfa7f7e45dd4587d8a,
