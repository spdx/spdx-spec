        sh:nodeKind sh:IRI ;
        sh:property _:Nc6e8155a8405417480b1671627a52aa9,
            _:Nd44fa3608ca941db97dc599fc6c5faf8 .

    ns8:serverAuthenticationProtocol a owl:ObjectProperty ;
