    <https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/platform> a owl:NamedIndividual,
            ns2:SoftwarePurpose ;
        rdfs:label "platform" ;
        rdfs:comment "The Element represents a runtime environment."@en .

