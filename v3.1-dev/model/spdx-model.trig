    _:N03972443a000464f94a7f9cf9a86a572 a sh:SPARQLConstraint ;
        sh:message "When relationship is serializedInArtifact, to must be an Artifact" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/serializedInArtifact> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Artifact> }
}""" .

