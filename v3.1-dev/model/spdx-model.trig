        rdfs:range xsd:string .

    ns9:datasetAvailability a owl:ObjectProperty ;
        rdfs:comment "Availability of a dataset."@en ;
        rdfs:range ns9:DatasetAvailabilityType .

    ns9:datasetNoise a owl:DatatypeProperty ;
        rdfs:comment "Potentially noisy elements of the dataset."@en ;
        rdfs:range xsd:string .

    ns9:datasetSize a owl:DatatypeProperty ;
        rdfs:comment """**DEPRECATED in SPDX 3.1.**
Use [/Software/artifactSize](../../Software/Properties/artifactSize.md)
instead.

Size of the dataset."""@en ;
        rdfs:range xsd:nonNegativeInteger .

    ns9:datasetType a owl:ObjectProperty ;
        rdfs:comment "Type of data in a dataset."@en ;
        rdfs:range ns9:DatasetType .

    ns9:datasetUpdateMechanism a owl:DatatypeProperty ;
        rdfs:comment "Mechanism to update the dataset."@en ;
        rdfs:range xsd:string .

    ns9:hasSensitivePersonalInformation a owl:ObjectProperty ;
        rdfs:comment "Describes if any sensitive personal information is present in the dataset."@en ;
        rdfs:range ns3:PresenceType .

    ns9:intendedUse a owl:DatatypeProperty ;
        rdfs:comment """**DEPRECATED in SPDX 3.1.**
