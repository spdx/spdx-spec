        sh:property _:N7c3f7d6b2c5242c88c4e58add371e37e .

    ns5:InstantiateVirtualHardwareProcess a owl:Class ;
        rdfs:comment "Class that describes an InstantiateVirtualHardwareProcess that is used to define VirtualHardware and its source."@en ;
        rdfs:subClassOf ns5:CreateProcess ;
        sh:nodeKind sh:IRI .

    ns5:ManufactureAction a owl:Class ;
