        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0a61894ad7c84429a68fb17a79571cc9,
            _:N5d21504abc344f3f94a6b086a5a53bfe,
