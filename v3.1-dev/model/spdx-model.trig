    _:N010ef41b20df46d191fcddba821c192f a sh:SPARQLConstraint ;
        sh:message "When relationship is hasStaticLink, class must be LifecycleScopedRelationship" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/hasStaticLink> .
    FILTER NOT EXISTS { $this rdf:type <Core/LifecycleScopedRelationship> }
}""" .

    _:N0130cfc468754e50b50ca1c27efaadca a sh:SPARQLConstraint ;
        sh:message "When relationship is hasContactPoint, to must be an Agent" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/hasContactPoint> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Agent> }
}""" .

    _:N013bd4f8d31a4e078beca2a7a910c4e6 a sh:SPARQLConstraint ;
        sh:message "When relationship is serializedInArtifact, from must be a SpdxDocument" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/serializedInArtifact> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/SpdxDocument> }
}""" .

