        rdfs:subClassOf ns7:UseProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N2a050af4c26c4060abcb9524c1cd8dab .

    ns7:InstantiateVirtualHardwareProcess a owl:Class ;
