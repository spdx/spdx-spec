        rdfs:range ns1:Location .

    ns6:forDropoffLocation a owl:ObjectProperty ;
        rdfs:comment "The location that an item will be dropping off or delivered."@en ;
        rdfs:range ns1:Location .

    ns6:forPickupLocation a owl:ObjectProperty ;
        rdfs:comment "The location for picking up a package or item."@en ;
        rdfs:range ns1:Location .

    ns6:pickupLocation a owl:ObjectProperty ;
        rdfs:comment "The location for picking up a package or item."@en ;
        rdfs:range ns1:Location .

    ns6:plannedCurrent a owl:ObjectProperty ;
