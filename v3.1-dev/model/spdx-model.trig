        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns9:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns3:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0e3b1667df6449eaa7ff17ae7d6bbafb,
            _:N1329928c1bfd4ee5921bf82c2d889669,
            _:N3046310449a94ea6baa7408c6d3e6f1e,
            _:N32afaea6293d4307a10c45c96e71dada,
            _:N3f8564333c904dfcac9d2718a3c54d2a,
            _:N41f8602a4d374002ba2b5cfca743888a,
            _:N48cd48b01fec4728b2aad5f9b9932389,
            _:N712a2c47c8a441baa7318732ad899b9e,
            _:N76131c342148455ebde69e5d0530644d,
            _:N7de267408e0e46aeb08cc9efe5894f33,
            _:N81d058e70ca7436a9c945928d80c2ec4,
            _:Nb323768fe4104488bae93f15226baf4c,
            _:Nbe7633e1b3e7438e9d702d896f3fdba3,
            _:Ncb98e3c29513442d93bb6276d4e48ce5,
