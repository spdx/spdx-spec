        sh:nodeKind sh:IRI ;
        sh:property _:N055968085d8d436c90314e40eaf59c08,
            _:N6d4dd32c905e41ec8467bb03be873fa1,
            _:N8c67e96cc2a244d681d4dd543ca5ae99,
