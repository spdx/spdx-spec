        sh:nodeKind sh:IRI ;
        sh:property _:N0ae1b75ab3d84979b873a5ff15d906ee,
            _:N578ce40c0b864eef9997ccd94f00c24b,
            _:N77c37823a56045c1b312a35d3cc00ca0,
