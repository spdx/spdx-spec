        sh:nodeKind sh:IRI ;
        sh:property _:N988f108184984639ace4e1dda968f760,
            _:Nb71912c3731645d998fd9cda40a7f90d .

    ns8:OrLaterOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing this version, or any later version,
of the indicated License."""@en ;
