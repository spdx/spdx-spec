        sh:nodeKind sh:IRI ;
        sh:property _:N1fe522ab95b242f7ab40a884ebcb27e3,
            _:N3ac33c3ba6014b1e9de9959f60d60956 .

    ns8:serverAuthenticationProtocol a owl:ObjectProperty ;
        rdfs:comment "Authentication protocol used by a server."@en ;
