    ns6:InspectionProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Inspection Process defines specific various processes needed to satisfy the inspection requirements for a specific product or service."@en ;
        rdfs:subClassOf ns6:UseProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N4470a1d5f0244a938e60bf7c0f8fb783 .

    ns6:InstantiateVirtualHardwareProcess a owl:Class ;
