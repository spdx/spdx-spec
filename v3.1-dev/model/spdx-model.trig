        rdfs:subClassOf ns2:VulnAssessmentRelationship ;
        sh:nodeKind sh:IRI ;
        sh:property _:N307f36b2518c4cb88f863b41d0ca8347 .

    ns2:VexAffectedVulnAssessmentRelationship a owl:Class,
            sh:NodeShape ;
