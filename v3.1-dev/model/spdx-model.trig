        sh:nodeKind sh:IRI ;
        sh:property _:N46edabe41cd24c1b9e2e3b9bc56731a2,
            _:N647fbbebd3864f018cfd7934690c3a4e .

    ns8:StorageAction a owl:Class ;
        rdfs:comment "Records the storage of a product."@en ;
        rdfs:subClassOf ns8:ModifyAction ;
        sh:nodeKind sh:IRI .

