        rdfs:subClassOf ns4:CreateProcess ;
        sh:nodeKind sh:IRI .

    ns4:ManufactureAction a owl:Class ;
        rdfs:comment "ManufactureAction represents the act of creating a product by a manufacturing process."@en ;
        rdfs:subClassOf ns4:CreateAction ;
        sh:nodeKind sh:IRI .

    ns4:ManufactureProcess a owl:Class ;
