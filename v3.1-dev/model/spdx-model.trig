    ns4:EvaluationResult a owl:Class,
            sh:NodeShape ;
        rdfs:comment "EvaluationResult is the result of an evaluation."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N8b54e7749ac74148b0003b8a151fd5a9,
            _:N8d33172842644f2f8b8825f3630c7cf6,
