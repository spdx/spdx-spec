        sh:nodeKind sh:IRI ;
        sh:property _:Nb9a3036ba7584b0aae8c79f4994cd3d1 .

    ns10:DestroyProcess a owl:Class ;
        rdfs:comment "The destruction process is defined in this process."@en ;
