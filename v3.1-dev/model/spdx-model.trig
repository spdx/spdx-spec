    <https://spdx.org/rdf/3.1/terms/SimpleLicensing/SimpleLicensingText> a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A license or addition that is not listed on the SPDX License List."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
