        sh:nodeKind sh:IRI ;
        sh:property _:N1814a98068f346a59f7162c465ac02ad,
            _:N3eff9e7293ad4937a9dbcdb3dab28d83,
            _:Nc0c8f9f6956245cf8c4bc794c819386f .

