            _:N94aa96c69c0e4007a9d4c74d5306947f .

    ns6:ResponsibilityChangeProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "ResponsibilityChangeProcess refers to the process of transferring responsibility from one party to another."@en ;
        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N02e65d1ded024b048cf6cd4dccb65626,
            _:N260aa9896d084a05965ab94590610f68,
