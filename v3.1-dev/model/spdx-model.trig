            sh:NodeShape ;
        rdfs:comment "Software provided as a service over a network."@en ;
        rdfs:subClassOf ns1:Artifact ;
        sh:nodeKind sh:IRI ;
        sh:property _:Nb1dd614b9b2c48c190da4a54a594b43b,
            _:Nd9af7b81d98e4dba876c984dfe081b63 .

    ns9:serverAuthenticationProtocol a owl:ObjectProperty ;
        rdfs:comment "Authentication protocol used by a server."@en ;
        rdfs:range ns9:AuthenticationProtocolType .

