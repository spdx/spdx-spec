        rdfs:range ns1:Agent .

    ns4:currentState a owl:ObjectProperty ;
        rdfs:comment "This is the state of an affected Element."@en ;
        rdfs:range ns4:State .

    ns4:decisionProcess a owl:ObjectProperty ;
