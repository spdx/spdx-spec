            ns2:SoftwarePurpose ;
        rdfs:label "application" ;
        rdfs:comment "The Element is a software application."@en .

    <https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/archive> a owl:NamedIndividual,
            ns2:SoftwarePurpose ;
        rdfs:label "archive" ;
