        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns9:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns3:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N1867d2d514164d60b9fddb3d15488971,
            _:N19070a887c4f48fb859162c3d93868df,
            _:N2bf66bfd55564b1a90d2d9ee68ff5465,
            _:N4dabd603383f4d6bb8342fe26b530706,
            _:N6bc1e928d5d748c682ec8e79cf732829,
            _:N6f8ff02e7c8d4706804e409e4e1324af,
            _:N788b308e12a1413f87eb6efec65e3558,
            _:N7fb19b35c62d42e78e27e2c4b77a88d9,
            _:N9113d551181844daac1dd7752aae7d7b,
            _:N9a9c4a8ec4fd48678ce92fb6b2d5175c,
            _:N9eb5bb2760394401bbb40e6e9151b337,
            _:Nc53f2758659d4ae18aa53f63eb610d17,
