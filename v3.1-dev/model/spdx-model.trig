        sh:nodeKind sh:IRI ;
        sh:property _:N162f4c047c324dbebf5d82111cdf4dfe,
            _:N1dcb600210614bbdb789da726467131d,
            _:N2adad8d8c01a4cda86bdc269086d341b,
