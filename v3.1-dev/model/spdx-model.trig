    _:Nb865058369024fdebdf52457aa205278 a sh:SPARQLConstraint ;
        sh:message "When relationship is delegatedTo, to must be a Relationship whose relationshipType is invokedBy" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/delegatedTo> .
