        rdfs:subClassOf ns5:CreateAction ;
        sh:nodeKind sh:IRI .

    ns5:ReproduceProcess a owl:Class ;
        rdfs:comment "Reproduction is the biological process by which living organisms produce offspring."@en ;
        rdfs:subClassOf ns5:CreateProcess ;
        sh:nodeKind sh:IRI .

