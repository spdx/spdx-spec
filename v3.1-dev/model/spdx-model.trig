    _:N00add4242d62415a80e5a5e90518804b a sh:SPARQLConstraint ;
        sh:message "When relationship is verifiedBy, from must be a Requirement" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/verifiedBy> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Requirement> }
}""" .

