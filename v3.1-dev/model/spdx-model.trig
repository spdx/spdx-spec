    spdx: a owl:Ontology ;
        rdfs:label "System Package Data Exchange™ (SPDX®) Ontology"@en ;
        dcterms:abstract "This ontology defines the terms and relationships used in the SPDX specification to describe system packages"@en ;
        dcterms:created "2026-01-23"^^xsd:date ;
        dcterms:creator "SPDX Project"@en ;
        dcterms:license <https://spdx.org/licenses/Community-Spec-1.0.html> ;
        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns6:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns3:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N02b32fe3e22c43a6b1209f7c502f5615,
            _:N1f418271d0984a44b369ac87110cb650,
            _:N302438b897474b5c900a81f0137412d1,
            _:N3879559b89eb4fec805ec3692f45a7f3,
            _:N40cc66826c374d81adea77b1468f5547,
            _:N47f46aa2a568416ca81ebd6cf857f488,
            _:N561e1ba336d94aeab0e7edf8f2538146,
            _:N57c104f75d7b437ea9bfd186b84763f8,
            _:N5e7e2c2b5f5c443a8d1513c407c8b214,
            _:Nb2376608d0b84af7a483d10161434147,
            _:Nb324678672ee471680794e01b578c048,
            _:Nb5049dbc44ca491593260917881cf4fc,
