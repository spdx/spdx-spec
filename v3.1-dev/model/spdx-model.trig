    _:N018114a696a443a28a83597175b91ddc a sh:SPARQLConstraint ;
        sh:message "When relationship is hasInstall, class must be LifecycleScopedRelationship" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/hasInstall> .
    FILTER NOT EXISTS { $this rdf:type <Core/LifecycleScopedRelationship> }
}""" .

