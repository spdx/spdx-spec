        rdfs:subClassOf ns9:VulnAssessmentRelationship ;
        sh:nodeKind sh:IRI ;
        sh:property _:Ndc4061c45a3c42269af382932e1baabb .

    ns9:VexAffectedVulnAssessmentRelationship a owl:Class,
            sh:NodeShape ;
