    _:N01682d95711a44888a8af2d6546839fa a sh:SPARQLConstraint ;
        sh:message "When relationship is delegatedTo, class must be LifecycleScopedRelationship" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
