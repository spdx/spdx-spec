        rdfs:range xsd:string .

    ns2:AbstractPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Refers to an abstract, conceptual software entity."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0bcd1b9b3ecf4df98652685d256760f7,
