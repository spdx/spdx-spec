    _:N04e7c2b333ca42dab73ceb3d542b2848 a sh:SPARQLConstraint ;
        sh:message "When relationship is hasResolution, from must be a ResolutionAction" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/hasResolution> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <SupplyChain/ResolutionAction> }
}""" .

