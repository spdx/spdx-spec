        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0a3f8b1dc9fa4d10bcc70ad2bac94736,
            _:N7555bd8777444deeadaccee48f4117b2,
