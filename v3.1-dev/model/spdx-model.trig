        rdfs:comment "Specifies the type of the content identifier."@en ;
        rdfs:range ns2:ContentIdentifierType .

    ns2:contentIdentifierValue a owl:DatatypeProperty ;
        rdfs:comment "Specifies the value of the content identifier."@en ;
        rdfs:range xsd:anyURI .

    ns2:copyrightText a owl:DatatypeProperty ;
