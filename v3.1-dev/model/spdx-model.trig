            _:N1a26d40b3f5a44af99a5c2f3a35bc8ac,
            _:N50d734902a014239bc4ae57822367b74,
            _:Na51d195e1ded4362a8f035322d5dd433 .

    ns1:SoftwareAgent a owl:Class ;
        rdfs:comment "A software agent."@en ;
        rdfs:subClassOf ns1:Agent ;
        sh:nodeKind sh:IRI .

    ns1:SpdxDocument a owl:Class,
            sh:NodeShape ;
