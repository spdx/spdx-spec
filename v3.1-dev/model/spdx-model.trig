    <https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/evidence> a owl:NamedIndividual,
            ns6:SoftwarePurpose ;
        rdfs:label "evidence" ;
        rdfs:comment "The Element is the evidence that a specification or requirement has been fulfilled."@en .

