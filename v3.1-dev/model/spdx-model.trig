        sh:nodeKind sh:IRI ;
        sh:property _:Nc0d99731c6b94cd89efc2bfaa7cc3d51 .

    ns8:DestroyProcess a owl:Class ;
        rdfs:comment "The destruction process is defined in this process."@en ;
