        rdfs:subClassOf ns2:UseProcess ;
        sh:nodeKind sh:IRI .

    ns2:ReproduceAction a owl:Class ;
        rdfs:comment "Reproduction is the biological process by which organisms generate new individuals of the same species."@en ;
        rdfs:subClassOf ns2:CreateAction ;
        sh:nodeKind sh:IRI .

    ns2:ReproduceProcess a owl:Class ;
