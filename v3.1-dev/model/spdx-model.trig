        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns7:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns5:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N00b7fba79f19485b965476bae97a9c7b,
            _:N2706fc5aa9994bcea2fba2a1dd2c9529,
            _:N3d8b3f2644854be8866d9473e433540c,
            _:N4ee38d1980d84a99a900b87854ca475c,
            _:N706c34ffdb6248bdb8ca2390e7709206,
