        rdfs:comment "An action of crossing a boundary is defined in this class."@en ;
        rdfs:subClassOf ns3:UseAction ;
        sh:nodeKind sh:IRI .

    ns3:BoundaryDefinitionAction a owl:Class,
            sh:NodeShape ;
