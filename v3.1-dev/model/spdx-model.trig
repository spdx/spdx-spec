        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns4:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns6:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0eebde0edda840e18699a60f4129365e,
            _:N1e2d0a0f7bce4bc8aa61724298580987,
            _:N258e4d07881342479874a86efa2e3c09,
            _:N2ed93a1d765048738b7e3d7e0930e193,
            _:N3a120ad19c8c4b8998702c5921388f81,
            _:N45c05b59fed341b8a0ed8a6488b53ace,
            _:N54c87f24616e48fc819398e6e8717b89,
            _:N5644ca15a6c34f8388b41095f0df6693,
            _:N640cdb93d92142ce96a51d1fecb1dc4c,
            _:N8393119b8b224c80a22731af62717f4b,
            _:N973a472074484f44b7d6b17d6635f4e3,
