    <https://spdx.org/rdf/3/terms/Dataset/ConfidentialityLevelType/clear> a owl:NamedIndividual,
            ns2:ConfidentialityLevelType ;
        rdfs:label "clear" ;
        rdfs:comment "Dataset may be distributed freely, without restriction."@en .

