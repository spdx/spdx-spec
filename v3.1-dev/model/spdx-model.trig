        sh:nodeKind sh:IRI ;
        sh:property _:Nbaeeaeb6840d498bac0eae453ab9fd6d .

    ns6:DestroyProcess a owl:Class ;
        rdfs:comment "The destruction process is defined in this process."@en ;
