        sh:nodeKind sh:IRI ;
        sh:property _:N204321d9ddd643cdafa45b1d101851a2,
            _:N597d5ccc99304dc98e3482ceefa47c9b,
            _:N94fbc02314704053a0b3371a8b17c523 .

