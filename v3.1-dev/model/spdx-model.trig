Size of the dataset."""@en ;
        rdfs:range xsd:nonNegativeInteger .

    ns2:datasetType a owl:ObjectProperty ;
        rdfs:comment "Type of data in a dataset."@en ;
        rdfs:range ns2:DatasetType .

    ns2:datasetUpdateMechanism a owl:DatatypeProperty ;
