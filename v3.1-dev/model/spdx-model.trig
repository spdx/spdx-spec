        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns6:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns4:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N26a8e9e19d5a4a0aaca1efb09f4e258b,
            _:N34bac9cc22894a5aaba855fdc6841a7a,
            _:N38ec6683743b406faef05ccb97e76072,
            _:N3b04f880921240bc93f45d479db64531,
            _:N3c41ecc2954042598f8db59feaaba87f,
