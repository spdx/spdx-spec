        sh:nodeKind sh:IRI ;
        sh:property _:N1374f9da2cd44915a3bd25651a767d8a,
            _:N13de6cfaa1f14a49aec968be27f445f0,
            _:N195e288787ef493f90128a3cd0068e33,
