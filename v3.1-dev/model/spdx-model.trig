        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N69452e4441a04282bf6c1f2c0ace0130,
            _:N7954a08afcba43ec8a07fa409c0fabfa,
