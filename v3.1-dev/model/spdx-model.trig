        rdfs:range ns2:RequirementVerification .

    ns2:evidenceCategory a owl:ObjectProperty ;
        rdfs:comment "evidenceCategory refers to a category of documented or observable proof."@en ;
        rdfs:range ns2:EvidenceType .

