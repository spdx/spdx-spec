        sh:nodeKind sh:IRI ;
        sh:property _:N9ec992203c4f4fbb926c28a0d153ee3e,
            _:Nf8f7e9b8e3354e76939d25da88873cc4 .

    ns10:additionText a owl:DatatypeProperty ;
