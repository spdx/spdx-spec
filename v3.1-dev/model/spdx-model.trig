        rdfs:subClassOf ns3:VulnAssessmentRelationship ;
        sh:nodeKind sh:IRI ;
        sh:property _:N3af31d20c41e448a857c37639655e357 .

    ns3:VexAffectedVulnAssessmentRelationship a owl:Class,
            sh:NodeShape ;
