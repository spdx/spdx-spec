        sh:nodeKind sh:IRI ;
        sh:property _:N127d601c080f4e1ca37ec643cb712c39,
            _:N1658461d490a41b0b38902a0f6c1e1cf,
            _:N24c0e50b6a0246e985b78820b60966ec,
