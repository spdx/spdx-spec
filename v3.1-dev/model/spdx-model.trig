            sh:NodeShape ;
        rdfs:comment "A prescribed change to a product's location."@en ;
        rdfs:subClassOf ns9:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N79fecfbe37ed4128bce0b20ccd623970,
            _:N7b035792908a483da4cf3fe69c4aa072,
