    spdx: a owl:Ontology ;
        rdfs:label "System Package Data Exchange™ (SPDX®) Ontology"@en ;
        dcterms:abstract "This ontology defines the terms and relationships used in the SPDX specification to describe system packages"@en ;
        dcterms:created "2026-01-23"^^xsd:date ;
        dcterms:creator "SPDX Project"@en ;
        dcterms:license <https://spdx.org/licenses/Community-Spec-1.0.html> ;
        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns9:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns10:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N09f1b432c8ad453da8ab3c024d0292b8,
            _:N2271f9d3c7be472185e894a5d928959b,
            _:N267efa7f1f324aba9261900e29fc0d76,
            _:N37b9ac3adb534bdc8f445432fbb0f0c1,
            _:N4b06280c3d824b728e61c16dbf7849df,
            _:N5dcc0e46177a4d40bc7963e2813b441a,
            _:N66dce8b9abd04cb694e22174e837294a,
            _:N6e986bc0b1a644c9b03a41910a3cf8d4,
            _:N9159132604164bc8bddac16a0b2d8e4b,
            _:N961b120f37a942879f4dc5aaa07f0f4b,
            _:N9d4c0e5d90c34609bf6b3c2f4afb59cb,
            _:Na55485ae393f4988833d99cd33f60d3b,
            _:Nb8824f5ee57342c49045153090ed3b4d,
