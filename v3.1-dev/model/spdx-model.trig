        rdfs:range xsd:string .

    ns6:AbstractPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Refers to an abstract, conceptual software entity."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N1f228896c5a447969eb0cc615ebb66ac,
            _:N23b1f4a006ed4bb2a468e714dcbc58b3,
