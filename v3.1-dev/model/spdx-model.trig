    _:Nf927a813e2b3491fb395ae232aae5305 a sh:SPARQLConstraint ;
        sh:message "At least one of Core/country, Core/city, Core/streetAddress, Core/geographicPointLocation, or Core/name is required" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    FILTER NOT EXISTS { $this <Core/country> ?country . }
    FILTER NOT EXISTS { $this <Core/city> ?city . }
    FILTER NOT EXISTS { $this <Core/streetAddress> ?streetAddress . }
    FILTER NOT EXISTS { $this <Core/geographicPointLocation> ?point . }
    FILTER NOT EXISTS { $this <Core/name> ?name . }
}""" .

