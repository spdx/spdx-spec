    <https://spdx.org/rdf/3/terms/Core/ExternalRefType/releaseNotes> a owl:NamedIndividual,
            ns1:ExternalRefType ;
        rdfs:label "releaseNotes" ;
        rdfs:comment "A reference to the release notes for a package."@en .

