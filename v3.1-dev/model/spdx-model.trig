    _:N066f30fb96bb47689c95485b32e0eaad a sh:SPARQLConstraint ;
        sh:message "When relationship is hasRequirement, class must be LifecycleScopedRelationship" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/hasRequirement> .
