        sh:nodeKind sh:IRI ;
        sh:property _:Nb4ff53072831409084fe463cec7ddd2a,
            _:Ne93537297afd4d9aa6581eaf7123a804 .

    ns10:StorageAction a owl:Class ;
        rdfs:comment "Records the storage of a product."@en ;
        rdfs:subClassOf ns10:ModifyAction ;
        sh:nodeKind sh:IRI .

