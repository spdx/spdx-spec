        rdfs:comment "The Element is a test used to verify functionality on a software element."@en .

    <https://spdx.org/rdf/3/terms/SupplyChain/ResponsibilityType/custody> a owl:NamedIndividual,
            ns10:ResponsibilityType ;
        rdfs:label "custody" ;
