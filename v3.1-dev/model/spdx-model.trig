            sh:NodeShape ;
        rdfs:comment "Provides an exploit assessment of a vulnerability."@en ;
        rdfs:subClassOf ns4:VulnAssessmentRelationship ;
        sh:nodeKind sh:IRI ;
        sh:property _:Nda860cf18dc8453fa9383fa05eebcc62,
            _:Nf33821a1fdff48a88ea98eee16eed7c0,
