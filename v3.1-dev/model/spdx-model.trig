        rdfs:subClassOf ns4:CreateAction ;
        sh:nodeKind sh:IRI .

    ns4:ReproduceProcess a owl:Class ;
        rdfs:comment "Reproduction is the biological process by which living organisms produce offspring."@en ;
        rdfs:subClassOf ns4:CreateProcess ;
