        sh:nodeKind sh:IRI ;
        sh:property _:N145a4cef5af446cab6887a18c79ce2b5 .

    ns9:WithAdditionOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing a License which has additional
