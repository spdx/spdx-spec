            _:Nd56098e8d206448facf4a3324c52af27 .

    ns1:SoftwareAgent a owl:Class ;
        rdfs:comment "A software agent."@en ;
        rdfs:subClassOf ns1:Agent ;
        sh:nodeKind sh:IRI .

    ns1:SpdxDocument a owl:Class,
            sh:NodeShape ;
