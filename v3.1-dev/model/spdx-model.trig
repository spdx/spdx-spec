        sh:nodeKind sh:IRI ;
        sh:property _:N1df8b14d80ed479abf6b9ab5c163f9bc,
            _:N2eff1b9f29224e5d91298632990c9742,
            _:N4fa8365a70d84f378c575365253b1158,
