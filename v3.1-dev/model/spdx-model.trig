        sh:nodeKind sh:IRI ;
        sh:property _:N1d2cba320da3461c89f94b82fb940c1a,
            _:N3011cda1ed2d4a1eb6c05726a6ea308a,
            _:N3e2ef5b7320049f1b6a227711309a74e,
