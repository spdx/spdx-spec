        sh:nodeKind sh:IRI ;
        sh:property _:N88590d3954264d68b4698e32f1d440ca,
            _:Neb96a709c98c4a7fab6e2989b7a4b113 .

    ns8:OrLaterOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing this version, or any later version,
of the indicated License."""@en ;
        rdfs:subClassOf ns8:ExtendableLicense ;
        sh:nodeKind sh:IRI ;
        sh:property _:N616e78fe784e461a9d9ef32aabfc4d0a .

    ns8:WithAdditionOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing a License which has additional
