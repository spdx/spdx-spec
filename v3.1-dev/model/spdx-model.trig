        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:property _:N47471d09b2f94a0b9fec55e9eff1ee2f,
            _:Nf049c3b5fb4146a78d854369fc9a8ca3,
            _:Nfe8dfd45d3f2436cabebf79261f9dd15 .

