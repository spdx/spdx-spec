            ns1:ProfileIdentifierType ;
        rdfs:label "build" ;
        rdfs:comment "The element follows the Build profile specification."@en .

    <https://spdx.org/rdf/3/terms/Core/ProfileIdentifierType/core> a owl:NamedIndividual,
