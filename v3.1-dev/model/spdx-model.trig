        sh:nodeKind sh:IRI ;
        sh:property _:N04cb0bd46a604f8da1243c9d134d35b0,
            _:N056e0fdd0f454c9cb0f7d444257f18bb,
            _:N4320a6a1128f4fd5bfdf6ac87a2e8718,
