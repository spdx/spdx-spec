        sh:nodeKind sh:IRI .

    ns7:TestProcess a owl:Class ;
        rdfs:comment "Test Process defines the testing process for an element."@en ;
        rdfs:subClassOf ns7:UseProcess ;
        sh:nodeKind sh:IRI .

