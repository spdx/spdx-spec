        rdfs:comment "Identifies the tooling that was used during the creation of the Element."@en ;
        rdfs:range ns4:Tool .

    ns4:creationInfo a owl:ObjectProperty ;
        rdfs:comment "Provides information about the creation of the Element."@en ;
