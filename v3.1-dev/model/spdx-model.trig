        rdfs:range xsd:string .

    ns5:datasetAvailability a owl:ObjectProperty ;
        rdfs:comment "Availability of a dataset."@en ;
        rdfs:range ns5:DatasetAvailabilityType .

    ns5:datasetNoise a owl:DatatypeProperty ;
