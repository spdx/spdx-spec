        rdfs:range ns3:ContentIdentifierType .

    ns3:contentIdentifierValue a owl:DatatypeProperty ;
        rdfs:comment "Specifies the value of the content identifier."@en ;
        rdfs:range xsd:anyURI .

    ns3:copyrightText a owl:DatatypeProperty ;
