            ns1:RelationshipCompleteness ;
        rdfs:label "complete" ;
        rdfs:comment "The relationship is known to be exhaustive."@en .

    <https://spdx.org/rdf/3/terms/Core/RelationshipCompleteness/incomplete> a owl:NamedIndividual,
            ns1:RelationshipCompleteness ;
        rdfs:label "incomplete" ;
