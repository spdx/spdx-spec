    _:N7f39dcfe1d6f41b4a0630b4f7a4c8ce4 a sh:SPARQLConstraint ;
        sh:message "When relationship is hasRequirement, class must be LifecycleScopedRelationship" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/hasRequirement> .
    FILTER NOT EXISTS { $this rdf:type <Core/LifecycleScopedRelationship> }
}""" .

    _:N7f4435fca2b94b3c83320fae075b7124 a sh:SPARQLConstraint ;
        sh:message "When relationship is resolved, from must be a ResolutionAction" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/resolved> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <SupplyChain/ResolutionAction> }
}""" .

