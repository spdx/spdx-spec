        rdfs:subClassOf ns7:CreateProcess ;
        sh:nodeKind sh:IRI .

    ns7:ManufactureAction a owl:Class ;
        rdfs:comment "ManufactureAction represents the act of creating a product by a manufacturing process."@en ;
        rdfs:subClassOf ns7:CreateAction ;
