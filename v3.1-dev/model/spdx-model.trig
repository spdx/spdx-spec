        sh:nodeKind sh:IRI ;
        sh:property _:N3bc38c2e7ca24cd08a8d03288e6bc5e8,
            _:N6d8117e6748e4253ae2b88a80c911b83,
            _:N7b794b6b39fe4195a5d12ed6e80da812,
            _:N8d28a81920984b5a92918af6d21f15bd,
            _:Nb0ad9e55460c4f52916f1743634edab5,
            _:Nb9b88ab81a084d7c93e7615d0cb3b8ef,
            _:Nd19a55933ba54bba931db677c18cf79f,
            _:Nd3c7da72abd94e7ca0b5406f9b529966,
            _:Nf0bdbd963e4d4400bb5a0d7beead1694 .

    <https://spdx.org/rdf/3.1/terms/Core/ProcessReadinessType/active> a owl:NamedIndividual,
