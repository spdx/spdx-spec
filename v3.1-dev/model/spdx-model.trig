    _:N01f01f08a209462fa8cf2fe1df924a7d a sh:SPARQLConstraint ;
        sh:message "When relationship is coordinatedBy, from must be a Vulnerability" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/coordinatedBy> .
