    <https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/install> a owl:NamedIndividual,
            ns5:SoftwarePurpose ;
        rdfs:label "install" ;
        rdfs:comment "The Element is used to install software on disk."@en .

