    spdx: a owl:Ontology ;
        rdfs:label "System Package Data Exchange™ (SPDX®) Ontology"@en ;
        dcterms:abstract "This ontology defines the terms and relationships used in the SPDX specification to describe system packages"@en ;
        dcterms:created "2026-01-23"^^xsd:date ;
        dcterms:creator "SPDX Project"@en ;
        dcterms:license <https://spdx.org/licenses/Community-Spec-1.0.html> ;
        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns3:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns5:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N040dbd1f7d154c5d80972aa0c95c8e71,
            _:N2097dbef59224c388b1839e3a0af7f8a,
            _:N2530f4a50a3e46ae90bb72fddf199457,
            _:N27055ab60d62476ab129378980773443,
            _:N3580a0791a7a4318ab07066c8ad2a605,
            _:N39658cecd9794a909938fadff4f636f5,
            _:N484f04c532214278a4afd8808dd225ba,
            _:N52fcc9a9d178443a8349bc731dc94c43,
            _:N5dc72a0ee0d540eea863cc0e9965109a,
            _:N8d40bd0ed3404df0b2c11f93bcc3dea3,
            _:N9143ee7b8adc4b169fad119b8b3300e4,
            _:N9161b58e7a57471c909d65f319586766,
            _:Nbd44202bfc0e40dc8785e4fc4a00324d,
            _:Nd8af18a478ff4b0c9ebc6c4f9dcf7363,
