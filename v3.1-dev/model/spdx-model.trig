        sh:nodeKind sh:IRI ;
        sh:property _:N1aa577cd82614b28abfed7e4cb4e487c,
            _:N41040102a4e94f35a453bcd80913c32a,
            _:N45e33b09c19046ebac32ccc3ad18147a,
