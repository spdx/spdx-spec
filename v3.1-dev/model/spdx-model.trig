        rdfs:subClassOf ns9:UseAction ;
        sh:nodeKind sh:IRI .

    ns9:PlanAction a owl:Class ;
        rdfs:comment "A PlanAction involves the execution of a plan in relation to a PlanProcess."@en ;
        rdfs:subClassOf ns9:UseAction ;
        sh:nodeKind sh:IRI .

    ns9:PlanProcess a owl:Class ;
