        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns8:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns3:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N128bf5e4ce0649b694f1150ce4090e9a,
            _:N1bf6a14232c44e4080038a02099efc5d,
            _:N3c519d00256a4a099e12215ad35dca60,
            _:N51e8bc68af834b63b75372c92b5fdbe0,
            _:N54f09f6affea4b3b87577819820469ef,
            _:N7212081d798a4b5c8dbc3785e9d802de,
            _:N82434e6210ec4f17bb6d2300a927bcb3,
            _:Na57c74386420495c8e761abf854c5690,
            _:Nc4d447c017954d119d7c24b8f76e11a0,
            _:Nc4dcac1028a34532a417bd4d86e64ea2,
            _:Nc784f87da2384804a14c0c114858e557,
            _:Nca9fb905651c4cad9500ac113f41b271,
