        rdfs:subClassOf ns7:UseAction ;
        sh:nodeKind sh:IRI .

    ns7:PlanAction a owl:Class ;
        rdfs:comment "A PlanAction involves the execution of a plan in relation to a PlanProcess."@en ;
        rdfs:subClassOf ns7:UseAction ;
        sh:nodeKind sh:IRI .

    ns7:PlanProcess a owl:Class ;
