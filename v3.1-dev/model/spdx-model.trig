        sh:nodeKind sh:IRI ;
        sh:property _:Ndd7d957daef448a3abc5ad12a5bad7a1 .

    ns2:DestroyProcess a owl:Class ;
        rdfs:comment "The destruction process is defined in this process."@en ;
