        rdfs:subClassOf <https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo> ;
        sh:nodeKind sh:IRI ;
        sh:property _:Ne6880a35a2554b8db2563a9067eaf599 .

    ns3:ListedLicense a owl:Class,
