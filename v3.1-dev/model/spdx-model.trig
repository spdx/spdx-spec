        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns3:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns6:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0688b400f70a4a14ba1c8eddf1e09bde,
            _:N0e705330f59e44b4844a584343435c0f,
            _:N18a7a45f44f14f8abded7174973e336c,
            _:N1c7d46e7e6214c91a5235bb4c94d26b3,
            _:N312f35f1a65143abaab0f7fb640b5a3a,
            _:N690fdc5f654d4d9690f680cebabe2e93,
            _:N834b33c57b8d498191e12b495c061679,
            _:Naf87000a2df14eb3b58efbf964f59a5e,
            _:Nb1871cd1adb7468183c69bdd1b4cfa0e,
            _:Nb2678dabfd344051988e2a28cedae201,
