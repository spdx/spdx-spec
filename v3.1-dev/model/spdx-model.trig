        sh:nodeKind sh:IRI ;
        sh:property _:N34aa948266f34ee28cbec39cb77bdd96,
            _:Naf99b0b72cff4acd96bd0c686c086796 .

    ns4:StorageAction a owl:Class ;
        rdfs:comment "Records the storage of a product."@en ;
        rdfs:subClassOf ns4:ModifyAction ;
        sh:nodeKind sh:IRI .

