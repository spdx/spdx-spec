        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns9:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns5:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N08fcdcf7915645bab99d293eb3b30c32,
            _:N12ccf3c5b69a4b269db19904c18c9373,
            _:N35892b0766894365aae32e2124526bc6,
            _:N3c74444d04174ee8a1a3522c0a8eb89e,
            _:N4287b17879234a709a274ebd2013a3b1,
            _:N4a7544e823d84569a58ddcf4c2dc1ff3,
            _:N59e6c8257bad40218764cf00123a7892,
            _:N655ed91f77a94c7f931022b2fce752b0,
            _:N764696669dc94aa0b66ec2c9f1f79675,
            _:N9a9f62bcb2524b8fa465a946c1400a51,
            _:N9f16a5e55cf64f9c9ca49fdfef17c99d,
            _:Nb19cc0c6fcb842f090ddcb8aaef96123,
