    _:Nfd3939ed98564489967baebe226bd06e a sh:SPARQLConstraint ;
        sh:message "When relationship is invokedBy, to must be an Agent" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/invokedBy> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Agent> }
}""" .

