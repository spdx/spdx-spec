    ns10:InspectionProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Inspection Process defines specific various processes needed to satisfy the inspection requirements for a specific product or service."@en ;
        rdfs:subClassOf ns10:UseProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:Nb00f5c171a2144abb22d031c499d00d6 .

    ns10:InstantiateVirtualHardwareProcess a owl:Class ;
