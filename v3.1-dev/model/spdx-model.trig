        sh:nodeKind sh:IRI ;
        sh:property _:N941c0565b68c454b96a140f0a5fc7dc6,
            _:Nc1c20dcde7954545890dda1d45ace0a6 .

    ns5:additionText a owl:DatatypeProperty ;
