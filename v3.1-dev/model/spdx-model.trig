        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns7:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns3:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N18f3b2be02f9470891067d9cacd14970,
            _:N19e94a34ecbe4684bf7fd27bbc32f4cd,
            _:N2c779b97c7ea4fddb668b6910f199962,
            _:N34cb7d727b6a4beb9ee5fc1c509758d1,
            _:N52f8dd402f8042ad80480a4c300abdc6,
            _:N6add2054d943413495cc628d9352e643,
            _:N9d9261f094ab4cb6a4c98aff3c6c1ecc,
            _:Na60aed5e56f24aa7b65ad1a7d3872075,
            _:Na6ceb0fc90b54a55b9efa72b9e567666,
            _:Nba4440c4120541b6b828e2618a3381fd,
            _:Nbb01ce3366da43b9868afc182c8f1237,
