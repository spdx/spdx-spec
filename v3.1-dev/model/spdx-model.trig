        rdfs:range xsd:string .

    ns11:datasetAvailability a owl:ObjectProperty ;
        rdfs:comment "Availability of a dataset."@en ;
        rdfs:range ns11:DatasetAvailabilityType .

    ns11:datasetNoise a owl:DatatypeProperty ;
