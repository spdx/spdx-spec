License or LicenseAddition."""@en ;
        rdfs:range xsd:string .

    ns10:seeAlso a owl:DatatypeProperty ;
        rdfs:comment "Contains a URL where the License or LicenseAddition can be found in use."@en ;
        rdfs:range xsd:anyURI .

