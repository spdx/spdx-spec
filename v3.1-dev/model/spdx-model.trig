    <https://spdx.org/rdf/3/terms/Security/ExploitCatalogType/other> a owl:NamedIndividual,
            ns5:ExploitCatalogType ;
        rdfs:label "other" ;
        rdfs:comment "Other exploit catalogs."@en .

    ns5:ExploitCatalogVulnAssessmentRelationship a owl:Class,
            sh:NodeShape ;
