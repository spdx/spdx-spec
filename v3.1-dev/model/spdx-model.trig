        rdfs:subClassOf <https://spdx.org/rdf/3/terms/Extension/Extension> ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:property _:Nb0b52b1d821e45b599dfc0a89459f5e6 .

    ns10:mass a owl:DatatypeProperty ;
