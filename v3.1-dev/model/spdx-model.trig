        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N1d559d2a0eeb4b078c9363283359d4c4,
            _:N1ec36820664140c9a73498211d8c9a4f,
