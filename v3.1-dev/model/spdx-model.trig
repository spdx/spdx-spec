text applied to it."""@en ;
        rdfs:subClassOf <https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo> ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0be12752b745404a95fece29576f21f0,
            _:N37a4a305d2a24cc4baf4c4f19cdd64d5 .

