        sh:nodeKind sh:IRI ;
        sh:property _:N3a28a0eca0be4115bcd4e26507ef4ed4,
            _:N719701d2777a4ab097cb066ffce4563d,
            _:N8c701f6c10bf4590a7ec6c3bc6810de2,
