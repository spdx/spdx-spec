    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nb37c4c230d6541138b5c7e01581dc70d">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/profileConformance"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:in rdf:parseType="Collection">
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/core"/>
