        </sh:in>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Neb11b7003cc948f2a7111eaed880165f">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety/verificationPrecondition"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
