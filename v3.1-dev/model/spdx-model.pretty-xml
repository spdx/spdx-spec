          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/security"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/build"/>
