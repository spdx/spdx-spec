  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Security/VexNotAffectedVulnAssessmentRelationship">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">Links a vulnerability and one or more elements designating the latter as products
not affected by the vulnerability.</rdfs:comment>
