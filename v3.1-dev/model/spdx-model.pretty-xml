        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:in rdf:parseType="Collection">
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType/analysis"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType/assessment"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType/audit"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType/demonstration"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType/inspection"/>
