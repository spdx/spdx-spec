    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Dataset/ConfidentialityLevelType"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/AI/limitation">
    <rdfs:comment xml:lang="en">Limitation of the AI software.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Software/contentIdentifierType">
    <rdfs:comment xml:lang="en">Specifies the type of the content identifier.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Software/ContentIdentifierType"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/processRationale">
