    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Agent"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/plannedCurrent">
    <rdfs:comment xml:lang="en">This is the planned individual, business, or organization who currently manages goods, services, or assets.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Agent"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/packageVerificationCodeExcludedFile">
    <rdfs:comment xml:lang="en">The relative file name of a file to be excluded from the
`PackageVerificationCode`.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/SupportType/noAssertion">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/SupportType"/>
    <rdfs:label>noAssertion</rdfs:label>
    <rdfs:comment xml:lang="en">No assertion about the type of support is made. This is considered the default if no other support type is used.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType/analysis">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType"/>
    <rdfs:label>analysis</rdfs:label>
    <rdfs:comment xml:lang="en">Analytical evaluating of data, designs, or processes methodically to verify correctness against standards or expectations. Typical analysis methods are FMEA, FTA, STPA, static analysis for MISRA compliance etc.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Security/CvssSeverityType/high">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Security/CvssSeverityType"/>
    <rdfs:label>high</rdfs:label>
