    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nc0e01d17ce064b15b38547b3335ea829">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Security/impactStatementTime"/>
