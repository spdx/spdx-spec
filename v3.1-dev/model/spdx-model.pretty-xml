  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Software/Sbom">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">A collection of SPDX Elements describing a single package.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Bom"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="Nc8484ef48f594278acfc1bd5e33bf41c">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Software/sbomType"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SbomType"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:in rdf:parseType="Collection">
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Software/SbomType/design"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Software/SbomType/source"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Software/SbomType/build"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Software/SbomType/deployed"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Software/SbomType/runtime"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Software/SbomType/analyzed"/>
        </sh:in>
      </rdf:Description>
    </sh:property>
  </owl:Class>
