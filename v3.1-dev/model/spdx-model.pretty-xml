    <rdfs:comment xml:lang="en">Timestamp of impact statement.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/AI/metric">
    <rdfs:comment xml:lang="en">Metric used to evaluate the AI model.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/DictionaryEntry"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/batchNumber">
    <rdfs:comment xml:lang="en">Identifier for product production batch.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/ConfidentialityLevelType/amber">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Dataset/ConfidentialityLevelType"/>
    <rdfs:label>amber</rdfs:label>
    <rdfs:comment xml:lang="en">Data points in the dataset can be shared only with specific organizations and their clients on a need to know basis.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType">
    <rdfs:comment xml:lang="en">Information about the relationship between two Elements.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/dataPreprocessing">
    <rdfs:comment xml:lang="en">Preprocessing steps that were applied to the raw data to create the given dataset.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/State">
    <rdfs:comment xml:lang="en">A state is an instance that describes what a system, component, subsystem, process, or project has achieved at any given time.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Artifact"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/createdBy">
    <rdfs:comment xml:lang="en">Identifies who or what created the Element.</rdfs:comment>
