    <rdfs:comment xml:lang="en">A place for the SPDX document creator to record a website that serves as the
package's home page.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/endIntegerRange">
