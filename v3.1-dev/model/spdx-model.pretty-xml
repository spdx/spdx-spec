        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nbc0c2e867f054fbfb070ad938fbabe6b">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/ExpandedLicensing/listVersionAdded"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/evidenceCategory">
    <rdfs:comment xml:lang="en">evidenceCategory refers to a category of documented or observable proof.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvidenceType"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType/registration">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType"/>
    <rdfs:label>registration</rdfs:label>
    <rdfs:comment xml:lang="en">Dataset is not publicly available and an email registration is required before accessing the dataset, although without an affirmative acceptance of terms.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/supportLevel">
    <rdfs:comment xml:lang="en">Specifies the level of support associated with an artifact.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/SupportType"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/securityPolicy">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType"/>
    <rdfs:label>securityPolicy</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to instructions for reporting newly discovered security vulnerabilities for a package.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/VirtualHardware">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">Class that describes an instance of VirtualHardware.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Hardware/Hardware"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="Ndf70c3fe20724942a02ff03429fc53e9">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Hardware/virtualHardwareModel"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Hardware/VirtualHardwareModelType"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:in rdf:parseType="Collection">
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/VirtualHardwareModelType/function"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/VirtualHardwareModelType/cycle"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/VirtualHardwareModelType/other"/>
        </sh:in>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/DestroyAction">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">The record of destruction is entered in this action.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Action"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N50d96d3419bf4665b593b51ac48a658d">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/destructionPerformedBy"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Agent"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/scope">
    <rdfs:comment xml:lang="en">Capture the scope of information about a specific relationship between elements.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/standardName">
    <rdfs:comment xml:lang="en">The name of a relevant standard that may apply to an artifact.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Security/CvssSeverityType">
    <rdfs:comment xml:lang="en">Specifies the CVSS base, temporal, threat, or environmental severity type.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/ExpandedLicensing/isFsfLibre">
    <rdfs:comment xml:lang="en">Specifies whether the License is listed as free by the
Free Software Foundation (FSF).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Security/SsvcDecisionType/trackStar">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Security/SsvcDecisionType"/>
    <rdfs:label>trackStar</rdfs:label>
    <rdfs:comment xml:lang="en">("Track\*" in the SSVC spec) The vulnerability contains specific characteristics that may require closer monitoring for changes. CISA recommends remediating Track\* vulnerabilities within standard update timelines.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/sha3_512">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm"/>
    <rdfs:label>sha3_512</rdfs:label>
    <rdfs:comment xml:lang="en">SHA-3 with a digest length of 512, as defined in [FIPS 202](https://csrc.nist.gov/pubs/fips/202/final).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/DatasetType/image">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Dataset/DatasetType"/>
    <rdfs:label>image</rdfs:label>
    <rdfs:comment xml:lang="en">Data is a collection of images such as pictures of animals.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/externalSpdxId">
    <rdfs:comment xml:lang="en">Identifies an external Element used within an SpdxDocument but defined
external to that SpdxDocument.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/ExpandedLicensing/ListedLicenseException">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
