  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/CreationInfo">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">Provides information about the creation of the Element.</rdfs:comment>
