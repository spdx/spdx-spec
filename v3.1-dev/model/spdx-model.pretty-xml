      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nd0c99a817f854fd895aaa9df43998e19">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/comment"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType/query">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType"/>
    <rdfs:label>query</rdfs:label>
    <rdfs:comment xml:lang="en">Dataset is publicly available, but not all at once, and can only be accessed through queries which return parts of the dataset.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/DatasetType/audio">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Dataset/DatasetType"/>
    <rdfs:label>audio</rdfs:label>
    <rdfs:comment xml:lang="en">Data is audio based, such as a collection of music from the 80s.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/sha3_224">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm"/>
    <rdfs:label>sha3_224</rdfs:label>
    <rdfs:comment xml:lang="en">SHA-3 with a digest length of 224, as defined in [FIPS 202](https://csrc.nist.gov/pubs/fips/202/final).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/streetAddress">
    <rdfs:comment xml:lang="en">Street address includes a street number, name and unit ID to identify a specific street.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/archive">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"/>
    <rdfs:label>archive</rdfs:label>
    <rdfs:comment xml:lang="en">The Element is an archived collection of one or more files (.tar, .zip, etc.).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Security/percentile">
    <rdfs:comment xml:lang="en">The percentile of the current probability score.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SbomType/source">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SbomType"/>
    <rdfs:label>source</rdfs:label>
    <rdfs:comment xml:lang="en">SBOM created directly from the development environment, source files, and included dependencies used to build a product artifact.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm">
    <rdfs:comment xml:lang="en">A mathematical algorithm that maps data of arbitrary size to a bit string.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Software/downloadLocation">
    <rdfs:comment xml:lang="en">Identifies the download Uniform Resource Identifier for the package at the time
that the document was created.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Operations/projectStartTime">
    <rdfs:comment xml:lang="en">Time when the project starts or is planned to start.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/dimensions">
    <rdfs:comment xml:lang="en">Information related to hardware dimension.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Hardware/Dimensions"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/decisionProcess">
    <rdfs:comment xml:lang="en">This is how the currentState of an affected Element is found.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/DefinedStateProcess"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipCompleteness/incomplete">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipCompleteness"/>
    <rdfs:label>incomplete</rdfs:label>
    <rdfs:comment xml:lang="en">The relationship is known not to be exhaustive.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/summary">
    <rdfs:comment xml:lang="en">A short description of an Element.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/amendedBy">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>amendedBy</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element is amended by each `to` Element.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasResolution">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>hasResolution</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` ResolutionAction point to the `to` OutOfSpecAction that is addressed.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/locatedAt">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>locatedAt</rdfs:label>
    <rdfs:comment xml:lang="en">`from` element located at a specific `to` location. A time period is optional.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Software/attributionText">
    <rdfs:comment xml:lang="en">Provides a place for the SPDX data creator to record acknowledgement text for
a software Package, File or Snippet.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/ResponsibilityType">
    <rdfs:comment xml:lang="en">These categories help define sets Responsibility Type.</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasOptionalComponent">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>hasOptionalComponent</rdfs:label>
    <rdfs:comment xml:lang="en">Every `to` Element is an optional component of the `from` Element (`from` hasOptionalComponent `to`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/category">
    <rdfs:comment xml:lang="en">The category describes the hardware item in a DefinedType.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/DefinedType"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType/assessment">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType"/>
    <rdfs:label>assessment</rdfs:label>
    <rdfs:comment xml:lang="en">A systematic examination of a system, process, or outcome to evaluate compliance of specific work products with a specific expectation with a specification, regulation or standard. Often involves judgement and a rationale of this judgement.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Software/sbomType">
    <rdfs:comment xml:lang="en">Provides information about the type of an SBOM.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SbomType"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/adler32">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm"/>
    <rdfs:label>adler32</rdfs:label>
    <rdfs:comment xml:lang="en">Adler-32 checksum is part of the widely used zlib compression library as defined in [RFC 1950](https://datatracker.ietf.org/doc/rfc1950/) Section 2.3.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/verificationPrecondition">
    <rdfs:comment xml:lang="en">Verification preconditions are initial criteria that are to be met prior to initiating the verification method.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Operations/weight">
    <rdfs:comment xml:lang="en">Weight to express relevance in de minimis consideration.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/statement">
    <rdfs:comment xml:lang="en">Commentary on an assertion that an annotator has made.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Software/packageUrl">
    <rdfs:comment xml:lang="en">Provides a place for the SPDX data creator to record the package URL string
(in accordance with the Package URL specification) for a software Package.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/ExpandedLicensing/subjectExtendableLicense">
    <rdfs:comment xml:lang="en">A License participating in a 'with addition' model.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/ExpandedLicensing/ExtendableLicense"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/funding">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType"/>
    <rdfs:label>funding</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to funding information related to a package.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/ManufactureProcess">
    <rdfs:comment xml:lang="en">This class represents the process involved in manufacturing products.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/CreateProcess"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ProcessReadinessType/obsolete">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ProcessReadinessType"/>
    <rdfs:label>obsolete</rdfs:label>
    <rdfs:comment xml:lang="en">superseded or not valid at present</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType/update">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType"/>
    <rdfs:label>update</rdfs:label>
    <rdfs:comment xml:lang="en">A relationship has specific context implications for a product update.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/ExpandedLicensing/IndividualLicensingInfo">
    <rdfs:comment xml:lang="en">A concrete subclass of AnyLicenseInfo used by Individuals in the
ExpandedLicensing profile.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasHost">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>hasHost</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Build was run on the `to` Element during a LifecycleScopeType period (e.g. the host that the build runs on).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/serialNumber">
    <rdfs:comment xml:lang="en">Identifier for specific product is called a serial number.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Service/AuthenticationProtocolType/tls">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Service/AuthenticationProtocolType"/>
    <rdfs:label>tls</rdfs:label>
    <rdfs:comment xml:lang="en">Transport Layer Security, or TLS, is a widely adopted security protocol designed to facilitate privacy and data security for communications over the Internet.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasAssociatedVulnerability">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>hasAssociatedVulnerability</rdfs:label>
    <rdfs:comment xml:lang="en">Used to associate a `from` Artifact with each `to` Vulnerability.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/AI/safetyRiskAssessment">
    <rdfs:comment xml:lang="en">Results of general safety risk assessment of the AI system.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/AI/SafetyRiskAssessmentType"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel/partialAutomation">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel"/>
    <rdfs:label>partialAutomation</rdfs:label>
    <rdfs:comment xml:lang="en">Level 2 - Partial automation or task automation. Some sub-functions of the system are fully automated while the system remain under control of an external agent. The system can perform actions for an approved task without requiring the agent's continuous direct control.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Security/locator">
    <rdfs:comment xml:lang="en">Provides the location of an exploit catalog.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/sha512">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm"/>
    <rdfs:label>sha512</rdfs:label>
    <rdfs:comment xml:lang="en">SHA-2 with a digest length of 512, as defined in [RFC 6234](https://datatracker.ietf.org/doc/rfc6234/).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/identifier">
    <rdfs:comment xml:lang="en">Uniquely identifies an external element.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Security/actionStatement">
    <rdfs:comment xml:lang="en">Provides advise on how to mitigate or remediate a vulnerability when a VEX product
is affected by it.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/dataCollectionProcess">
    <rdfs:comment xml:lang="en">How the dataset was collected.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/packagedBy">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>packagedBy</rdfs:label>
    <rdfs:comment xml:lang="en">Every `to` Element is a packaged instance of the `from` Element (`from` packagedBy `to`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Build/environment">
    <rdfs:comment xml:lang="en">Property describing the session in which a build is invoked.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/DictionaryEntry"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType/clickthrough">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType"/>
    <rdfs:label>clickthrough</rdfs:label>
    <rdfs:comment xml:lang="en">Dataset is not publicly available and can only be accessed after affirmatively accepting terms on a clickthrough webpage.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/BulkHardware">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">Products or commodities produced as a bulk unit are called bulk products. Commodities are often sold in bulk.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Hardware/Hardware"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="Ne47735b0406b4befb30bdd65fa36d204">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Hardware/bulkQuantity"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Core/UnitOfMeasure"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/requirementUUID">
    <rdfs:comment xml:lang="en">Provides a universally unique Requirement ID.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifier"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/SupportType/support">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/SupportType"/>
    <rdfs:label>support</rdfs:label>
    <rdfs:comment xml:lang="en">The artifact has been released, and is supported from the supplier. There is a validUntilDate that can provide additional information about the duration of support.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/republishedBy">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>republishedBy</rdfs:label>
    <rdfs:comment xml:lang="en">Designates a `from` Vulnerability's details were tracked, aggregated, and/or enriched to improve context (i.e. NVD) by each `to` Agent.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/originatedBy">
    <rdfs:comment xml:lang="en">Identifies from where or whom the Element originally came.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Agent"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Security/CvssSeverityType/medium">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Security/CvssSeverityType"/>
    <rdfs:label>medium</rdfs:label>
    <rdfs:comment xml:lang="en">When a CVSS score is between 4.0 - 6.9.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/sha224">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm"/>
    <rdfs:label>sha224</rdfs:label>
    <rdfs:comment xml:lang="en">SHA-2 with a digest length of 224, as defined in [RFC 3874](https://datatracker.ietf.org/doc/rfc3874/).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/AI/EnergyUnitType/kilowattHour">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/AI/EnergyUnitType"/>
    <rdfs:label>kilowattHour</rdfs:label>
    <rdfs:comment xml:lang="en">Kilowatt-hour.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/invokedBy">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>invokedBy</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element was invoked by the `to` Agent, during a LifecycleScopeType period (for example, a Build element that describes a build step).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/AI/informationAboutApplication">
    <rdfs:comment xml:lang="en">Information about the AI software, not including the model description.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/diskImage">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"/>
    <rdfs:label>diskImage</rdfs:label>
    <rdfs:comment xml:lang="en">The Element refers to a disk image that can be written to a disk, booted in a VM, etc. A disk image typically contains most or all of the components necessary to boot, such as bootloaders, kernels, firmware, userspace, etc.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Security/impactStatement">
    <rdfs:comment xml:lang="en">Explains why a VEX product is not affected by a vulnerability. It is an
alternative in VexNotAffectedVulnAssessmentRelationship to the machine-readable
justification label.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Software/SbomType">
    <rdfs:comment xml:lang="en">Provides a set of values to be used to describe the common types of SBOMs that
tools may create.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/ExpandedLicensing/DisjunctiveLicenseSet">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">Portion of an AnyLicenseInfo representing a set of licensing information where
only one of the elements applies.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
