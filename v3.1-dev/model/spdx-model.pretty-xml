  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasEvidence">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>hasEvidence</rdfs:label>
    <rdfs:comment xml:lang="en">Every `to` Element is considered as evidence for the `from` Element (`from` hasEvidence `to`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/install">
