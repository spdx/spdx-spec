    <rdfs:comment xml:lang="en">Safety risk level.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/inLanguage">
    <rdfs:comment xml:lang="en">Specifies a human language used within the content of an Element or a property.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/confidentialityLevel">
