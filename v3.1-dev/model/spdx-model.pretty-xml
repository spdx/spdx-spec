  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/devLifecycleStage">
    <rdfs:comment xml:lang="en">The product lifecycle phase, the requirement is applicable for.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/AI/modelDataPreprocessing">
    <rdfs:comment xml:lang="en">Preprocessing steps applied to the training data before the model training.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/software">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType"/>
    <rdfs:label>software</rdfs:label>
    <rdfs:comment xml:lang="en">The element follows the Software profile specification.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/DatasetType/categorical">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Dataset/DatasetType"/>
    <rdfs:label>categorical</rdfs:label>
    <rdfs:comment xml:lang="en">Data that is classified into a discrete number of categories, such as the eye color of a population of people.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Operations/projectContract">
    <rdfs:comment xml:lang="en">Link to the project contract.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvidenceType">
    <rdfs:comment xml:lang="en">EvidenceType refers to categories of documented or observable proof used to verify compliance, qualification, or performance</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Build/parameter">
    <rdfs:comment xml:lang="en">Property describing a parameter used in an instance of a build.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/DictionaryEntry"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/coordinatedBy">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>coordinatedBy</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Vulnerability is coordinatedBy the `to` Agent(s) (vendor, researcher, or consumer agent).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/finetunedOn">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>finetunedOn</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element has been finetuned on the `to` Element(s).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/documentation">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"/>
    <rdfs:label>documentation</rdfs:label>
    <rdfs:comment xml:lang="en">The Element is documentation.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasTest">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>hasTest</rdfs:label>
    <rdfs:comment xml:lang="en">Every `to` Element is a test artifact for the `from` Element (`from` hasTest `to`), during a LifecycleScopeType period.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/DatasetType/video">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Dataset/DatasetType"/>
    <rdfs:label>video</rdfs:label>
    <rdfs:comment xml:lang="en">Data is video based, such as a collection of movie clips featuring Tom Hanks.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/DatasetType/text">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Dataset/DatasetType"/>
    <rdfs:label>text</rdfs:label>
    <rdfs:comment xml:lang="en">Data consists of unstructured text, such as a book, a Wikipedia article (without images), or a transcript.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Security/VexJustificationType/inlineMitigationsAlreadyExist">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Security/VexJustificationType"/>
    <rdfs:label>inlineMitigationsAlreadyExist</rdfs:label>
    <rdfs:comment xml:lang="en">Built-in inline controls or mitigations prevent an adversary from leveraging the vulnerability.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/sha256">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm"/>
    <rdfs:label>sha256</rdfs:label>
    <rdfs:comment xml:lang="en">SHA-2 with a digest length of 256, as defined in [RFC 6234](https://datatracker.ietf.org/doc/rfc6234/).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/other">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>other</rdfs:label>
    <rdfs:comment xml:lang="en">Used when the type does not match any of the other options.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/AI/EnergyUnitType/other">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/AI/EnergyUnitType"/>
    <rdfs:label>other</rdfs:label>
    <rdfs:comment xml:lang="en">Any other units of energy measurement.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/duns">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>duns</rdfs:label>
    <rdfs:comment xml:lang="en">[Data Universal Numbering System (D-U-N-S) Number](https://www.dnb.com/en-us/smb/duns.html) is a unique nine-digit identifier, issued by Dun &amp; Bradstreet, that identifies a business entity, often on a location-specific basis.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType/scrapingScript">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType"/>
    <rdfs:label>scrapingScript</rdfs:label>
    <rdfs:comment xml:lang="en">Dataset provider is not making available the underlying data and the dataset shall be reassembled, typically using the provided script for scraping the data.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/HarvestProcess">
    <rdfs:comment xml:lang="en">Harvest is the process of extracting goods or products from nature.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/CreateProcess"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/transportRoute">
    <rdfs:comment xml:lang="en">A transport route refers to the specific path or network used to move people, goods, data, or resources from one location to another.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/createdUsing">
    <rdfs:comment xml:lang="en">Identifies the tooling that was used during the creation of the Element.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Tool"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasDynamicLink">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>hasDynamicLink</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element dynamically links in each `to` Element, during a LifecycleScopeType period.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/contactType">
    <rdfs:comment xml:lang="en">Identifies the nature of the contactPointRelationship.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ContactPointRelationshipType"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/module">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"/>
    <rdfs:label>module</rdfs:label>
    <rdfs:comment xml:lang="en">The Element is a module of a piece of software.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/ChangeAction">
    <rdfs:comment xml:lang="en">An actual change to a product.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/ModifyAction"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/source">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"/>
    <rdfs:label>source</rdfs:label>
    <rdfs:comment xml:lang="en">The Element is a single or a collection of source files.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/DatasetType/syntactic">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Dataset/DatasetType"/>
    <rdfs:label>syntactic</rdfs:label>
    <rdfs:comment xml:lang="en">Data describes the syntax or semantics of a language or text, such as a parse tree used for natural language processing.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/PositiveIntegerRange">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">A tuple of two positive integers that define a range.</rdfs:comment>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="Nc22f9f6774604fdf9c1a0ee3adf80d89">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/beginIntegerRange"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N3f4d148def1e4d4db0770266b6b5f842">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/endIntegerRange"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Security/CvssSeverityType/critical">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Security/CvssSeverityType"/>
    <rdfs:label>critical</rdfs:label>
    <rdfs:comment xml:lang="en">When a CVSS score is between 9.0 - 10.0.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/other">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm"/>
    <rdfs:label>other</rdfs:label>
    <rdfs:comment xml:lang="en">any hashing algorithm that does not exist in this list of entries</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/headquartersLocation">
    <rdfs:comment xml:lang="en">The headquartersLocation defines the location of the organization's headquarters.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Location"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Security/decisionType">
    <rdfs:comment xml:lang="en">Provide the enumeration of possible decisions in the
[Stakeholder-Specific Vulnerability Categorization (SSVC) decision tree](https://www.cisa.gov/stakeholder-specific-vulnerability-categorization-ssvc).</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Security/SsvcDecisionType"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/verifiedUsing">
    <rdfs:comment xml:lang="en">Provides an IntegrityMethod with which the integrity of an Element can be
asserted.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/IntegrityMethod"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Security/VexUnderInvestigationVulnAssessmentRelationship">
    <rdfs:comment xml:lang="en">Designates elements as products where the impact of a vulnerability is being
investigated.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Security/VexVulnAssessmentRelationship"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasVariant">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>hasVariant</rdfs:label>
    <rdfs:comment xml:lang="en">Every `to` Element is a variant the `from` Element (`from` hasVariant `to`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/staticAnalysisReport">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType"/>
    <rdfs:label>staticAnalysisReport</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to a static analysis report for a package.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasInput">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>hasInput</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Build, DefinedProcess or Action element has each `to` Element as an input.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType/demonstration">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType"/>
    <rdfs:label>demonstration</rdfs:label>
    <rdfs:comment xml:lang="en">Demonstrating and monitoring or recording that the item under verification to confirm that a requirement is met by the item under verification.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Operations/projectEndTime">
    <rdfs:comment xml:lang="en">Time when the project ends or is planned to end.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Operations/projectTitle">
    <rdfs:comment xml:lang="en">Title of the project.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Operations/projectSponsor">
    <rdfs:comment xml:lang="en">Sponsor of the project.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Agent"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/Person">
    <rdfs:comment xml:lang="en">An individual human being.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Agent"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/FileKindType/file">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/FileKindType"/>
    <rdfs:label>file</rdfs:label>
    <rdfs:comment xml:lang="en">The file represents a single file (default).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/device">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"/>
    <rdfs:label>device</rdfs:label>
    <rdfs:comment xml:lang="en">The Element refers to a chipset, processor, or electronic board.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/ReproduceAction">
    <rdfs:comment xml:lang="en">Reproduction is the biological process by which organisms generate new individuals of the same species.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/CreateAction"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/SimpleLicensing/customIdToLicense">
    <rdfs:comment xml:lang="en">Maps a "LicenseRef-" string for a custom license or a "AdditionRef-" string for
a custom license addition to a `CustomLicense`, a `CustomLicenseAddition`, or a
`SimpleLicensingText`.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ElementMap"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Security/vexVersion">
    <rdfs:comment xml:lang="en">Specifies the version of a VEX statement.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/usesTool">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>usesTool</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element uses each `to` Element as a tool, during a LifecycleScopeType period.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/evaluation">
    <rdfs:comment xml:lang="en">Evaluation is an outcome considering results of a verification.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvaluationResultType"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/HarvestAction">
    <rdfs:comment xml:lang="en">HarvestAction represents the act of creating a product by directly extracting goods or materials from nature.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/CreateAction"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/crystalsKyber">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm"/>
    <rdfs:label>crystalsKyber</rdfs:label>
    <rdfs:comment xml:lang="en">[Kyber](https://pq-crystals.org/kyber/)</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/verificationUUID">
    <rdfs:comment xml:lang="en">A verificationUUID is a universally unique identifier (UUID) assigned to a Verification item.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifier"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Security/VexAffectedVulnAssessmentRelationship">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">Connects a vulnerability and an element designating the element as a product
affected by the vulnerability.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Security/VexVulnAssessmentRelationship"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N11abae0147d34ea594d95d452cc940e2">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Security/actionStatement"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N6d561689bf3240e587214cfb626e82ee">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Security/actionStatementTime"/>
        <sh:pattern>^\d\d\d\d-\d\d-\d\dT\d\d:\d\d:\d\dZ$</sh:pattern>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/Annotation">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">An assertion made in relation to one or more elements.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Element"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N5370d6ac8ef241d1bf831bf21055dbbc">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/annotationType"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Core/AnnotationType"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:in rdf:parseType="Collection">
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/AnnotationType/other"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/AnnotationType/review"/>
        </sh:in>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N7d938af518c5454293508b7a34c3319f">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/contentType"/>
        <sh:pattern>^[^\/]+\/[^\/]+$</sh:pattern>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N51a8802ddc0446a59f243ac78700d469">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/statement"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N5a2006354c3d4e4ba99f54cfe1b273e4">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/subject"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Element"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/securityOther">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType"/>
    <rdfs:label>securityOther</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to related security information of unspecified type.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasDistributionArtifact">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>hasDistributionArtifact</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element is distributed as an artifact in each `to` Element (e.g. an RPM or archive file).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/Tool">
    <rdfs:comment xml:lang="en">An element of hardware and/or software utilized to carry out a particular function.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Element"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/AI/SafetyRiskAssessmentType/low">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/AI/SafetyRiskAssessmentType"/>
    <rdfs:label>low</rdfs:label>
    <rdfs:comment xml:lang="en">Low/no risk is posed by an AI system.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/support">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType"/>
    <rdfs:label>support</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to the software support channel or other support information for a package.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/simpleLicensing">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType"/>
    <rdfs:label>simpleLicensing</rdfs:label>
    <rdfs:comment xml:lang="en">The element follows the SimpleLicensing profile specification.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/forDropoffLocation">
    <rdfs:comment xml:lang="en">The location that an item will be dropping off or delivered.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Location"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel/notAutomated">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel"/>
    <rdfs:label>notAutomated</rdfs:label>
    <rdfs:comment xml:lang="en">Level 0 - Not automated. No automation. The operator fully controls the system.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/VirtualHardwareModelType/function">
