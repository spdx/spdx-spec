  <owl:Ontology rdf:about="https://spdx.org/rdf/3.1/terms/">
    <owl:versionIRI rdf:resource="https://spdx.org/rdf/3.1/terms/"/>
    <rdfs:label xml:lang="en">System Package Data Exchange™ (SPDX®) Ontology</rdfs:label>
    <dcterms:abstract xml:lang="en">This ontology defines the terms and relationships used in the SPDX specification to describe system packages</dcterms:abstract>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-01-23</dcterms:created>
    <dcterms:creator xml:lang="en">SPDX Project</dcterms:creator>
    <dcterms:license rdf:resource="https://spdx.org/licenses/Community-Spec-1.0.html"/>
    <dcterms:references rdf:resource="https://spdx.dev/specifications/"/>
    <dcterms:title xml:lang="en">System Package Data Exchange (SPDX) Ontology</dcterms:title>
    <omg-ann:copyright xml:lang="en">Copyright (C) 2026 SPDX Project</omg-ann:copyright>
  </owl:Ontology>
