  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/ContactPointRelationshipType">
    <rdfs:comment xml:lang="en">Information about the type of contact point for `ContactPointRelationship`s.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Software/packageVersion">
    <rdfs:comment xml:lang="en">Identify the version of a package.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/postOfficeBoxNumber">
    <rdfs:comment xml:lang="en">The number that identifies a PO box. A PO box is a box in a post office or other postal service location assigned to an organization where postal items may be kept.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/itemVersion">
