        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/AI/EnergyConsumptionDescription">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">The class that helps note down the quantity of energy consumption and the unit
used for measurement.</rdfs:comment>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="Nd366ffefcebc4b1f8c1bcddde1dfa888">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/AI/energyQuantity"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N7209d3af1d30416d8888848f10edf35e">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/AI/energyUnit"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/AI/EnergyUnitType"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:in rdf:parseType="Collection">
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/AI/EnergyUnitType/kilowattHour"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/AI/EnergyUnitType/megajoule"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/AI/EnergyUnitType/other"/>
        </sh:in>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/AI/SafetyRiskAssessmentType/serious">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/AI/SafetyRiskAssessmentType"/>
    <rdfs:label>serious</rdfs:label>
    <rdfs:comment xml:lang="en">The highest level of risk posed by an AI system.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/Regulation">
    <rdfs:comment xml:lang="en">Regulation represents a rule or directive maintained by an authority.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Specification"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/follows">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>follows</rdfs:label>
    <rdfs:comment xml:lang="en">The `to` Element succeeds the `from` Element, establishing a unidirectional sequence. This succession is defined as chronological, procedural, or logical. It is used to represent either a temporal order (e.g., in a workflow) or a logical order for processing and traversal (e.g., in an ordered list).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/isoAutomationLevel">
    <rdfs:comment xml:lang="en">ISO level of automation.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/mailingList">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType"/>
    <rdfs:label>mailingList</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to the mailing list used by the maintainer for a package.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType/decommission">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType"/>
    <rdfs:label>decommission</rdfs:label>
    <rdfs:comment xml:lang="en">A relationship has specific context implications for a product's retirement and/or decommissioning.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Security/VexJustificationType/componentNotPresent">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Security/VexJustificationType"/>
    <rdfs:label>componentNotPresent</rdfs:label>
    <rdfs:comment xml:lang="en">The software is not affected because the vulnerable component is not in the product.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel/conditionalAutomation">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel"/>
    <rdfs:label>conditionalAutomation</rdfs:label>
    <rdfs:comment xml:lang="en">Level 3 - Conditional automation. The system can propose strategies and then automatically execute the approved plan, with an external agent being ready to take over when necessary.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/context">
    <rdfs:comment xml:lang="en">Gives information about the circumstances or unifying properties
that Elements of the bundle have been assembled under.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Software/byteRange">
    <rdfs:comment xml:lang="en">Defines the byte range in the original host file that the snippet information
applies to.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/PositiveIntegerRange"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/DefinedType">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">The DefinedType class associates a specific type with its defined source.</rdfs:comment>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N5411eb678a7d4c719e5a77311cd2b96c">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/typeFromSource"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nc2479c6836fb4eeeba8fdb54cf979031">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/definitionSource"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Specification"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/manifest">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"/>
    <rdfs:label>manifest</rdfs:label>
    <rdfs:comment xml:lang="en">The Element is a software manifest.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/AI/useSensitivePersonalInformation">
    <rdfs:comment xml:lang="en">Records if sensitive personal information is used during model training or
could be used during the inference.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/PresenceType"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/quantity">
    <rdfs:comment xml:lang="en">Quantity is the amount in the selected QUDT unit.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/to">
    <rdfs:comment xml:lang="en">References an Element on the right-hand side of a relationship.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Element"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/ExpandedLicensing/seeAlso">
    <rdfs:comment xml:lang="en">Contains a URL where the License or LicenseAddition can be found in use.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/doesNotAffect">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>doesNotAffect</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Vulnerability has no impact on each `to` Element. The use of the `doesNotAffect` is constrained to `VexNotAffectedVulnAssessmentRelationship` classed relationships.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/UseAction">
    <rdfs:comment xml:lang="en">The action of product use.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Action"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N240c30ce0e8a467c8cb161960b8735d2">
        <sh:path rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <sh:not>
          <rdf:Description rdf:nodeID="Nbc5ebf0b5fc042a6a5530ba21503425d">
            <sh:hasValue rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/UseAction"/>
          </rdf:Description>
        </sh:not>
        <sh:message xml:lang="en">https://spdx.org/rdf/3.1/terms/SupplyChain/UseAction is an abstract class and should not be instantiated directly. Instantiate a subclass instead.</sh:message>
      </rdf:Description>
    </sh:property>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/secureSoftwareAttestation">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType"/>
    <rdfs:label>secureSoftwareAttestation</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to information assuring that the software is developed using security practices as defined by [NIST SP 800-218 Secure Software Development Framework (SSDF) Version 1.1](https://csrc.nist.gov/pubs/sp/800/218/final) or [CISA Secure Software Development Attestation Form](https://www.cisa.gov/resources-tools/resources/secure-software-development-attestation-form).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/externalIdentifier">
    <rdfs:comment xml:lang="en">Provides a reference to a resource outside the scope of SPDX 3 content
that uniquely identifies an Element.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifier"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/TestProcess">
    <rdfs:comment xml:lang="en">Test Process defines the testing process for an element.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/UseProcess"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/AssemblyProcess">
    <rdfs:comment xml:lang="en">The AssemblyProcess represents the process of creating a product by assembling a set of components, potentially in a way that allows for at disassembly (at least partially).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/CreateProcess"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/copiedTo">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>copiedTo</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element has been copied to each `to` Element.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/additionalInformation">
    <rdfs:comment xml:lang="en">Additional relevance information.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/DictionaryEntry"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvaluationResultType/fail">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvaluationResultType"/>
    <rdfs:label>fail</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates a failed evaluation where the requirement or condition is not met.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Security/ExploitCatalogType/kev">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Security/ExploitCatalogType"/>
    <rdfs:label>kev</rdfs:label>
    <rdfs:comment xml:lang="en">CISA's Known Exploited Vulnerability (KEV) catalog.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/geographicPointLocation">
    <rdfs:comment xml:lang="en">This is a set of point coordinates as defined in by the GPS standard.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/validState">
    <rdfs:comment xml:lang="en">The valid state for DefinedStateProcess.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/State"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasStaticLink">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>hasStaticLink</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element statically links in each `to` Element, during a LifecycleScopeType period.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Software/additionalPurpose">
    <rdfs:comment xml:lang="en">Provides additional purpose information of the software artifact.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/file">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"/>
    <rdfs:label>file</rdfs:label>
    <rdfs:comment xml:lang="en">The Element is a single file which can be independently distributed (configuration file, statically linked binary, Kubernetes deployment, etc.).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Security/statusNotes">
    <rdfs:comment xml:lang="en">Conveys information about how VEX status was determined.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/hasSensitivePersonalInformation">
    <rdfs:comment xml:lang="en">Describes if any sensitive personal information is present in the dataset.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/PresenceType"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SbomType/analyzed">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SbomType"/>
    <rdfs:label>analyzed</rdfs:label>
    <rdfs:comment xml:lang="en">SBOM generated through analysis of artifacts (e.g., executables, packages, containers, and virtual machine images) after its build. Such analysis generally requires a variety of heuristics. In some contexts, this may also be referred to as a "3rd party" SBOM.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasOutput">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>hasOutput</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Build, DefinedProcess or Action element generates each `to` Element as an output.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/validatedOn">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>validatedOn</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element has been validated on the `to` Element(s).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/SimpleLicensing/licenseListVersion">
    <rdfs:comment xml:lang="en">The version of the SPDX License List used in the license expression.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Operations/exportControlSpecification">
    <rdfs:comment xml:lang="en">Specification basis for the export control classification.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Specification"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/Bom">
    <rdfs:comment xml:lang="en">A container for a grouping of SPDX 3 content characterizing details
(provenance, composition, licensing, etc.) about a product.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Bundle"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/namespaceMap">
    <rdfs:comment xml:lang="en">Provides a NamespaceMap of prefixes and associated namespace partial URIs applicable to an SpdxDocument and independent of any specific serialization format or instance.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/NamespaceMap"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/ResponsibilityType/custody">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/ResponsibilityType"/>
    <rdfs:label>custody</rdfs:label>
    <rdfs:comment xml:lang="en">Custody refers to the responsibility, control, and safekeeping of an asset, person, or legal entity. It involves both physical possession and legal authority over something or someone.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/InspectionProcess">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">Inspection Process defines specific various processes needed to satisfy the inspection requirements for a specific product or service.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/UseProcess"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N89a9141fa9534536a715c787b0765a0a">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/plannedInspectionLocation"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Location"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasDeletedFile">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>hasDeletedFile</rdfs:label>
    <rdfs:comment xml:lang="en">Every `to` Element is a file deleted from the `from` Element (`from` hasDeletedFile `to`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/patchedBy">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>patchedBy</rdfs:label>
    <rdfs:comment xml:lang="en">Every `to` Element is a patch for the `from` Element (`from` patchedBy `to`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/lite">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType"/>
    <rdfs:label>lite</rdfs:label>
    <rdfs:comment xml:lang="en">The element follows the Lite profile specification.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/plannedProductOfResponsibilityChange">
    <rdfs:comment xml:lang="en">This is the planned product associated with the change of responsibility.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Element"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/VirtualHardwareModelType">
    <rdfs:comment xml:lang="en">VirtualHardwareModelType sets the VirtualHardware Model Type.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Operations/assessmentResult">
    <rdfs:comment xml:lang="en">Specifies an Element as subject of an assessment.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Operations/ExportControlClassification"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/externalRef">
    <rdfs:comment xml:lang="en">Points to a resource outside the scope of the SPDX 3 content
that provides additional characteristics of an Element.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalRef"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Security/EpssVulnAssessmentRelationship">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">Provides an EPSS assessment for a vulnerability.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Security/VulnAssessmentRelationship"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="Nd588fa521e214eaba4abbb15fcf04479">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Security/probability"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N1ddb1edb1fa44eb1a4dcafaa60a8c71e">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Security/percentile"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Service/serverAuthenticationProtocol">
    <rdfs:comment xml:lang="en">Authentication protocol used by a server.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Service/AuthenticationProtocolType"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/Action">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">Class that describes an action that has occurred.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Artifact"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N2a0a630582f24d548a1f8791d27873ff">
        <sh:path rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <sh:not>
          <rdf:Description rdf:nodeID="Nb79af62a150c470abcc840f2e368ebca">
            <sh:hasValue rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Action"/>
          </rdf:Description>
        </sh:not>
        <sh:message xml:lang="en">https://spdx.org/rdf/3.1/terms/Core/Action is an abstract class and should not be instantiated directly. Instantiate a subclass instead.</sh:message>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N65a59b4230df4a49a76630b9b19ea2fd">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/actionStartTime"/>
        <sh:pattern>^\d\d\d\d-\d\d-\d\dT\d\d:\d\d:\d\dZ$</sh:pattern>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Na0d8ac814bb141bb9cdc39304060f2db">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/actionEndTime"/>
        <sh:pattern>^\d\d\d\d-\d\d-\d\dT\d\d:\d\d:\d\dZ$</sh:pattern>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nf8c23bb260c84183a302139057e07269">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/actionLocation"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Location"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N6c4dfe1457bc4ceeba02d9c28e8ae802">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/additionalInformation"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Core/DictionaryEntry"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
      </rdf:Description>
    </sh:property>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Extension/cdxPropValue">
    <rdfs:comment xml:lang="en">A value used in a CdxPropertyEntry name-value pair.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Service/serviceHostingCountry">
    <rdfs:comment xml:lang="en">Specifies a country code where a software service is hosted.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Software/sourceInfo">
    <rdfs:comment xml:lang="en">Records any relevant background information or additional comments
about the origin of the package.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasDependencyManifest">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>hasDependencyManifest</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element has manifest files that contain dependency information in each `to` Element.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/intendedUse">
    <rdfs:comment xml:lang="en">**DEPRECATED in SPDX 3.1.**
Use [/Core/intendedUse](../../Core/Properties/intendedUse.md) instead.

The intended use of a given dataset.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/countyCode">
    <rdfs:comment xml:lang="en">A code that identifies a county.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/algorithm">
    <rdfs:comment xml:lang="en">Specifies the algorithm used for calculating the hash value.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Security/assessedElement">
    <rdfs:comment xml:lang="en">Specifies an Element contained in a piece of software where a vulnerability was
found.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwareArtifact"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Operations/ExportControlClassification">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">Assement of an Element for export control classification.</rdfs:comment>
