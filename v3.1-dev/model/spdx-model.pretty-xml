        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N8b33ad9117584bf89eab21cc99176e70">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Operations/exportClassification"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="Nbd27baaeb05e48259cb16c1d39d682bb">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Operations/weight"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
