  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Security/probability">
    <rdfs:comment xml:lang="en">A probability score between 0 and 1 of a vulnerability being exploited.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/SpecificationType/regulation">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/SpecificationType"/>
    <rdfs:label>regulation</rdfs:label>
    <rdfs:comment xml:lang="en">A mandatory legal specification issued by a governmental or regulatory authority. Compliance is enforceable by law.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/publishedBy">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>publishedBy</rdfs:label>
    <rdfs:comment xml:lang="en">Designates a `from` Vulnerability was made available for public use or reference by each `to` Agent.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/SpecificationType/formalStandard">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/SpecificationType"/>
    <rdfs:label>formalStandard</rdfs:label>
    <rdfs:comment xml:lang="en">A formal standard is a standard ratified by a recognized standards-development organization and published as a normative reference.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/AI/SafetyRiskAssessmentType/medium">
