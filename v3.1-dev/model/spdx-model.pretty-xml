    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/country">
    <rdfs:comment xml:lang="en">Specifies a country code of the location.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/AI/autonomyType">
    <rdfs:comment xml:lang="en">**DEPRECATED in SPDX 3.1.**
Use [/Core/isoAutomationLevel](../../Core/Properties/isoAutomationLevel.md)
instead.

Indicates whether the system can perform a decision or action without human
involvement or guidance.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/PresenceType"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/BoundaryCrossingAction">
    <rdfs:comment xml:lang="en">An action of crossing a boundary is defined in this class.</rdfs:comment>
