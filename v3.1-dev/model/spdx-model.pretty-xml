  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Security/SsvcDecisionType/track">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Security/SsvcDecisionType"/>
    <rdfs:label>track</rdfs:label>
    <rdfs:comment xml:lang="en">The vulnerability does not require action at this time. The organization would continue to track the vulnerability and reassess it if new information becomes available. CISA recommends remediating Track vulnerabilities within standard update timelines.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/runtimeAnalysisReport">
