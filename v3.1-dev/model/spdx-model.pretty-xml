    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N3ca318efd9b24bff820941ca40599ec2">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Security/justificationType"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Security/VexJustificationType"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:in rdf:parseType="Collection">
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Security/VexJustificationType/componentNotPresent"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Security/VexJustificationType/vulnerableCodeNotPresent"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Security/VexJustificationType/vulnerableCodeCannotBeControlledByAdversary"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Security/VexJustificationType/vulnerableCodeNotInExecutePath"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Security/VexJustificationType/inlineMitigationsAlreadyExist"/>
        </sh:in>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N0f957df525644b78a7905a2ee2c9a015">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Security/impactStatement"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
