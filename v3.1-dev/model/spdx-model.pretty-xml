    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvaluationResultType">
    <rdfs:comment xml:lang="en">EvaluationResultType describes the outcome of an evaluation or verification process with.</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/filesystemImage">
