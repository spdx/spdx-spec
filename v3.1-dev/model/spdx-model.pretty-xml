        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Element"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N2f6e7bf62b134a76b541364affd02b3a">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/rootElement"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Element"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
