  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/additionalInformationSpecification">
    <rdfs:comment xml:lang="en">It is the authoritative or credible entity, document, or body of knowledge that provides the meaning of an additionalInformation key and/or its values, ensuring accuracy, context, and standardization.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Specification"/>
  </owl:ObjectProperty>
