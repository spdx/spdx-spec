    <rdfs:label>expandsTo</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Element expands out as an artifact described by each `to` Element.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/productMetadata">
