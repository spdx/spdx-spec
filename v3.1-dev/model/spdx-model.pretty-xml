  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/urlScheme">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>urlScheme</rdfs:label>
    <rdfs:comment xml:lang="en">[Uniform Resource Identifier (URI) Schemes](https://www.iana.org/assignments/uri-schemes/uri-schemes.xhtml). The scheme used in order to locate a resource.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/validUntilTime">
    <rdfs:comment xml:lang="en">Specifies until when the artifact can be used before its usage needs to be
reassessed.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/bulkQuantity">
    <rdfs:comment xml:lang="en">The amount or measure of a bulk product.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/UnitOfMeasure"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/Specification">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">A specification is a detailed description of the design, requirements,
or features of a product, process, or system.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Artifact"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="Ne75a61527bdb4d7d8d231a8f2eac6c33">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/specType"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Core/SpecificationType"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:in rdf:parseType="Collection">
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/SpecificationType/formalStandard"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/SpecificationType/regulation"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/SpecificationType/specification"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Core/SpecificationType/other"/>
        </sh:in>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/AI/metricDecisionThreshold">
    <rdfs:comment xml:lang="en">Threshold that was used for computation of a metric described in
the metric field.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/DictionaryEntry"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/evaluationBasedOn">
    <rdfs:comment xml:lang="en">Indicates the specific RequirementVerification instance on which the EvaluationResult is based.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety/RequirementVerification"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/verificationRationale">
    <rdfs:comment xml:lang="en">A verificationRationale is supporting information that justifies the verification details.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Extension/Extension">
    <rdfs:comment xml:lang="en">A characterization of some aspect of an Element that is associated with the Element in a generalized fashion.</rdfs:comment>
    <sh:property>
      <rdf:Description rdf:nodeID="N8c589c1296b943e0a1d35afe96a64bc6">
        <sh:path rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <sh:not>
          <rdf:Description rdf:nodeID="Ne2ddbb169a6f40efb22af06c54627a6d">
            <sh:hasValue rdf:resource="https://spdx.org/rdf/3.1/terms/Extension/Extension"/>
          </rdf:Description>
        </sh:not>
        <sh:message xml:lang="en">https://spdx.org/rdf/3.1/terms/Extension/Extension is an abstract class and should not be instantiated directly. Instantiate a subclass instead.</sh:message>
      </rdf:Description>
    </sh:property>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Security/SsvcDecisionType/act">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Security/SsvcDecisionType"/>
    <rdfs:label>act</rdfs:label>
    <rdfs:comment xml:lang="en">The vulnerability requires attention from the organization's internal, supervisory-level and leadership-level individuals. Necessary actions include requesting assistance or information about the vulnerability, as well as publishing a notification either internally and/or externally. Typically, internal groups would meet to determine the overall response and then execute agreed upon actions. CISA recommends remediating Act vulnerabilities as soon as possible.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType/review">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType"/>
    <rdfs:label>review</rdfs:label>
    <rdfs:comment xml:lang="en">A examination or checking of documentation, records, processes, or systems to confirm compliance or adherence with an upper level requirement. Typically done as peer review, offline review or review meeting.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/bom">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"/>
    <rdfs:label>bom</rdfs:label>
    <rdfs:comment xml:lang="en">The Element is a bill of materials.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType/design">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType"/>
    <rdfs:label>design</rdfs:label>
    <rdfs:comment xml:lang="en">A relationship has specific context implications during an element's design.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/hsCodes">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>hsCodes</rdfs:label>
    <rdfs:comment xml:lang="en">The [Harmonized System (HS)](https://www.wcoomd.org/en/topics/nomenclature/overview/what-is-the-harmonized-system.aspx) of tariff nomenclature is an internationally standardized system of names and numbers, defined by the World Customs Organization, used to classify traded products.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/DatasetType/numeric">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Dataset/DatasetType"/>
    <rdfs:label>numeric</rdfs:label>
    <rdfs:comment xml:lang="en">Data consists only of numeric entries.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/CreateProcess">
    <rdfs:comment xml:lang="en">The CreateProcess refers to the abstract process class that can be used to represent the process of creation of a product.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/DefinedProcess"/>
    <sh:property>
      <rdf:Description rdf:nodeID="Nfd8c5ae015914feca45d4a8f4102bba7">
        <sh:path rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <sh:not>
          <rdf:Description rdf:nodeID="Na03428ed5d394c87b085cafe9b5d517e">
            <sh:hasValue rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/CreateProcess"/>
          </rdf:Description>
        </sh:not>
