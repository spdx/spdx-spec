        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N7481590c1b294923a58a20254d8eaac0">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/ExpandedLicensing/listVersionAdded"/>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/AnnotationType">
    <rdfs:comment xml:lang="en">Specifies the type of an annotation.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/DatasetType">
    <rdfs:comment xml:lang="en">Enumeration of dataset types.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/ExpandedLicensing/CustomLicenseAddition">
    <rdfs:comment xml:lang="en">A license addition that is not listed on the SPDX Exceptions List.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/ExpandedLicensing/LicenseAddition"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Security/exploited">
    <rdfs:comment xml:lang="en">Denote whether a CVE is present in an exploit catalog.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/patch">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"/>
    <rdfs:label>patch</rdfs:label>
    <rdfs:comment xml:lang="en">The Element contains a set of changes to update, fix, or improve another Element.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/verificationMethod">
    <rdfs:comment xml:lang="en">verificationMethod refers to the specific approach used for a checking an element's conformance with its requirements.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/currentState">
    <rdfs:comment xml:lang="en">This is the state of an affected Element.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/State"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/comment">
    <rdfs:comment xml:lang="en">Provide consumers with comments by the creator of the Element about the
Element.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType">
    <rdfs:comment xml:lang="en">Provide an enumerated set of lifecycle phases that can provide context to relationships.</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasTestCase">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>hasTestCase</rdfs:label>
    <rdfs:comment xml:lang="en">Every `to` Element is a test case for the `from` Element (`from` hasTestCase `to`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/ConfidentialityLevelType">
    <rdfs:comment xml:lang="en">Confidentiality level.</rdfs:comment>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/fixedBy">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>fixedBy</rdfs:label>
    <rdfs:comment xml:lang="en">Designates a `from` Vulnerability has been fixed by the `to` Agent(s).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/webpage">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>webpage</rdfs:label>
    <rdfs:comment xml:lang="en">Absolute URL that can be used to locate a resource, as defined in [RFC 7230](https://datatracker.ietf.org/doc/rfc7230/) Section 2.7.1 or Section 2.7.2.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/provinceStateCode">
    <rdfs:comment xml:lang="en">Text specifying a province or state.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/specType">
    <rdfs:comment xml:lang="en">A specification type defines the nature of a specification.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/SpecificationType"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/from">
    <rdfs:comment xml:lang="en">References the Element on the left-hand side of a relationship.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Element"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/library">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"/>
    <rdfs:label>library</rdfs:label>
    <rdfs:comment xml:lang="en">The Element is a software library.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/fixedIn">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>fixedIn</rdfs:label>
    <rdfs:comment xml:lang="en">A `from` Vulnerability has been fixed in each `to` Element. The use of the `fixedIn` type is constrained to `VexFixedVulnAssessmentRelationship` classed relationships.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/securityOther">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>securityOther</rdfs:label>
    <rdfs:comment xml:lang="en">Used when there is a security related identifier of unspecified type.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/locationHint">
    <rdfs:comment xml:lang="en">Provides an indication of where to retrieve an external Element.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Software/File">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">Refers to any object that stores content on a computer.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwareArtifact"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="N3dd1e599c5e44779a6a0fc2bf5d3034f">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Core/contentType"/>
        <sh:pattern>^[^\/]+\/[^\/]+$</sh:pattern>
        <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
    <sh:property>
      <rdf:Description rdf:nodeID="N0d2751861cf448d78ee32010d34310ba">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/Software/fileKind"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/Software/FileKindType"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:in rdf:parseType="Collection">
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Software/FileKindType/file"/>
          <rdf:Description rdf:about="https://spdx.org/rdf/3.1/terms/Software/FileKindType/directory"/>
        </sh:in>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/centerOfMass">
    <rdfs:comment xml:lang="en">A point representing the mean position of the matter in a body or system.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Hardware/Dimensions"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/actionStartTime">
    <rdfs:comment xml:lang="en">Property describing the start time of an action.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ContactPointRelationshipType/compliance">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ContactPointRelationshipType"/>
    <rdfs:label>compliance</rdfs:label>
    <rdfs:comment xml:lang="en">A contact point for compliance (i.e. export control, licensing).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasDeclaredLicense">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>hasDeclaredLicense</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` SoftwareArtifact was discovered to actually contain each `to` AnyLicenseInfo (for example, as detected by automated tooling).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Hardware/xAxisLength">
    <rdfs:comment xml:lang="en">Information related to hardware dimension.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/MeasureOfLength"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/AI/inferenceEnergyConsumption">
    <rdfs:comment xml:lang="en">Energy consumed during inference time by an AI model
that is being used in the AI system.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/AI/EnergyConsumptionDescription"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/hashValue">
    <rdfs:comment xml:lang="en">The result of applying a hash algorithm to an Element.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/AssemblyAction">
    <rdfs:comment xml:lang="en">AssemblyAction represents the event of creating a product by assembling individual components.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/CreateAction"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/current">
    <rdfs:comment xml:lang="en">This is the individual, business, or organization who currently manages goods, services, or assets.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Agent"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/issueTracker">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType"/>
    <rdfs:label>issueTracker</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to the issue tracker for a package.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/actionLocation">
    <rdfs:comment xml:lang="en">Location of a specific action.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Location"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType">
    <rdfs:comment xml:lang="en">Availability of dataset.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/elementValue">
    <rdfs:comment xml:lang="en">A value used in a key-value pair with a generic key that refers to an Element</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Element"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/locationTime">
    <rdfs:comment xml:lang="en">A known location is specified at this time.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/value">
    <rdfs:comment xml:lang="en">A value used in a generic key-value pair.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/mavenCentral">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType"/>
    <rdfs:label>mavenCentral</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to a Maven repository artifact. The artifact locator format is defined in the [Maven documentation](https://maven.apache.org/guides/mini/guide-naming-conventions.html) and looks like `groupId:artifactId[:version]`.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/description">
    <rdfs:comment xml:lang="en">Provides a detailed description of the Element.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/key">
    <rdfs:comment xml:lang="en">A key used in a generic key-value pair.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/contentType">
    <rdfs:comment xml:lang="en">Provides information about the content type of an Element or a property.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType/audit">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType"/>
    <rdfs:label>audit</rdfs:label>
    <rdfs:comment xml:lang="en">An examination typically focusing on compliance with policies, standards, or regulations. Usually this is done during an audit meeting, while the assessment also involves deep and detailed reviews of work products (e.g. requirements, verification specifications, reports etc.)</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/AI/standardCompliance">
    <rdfs:comment xml:lang="en">Standard that an artifact is being complied with.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Security/actionStatementTime">
    <rdfs:comment xml:lang="en">Records the time when a recommended action was communicated in a VEX statement
to mitigate a vulnerability.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/operatingSystem">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"/>
    <rdfs:label>operatingSystem</rdfs:label>
    <rdfs:comment xml:lang="en">The Element is an operating system.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvaluationResultType/pass">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvaluationResultType"/>
    <rdfs:label>pass</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates a successful evaluation where the requirement or condition is clearly met.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/requirement">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"/>
    <rdfs:label>requirement</rdfs:label>
    <rdfs:comment xml:lang="en">The Element provides a requirement needed as input for another Element.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/cpe22">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>cpe22</rdfs:label>
    <rdfs:comment xml:lang="en">[Common Platform Enumeration Specification 2.2](https://cpe.mitre.org/files/cpe-specification_2.2.pdf).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SbomType/deployed">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SbomType"/>
    <rdfs:label>deployed</rdfs:label>
    <rdfs:comment xml:lang="en">SBOM provides an inventory of software that is present on a system. This may be an assembly of other SBOMs that combines analysis of configuration options, and examination of execution behavior in a (potentially simulated) deployment environment.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/requirementUUID">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"/>
    <rdfs:label>requirementUUID</rdfs:label>
    <rdfs:comment xml:lang="en">The UUID used by a requirements management or any other lifecycle management tool to uniquely identify a requirement item. UUID, or universally unique ID, is a standard term in requirements engineering.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/DefinedStateProcess">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">This process is used to determine the state of an affected Element.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/UseProcess"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
    <sh:property>
      <rdf:Description rdf:nodeID="Nb7a9e95999344e7180cc5f947a33cf95">
        <sh:path rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/validState"/>
        <sh:class rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/State"/>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
      </rdf:Description>
    </sh:property>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/import">
    <rdfs:comment xml:lang="en">Provides an ExternalMap of Element identifiers.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalMap"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/sourceArtifact">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType"/>
    <rdfs:label>sourceArtifact</rdfs:label>
    <rdfs:comment xml:lang="en">A reference to an artifact containing the sources for a package.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Software/contentIdentifier">
    <rdfs:comment xml:lang="en">A canonical, unique, immutable identifier of the artifact content, that may be
used for verifying its identity and/or integrity.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Software/ContentIdentifier"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/SimpleLicensing/licenseText">
    <rdfs:comment xml:lang="en">Identifies the full text of a License or Addition.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Software/snippetFromFile">
    <rdfs:comment xml:lang="en">Defines the original host file that the snippet information applies to.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Software/File"/>
  </owl:ObjectProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/PresenceType/no">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/PresenceType"/>
    <rdfs:label>no</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates absence of the field.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Service/AuthenticationProtocolType/ocsp">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Service/AuthenticationProtocolType"/>
    <rdfs:label>ocsp</rdfs:label>
    <rdfs:comment xml:lang="en">Online Certificate Status Protocol, or OCSP, is a common scheme used to maintain the security of a server and other network resources.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/AnnotationType/review">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/AnnotationType"/>
    <rdfs:label>review</rdfs:label>
    <rdfs:comment xml:lang="en">Used when someone reviews the Element.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/ExpandedLicensing/isOsiApproved">
    <rdfs:comment xml:lang="en">Specifies whether the License is listed as approved by the
Open Source Initiative (OSI).</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/dropoffLocation">
    <rdfs:comment xml:lang="en">The location for dropping off or delivering a package or item.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Location"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/SoftwareAgent">
    <rdfs:comment xml:lang="en">A software agent.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Agent"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/verifiedBy">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>verifiedBy</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Requirement that has verification (test, review, analysis etc.) details defined in the `to` RequirementVerification.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/PlanAction">
    <rdfs:comment xml:lang="en">A PlanAction involves the execution of a plan in relation to a PlanProcess.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://spdx.org/rdf/3.1/terms/SupplyChain/UseAction"/>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
  </owl:Class>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/container">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"/>
    <rdfs:label>container</rdfs:label>
    <rdfs:comment xml:lang="en">The Element is a container image which can be used by a container runtime application.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Security/VexJustificationType/vulnerableCodeCannotBeControlledByAdversary">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Security/VexJustificationType"/>
    <rdfs:label>vulnerableCodeCannotBeControlledByAdversary</rdfs:label>
    <rdfs:comment xml:lang="en">The vulnerable component is present, and the component contains the vulnerable code. However, vulnerable code is used in such a way that an attacker cannot mount any anticipated attack.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Operations/exportingCountry">
    <rdfs:comment xml:lang="en">Country for which export controls must be taken into account.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType/runtime">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType"/>
    <rdfs:label>runtime</rdfs:label>
    <rdfs:comment xml:lang="en">A relationship has specific context implications during the execution phase of an element.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/extension">
    <rdfs:comment xml:lang="en">Specifies an Extension characterization of some aspect of an Element.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Extension/Extension"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Service/AuthenticationProtocolType">
    <rdfs:comment xml:lang="en">Protocols which support authentication.</rdfs:comment>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://spdx.org/rdf/3.1/terms/SupplyChain/previous">
    <rdfs:comment xml:lang="en">This is the individual, business, or organization who was previously managing goods, services, or assets.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/Agent"/>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType">
    <rdfs:comment xml:lang="en">Specifies the type of an external identifier.</rdfs:comment>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/processReadiness">
    <rdfs:comment xml:lang="en">processReadiness describes the readiness of a process.</rdfs:comment>
    <rdfs:range rdf:resource="https://spdx.org/rdf/3.1/terms/Core/ProcessReadinessType"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Build/buildStartTime">
    <rdfs:comment xml:lang="en">Property describing the start time of a build.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasExample">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>hasExample</rdfs:label>
    <rdfs:comment xml:lang="en">Every `to` Element is an example for the `from` Element (`from` hasExample `to`).</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/RelationshipType/affects">
    <rdf:type rdf:resource="https://spdx.org/rdf/3.1/terms/Core/RelationshipType"/>
    <rdfs:label>affects</rdfs:label>
    <rdfs:comment xml:lang="en">The `from` Vulnerability, Action or DefinedProcess affects each `to` Element.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/exportControlAssessment">
