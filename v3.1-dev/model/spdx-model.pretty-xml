  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://spdx.org/rdf/3.1/terms/Core/name">
    <rdfs:comment xml:lang="en">Identifies the name of an Element as designated by the creator.</rdfs:comment>
