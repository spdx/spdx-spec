SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasRoleIn&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/RoleRelationship&gt; }
}&quot;</td></tr></table> > ] 
