# N08f686d0cb1b4d4f85c79a6d10eb84c3 node1027
node1027 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N08f686d0cb1b4d4f85c79a6d10eb84c3</B></td></tr><tr><td href='N08f686d0cb1b4d4f85c79a6d10eb84c3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N08f686d0cb1b4d4f85c79a6d10eb84c3</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is serializedInArtifact, from must be a SpdxDocument&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/serializedInArtifact&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/SpdxDocument&gt; }
}&quot;</td></tr></table> > ] 
