node122 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N2b8567a338244badb52124d8711928b2</B></td></tr><tr><td href='N2b8567a338244badb52124d8711928b2' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N2b8567a338244badb52124d8711928b2</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;https://spdx.org/rdf/3.1/terms/SupplyChain/ModifyProcess is an abstract class and should not be instantiated directly. Instantiate a subclass instead.&quot;@en</td></tr></table> > ] 
