# Ne3fc5c12f7274f46824f73ed62cf9280 node86
node86 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne3fc5c12f7274f46824f73ed62cf9280</B></td></tr><tr><td href='Ne3fc5c12f7274f46824f73ed62cf9280' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne3fc5c12f7274f46824f73ed62cf9280</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is doesNotAffect, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/doesNotAffect&gt; .
    $this &lt;Core/from&gt; ?from .
