# N6ea791b47a80402fbd3484a125788242 node815
node815 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N6ea791b47a80402fbd3484a125788242</B></td></tr><tr><td href='N6ea791b47a80402fbd3484a125788242' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N6ea791b47a80402fbd3484a125788242</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is coordinatedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
