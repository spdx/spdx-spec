node1159 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nfcacd188050141a09cc61c6bda5f8fcb</B></td></tr><tr><td href='Nfcacd188050141a09cc61c6bda5f8fcb' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nfcacd188050141a09cc61c6bda5f8fcb</font></td></tr></table> > ] 
