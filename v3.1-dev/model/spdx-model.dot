node1201 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N1dead58cf0c340a9a2773edcca560c0d</B></td></tr><tr><td href='N1dead58cf0c340a9a2773edcca560c0d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N1dead58cf0c340a9a2773edcca560c0d</font></td></tr></table> > ] 
