# Nff69b20dfb924eaf9546d403aba15066 node3
node3 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nff69b20dfb924eaf9546d403aba15066</B></td></tr><tr><td href='Nff69b20dfb924eaf9546d403aba15066' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nff69b20dfb924eaf9546d403aba15066</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasProvidedDependency, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
