# N9b0c863721db4502beb4a1d63a751a1b node253
node253 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N9b0c863721db4502beb4a1d63a751a1b</B></td></tr><tr><td href='N9b0c863721db4502beb4a1d63a751a1b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N9b0c863721db4502beb4a1d63a751a1b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is publishedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
