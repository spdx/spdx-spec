# Nfced6bc9437e4ae2bd232badad4256b1 node1121
node1121 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nfced6bc9437e4ae2bd232badad4256b1</B></td></tr><tr><td href='Nfced6bc9437e4ae2bd232badad4256b1' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nfced6bc9437e4ae2bd232badad4256b1</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasUninstall, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasUninstall&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Artifact&gt; }
