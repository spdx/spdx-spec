# Nf87724d79bb24361b94d2b09f8aad82e node1414
node1414 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf87724d79bb24361b94d2b09f8aad82e</B></td></tr><tr><td href='Nf87724d79bb24361b94d2b09f8aad82e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf87724d79bb24361b94d2b09f8aad82e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is reportedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/reportedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
