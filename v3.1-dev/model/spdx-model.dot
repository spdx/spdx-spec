# Nd6752a05f8c548258550986e41279fb0 node1722
node1722 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nd6752a05f8c548258550986e41279fb0</B></td></tr><tr><td href='Nd6752a05f8c548258550986e41279fb0' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nd6752a05f8c548258550986e41279fb0</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is doesNotAffect, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/doesNotAffect&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
