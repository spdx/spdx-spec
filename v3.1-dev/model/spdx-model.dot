# Na4eaeccb539544d2a7048a1ea477cac3 node303
node303 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na4eaeccb539544d2a7048a1ea477cac3</B></td></tr><tr><td href='Na4eaeccb539544d2a7048a1ea477cac3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na4eaeccb539544d2a7048a1ea477cac3</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is performedBy, from must be an Action&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/performedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
}&quot;</td></tr></table> > ] 
