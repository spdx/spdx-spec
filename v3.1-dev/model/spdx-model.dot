# Nbf15ef2ad9724e709fc69334788aee26 node1522
node1522 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nbf15ef2ad9724e709fc69334788aee26</B></td></tr><tr><td href='Nbf15ef2ad9724e709fc69334788aee26' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nbf15ef2ad9724e709fc69334788aee26</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is foundBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/foundBy&gt; .
    $this &lt;Core/to&gt; ?to .
