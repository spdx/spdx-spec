# N3955dc54204844ababffa34a8640936a node485
node485 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N3955dc54204844ababffa34a8640936a</B></td></tr><tr><td href='N3955dc54204844ababffa34a8640936a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N3955dc54204844ababffa34a8640936a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, from must be an Action or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/createdBy&gt; .
    $this &lt;Core/from&gt; ?from .
