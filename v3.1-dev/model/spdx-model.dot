# Nfb6ce36e91e34b9f8997540ce3e4bd88 node1450
node1450 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nfb6ce36e91e34b9f8997540ce3e4bd88</B></td></tr><tr><td href='Nfb6ce36e91e34b9f8997540ce3e4bd88' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nfb6ce36e91e34b9f8997540ce3e4bd88</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, from must be an Action or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/createdBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/DefinedProcess&gt; }
