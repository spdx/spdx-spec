# N0392900a35dd4648b6447cd589daed2e node1283
node1283 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N0392900a35dd4648b6447cd589daed2e</B></td></tr><tr><td href='N0392900a35dd4648b6447cd589daed2e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N0392900a35dd4648b6447cd589daed2e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is serializedInArtifact, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
