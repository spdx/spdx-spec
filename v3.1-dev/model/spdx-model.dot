# N0884ac93d9ef4801ad777e5bca488d3a node1296
node1296 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N0884ac93d9ef4801ad777e5bca488d3a</B></td></tr><tr><td href='N0884ac93d9ef4801ad777e5bca488d3a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N0884ac93d9ef4801ad777e5bca488d3a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is underInvestigationFor, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/underInvestigationFor&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
