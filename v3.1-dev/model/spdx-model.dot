# Nb7d5d4a8a7204bc1903f04a0ec120eb0 node918
node918 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb7d5d4a8a7204bc1903f04a0ec120eb0</B></td></tr><tr><td href='Nb7d5d4a8a7204bc1903f04a0ec120eb0' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb7d5d4a8a7204bc1903f04a0ec120eb0</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/createdBy&gt; .
    $this &lt;Core/to&gt; ?to .
