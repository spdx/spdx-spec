node341 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb483fc5fc7ad462eb8f3825f7ba66d3e</B></td></tr><tr><td href='Nb483fc5fc7ad462eb8f3825f7ba66d3e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb483fc5fc7ad462eb8f3825f7ba66d3e</font></td></tr></table> > ] 
