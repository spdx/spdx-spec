# N1fa435e2fccc44b0958091f3f82eb32c node1525
node1525 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N1fa435e2fccc44b0958091f3f82eb32c</B></td></tr><tr><td href='N1fa435e2fccc44b0958091f3f82eb32c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N1fa435e2fccc44b0958091f3f82eb32c</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is runsOn, to must be a Hardware&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/runsOn&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Hardware/Hardware&gt; }
}&quot;</td></tr></table> > ] 
