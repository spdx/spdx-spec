# N90ca8daade52494ba2cf5e46041bae55 node1189
node1189 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N90ca8daade52494ba2cf5e46041bae55</B></td></tr><tr><td href='N90ca8daade52494ba2cf5e46041bae55' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N90ca8daade52494ba2cf5e46041bae55</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is affects, from must be a Vulnerability, Action, or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
