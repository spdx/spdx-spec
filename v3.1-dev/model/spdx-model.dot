node405 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>NoneElement</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/NoneElement' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/NoneElement</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;An Individual Value for Element representing a set of Elements with
cardinality (number/count) of zero.&quot;@en</td></tr></table> > ] 
