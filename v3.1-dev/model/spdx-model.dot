# N7ad8f26645b34fb5bb0993c0bef23105 node1164
node1164 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N7ad8f26645b34fb5bb0993c0bef23105</B></td></tr><tr><td href='N7ad8f26645b34fb5bb0993c0bef23105' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N7ad8f26645b34fb5bb0993c0bef23105</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedIn, class must be VexFixedVulnAssessmentRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
