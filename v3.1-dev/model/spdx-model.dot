node1051 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne34aab66cc604a8da10df2f86ced4396</B></td></tr><tr><td href='Ne34aab66cc604a8da10df2f86ced4396' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne34aab66cc604a8da10df2f86ced4396</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:pattern</td><td align='left'>&quot;^\d\d\d\d-\d\d-\d\dT\d\d:\d\d:\d\dZ$&quot;</td></tr></table> > ] 
