# N5bb707e5942840f19a337c008954373b node86
node86 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N5bb707e5942840f19a337c008954373b</B></td></tr><tr><td href='N5bb707e5942840f19a337c008954373b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N5bb707e5942840f19a337c008954373b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasInput, from must be a Build, DefinedProcess, or Action&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
