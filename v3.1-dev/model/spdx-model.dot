# N65a6d6d4a03f48b3b8353e6acd0204d1 node912
node912 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N65a6d6d4a03f48b3b8353e6acd0204d1</B></td></tr><tr><td href='N65a6d6d4a03f48b3b8353e6acd0204d1' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N65a6d6d4a03f48b3b8353e6acd0204d1</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasConcludedLicense, to must be an AnyLicenseInfo&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasConcludedLicense&gt; .
    $this &lt;Core/to&gt; ?to .
