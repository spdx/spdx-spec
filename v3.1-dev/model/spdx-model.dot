# N37fa2d8bc0f04b00a155842263a481dd node1049
node1049 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N37fa2d8bc0f04b00a155842263a481dd</B></td></tr><tr><td href='N37fa2d8bc0f04b00a155842263a481dd' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N37fa2d8bc0f04b00a155842263a481dd</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is coordinatedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/coordinatedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
