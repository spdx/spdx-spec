# Ne8302cf00c374a5abb226c11496243d0 node1138
node1138 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne8302cf00c374a5abb226c11496243d0</B></td></tr><tr><td href='Ne8302cf00c374a5abb226c11496243d0' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne8302cf00c374a5abb226c11496243d0</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is foundBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/foundBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
