node41 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>rootElement</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/rootElement' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/rootElement</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;This property is used to denote the root Element(s) of a tree of elements contained in a BOM.&quot;@en</td></tr></table> > ] 
