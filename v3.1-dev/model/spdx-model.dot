node30 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N4ad7a2aed5404050ae77226408277cd7</B></td></tr><tr><td href='N4ad7a2aed5404050ae77226408277cd7' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N4ad7a2aed5404050ae77226408277cd7</font></td></tr></table> > ] 
