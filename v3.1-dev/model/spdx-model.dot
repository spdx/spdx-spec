node1129 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>externalSpdxId</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/externalSpdxId' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/externalSpdxId</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Identifies an external Element used within an SpdxDocument but defined
external to that SpdxDocument.&quot;@en</td></tr></table> > ] 
