node1228 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N5277dfd663df43418b90c053aae1f7dc</B></td></tr><tr><td href='N5277dfd663df43418b90c053aae1f7dc' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N5277dfd663df43418b90c053aae1f7dc</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is resolved, from must be a ResolutionAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/resolved&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;SupplyChain/ResolutionAction&gt; }
}&quot;</td></tr></table> > ] 
# Ncef982199cb846a1b9c6b4d80bfb8d81 node1229
