node1342 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>noAssertion</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/SupportType/noAssertion' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/SupportType/noAssertion</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;No assertion about the type of support is made. This is considered the default if no other support type is used.&quot;@en</td></tr></table> > ] 
