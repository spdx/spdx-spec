node925 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nbe71551200074a8aa087868e3d2b94c4</B></td></tr><tr><td href='Nbe71551200074a8aa087868e3d2b94c4' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nbe71551200074a8aa087868e3d2b94c4</font></td></tr></table> > ] 
