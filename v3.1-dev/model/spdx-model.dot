# Ne3567d3104ae44e093044b27fbc72b7e node173
node173 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne3567d3104ae44e093044b27fbc72b7e</B></td></tr><tr><td href='Ne3567d3104ae44e093044b27fbc72b7e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne3567d3104ae44e093044b27fbc72b7e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasUninstall, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasUninstall&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Artifact&gt; }
}&quot;</td></tr></table> > ] 
