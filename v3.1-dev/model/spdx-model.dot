node1026 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N3b382002a7b44d5d934df5c9d8fb09e8</B></td></tr><tr><td href='N3b382002a7b44d5d934df5c9d8fb09e8' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N3b382002a7b44d5d934df5c9d8fb09e8</font></td></tr><tr><td align='left'>sh:pattern</td><td align='left'>&quot;^[a-zA-Z]{2,8}(-[a-zA-Z0-9]{1,8})*$&quot;</td></tr></table> > ] 
