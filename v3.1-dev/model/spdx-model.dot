# https://spdx.org/rdf/3/terms/Core/RelationshipType/follows node920
node920 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>follows</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipType/follows' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipType/follows</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The `to` Element succeeds the `from` Element, establishing a unidirectional sequence. This succession is defined as chronological, procedural, or logical. It is used to represent either a temporal order (e.g., in a workflow) or a logical order for processing and traversal (e.g., in an ordered list).&quot;@en</td></tr></table> > ] 
# N376bf567ce5944e3b21fd7a543e0452c node921
node921 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N376bf567ce5944e3b21fd7a543e0452c</B></td></tr><tr><td href='N376bf567ce5944e3b21fd7a543e0452c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N376bf567ce5944e3b21fd7a543e0452c</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasContactPoint, class must be ContactPointRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
