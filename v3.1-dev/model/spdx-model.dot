# N60bb3c81eb034e758d033850461bbe5b node1346
node1346 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N60bb3c81eb034e758d033850461bbe5b</B></td></tr><tr><td href='N60bb3c81eb034e758d033850461bbe5b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N60bb3c81eb034e758d033850461bbe5b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is invokedBy, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
