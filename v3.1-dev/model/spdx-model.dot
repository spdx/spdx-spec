node1097 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ncbe112a40cc54bd5943ddf36ea34f03d</B></td></tr><tr><td href='Ncbe112a40cc54bd5943ddf36ea34f03d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ncbe112a40cc54bd5943ddf36ea34f03d</font></td></tr></table> > ] 
