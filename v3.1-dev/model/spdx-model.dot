node648 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>hashValue</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/hashValue' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/hashValue</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The result of applying a hash algorithm to an Element.&quot;@en</td></tr></table> > ] 
