# Ne5a11c5ea8f448d4b2d3ed25b103dc34 node314
node314 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne5a11c5ea8f448d4b2d3ed25b103dc34</B></td></tr><tr><td href='Ne5a11c5ea8f448d4b2d3ed25b103dc34' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne5a11c5ea8f448d4b2d3ed25b103dc34</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasAssessmentFor, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasAssessmentFor&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
