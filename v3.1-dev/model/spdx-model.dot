node826 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Sbom</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Software/Sbom' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Software/Sbom</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A collection of SPDX Elements describing a single package.&quot;@en</td></tr></table> > ] 
