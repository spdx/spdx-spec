node473 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N1488f2dc036649a198c36ab1f3ab2397</B></td></tr><tr><td href='N1488f2dc036649a198c36ab1f3ab2397' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N1488f2dc036649a198c36ab1f3ab2397</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;https://spdx.org/rdf/3/terms/Security/VexVulnAssessmentRelationship is an abstract class and should not be instantiated directly. Instantiate a subclass instead.&quot;@en</td></tr></table> > ] 
