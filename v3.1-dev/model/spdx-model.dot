# Na63c39d60c0848fb8d6afb56e478eaaf node1923
node1923 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na63c39d60c0848fb8d6afb56e478eaaf</B></td></tr><tr><td href='Na63c39d60c0848fb8d6afb56e478eaaf' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na63c39d60c0848fb8d6afb56e478eaaf</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is providesSupportFor, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/providesSupportFor&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Artifact&gt; }
}&quot;</td></tr></table> > ] 
# N8a90eeae7daf4e9b8fab8c2bf4cd4911 node1924
