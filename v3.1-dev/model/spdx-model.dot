# Nb017555183df42c69097c49d1e0b50b9 node1713
node1713 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb017555183df42c69097c49d1e0b50b9</B></td></tr><tr><td href='Nb017555183df42c69097c49d1e0b50b9' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb017555183df42c69097c49d1e0b50b9</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is republishedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/republishedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
