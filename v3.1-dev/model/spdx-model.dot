node1013 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>design</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Software/SbomType/design' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Software/SbomType/design</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;SBOM of intended, planned software project or product with included components (some of which may not yet exist) for a new software artifact.&quot;@en</td></tr></table> > ] 
