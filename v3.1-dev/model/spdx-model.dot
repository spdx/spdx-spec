SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/providesSupportFor&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/SupportRelationship&gt; }
}&quot;</td></tr></table> > ] 
# Nfde0781edfe64bcdbc1b19a9c916fd87 node725
node725 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nfde0781edfe64bcdbc1b19a9c916fd87</B></td></tr><tr><td href='Nfde0781edfe64bcdbc1b19a9c916fd87' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nfde0781edfe64bcdbc1b19a9c916fd87</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, from must be an Action or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/createdBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/DefinedProcess&gt; }
}&quot;</td></tr></table> > ] 
