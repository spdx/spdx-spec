# N09c93368cc384f28b3ce33de666628f7 node538
node538 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N09c93368cc384f28b3ce33de666628f7</B></td></tr><tr><td href='N09c93368cc384f28b3ce33de666628f7' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N09c93368cc384f28b3ce33de666628f7</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasAssessmentFor, class must be VulnAssessmentRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasAssessmentFor&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Security/VulnAssessmentRelationship&gt; }
}&quot;</td></tr></table> > ] 
# Nf616af2592644b368eb7449a5aab840f node539
node539 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf616af2592644b368eb7449a5aab840f</B></td></tr><tr><td href='Nf616af2592644b368eb7449a5aab840f' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf616af2592644b368eb7449a5aab840f</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasContactPoint, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasContactPoint&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
