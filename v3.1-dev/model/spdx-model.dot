node1820 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N1cdd12b53463466d9fdd3c76d0f7630c</B></td></tr><tr><td href='N1cdd12b53463466d9fdd3c76d0f7630c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N1cdd12b53463466d9fdd3c76d0f7630c</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is publishedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
