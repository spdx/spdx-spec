# Nf73e4e68d47e474ab4a7dd8be1ce3b8b node312
node312 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf73e4e68d47e474ab4a7dd8be1ce3b8b</B></td></tr><tr><td href='Nf73e4e68d47e474ab4a7dd8be1ce3b8b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf73e4e68d47e474ab4a7dd8be1ce3b8b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/createdBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
