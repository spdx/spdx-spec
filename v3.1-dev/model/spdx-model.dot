# N59a6252a178c4303835357cba006992a node1263
node1263 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N59a6252a178c4303835357cba006992a</B></td></tr><tr><td href='N59a6252a178c4303835357cba006992a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N59a6252a178c4303835357cba006992a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is tracedToDetail, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/tracedToDetail&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
