# N65590d80fae24f22babe2d69b16a708d node204
node204 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N65590d80fae24f22babe2d69b16a708d</B></td></tr><tr><td href='N65590d80fae24f22babe2d69b16a708d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N65590d80fae24f22babe2d69b16a708d</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is runsOn, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/runsOn&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
# N8671c6544ab54e5a9692be6432a145be node205
node205 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8671c6544ab54e5a9692be6432a145be</B></td></tr><tr><td href='N8671c6544ab54e5a9692be6432a145be' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8671c6544ab54e5a9692be6432a145be</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, from must be an Action or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/createdBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/DefinedProcess&gt; }
}&quot;</td></tr></table> > ] 
