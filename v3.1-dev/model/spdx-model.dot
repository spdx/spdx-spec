# Ne380ad6e1db44089b99f5429556c16c4 node616
node616 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne380ad6e1db44089b99f5429556c16c4</B></td></tr><tr><td href='Ne380ad6e1db44089b99f5429556c16c4' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne380ad6e1db44089b99f5429556c16c4</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is providesSupportFor, from must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/providesSupportFor&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
# N1e8fe5f35f11442f9806f4a6fbbbff56 node617
node617 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N1e8fe5f35f11442f9806f4a6fbbbff56</B></td></tr><tr><td href='N1e8fe5f35f11442f9806f4a6fbbbff56' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N1e8fe5f35f11442f9806f4a6fbbbff56</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;A value for Core/name is required when a value for Core/version is present&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Software/version&gt; ?version .
    FILTER NOT EXISTS {
        $this &lt;Software/name&gt; ?name .
    }
