# N56f0b5a9e239434d84a54187472e65b9 node163
node163 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N56f0b5a9e239434d84a54187472e65b9</B></td></tr><tr><td href='N56f0b5a9e239434d84a54187472e65b9' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N56f0b5a9e239434d84a54187472e65b9</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is performedBy, from must be an Action or a Relationship of type hasInstall or hasUninstall&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/performedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
    FILTER NOT EXISTS { ?from &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasInstall&gt; }
    FILTER NOT EXISTS { ?from &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasUninstall&gt; }
}&quot;</td></tr></table> > ] 
