# N2aa2b56a1d054bffab1ab0967687d4e0 node1067
node1067 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N2aa2b56a1d054bffab1ab0967687d4e0</B></td></tr><tr><td href='N2aa2b56a1d054bffab1ab0967687d4e0' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N2aa2b56a1d054bffab1ab0967687d4e0</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
