# N54e1d0bfb52e4978870bb4754c710027 node1741
node1741 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N54e1d0bfb52e4978870bb4754c710027</B></td></tr><tr><td href='N54e1d0bfb52e4978870bb4754c710027' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N54e1d0bfb52e4978870bb4754c710027</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
