# Nff66c4ae71f542a1bf88d0b0cdc4a030 node1725
node1725 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nff66c4ae71f542a1bf88d0b0cdc4a030</B></td></tr><tr><td href='Nff66c4ae71f542a1bf88d0b0cdc4a030' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nff66c4ae71f542a1bf88d0b0cdc4a030</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is runsOn, to must be a Hardware&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
