# N8d09bcb4c3ba4cbeb3db8590a8d4b0a2 node1351
node1351 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8d09bcb4c3ba4cbeb3db8590a8d4b0a2</B></td></tr><tr><td href='N8d09bcb4c3ba4cbeb3db8590a8d4b0a2' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8d09bcb4c3ba4cbeb3db8590a8d4b0a2</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasResolution, from must be a ResolutionAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasResolution&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;SupplyChain/ResolutionAction&gt; }
}&quot;</td></tr></table> > ] 
