# N4e3fa6cf172a41458b887444fb2c7f53 node433
node433 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N4e3fa6cf172a41458b887444fb2c7f53</B></td></tr><tr><td href='N4e3fa6cf172a41458b887444fb2c7f53' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N4e3fa6cf172a41458b887444fb2c7f53</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is underInvestigationFor, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/underInvestigationFor&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
