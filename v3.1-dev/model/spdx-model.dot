# Nf8142e145e404427a9b225734b3222b0 node1519
node1519 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf8142e145e404427a9b225734b3222b0</B></td></tr><tr><td href='Nf8142e145e404427a9b225734b3222b0' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf8142e145e404427a9b225734b3222b0</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasAssessmentFor, class must be VulnAssessmentRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasAssessmentFor&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Security/VulnAssessmentRelationship&gt; }
}&quot;</td></tr></table> > ] 
# N12f6113a76e5416cb04e04322aa21d9d node1520
