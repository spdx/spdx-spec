node767 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>inLanguage</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/inLanguage' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/inLanguage</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Specifies a human language used within the content of an Element or a property.&quot;@en</td></tr></table> > ] 
