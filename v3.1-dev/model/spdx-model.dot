# Nebb0123d49594e399ca0b410e7ce673b node1560
node1560 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nebb0123d49594e399ca0b410e7ce673b</B></td></tr><tr><td href='Nebb0123d49594e399ca0b410e7ce673b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nebb0123d49594e399ca0b410e7ce673b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasPrerequisite, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasPrerequisite&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
