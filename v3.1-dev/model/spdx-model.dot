# N33ef1d0a3f4d4f559cb997ce303e9238 node532
node532 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N33ef1d0a3f4d4f559cb997ce303e9238</B></td></tr><tr><td href='N33ef1d0a3f4d4f559cb997ce303e9238' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N33ef1d0a3f4d4f559cb997ce303e9238</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasOptionalDependency, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasOptionalDependency&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
