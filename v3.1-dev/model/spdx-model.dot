    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasContactPoint&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/ContactPointRelationship&gt; }
}&quot;</td></tr></table> > ] 
