# N71484a41137448898a22e451505c8dff node1883
node1883 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N71484a41137448898a22e451505c8dff</B></td></tr><tr><td href='N71484a41137448898a22e451505c8dff' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N71484a41137448898a22e451505c8dff</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is providesSupportFor, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
