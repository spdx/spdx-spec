# Ncf727c3a678a417a85e07286fb216b2a node1181
node1181 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ncf727c3a678a417a85e07286fb216b2a</B></td></tr><tr><td href='Ncf727c3a678a417a85e07286fb216b2a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ncf727c3a678a417a85e07286fb216b2a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, from must be an Action or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/createdBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/DefinedProcess&gt; }
}&quot;</td></tr></table> > ] 
