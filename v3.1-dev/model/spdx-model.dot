# N7e6e53b510b649e79d7bf9647c303c92 node1300
node1300 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N7e6e53b510b649e79d7bf9647c303c92</B></td></tr><tr><td href='N7e6e53b510b649e79d7bf9647c303c92' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N7e6e53b510b649e79d7bf9647c303c92</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasInput, from must be a Build, DefinedProcess, or Action&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasInput&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Build/Build&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/DefinedProcess&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
}&quot;</td></tr></table> > ] 
# N347380617b36424eb40aebe27723f129 node1301
node1301 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N347380617b36424eb40aebe27723f129</B></td></tr><tr><td href='N347380617b36424eb40aebe27723f129' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N347380617b36424eb40aebe27723f129</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship id dependsOn, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/dependsOn&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
