# N211367bca39f4b63a921197cfa6fe346 node1500
node1500 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N211367bca39f4b63a921197cfa6fe346</B></td></tr><tr><td href='N211367bca39f4b63a921197cfa6fe346' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N211367bca39f4b63a921197cfa6fe346</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasDeclaredLicense, to must be an AnyLicenseInfo&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasDeclaredLicense&gt; .
    $this &lt;Core/to&gt; ?to .
