# Nfbe3298e0f3041859cf4427a4d2a4fee node1553
node1553 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nfbe3298e0f3041859cf4427a4d2a4fee</B></td></tr><tr><td href='Nfbe3298e0f3041859cf4427a4d2a4fee' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nfbe3298e0f3041859cf4427a4d2a4fee</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is runsOn, to must be a Hardware&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/runsOn&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Hardware/Hardware&gt; }
}&quot;</td></tr></table> > ] 
