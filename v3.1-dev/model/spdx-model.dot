# Nddb43c5e70ab462a9065b2c0f91b336e node638
node638 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nddb43c5e70ab462a9065b2c0f91b336e</B></td></tr><tr><td href='Nddb43c5e70ab462a9065b2c0f91b336e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nddb43c5e70ab462a9065b2c0f91b336e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is performedBy, from must be an Action&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/performedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
}&quot;</td></tr></table> > ] 
