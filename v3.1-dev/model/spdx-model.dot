# Nae701cf4f5834c35aad105e6ec0d8a52 node1839
node1839 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nae701cf4f5834c35aad105e6ec0d8a52</B></td></tr><tr><td href='Nae701cf4f5834c35aad105e6ec0d8a52' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nae701cf4f5834c35aad105e6ec0d8a52</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is invokedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
