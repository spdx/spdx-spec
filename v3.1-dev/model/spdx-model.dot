# Nc52c8aa6a0884a95977f59af8e01dd05 node2083
node2083 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nc52c8aa6a0884a95977f59af8e01dd05</B></td></tr><tr><td href='Nc52c8aa6a0884a95977f59af8e01dd05' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nc52c8aa6a0884a95977f59af8e01dd05</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasContactPoint, class must be ContactPointRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasContactPoint&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/ContactPointRelationship&gt; }
}&quot;</td></tr></table> > ] 
}
