# N75c6bb74c4554de2b59d807891e9440b node1628
node1628 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N75c6bb74c4554de2b59d807891e9440b</B></td></tr><tr><td href='N75c6bb74c4554de2b59d807891e9440b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N75c6bb74c4554de2b59d807891e9440b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is republishedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/republishedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
