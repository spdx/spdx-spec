# Nd428a456de5649ba89a36a1d2e464e4a node1811
node1811 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nd428a456de5649ba89a36a1d2e464e4a</B></td></tr><tr><td href='Nd428a456de5649ba89a36a1d2e464e4a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nd428a456de5649ba89a36a1d2e464e4a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasDeclaredLicense, to must be an AnyLicenseInfo&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
