# N0faa905debb14c01aecaf2472eeac257 node1982
node1982 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N0faa905debb14c01aecaf2472eeac257</B></td></tr><tr><td href='N0faa905debb14c01aecaf2472eeac257' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N0faa905debb14c01aecaf2472eeac257</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is assumes, to must be an Assumption&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/assumes&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;FunctionalSafety/Assumption&gt; }
}&quot;</td></tr></table> > ] 
