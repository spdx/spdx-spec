# Ne3d2a832848548e2ad23c7279cfc0415 node1530
node1530 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne3d2a832848548e2ad23c7279cfc0415</B></td></tr><tr><td href='Ne3d2a832848548e2ad23c7279cfc0415' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne3d2a832848548e2ad23c7279cfc0415</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is resolved, to must be an OutOfSpecAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/resolved&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;SupplyChain/OutOfSpecAction&gt; }
}&quot;</td></tr></table> > ] 
