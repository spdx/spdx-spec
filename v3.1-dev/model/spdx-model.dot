# Nbeb2123b41584988a76be99c33c5bf01 node54
node54 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nbeb2123b41584988a76be99c33c5bf01</B></td></tr><tr><td href='Nbeb2123b41584988a76be99c33c5bf01' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nbeb2123b41584988a76be99c33c5bf01</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasSpecification, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasSpecification&gt; .
