# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ismn node768
node768 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>ismn</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ismn' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ismn</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;[International Standard Music Number (ISMN)](https://ismn-international.org/ismn/the-ismn/) is a unique numeric identifier for printed music (notated music) standardized by [ISO 10957](https://www.iso.org/standard/83122.html). It consists of either 10 characters (starting with the letter &quot;M&quot; for assignments prior to January 1, 2008) or 13 digits. A 13-digit ISMN is composed of four parts: the GS1 prefix `979-0`, a registrant element, an item element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., `9790006538424`).&quot;@en</td></tr></table> > ] 
# N142a26f4c5f24b94992f7a2de3fd4e5d node769
node769 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N142a26f4c5f24b94992f7a2de3fd4e5d</B></td></tr><tr><td href='N142a26f4c5f24b94992f7a2de3fd4e5d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N142a26f4c5f24b94992f7a2de3fd4e5d</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is republishedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/republishedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
