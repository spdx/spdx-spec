# N0b81c6a1d857401b893c311ea8e15666 node828
node828 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N0b81c6a1d857401b893c311ea8e15666</B></td></tr><tr><td href='N0b81c6a1d857401b893c311ea8e15666' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N0b81c6a1d857401b893c311ea8e15666</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is runsOn, to must be a Hardware&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
