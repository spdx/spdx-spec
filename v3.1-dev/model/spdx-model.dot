node679 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne44e194cbd9345359f92d67504fe28d1</B></td></tr><tr><td href='Ne44e194cbd9345359f92d67504fe28d1' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne44e194cbd9345359f92d67504fe28d1</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo is an abstract class and should not be instantiated directly. Instantiate a subclass instead.&quot;@en</td></tr></table> > ] 
