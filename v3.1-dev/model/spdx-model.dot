node1718 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>trainedOn</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipType/trainedOn' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipType/trainedOn</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The `from` Element has been trained on the `to` Element(s).&quot;@en</td></tr></table> > ] 
