# N8cecf397f77d49f391865f1b7835e353 node1100
node1100 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8cecf397f77d49f391865f1b7835e353</B></td></tr><tr><td href='N8cecf397f77d49f391865f1b7835e353' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8cecf397f77d49f391865f1b7835e353</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is republishedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
