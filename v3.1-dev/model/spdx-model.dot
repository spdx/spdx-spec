node889 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>HarvestProcess</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/SupplyChain/HarvestProcess' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/SupplyChain/HarvestProcess</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Harvest is the process of extracting goods or products from nature.&quot;@en</td></tr></table> > ] 
# Ned2b0e44bdb940059b3f2eb2d9e2e106 node890
node890 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ned2b0e44bdb940059b3f2eb2d9e2e106</B></td></tr><tr><td href='Ned2b0e44bdb940059b3f2eb2d9e2e106' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ned2b0e44bdb940059b3f2eb2d9e2e106</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasRoleIn, class must be RoleRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasRoleIn&gt; .
