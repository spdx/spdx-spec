# Neca7a5095a2947038edd4173c60fd7af node1391
node1391 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Neca7a5095a2947038edd4173c60fd7af</B></td></tr><tr><td href='Neca7a5095a2947038edd4173c60fd7af' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Neca7a5095a2947038edd4173c60fd7af</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is verifiedBy, to must be a RequirementVerification&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/verifiedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;FunctionalSafety/RequirementVerification&gt; }
}&quot;</td></tr></table> > ] 
