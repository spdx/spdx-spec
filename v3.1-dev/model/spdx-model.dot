# Naac7b38f62d5416ab9f479818acdcd99 node1804
node1804 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Naac7b38f62d5416ab9f479818acdcd99</B></td></tr><tr><td href='Naac7b38f62d5416ab9f479818acdcd99' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Naac7b38f62d5416ab9f479818acdcd99</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/createdBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
