# Ne272a1211cc242d48154dedad8b9cefb node1754
node1754 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne272a1211cc242d48154dedad8b9cefb</B></td></tr><tr><td href='Ne272a1211cc242d48154dedad8b9cefb' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne272a1211cc242d48154dedad8b9cefb</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is foundBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
