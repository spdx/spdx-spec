# Nff3ea6df65e24bb4b6b1763a343b5c36 node953
node953 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nff3ea6df65e24bb4b6b1763a343b5c36</B></td></tr><tr><td href='Nff3ea6df65e24bb4b6b1763a343b5c36' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nff3ea6df65e24bb4b6b1763a343b5c36</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is serializedInArtifact, from must be a SpdxDocument&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/serializedInArtifact&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/SpdxDocument&gt; }
}&quot;</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/eori node954
