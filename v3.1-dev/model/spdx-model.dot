# Nb34b24f6f1b240fe8ab451d83e29b549 node955
node955 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb34b24f6f1b240fe8ab451d83e29b549</B></td></tr><tr><td href='Nb34b24f6f1b240fe8ab451d83e29b549' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb34b24f6f1b240fe8ab451d83e29b549</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is republishedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/republishedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
