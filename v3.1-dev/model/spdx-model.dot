node812 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N03eceac8ad59406595cee73a1ee50f84</B></td></tr><tr><td href='N03eceac8ad59406595cee73a1ee50f84' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N03eceac8ad59406595cee73a1ee50f84</font></td></tr></table> > ] 
