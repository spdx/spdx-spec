# Neb4c4a85389342fc81b648e10b9df97a node400
node400 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Neb4c4a85389342fc81b648e10b9df97a</B></td></tr><tr><td href='Neb4c4a85389342fc81b648e10b9df97a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Neb4c4a85389342fc81b648e10b9df97a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, to must be a Relationship whose relationshipType is invokedBy&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
