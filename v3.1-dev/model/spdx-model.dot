# N53193c70e2ac41b191b1760ab4f91415 node240
node240 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N53193c70e2ac41b191b1760ab4f91415</B></td></tr><tr><td href='N53193c70e2ac41b191b1760ab4f91415' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N53193c70e2ac41b191b1760ab4f91415</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is verifiedBy, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/verifiedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
