# N9fd5ad2f8ebf4e6c8c3122c77f49c3c1 node1450
node1450 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N9fd5ad2f8ebf4e6c8c3122c77f49c3c1</B></td></tr><tr><td href='N9fd5ad2f8ebf4e6c8c3122c77f49c3c1' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N9fd5ad2f8ebf4e6c8c3122c77f49c3c1</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, to must be a Relationship whose relationshipType is invokedBy&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/delegatedTo&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS {
        ?to rdf:type/rdfs:subClassOf* &lt;Core/Relationship&gt; .
        ?to &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    }
}&quot;</td></tr></table> > ] 
