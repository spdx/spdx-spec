# Nc6d01fc4a23d4a5d8149fa39303b3478 node1234
node1234 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nc6d01fc4a23d4a5d8149fa39303b3478</B></td></tr><tr><td href='Nc6d01fc4a23d4a5d8149fa39303b3478' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nc6d01fc4a23d4a5d8149fa39303b3478</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is publishedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/publishedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
