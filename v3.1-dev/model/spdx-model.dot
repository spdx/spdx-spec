# Na8a0ed6b26204543ab438d431a92313e node1717
node1717 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na8a0ed6b26204543ab438d431a92313e</B></td></tr><tr><td href='Na8a0ed6b26204543ab438d431a92313e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na8a0ed6b26204543ab438d431a92313e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, from must be an Action or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
