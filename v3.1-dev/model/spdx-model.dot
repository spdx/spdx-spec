# https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/gitoid node208
node208 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>gitoid</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/gitoid' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/gitoid</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;[Gitoid](https://www.iana.org/assignments/uri-schemes/prov/gitoid), stands for [Git Object ID](https://git-scm.com/book/en/v2/Git-Internals-Git-Objects). A gitoid of type blob is a unique hash of a binary artifact. A gitoid may represent either an [Artifact Identifier](https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-identifier-types) for the software artifact or an [Input Manifest Identifier](https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#input-manifest-identifier) for the software artifact&#x27;s associated [Artifact Input Manifest](https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-input-manifest); this ambiguity exists because the Artifact Input Manifest is itself an artifact, and the gitoid of that artifact is its valid identifier. Gitoids calculated on software artifacts (Snippet, File, or Package Elements) should be recorded in the SPDX 3 SoftwareArtifact&#x27;s contentIdentifier property. Gitoids calculated on the Artifact Input Manifest (Input Manifest Identifier) should be recorded in the SPDX 3 Element&#x27;s externalIdentifier property. See [OmniBOR Specification](https://github.com/omnibor/spec/), a minimalistic specification for describing software [Artifact Dependency Graphs](https://github.com/omnibor/spec/blob/eb1ee5c961c16215eb8709b2975d193a2007a35d/spec/SPEC.md#artifact-dependency-graph-adg).&quot;@en</td></tr></table> > ] 
# N374ce6ced2bf4bdea20375018d34524c node209
node209 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N374ce6ced2bf4bdea20375018d34524c</B></td></tr><tr><td href='N374ce6ced2bf4bdea20375018d34524c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N374ce6ced2bf4bdea20375018d34524c</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Dataset/ConfidentialityLevelType/amberStrict node210
node210 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>amberStrict</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Dataset/ConfidentialityLevelType/amberStrict' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Dataset/ConfidentialityLevelType/amberStrict</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Limited distribution - organization only. The dataset shall be shared only with specific organizations on a need-to-know basis.&quot;@en</td></tr></table> > ] 
# N606654b08c4a4259ac75355bfff69a40 node211
node211 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N606654b08c4a4259ac75355bfff69a40</B></td></tr><tr><td href='N606654b08c4a4259ac75355bfff69a40' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N606654b08c4a4259ac75355bfff69a40</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, to must be a Relationship whose relationshipType is invokedBy&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/delegatedTo&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS {
        ?to rdf:type/rdfs:subClassOf* &lt;Core/Relationship&gt; .
        ?to &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    }
}&quot;</td></tr></table> > ] 
