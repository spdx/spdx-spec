# Nee832296165d42af93a386a0b1e7e007 node1511
node1511 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nee832296165d42af93a386a0b1e7e007</B></td></tr><tr><td href='Nee832296165d42af93a386a0b1e7e007' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nee832296165d42af93a386a0b1e7e007</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is republishedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
