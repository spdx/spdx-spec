node486 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>clickthrough</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType/clickthrough' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType/clickthrough</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Dataset is not publicly available and can only be accessed after affirmatively accepting terms on a clickthrough webpage.&quot;@en</td></tr></table> > ] 
