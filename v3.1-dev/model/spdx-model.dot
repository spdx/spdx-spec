node1555 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>timeseries</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Dataset/DatasetType/timeseries' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Dataset/DatasetType/timeseries</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Data is recorded in an ordered sequence of timestamped entries, such as the price of a stock over the course of a day.&quot;@en</td></tr></table> > ] 
