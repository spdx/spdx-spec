# Na1565b40d5a145d698e36b6c1d0725f7 node342
node342 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na1565b40d5a145d698e36b6c1d0725f7</B></td></tr><tr><td href='Na1565b40d5a145d698e36b6c1d0725f7' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na1565b40d5a145d698e36b6c1d0725f7</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is performedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/performedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
