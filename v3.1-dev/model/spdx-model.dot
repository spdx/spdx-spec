node1830 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nbaf9e9e59c9544359e9cc4a35aefebde</B></td></tr><tr><td href='Nbaf9e9e59c9544359e9cc4a35aefebde' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nbaf9e9e59c9544359e9cc4a35aefebde</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is providesSupportFor, class must be SupportRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/providesSupportFor&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/SupportRelationship&gt; }
}&quot;</td></tr></table> > ] 
