node686 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>justificationType</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Security/justificationType' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Security/justificationType</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Impact justification label to be used when linking a vulnerability to an element
representing a VEX product with a VexNotAffectedVulnAssessmentRelationship
relationship.&quot;@en</td></tr></table> > ] 
