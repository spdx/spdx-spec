# N101094334abd4c50a78565e5b99ab615 node723
node723 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N101094334abd4c50a78565e5b99ab615</B></td></tr><tr><td href='N101094334abd4c50a78565e5b99ab615' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N101094334abd4c50a78565e5b99ab615</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasConcludedLicense, to must be an AnyLicenseInfo&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasConcludedLicense&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;SimpleLicensing/AnyLicenseInfo&gt; }
}&quot;</td></tr></table> > ] 
# N438b14b297d9429daaf935075565042b node724
