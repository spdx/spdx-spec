# https://spdx.org/rdf/3/terms/Core/RelationshipType/follows node795
node795 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>follows</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipType/follows' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipType/follows</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The `to` Element succeeds the `from` Element, establishing a unidirectional sequence. This succession is defined as chronological, procedural, or logical. It is used to represent either a temporal order (e.g., in a workflow) or a logical order for processing and traversal (e.g., in an ordered list).&quot;@en</td></tr></table> > ] 
# N9608434baba7437ca80bc4d21d9d2c95 node796
node796 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N9608434baba7437ca80bc4d21d9d2c95</B></td></tr><tr><td href='N9608434baba7437ca80bc4d21d9d2c95' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N9608434baba7437ca80bc4d21d9d2c95</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/createdBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
