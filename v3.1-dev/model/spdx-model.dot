# N3a2cb0ecc87e47daa427be4c80cdac5c node1453
node1453 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N3a2cb0ecc87e47daa427be4c80cdac5c</B></td></tr><tr><td href='N3a2cb0ecc87e47daa427be4c80cdac5c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N3a2cb0ecc87e47daa427be4c80cdac5c</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is tracedToDetail, to must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/tracedToDetail&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
