# https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/swhid node1305
node1305 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>swhid</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/swhid' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/swhid</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;SoftWare Hash IDentifier, a persistent intrinsic identifier for digital artifacts, such as files, trees (also known as directories or folders), commits, and other objects typically found in version control systems. The format of the identifiers is defined in the [SWHID specification](https://www.swhid.org/swhid-specification/v1.2/) ([ISO/IEC 18670](https://www.iso.org/standard/89985.html)). They typically look like `swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2`.&quot;@en</td></tr></table> > ] 
# N8e0df4674c7b4f5eb9065b080032fa17 node1306
node1306 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8e0df4674c7b4f5eb9065b080032fa17</B></td></tr><tr><td href='N8e0df4674c7b4f5eb9065b080032fa17' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8e0df4674c7b4f5eb9065b080032fa17</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, to must be a Relationship whose relationshipType is invokedBy&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/delegatedTo&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS {
        ?to rdf:type/rdfs:subClassOf* &lt;Core/Relationship&gt; .
        ?to &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    }
}&quot;</td></tr></table> > ] 
