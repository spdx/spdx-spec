# N66267df2527a46a8b866fd13de67f8c4 node1483
node1483 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N66267df2527a46a8b866fd13de67f8c4</B></td></tr><tr><td href='N66267df2527a46a8b866fd13de67f8c4' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N66267df2527a46a8b866fd13de67f8c4</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasAssessmentFor, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
