# N48e52caed27d46698ba4cc751e982e68 node720
node720 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N48e52caed27d46698ba4cc751e982e68</B></td></tr><tr><td href='N48e52caed27d46698ba4cc751e982e68' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N48e52caed27d46698ba4cc751e982e68</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is providesSupportFor, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
