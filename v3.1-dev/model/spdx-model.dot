# Ncc7e0d10d8ec4589ab7f2961fdfc5b56 node1270
node1270 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ncc7e0d10d8ec4589ab7f2961fdfc5b56</B></td></tr><tr><td href='Ncc7e0d10d8ec4589ab7f2961fdfc5b56' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ncc7e0d10d8ec4589ab7f2961fdfc5b56</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasUninstall, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasUninstall&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Artifact&gt; }
}&quot;</td></tr></table> > ] 
