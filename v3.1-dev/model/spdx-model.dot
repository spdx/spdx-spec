node927 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N02dd12fe999849ce80b3aadac3030522</B></td></tr><tr><td href='N02dd12fe999849ce80b3aadac3030522' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N02dd12fe999849ce80b3aadac3030522</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:minCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
