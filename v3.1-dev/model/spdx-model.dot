node915 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>other</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/AnnotationType/other' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/AnnotationType/other</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Used to store extra information about an Element which is not part of a review (e.g. extra information provided during the creation of the Element).&quot;@en</td></tr></table> > ] 
