# N730640b0584b4b00944cf0d653ae2086 node1002
node1002 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N730640b0584b4b00944cf0d653ae2086</B></td></tr><tr><td href='N730640b0584b4b00944cf0d653ae2086' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N730640b0584b4b00944cf0d653ae2086</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
