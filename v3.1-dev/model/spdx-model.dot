node374 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N10b0984dae9d4bda906b79e40f57e32f</B></td></tr><tr><td href='N10b0984dae9d4bda906b79e40f57e32f' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N10b0984dae9d4bda906b79e40f57e32f</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
