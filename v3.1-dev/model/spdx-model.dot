# Ncb5ef557f1b24d28936b0085475f6e70 node1783
node1783 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ncb5ef557f1b24d28936b0085475f6e70</B></td></tr><tr><td href='Ncb5ef557f1b24d28936b0085475f6e70' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ncb5ef557f1b24d28936b0085475f6e70</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is coordinatedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
