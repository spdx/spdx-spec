# N73ff140aa22348e2a2dc2278b179d1ee node1631
node1631 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N73ff140aa22348e2a2dc2278b179d1ee</B></td></tr><tr><td href='N73ff140aa22348e2a2dc2278b179d1ee' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N73ff140aa22348e2a2dc2278b179d1ee</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasDeclaredLicense, to must be an AnyLicenseInfo&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasDeclaredLicense&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;SimpleLicensing/AnyLicenseInfo&gt; }
}&quot;</td></tr></table> > ] 
