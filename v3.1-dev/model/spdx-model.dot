# https://spdx.org/rdf/3/terms/Core/ExternalRefType/x509Cert node1550
node1550 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>x509Cert</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalRefType/x509Cert' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalRefType/x509Cert</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A reference to an X.509 certificate as defined in [RFC 5280](https://datatracker.ietf.org/doc/rfc5280/). The primary media type shall be `application/pkix-cert`. The legacy media types `application/x-x509-ca-cert` and `application/x-x509-user-cert` may be used for backward compatibility, but shall not be used in new implementations. NOTE — RFC 5280 supersedes earlier X.509 profiles, including RFC 1422. Existing references based on RFC 1422 remain valid.&quot;@en</td></tr></table> > ] 
# Na4014427540c4a118bb3ae7e70dfec9b node1551
node1551 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na4014427540c4a118bb3ae7e70dfec9b</B></td></tr><tr><td href='Na4014427540c4a118bb3ae7e70dfec9b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na4014427540c4a118bb3ae7e70dfec9b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is verifiedBy, to must be a RequirementVerification&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/verifiedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;FunctionalSafety/RequirementVerification&gt; }
}&quot;</td></tr></table> > ] 
