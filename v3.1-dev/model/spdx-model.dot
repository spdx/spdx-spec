# N78b8238cc3374b069f78b3a2b3129797 node1580
node1580 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N78b8238cc3374b069f78b3a2b3129797</B></td></tr><tr><td href='N78b8238cc3374b069f78b3a2b3129797' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N78b8238cc3374b069f78b3a2b3129797</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is conformsTo, to must be an Assumption or Specification&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/conformsTo&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;FunctionalSafety/Assumption&gt; }
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Specification&gt; }
}&quot;</td></tr></table> > ] 
