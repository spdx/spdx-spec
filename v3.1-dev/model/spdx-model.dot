# Nf97dbe29725c49198de964b8955833c0 node653
node653 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf97dbe29725c49198de964b8955833c0</B></td></tr><tr><td href='Nf97dbe29725c49198de964b8955833c0' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf97dbe29725c49198de964b8955833c0</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasContactPoint, class must be ContactPointRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasContactPoint&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/ContactPointRelationship&gt; }
}&quot;</td></tr></table> > ] 
# N7c76311f73bd499ead1fd4b6dcc52151 node654
node654 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N7c76311f73bd499ead1fd4b6dcc52151</B></td></tr><tr><td href='N7c76311f73bd499ead1fd4b6dcc52151' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N7c76311f73bd499ead1fd4b6dcc52151</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasResolution, to must be an OutOfSpecAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasResolution&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;SupplyChain/OutOfSpecAction&gt; }
}&quot;</td></tr></table> > ] 
