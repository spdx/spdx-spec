node296 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne445e365e1794a46bb1fd9eaed12ac4d</B></td></tr><tr><td href='Ne445e365e1794a46bb1fd9eaed12ac4d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne445e365e1794a46bb1fd9eaed12ac4d</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:minCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
