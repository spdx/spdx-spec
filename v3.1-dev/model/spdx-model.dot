node967 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N443dcd0093e9449b9d3dbbea3386e39f</B></td></tr><tr><td href='N443dcd0093e9449b9d3dbbea3386e39f' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N443dcd0093e9449b9d3dbbea3386e39f</font></td></tr><tr><td align='left'>sh:pattern</td><td align='left'>&quot;^[A-Z]{3}$&quot;</td></tr></table> > ] 
