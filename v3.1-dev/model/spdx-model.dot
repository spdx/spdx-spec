# N90e6dc64a1f441879953f044aa3ba537 node1022
node1022 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N90e6dc64a1f441879953f044aa3ba537</B></td></tr><tr><td href='N90e6dc64a1f441879953f044aa3ba537' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N90e6dc64a1f441879953f044aa3ba537</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasHost, from must be a Build&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
