# N51a6f8ac8cc74341a76529cc7509d195 node1388
node1388 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N51a6f8ac8cc74341a76529cc7509d195</B></td></tr><tr><td href='N51a6f8ac8cc74341a76529cc7509d195' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N51a6f8ac8cc74341a76529cc7509d195</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, from must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
