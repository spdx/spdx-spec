# N6465037506da41ee9b420b25b10c8fd1 node5
node5 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N6465037506da41ee9b420b25b10c8fd1</B></td></tr><tr><td href='N6465037506da41ee9b420b25b10c8fd1' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N6465037506da41ee9b420b25b10c8fd1</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasProvidedDependency, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasProvidedDependency&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
