# N832e460b96a44cc29a13bbfb1f064ed1 node1191
node1191 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N832e460b96a44cc29a13bbfb1f064ed1</B></td></tr><tr><td href='N832e460b96a44cc29a13bbfb1f064ed1' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N832e460b96a44cc29a13bbfb1f064ed1</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedIn, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/fixedIn&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
