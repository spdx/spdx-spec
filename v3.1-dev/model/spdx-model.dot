node1153 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8f03be53d7d54aa3adcb91cd7e53356c</B></td></tr><tr><td href='N8f03be53d7d54aa3adcb91cd7e53356c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8f03be53d7d54aa3adcb91cd7e53356c</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is configures, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
