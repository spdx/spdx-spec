node1781 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N75d62ddcebb94d0884a563194d327d16</B></td></tr><tr><td href='N75d62ddcebb94d0884a563194d327d16' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N75d62ddcebb94d0884a563194d327d16</font></td></tr></table> > ] 
