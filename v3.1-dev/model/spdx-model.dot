# Nef69a20785a6409e828b6341fd1232e8 node675
node675 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nef69a20785a6409e828b6341fd1232e8</B></td></tr><tr><td href='Nef69a20785a6409e828b6341fd1232e8' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nef69a20785a6409e828b6341fd1232e8</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/createdBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
