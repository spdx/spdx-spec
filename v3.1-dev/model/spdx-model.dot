# N00bdabd597a04bafb317d5770f5aadef node1266
node1266 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N00bdabd597a04bafb317d5770f5aadef</B></td></tr><tr><td href='N00bdabd597a04bafb317d5770f5aadef' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N00bdabd597a04bafb317d5770f5aadef</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is usesTool, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
