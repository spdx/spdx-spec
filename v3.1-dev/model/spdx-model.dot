# Ne2bc3e3677d740a18428da756b5bde23 node1258
node1258 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne2bc3e3677d740a18428da756b5bde23</B></td></tr><tr><td href='Ne2bc3e3677d740a18428da756b5bde23' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne2bc3e3677d740a18428da756b5bde23</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is publishedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/publishedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
