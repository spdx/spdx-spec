node1577 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N082a799afc414c41b129dfae8b207689</B></td></tr><tr><td href='N082a799afc414c41b129dfae8b207689' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N082a799afc414c41b129dfae8b207689</font></td></tr></table> > ] 
