node1782 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>coordinatedBy</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipType/coordinatedBy' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipType/coordinatedBy</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The `from` /Security/Vulnerability is coordinatedBy the `to` Agent(s) (vendor, researcher, or consumer agent).&quot;@en</td></tr></table> > ] 
