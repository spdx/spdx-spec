# Nd0396a627dc94a5f86b3f720fcabf496 node1263
node1263 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nd0396a627dc94a5f86b3f720fcabf496</B></td></tr><tr><td href='Nd0396a627dc94a5f86b3f720fcabf496' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nd0396a627dc94a5f86b3f720fcabf496</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is republishedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/republishedBy&gt; .
    $this &lt;Core/to&gt; ?to .
