# Nbf54b39a0d7a41ba9df37fe66b30267e node1915
node1915 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nbf54b39a0d7a41ba9df37fe66b30267e</B></td></tr><tr><td href='Nbf54b39a0d7a41ba9df37fe66b30267e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nbf54b39a0d7a41ba9df37fe66b30267e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is coordinatedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/coordinatedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
