# Na6652fed56ea4713b50823f73576e306 node1832
node1832 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na6652fed56ea4713b50823f73576e306</B></td></tr><tr><td href='Na6652fed56ea4713b50823f73576e306' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na6652fed56ea4713b50823f73576e306</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is assumes, to must be an Assumption&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
