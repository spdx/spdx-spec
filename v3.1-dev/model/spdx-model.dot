# Nab87d0b85e1d48ef99c022fe0c1caa42 node930
node930 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nab87d0b85e1d48ef99c022fe0c1caa42</B></td></tr><tr><td href='Nab87d0b85e1d48ef99c022fe0c1caa42' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nab87d0b85e1d48ef99c022fe0c1caa42</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is verifiedBy, to must be a RequirementVerification&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/verifiedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;FunctionalSafety/RequirementVerification&gt; }
}&quot;</td></tr></table> > ] 
