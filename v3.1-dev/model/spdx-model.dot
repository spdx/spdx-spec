# N786cd5139f31453ea382852f9986781f node637
node637 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N786cd5139f31453ea382852f9986781f</B></td></tr><tr><td href='N786cd5139f31453ea382852f9986781f' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N786cd5139f31453ea382852f9986781f</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedIn, class must be VexFixedVulnAssessmentRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
