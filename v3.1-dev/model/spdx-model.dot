# Ne2086af1ed85479b950644fe6c3c117d node1392
node1392 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne2086af1ed85479b950644fe6c3c117d</B></td></tr><tr><td href='Ne2086af1ed85479b950644fe6c3c117d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne2086af1ed85479b950644fe6c3c117d</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is providesSupportFor, class must be SupportRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/providesSupportFor&gt; .
