# N6fa8e3b57e504180bfc79fac2ea58bd9 node1721
node1721 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N6fa8e3b57e504180bfc79fac2ea58bd9</B></td></tr><tr><td href='N6fa8e3b57e504180bfc79fac2ea58bd9' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N6fa8e3b57e504180bfc79fac2ea58bd9</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is invokedBy, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
