# N0fdf2d3df20c4980a2574300634d2024 node1227
node1227 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N0fdf2d3df20c4980a2574300634d2024</B></td></tr><tr><td href='N0fdf2d3df20c4980a2574300634d2024' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N0fdf2d3df20c4980a2574300634d2024</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is tracedToDetail, to must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/tracedToDetail&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
