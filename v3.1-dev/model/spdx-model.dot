# Ne2c80b5b18d94b6e81de291cfd358442 node1667
node1667 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne2c80b5b18d94b6e81de291cfd358442</B></td></tr><tr><td href='Ne2c80b5b18d94b6e81de291cfd358442' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne2c80b5b18d94b6e81de291cfd358442</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is performedBy, from must be an Action or a Relationship of type hasInstall or hasUninstall&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
