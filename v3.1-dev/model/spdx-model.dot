# Na630662a12de4581b7a6e511c7cb7602 node1179
node1179 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na630662a12de4581b7a6e511c7cb7602</B></td></tr><tr><td href='Na630662a12de4581b7a6e511c7cb7602' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na630662a12de4581b7a6e511c7cb7602</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasDynamicLink, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasDynamicLink&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
