# https://spdx.org/rdf/3/terms/Security/SsvcDecisionType/act node933
node933 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>act</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Security/SsvcDecisionType/act' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Security/SsvcDecisionType/act</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The vulnerability requires attention from the organization&#x27;s internal, supervisory-level and leadership-level individuals. Necessary actions include requesting assistance or information about the vulnerability, as well as publishing a notification either internally and/or externally. Typically, internal groups would meet to determine the overall response and then execute agreed upon actions. CISA recommends remediating Act vulnerabilities as soon as possible.&quot;@en</td></tr></table> > ] 
# Nec6948e0c2e04dad888d3c2708fef700 node934
node934 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nec6948e0c2e04dad888d3c2708fef700</B></td></tr><tr><td href='Nec6948e0c2e04dad888d3c2708fef700' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nec6948e0c2e04dad888d3c2708fef700</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is performedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/performedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
