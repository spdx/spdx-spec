# N2a3f8ccff72641a89a293795d4612120 node1503
node1503 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N2a3f8ccff72641a89a293795d4612120</B></td></tr><tr><td href='N2a3f8ccff72641a89a293795d4612120' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N2a3f8ccff72641a89a293795d4612120</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasUninstall, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasUninstall&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Artifact&gt; }
}&quot;</td></tr></table> > ] 
# N61fac3c7295943b2b1b13e882c86a00a node1504
node1504 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N61fac3c7295943b2b1b13e882c86a00a</B></td></tr><tr><td href='N61fac3c7295943b2b1b13e882c86a00a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N61fac3c7295943b2b1b13e882c86a00a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;A value for Core/name is required when a value for Core/version is present&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Software/version&gt; ?version .
    FILTER NOT EXISTS {
        $this &lt;Software/name&gt; ?name .
    }
}&quot;</td></tr></table> > ] 
