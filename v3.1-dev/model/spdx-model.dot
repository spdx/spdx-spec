# N5a2e7436e2e7426aa07aad9d9c61dd4e node567
node567 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N5a2e7436e2e7426aa07aad9d9c61dd4e</B></td></tr><tr><td href='N5a2e7436e2e7426aa07aad9d9c61dd4e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N5a2e7436e2e7426aa07aad9d9c61dd4e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship id dependsOn, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/dependsOn&gt; .
