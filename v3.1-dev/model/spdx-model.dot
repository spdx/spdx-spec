# N9f02e504fa2d4e08a0a8258e542a2ea7 node1137
node1137 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N9f02e504fa2d4e08a0a8258e542a2ea7</B></td></tr><tr><td href='N9f02e504fa2d4e08a0a8258e542a2ea7' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N9f02e504fa2d4e08a0a8258e542a2ea7</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasOptionalDependency, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasOptionalDependency&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
# N7b9dec36e56346faa4ec6af6729d490a node1138
node1138 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N7b9dec36e56346faa4ec6af6729d490a</B></td></tr><tr><td href='N7b9dec36e56346faa4ec6af6729d490a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N7b9dec36e56346faa4ec6af6729d490a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasInput, from must be a Build, DefinedProcess, or Action&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasInput&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Build/Build&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/DefinedProcess&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
}&quot;</td></tr></table> > ] 
