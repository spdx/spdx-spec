node173 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne51106acb8f94292a7a9e478b6e147cc</B></td></tr><tr><td href='Ne51106acb8f94292a7a9e478b6e147cc' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne51106acb8f94292a7a9e478b6e147cc</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
