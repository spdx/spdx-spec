# N1158e8e65e2e45c893775c1f51b6c0e4 node1189
node1189 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N1158e8e65e2e45c893775c1f51b6c0e4</B></td></tr><tr><td href='N1158e8e65e2e45c893775c1f51b6c0e4' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N1158e8e65e2e45c893775c1f51b6c0e4</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is coordinatedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
