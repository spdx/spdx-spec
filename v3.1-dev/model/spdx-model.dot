node503 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb344eabd04a742a69c6accdb3e4d5ffe</B></td></tr><tr><td href='Nb344eabd04a742a69c6accdb3e4d5ffe' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb344eabd04a742a69c6accdb3e4d5ffe</font></td></tr><tr><td align='left'>sh:pattern</td><td align='left'>&quot;^[A-Z]{3}$&quot;</td></tr></table> > ] 
