# N5136375f212c4b9e8642cb4bf1f214b2 node202
node202 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N5136375f212c4b9e8642cb4bf1f214b2</B></td></tr><tr><td href='N5136375f212c4b9e8642cb4bf1f214b2' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N5136375f212c4b9e8642cb4bf1f214b2</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is verifiedBy, to must be a RequirementVerification&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/verifiedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;FunctionalSafety/RequirementVerification&gt; }
}&quot;</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/RelationshipType/follows node203
node203 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>follows</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipType/follows' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipType/follows</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The `to` Element succeeds the `from` Element, establishing a unidirectional sequence. This succession is defined as chronological, procedural, or logical. It is used to represent either a temporal order (e.g., in a workflow) or a logical order for processing and traversal (e.g., in an ordered list).&quot;@en</td></tr></table> > ] 
# N3cbc36ccad5d4b87a475c6732917b314 node204
node204 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N3cbc36ccad5d4b87a475c6732917b314</B></td></tr><tr><td href='N3cbc36ccad5d4b87a475c6732917b314' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N3cbc36ccad5d4b87a475c6732917b314</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasContactPoint, class must be ContactPointRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
