# N7b0c759ae8f84d13b6de239cf40efea9 node1145
node1145 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N7b0c759ae8f84d13b6de239cf40efea9</B></td></tr><tr><td href='N7b0c759ae8f84d13b6de239cf40efea9' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N7b0c759ae8f84d13b6de239cf40efea9</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is serializedInArtifact, from must be a SpdxDocument&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
