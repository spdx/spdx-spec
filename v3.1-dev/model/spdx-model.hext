["https://spdx.org/rdf/3.1/terms/Core/processVersion", "http://www.w3.org/2000/01/rdf-schema#comment", "Defines the version of a specific process.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
