["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/bic", "http://www.w3.org/2000/01/rdf-schema#comment", "Business Identifier Code (BIC), also known as SWIFT-BIC or SWIFT code, is a unique 8 or 11-character alphanumeric code standardized by [ISO 9362](https://www.iso.org/standard/84108.html) to identify financial and non-financial institutions (e.g., `BBWCUS33`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N8067e5251ecd41d6af4de21406c3381b", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:N32bcac824a0f434b8bc45acfdc74efe7", "localId", "", ""]
