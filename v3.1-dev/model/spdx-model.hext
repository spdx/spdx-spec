["https://spdx.org/rdf/3.1/terms/Hardware/hazard", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#ObjectProperty", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Security/SsvcDecisionType/act", "http://www.w3.org/2000/01/rdf-schema#comment", "The vulnerability requires attention from the organization's internal, supervisory-level and leadership-level individuals. Necessary actions include requesting assistance or information about the vulnerability, as well as publishing a notification either internally and/or externally. Typically, internal groups would meet to determine the overall response and then execute agreed upon actions. CISA recommends remediating Act vulnerabilities as soon as possible.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/FunctionalSafety/evidenceUID", "http://www.w3.org/2000/01/rdf-schema#comment", "A evidenceUID is a unique identifier assigned to an entity, item,\nor requirement.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/eolNotice", "http://www.w3.org/2000/01/rdf-schema#label", "eolNotice", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/identifierLocator", "http://www.w3.org/2000/01/rdf-schema#comment", "Provides the location for more information regarding an external identifier.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/originatedBy", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#ObjectProperty", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType/inspection", "http://www.w3.org/2000/01/rdf-schema#comment", "A thorough examination or checking of documentation, records, processes, or systems to confirm compliance or adherence. An inspection needs to have a defined set of acceptance criteria (e.g. a checklist), a documentation of roles involved in the inspection (e.g. to document the inspector's independence) and a clear documentation of when and how it was performed.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/SupplyChain/InspectionProcess", "http://www.w3.org/ns/shacl#nodeKind", "http://www.w3.org/ns/shacl#IRI", "globalId", "", ""]
