["https://spdx.org/rdf/3.1/terms/Operations/assessmentTime", "http://www.w3.org/2000/01/rdf-schema#comment", "Timestamp, when an assessment was conducted.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
