["https://spdx.org/rdf/3/terms/Core/streetAddress", "http://www.w3.org/2000/01/rdf-schema#comment", "Street address includes a street number, name and unit ID to identify a specific street.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Security/CvssSeverityType/medium", "http://www.w3.org/2000/01/rdf-schema#comment", "When a CVSS score is between 4.0 - 6.9.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Security/SsvcDecisionType/trackStar", "http://www.w3.org/2000/01/rdf-schema#comment", "(\"Track\\*\" in the SSVC spec) The vulnerability contains specific characteristics that may require closer monitoring for changes. CISA recommends remediating Track\\* vulnerabilities within standard update timelines.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
