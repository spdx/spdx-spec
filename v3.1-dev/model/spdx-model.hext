["https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel/autonomous", "http://www.w3.org/2000/01/rdf-schema#comment", "Level 6 - Autonomous. The system is capable of modifying its intended domain of use or its goals without external intervention, control or oversight.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nfb8b89b5d15648ac948b61ef087ae482", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "http://www.w3.org/1999/02/22-rdf-syntax-ns#nil", "globalId", "", ""]
