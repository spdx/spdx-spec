["https://spdx.org/rdf/3/terms/Hardware/VirtualHardwareModelType", "http://www.w3.org/2000/01/rdf-schema#comment", "Specifies the type of simulation model used to represent virtual hardware.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/runsOn", "http://www.w3.org/2000/01/rdf-schema#comment", "The `from` Element (the instructions) runs on each `to` /Hardware/Hardware (processing element), during a LifecycleScopeType period.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Ndedb5870733b420194ed6ab890abd431", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType/other", "globalId", "", ""]
