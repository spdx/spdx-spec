["https://spdx.org/rdf/3.1/terms/Security/VexJustificationType/vulnerableCodeNotInExecutePath", "http://www.w3.org/2000/01/rdf-schema#comment", "The affected code is not reachable through the execution of the code, including non-anticipated states of the product.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
