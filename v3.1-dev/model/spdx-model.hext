["https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/support", "http://www.w3.org/2000/01/rdf-schema#comment", "A reference to the software support channel or other support information for a package.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
