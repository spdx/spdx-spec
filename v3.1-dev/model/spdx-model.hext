["https://spdx.org/rdf/3/terms/Dataset/DatasetType/graph", "http://www.w3.org/2000/01/rdf-schema#comment", "Data is in the form of a graph where entries are somehow related to each other through edges, such as a social network of friends.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RequirementStatusType/backlog", "http://www.w3.org/2000/01/rdf-schema#comment", "A requirement has been captured and logged, but not yet ready to become a formal requirement draft. A backlog requirement may still be incomplete or ambiguous.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
