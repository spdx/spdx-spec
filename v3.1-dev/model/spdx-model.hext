["https://spdx.org/rdf/3.1/terms/Core/builtTime", "http://www.w3.org/2000/01/rdf-schema#comment", "Specifies the time an artifact was built.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/ExpandedLicensing/licenseXml", "http://www.w3.org/2000/01/rdf-schema#comment", "Identifies all the text and metadata associated with a license in the license\nXML format.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType/inspection", "http://www.w3.org/2000/01/rdf-schema#comment", "A thorough examination or checking of documentation, records, processes, or systems to confirm compliance or adherence. An inspection needs to have a defined set of acceptance criteria (e.g. a checklist), a documentation of roles involved in the inspection (e.g. to document the inspector's independence) and a clear documentation of when and how it was performed.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/RelationshipType/contains", "http://www.w3.org/2000/01/rdf-schema#comment", "The `from` Element contains each `to` Element.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel/assistiveAutomation", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasInput", "http://www.w3.org/2000/01/rdf-schema#label", "hasInput", "http://www.w3.org/2001/XMLSchema#string", "", ""]
