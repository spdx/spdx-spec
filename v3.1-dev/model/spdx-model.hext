["_:Ne03f9ef7cc6a48d4862eae4951237b08", "http://www.w3.org/ns/shacl#pattern", "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T(([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]|23:59:60)Z$", "http://www.w3.org/2001/XMLSchema#string", "", ""]
