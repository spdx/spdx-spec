["_:N39f7657017f04a5b8dcb733d86af5c0b", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/providesSupportFor> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Agent> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/TransportProcess", "http://www.w3.org/ns/shacl#property", "_:N1b2cc9933f704c5b8c62e1ec2246bb04", "localId", "", ""]
