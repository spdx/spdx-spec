["https://spdx.org/rdf/3/terms/Core/RelationshipType/expandsTo", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Core/RelationshipType", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isni", "http://www.w3.org/2000/01/rdf-schema#comment", "[International Standard Name Identifier (ISNI)](https://isni.org/page/what-is-isni/) is a unique identifier used to distinguish the public identities of parties involved in the creation, production, and distribution of media content. Standardized by [ISO 27729](https://www.iso.org/standard/87177.html), it consists of 16 characters\u201415 digits plus a final check character\u2014and is often represented as a URI, such as `https://isni.org/isni/000000012146438X`.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N765e3eee56c744e9889a654871892d74", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:N7ac22554542749418bd94e9363212d65", "localId", "", ""]
["_:Nd6726685b291498f96d3457c671763ed", "http://www.w3.org/ns/shacl#class", "https://spdx.org/rdf/3/terms/Core/ExternalRef", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/review", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ismn", "http://www.w3.org/2000/01/rdf-schema#comment", "[International Standard Music Number (ISMN)](https://ismn-international.org/ismn/the-ismn/) is a unique numeric identifier for printed music (notated music) standardized by [ISO 10957](https://www.iso.org/standard/83122.html). It consists of either 10 characters (starting with the letter \"M\" for assignments prior to January 1, 2008) or 13 digits. A 13-digit ISMN is composed of four parts: the GS1 prefix `979-0`, a registrant element, an item element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., `9790006538424`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
