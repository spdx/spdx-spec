["_:N54e203f13b4847309e49e57b8df9b7b2", "http://www.w3.org/ns/shacl#message", "https://spdx.org/rdf/3.1/terms/Software/SoftwareArtifact is an abstract class and should not be instantiated directly. Instantiate a subclass instead.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/SupplyChain/TransportAction", "http://www.w3.org/2000/01/rdf-schema#comment", "An actual change to a product's location.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N5141415399f9485182997391ee127367", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3.1/terms/Core/SupportType/noSupport", "globalId", "", ""]
