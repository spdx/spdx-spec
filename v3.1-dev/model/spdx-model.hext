["_:N18f7a0945d1543cfb0e4435aa8ca8143", "http://www.w3.org/ns/shacl#pattern", "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T(([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]|23:59:60)Z$", "http://www.w3.org/2001/XMLSchema#string", "", ""]
