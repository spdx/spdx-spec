["https://spdx.org/rdf/3/terms/Dataset/DatasetType/categorical", "http://www.w3.org/2000/01/rdf-schema#comment", "Data that is classified into a discrete number of categories, such as the eye color of a population of people.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/postOfficeBoxNumber", "http://www.w3.org/2000/01/rdf-schema#comment", "The number that identifies a PO box. A PO box is a box in a post office or other postal service location assigned to an organization where postal items may be kept.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
