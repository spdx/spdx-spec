["https://spdx.org/rdf/3.1/terms/Core/Bom", "http://www.w3.org/2000/01/rdf-schema#comment", "A container for a grouping of SPDX 3 content characterizing details\n(provenance, composition, licensing, etc.) about a product.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/Specification", "http://www.w3.org/2000/01/rdf-schema#comment", "A specification is a detailed description of the design, requirements,\nor features of a product, process, or system.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/RelationshipType/pretrainedOn", "http://www.w3.org/2000/01/rdf-schema#comment", "The `from` Element has been pretrained on the `to` Element(s).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
