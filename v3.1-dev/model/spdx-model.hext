["https://spdx.org/rdf/3.1/terms/SupplyChain/dropoffLocation", "http://www.w3.org/2000/01/rdf-schema#comment", "The location for dropping off or delivering a package or item.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Security/justificationType", "http://www.w3.org/2000/01/rdf-schema#comment", "Impact justification label to be used when linking a vulnerability to an element\nrepresenting a VEX product with a VexNotAffectedVulnAssessmentRelationship\nrelationship.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
