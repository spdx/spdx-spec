["https://spdx.org/rdf/3/terms/Core/RelationshipType/hasContactPoint", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Core/RelationshipType", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/LifecycleScopeType/decommission", "http://www.w3.org/2000/01/rdf-schema#comment", "A relationship has specific context implications for a product's retirement and/or decommissioning.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/modifiedBy", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Core/RelationshipType", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iban", "http://www.w3.org/2000/01/rdf-schema#comment", "International Bank Account Number (IBAN) is a system for identifying bank accounts across national borders standardized by [ISO 13616](https://www.iso.org/standard/81090.html). It consists of up to 34 alphanumeric characters, including a country code, two check digits, and a basic bank account number. While spaces may be inserted for human readability, they must be omitted when used for electronic data exchange (e.g., `IE64IRCE92050112345678`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ProfileIdentifierType/functionalSafety", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
