["https://spdx.org/rdf/3/terms/Core/ExternalRefType/sourceArtifact", "http://www.w3.org/2000/01/rdf-schema#comment", "A reference to an artifact containing the sources for a package.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
