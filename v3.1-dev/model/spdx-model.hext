["https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType/video", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3.0.1/terms/Dataset/DatasetType", "globalId", "", ""]
