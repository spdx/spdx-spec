["_:N0ed535f16f284ea2bf893ed0ccd8ba54", "http://www.w3.org/ns/shacl#class", "https://spdx.org/rdf/3/terms/Security/VexUnderInvestigationVulnAssessmentRelationship", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Security/SsvcDecisionType/act", "http://www.w3.org/2000/01/rdf-schema#comment", "The vulnerability requires attention from the organization's internal, supervisory-level and leadership-level individuals. Necessary actions include requesting assistance or information about the vulnerability, as well as publishing a notification either internally and/or externally. Typically, internal groups would meet to determine the overall response and then execute agreed upon actions. CISA recommends remediating Act vulnerabilities as soon as possible.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N581fad659d4d4faa80807859b5dba7d5", "http://www.w3.org/ns/shacl#minCount", "1", "http://www.w3.org/2001/XMLSchema#integer", "", ""]
["https://spdx.org/rdf/3/terms/Software/copyrightText", "http://www.w3.org/2000/01/rdf-schema#comment", "Identifies the text of one or more copyright notices for a software Package,\nFile or Snippet, if any.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N1885937a03fe4e11af66367a317b7243", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/hasDynamicLink> .\n    FILTER NOT EXISTS { $this rdf:type <Core/LifecycleScopedRelationship> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3/terms/Dataset/datasetSize", "http://www.w3.org/2000/01/rdf-schema#comment", "**DEPRECATED in SPDX 3.1.**\nUse [/Software/byteSize](../../Software/Properties/byteSize.md)\ninstead.\n\nSize of the dataset.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SimpleLicensing/SimpleLicensingText", "http://www.w3.org/2000/01/rdf-schema#comment", "A license or a license addition that is not listed on the SPDX License List.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
