["https://spdx.org/rdf/3/terms/Core/RelationshipCompleteness/complete", "http://www.w3.org/2000/01/rdf-schema#comment", "The relationship is known to be exhaustive.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
