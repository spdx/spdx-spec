["_:N7e08f0efbb13489e9889ee1f97fb244f", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "_:Nd6112e4995a3421a80753c8a3f4a1426", "localId", "", ""]
["_:N2ec91b3b496f40978a76ce17b312e4ab", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/affects> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Action> }\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/DefinedProcess> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["_:N7aa48b481b854efa99d7ee504ab2fd55", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:N175285910d9b4e3eb4c5e7d889572fb3", "localId", "", ""]
