["_:N4825fca341824626b75845acfdc04ed6", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3.1/terms/Core/ContactPointRelationshipType/securityVulnerability", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ibid", "http://www.w3.org/2000/01/rdf-schema#comment", "[International Business Identifier (IBID)](https://ekys.org/business_identifiers/) is a verifiable unique identifier for legal entities as defined in the [ISO/DIS 25500-3](https://www.iso.org/standard/87705.html) draft standard. It is composed of three data elements: the International Business Registration Number (IBRN), the legal name, and the date of origin formatted as eight numeric characters (YYYYMMDD). Each element is separated by a pipe character (`|`) (e.g., `US-DE.BER:3031657|Code Management Association|19990420`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N3a115a1d298f4884a67a32bb977c0a06", "http://www.w3.org/ns/shacl#nodeKind", "http://www.w3.org/ns/shacl#Literal", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/falcon", "http://www.w3.org/2000/01/rdf-schema#label", "falcon", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["_:Nd0b1b2846ace436490b8ef2d02c6056b", "http://www.w3.org/ns/shacl#maxCount", "1", "http://www.w3.org/2001/XMLSchema#integer", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ismn", "http://www.w3.org/2000/01/rdf-schema#comment", "[International Standard Music Number (ISMN)](https://ismn-international.org/ismn/the-ismn/) is a unique numeric identifier for printed music (notated music) standardized by [ISO 10957](https://www.iso.org/standard/83122.html). It consists of either 10 characters (starting with the letter \"M\" for assignments prior to January 1, 2008) or 13 digits. A 13-digit ISMN is composed of four parts: the GS1 prefix `979-0`, a registrant element, an item element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., `9790006538424`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/SupplyChain/ReproduceAction", "http://www.w3.org/2000/01/rdf-schema#comment", "Reproduction is the biological process by which organisms generate new individuals of the same species.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
