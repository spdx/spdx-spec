["https://spdx.org/rdf/3.1/terms/ExpandedLicensing/ListedLicense", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#Class", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvidenceType/recording", "http://www.w3.org/2000/01/rdf-schema#comment", "Captured datastream like audio, video, or any other kind of continuous electronic capture of events, behavior or conditions.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
