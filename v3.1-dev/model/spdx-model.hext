["https://spdx.org/rdf/3.1/terms/Core/created", "http://www.w3.org/2000/01/rdf-schema#comment", "Identifies when the Element was originally created.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
