["https://spdx.org/rdf/3/terms/Core/RelationshipType/availableFrom", "http://www.w3.org/2000/01/rdf-schema#comment", "The `from` Element is available from the additional supplier described by each `to` Element.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N6e7d2149a2174644b8ad8da52b7bfb46", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Software/version> ?version .\n    FILTER NOT EXISTS {\n        $this <Software/name> ?name .\n    }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
