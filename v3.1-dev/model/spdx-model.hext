["https://spdx.org/rdf/3.1/terms/Core/intendedUse", "http://www.w3.org/2000/01/rdf-schema#comment", "The intendedUse property is designed to capture a summary of how or for what item or artifact is meant to be used for.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/md6", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
