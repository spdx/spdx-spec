["https://spdx.org/rdf/3.1/terms/Core/externalSpdxId", "http://www.w3.org/2000/01/rdf-schema#comment", "Identifies an external Element used within an SpdxDocument but defined\nexternal to that SpdxDocument.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
