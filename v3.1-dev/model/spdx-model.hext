["https://spdx.org/rdf/3/terms/Core/ExternalRefType/securityPenTestReport", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Core/ExternalRefType", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/follows", "http://www.w3.org/2000/01/rdf-schema#comment", "The `to` Element succeeds the `from` Element, establishing a unidirectional sequence. This succession is defined as chronological, procedural, or logical. It is used to represent either a temporal order (e.g., in a workflow) or a logical order for processing and traversal (e.g., in an ordered list).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Hardware/yAxisLength", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#ObjectProperty", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Dataset/DatasetType/categorical", "http://www.w3.org/2000/01/rdf-schema#comment", "Data that is classified into a discrete number of categories, such as the eye color of a population of people.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nc4a4f181ceab44df9318f0aa47d1e7ba", "http://www.w3.org/ns/shacl#nodeKind", "http://www.w3.org/ns/shacl#IRI", "globalId", "", ""]
