["https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType/directDownload", "http://www.w3.org/2000/01/rdf-schema#comment", "Dataset is publicly available and can be downloaded directly.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Dataset/DatasetType/audio", "http://www.w3.org/2000/01/rdf-schema#label", "audio", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/platform", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/SupportType/deployed", "http://www.w3.org/2000/01/rdf-schema#comment", "In addition to being supported by the supplier, the software is known to have been deployed and is in use. For a software as a service provider, this implies the software is now available as a service.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/ExpandedLicensing/ListedLicense", "http://www.w3.org/2000/01/rdf-schema#comment", "A license that is listed on the SPDX License List.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
