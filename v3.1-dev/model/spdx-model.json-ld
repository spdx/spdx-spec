        "@language": "en",
        "@value": "Provides information about the creation of the Element."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/CreationInfo"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/description",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Provides a detailed description of the Element."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
