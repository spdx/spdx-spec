  {
    "@id": "https://spdx.org/rdf/3/terms/FunctionalSafety/Assumption",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A distinct unit representing a constraint associated with an item's use in a system."
      }
    ],
