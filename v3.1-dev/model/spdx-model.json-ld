  {
    "@id": "https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType/demonstration",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Demonstrating and monitoring or recording that the item under verification to confirm that a requirement is met by the item under verification."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "demonstration"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType/review",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/FunctionalSafety/VerificationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A examination or checking of documentation, records, processes, or systems to confirm compliance or adherence with an upper level requirement. Typically done as peer review, offline review or review meeting."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "review"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/FunctionalSafety/verificationPrecondition",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Verification preconditions are initial criteria that are to be met prior to initiating the verification method."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
