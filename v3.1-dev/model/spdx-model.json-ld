      {
        "@language": "en",
        "@value": "The Boundary Definition Process refers to the process class used to produce boundaries."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/DefinedProcess"
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Dataset/ConfidentialityLevelType/clear",
