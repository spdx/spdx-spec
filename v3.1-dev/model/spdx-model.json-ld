  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasAssessmentFor",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Core/RelationshipType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a `from` Vulnerability and each `to` Element with a security assessment. To be used with `VulnAssessmentRelationship` types."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
