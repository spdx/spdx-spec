      {
        "@language": "en",
        "@value": "Documentation of direct monitoring or witnessing of the demonstration of processes, tests, or any kind of system responses during a specified timeframe under specified environmental conditions."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
