        "@language": "en",
        "@value": "The Element is an Artifact that can be run on a computer."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "executable"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/vatNumber",
