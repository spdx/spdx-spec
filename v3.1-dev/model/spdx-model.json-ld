    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Any other safety integrity level not covered above."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "other"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/SupportType/deployed",
    "@type": [
