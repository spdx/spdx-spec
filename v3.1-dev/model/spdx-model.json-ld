    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The measure of mass refers to the quantity of matter in an object or substance."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
