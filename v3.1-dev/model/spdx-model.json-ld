        "@value": "References an Element on the right-hand side of a relationship."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/Element"
      }
    ]
  },
