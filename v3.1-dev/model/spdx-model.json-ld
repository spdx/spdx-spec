        "@value": "A distinct unit representing a requirement, as used in systems, software, and hardware engineering."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/Element"
      }
