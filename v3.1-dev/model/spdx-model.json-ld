    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The unique identifier used by a verification management system or any other lifecycle management tool to uniquely identify a verification item."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "verificationUID"
      }
    ]
  },
