      {
        "@language": "en",
        "@value": "The `from` Element assumes each `to` /FunctionalSafety/Assumption."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "assumes"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalRefType/cwe",
