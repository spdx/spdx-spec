        "@value": "recording"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/SupplyChain/previous",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "This is the individual, business, or organization who was previously managing goods, services, or assets."
