        "@value": "An entity providing an assessment."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/Agent"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Software/packageVersion",
