        "@value": "Copyright (C) 2026 SPDX Project"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/ExpandedLicensing/NoAssertionLicense",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/ExpandedLicensing/IndividualLicensingInfo"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An Individual Value for License when no assertion can be made about its actual\nvalue."
      }
    ],
    "http://www.w3.org/2002/07/owl#sameAs": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Licensing/NoAssertion"
      }
    ],
    "https://spdx.org/rdf/3/terms/Core/creationInfo": [
      {
        "@id": "https://spdx.org/rdf/3.1/creationInfo_NoAssertionLicense"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isni",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "[International Standard Name Identifier (ISNI)](https://isni.org/page/what-is-isni/) is a unique identifier used to distinguish the public identities of parties involved in the creation, production, and distribution of media content. Standardized by [ISO 27729](https://www.iso.org/standard/87177.html), it consists of 16 characters—15 digits plus a final check character—and is often represented as a URI, such as `https://isni.org/isni/000000012146438X`."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "isni"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Hardware/VirtualHardwareModelType/cycle",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Hardware/VirtualHardwareModelType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Simulation architectures with precise cycle-level accuracy."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "cycle"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel/conditionalAutomation",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Level 3 - Conditional automation. The system can propose strategies and then automatically execute the approved plan, with an external agent being ready to take over when necessary."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "conditionalAutomation"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/assignedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "assignedBy identifies the agent that grants or assigns the role to the target element."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/Agent"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Security/CvssSeverityType",
