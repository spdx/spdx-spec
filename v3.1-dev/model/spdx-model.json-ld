    "@id": "_:N54def692faa14718adbd109322176623",
    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/Role"
      }
    ],
    "http://www.w3.org/ns/shacl#minCount": [
