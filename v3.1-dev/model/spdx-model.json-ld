        "@value": "A LicenseAddition participating in a 'with addition' model."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/ExpandedLicensing/LicenseAddition"
