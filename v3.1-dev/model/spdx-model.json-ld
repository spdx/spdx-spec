        "@language": "en",
        "@value": "An Individual Value for License when no assertion can be made about its actual\nvalue."
      }
    ],
    "http://www.w3.org/2002/07/owl#sameAs": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Licensing/NoAssertion"
      }
    ],
    "https://spdx.org/rdf/3/terms/Core/creationInfo": [
      {
        "@id": "https://spdx.org/rdf/3.1/creationInfo_NoAssertionLicense"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/RelationshipType/hasMetadata",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/RelationshipType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Every `to` Element is metadata about the `from` Element (`from` hasMetadata `to`)."
      }
    ],
