    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "device"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/SupplyChain/TransportAction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
