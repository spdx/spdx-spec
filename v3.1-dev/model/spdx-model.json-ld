  {
    "@id": "https://spdx.org/rdf/3/terms/SimpleLicensing/customIdToUri",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "**DEPRECATED in SPDX 3.1.**\nUse [customIdToLicense](./customIdToLicense.md) instead.\n\nMaps a \"LicenseRef-\" string for a custom license or a \"AdditionRef-\" string for\na custom license addition to its URI identifier.\n\n**NOTE:**\nThis property is deprecated and only included for backward compatibility.\nNew documents should use [customIdToLicense](./customIdToLicense.md) instead."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/DictionaryEntry"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/RelationshipType/hasResolution",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
