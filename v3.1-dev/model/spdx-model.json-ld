    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Specifies the CVSS base, temporal, threat, or environmental severity type."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Hardware/VirtualHardwareModelType",
