      {
        "@language": "en",
        "@value": "**DEPRECATED in SPDX 3.1.**\nUse [/Core/endTime](../../Core/Properties/endTime.md) instead.\n\nProperty that describes the time at which a build stops."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTimeStamp"
