    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The `from` /Build/Build, DefinedProcess or Action element has each `to` Element as an input."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "hasInput"
      }
    ]
  },
