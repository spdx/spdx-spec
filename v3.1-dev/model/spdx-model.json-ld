        "@language": "en",
        "@value": "The `from` Element (the instructions) of runs on each `to` Hardware (processing element), during a LifecycleScopeType period."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "runsOn"
      }
    ]
  },
