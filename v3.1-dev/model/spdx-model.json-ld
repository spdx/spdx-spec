  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/bic",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Business Identifier Code (BIC), also known as SWIFT-BIC or SWIFT code, is a unique 8 or 11-character alphanumeric code standardized by [ISO 9362](https://www.iso.org/standard/84108.html) to identify financial and non-financial institutions (e.g., `BBWCUS33`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "bic"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/PresenceType/noAssertion",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/PresenceType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Makes no assertion about the field."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "noAssertion"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isan",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "[International Standard Audiovisual Number (ISAN)](https://www.isan.org/about/#what_is_isan) is a unique 24-digit hexadecimal identifier for audiovisual works standardized by [ISO 15706](https://www.iso.org/standard/83124.html). The ISAN remains persistent for a work regardless of its distribution format or its use. To facilitate human readability, the \"ISAN\" label, grouping hyphens, and two check characters are included (e.g., `ISAN 0000-0000-3A8D-0000-Z-0000-0000-6`); however, these elements shall be omitted when the identifier is stored electronically (e.g., `000000003A8D000000000000`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "isan"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/securityOther",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Used when there is a security related identifier of unspecified type."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "securityOther"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/assessment",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType"
