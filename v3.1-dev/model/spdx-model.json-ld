    "@id": "https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/ai",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The element follows the AI profile specification."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ai"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/externalRefType",
