      {
        "@language": "en",
        "@value": "The `from` SpdxDocument can be found in a serialized form in each `to` Artifact."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "serializedInArtifact"
      }
    ]
  },
