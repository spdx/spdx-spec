    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Every `from` Action, or Relationship of type hasInstall or hasUninstall, is performed by `to` Agent."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "performedBy"
      }
    ]
  },
