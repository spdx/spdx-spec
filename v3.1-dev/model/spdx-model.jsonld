    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/ExternalRef"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/streetAddress",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Street address includes a street number, name and unit ID to identify a specific street."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
