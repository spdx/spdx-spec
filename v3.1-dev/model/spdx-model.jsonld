        "@value": "A statement of how, or for what purpose, an item or artifact is intended\nto be used."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
