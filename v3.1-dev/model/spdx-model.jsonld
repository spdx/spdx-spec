      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "certificationReport"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Build/buildType",
    "@type": [
