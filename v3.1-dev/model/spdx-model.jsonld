      {
        "@language": "en",
        "@value": "A reference to a certification report for a package from an accredited/independent body."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "certificationReport"
      }
    ]
  },
