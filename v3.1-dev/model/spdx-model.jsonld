      {
        "@value": "assistiveAutomation"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Security/VexJustificationType/inlineMitigationsAlreadyExist",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Security/VexJustificationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Built-in inline controls or mitigations prevent an adversary from leveraging the vulnerability."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "inlineMitigationsAlreadyExist"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Hardware/partNumber",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Product Part Number as defined by OEM."
      }
    ],
