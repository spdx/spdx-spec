        "@value": "verificationMethod refers to the specific approach used for a checking an element's conformance with its requirements."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType"
      }
    ]
  },
