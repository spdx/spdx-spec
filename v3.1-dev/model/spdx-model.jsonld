      {
        "@language": "en",
        "@value": "Certificate Revocation List, or CRL, is a list of revoked certificates as defined in [RFC 5280]](https://datatracker.ietf.org/doc/rfc5280/) that is downloaded from the Certificate Authority (CA)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
