      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/MeasureOfMass"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasProvidedDependency",
