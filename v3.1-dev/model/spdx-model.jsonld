      {
        "@language": "en",
        "@value": "The Agent who is responsible for product branding such as an OEM."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/Agent"
