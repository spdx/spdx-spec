      {
        "@id": "https://spdx.org/rdf/3.1/terms/FunctionalSafety/RequirementVerification"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/buildMeta",
