  {
    "@id": "https://spdx.org/rdf/3/terms/Hardware/serialNumber",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Identifier for specific product is called a serial number."
      }
    ],
