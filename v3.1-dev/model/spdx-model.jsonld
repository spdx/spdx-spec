  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasMetadata",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Core/RelationshipType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Every `to` Element is metadata about the `from` Element (`from` hasMetadata `to`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "hasMetadata"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/firmware",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The Element provides low level control over a device's hardware."
      }
    ],
