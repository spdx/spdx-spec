        "@value": "Describes one a profile which the creator of this ElementCollection intends to\nconform to."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType"
      }
    ]
  },
