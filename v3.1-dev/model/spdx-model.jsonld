      }
    ],
    "http://purl.org/dc/terms/references": [
      {
        "@id": "https://spdx.dev/specifications/"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "System Package Data Exchange (SPDX) Ontology"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
