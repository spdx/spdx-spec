        "@language": "en",
        "@value": "Capture the scope of information about a specific relationship between elements."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType"
      }
    ]
  },
  {
