      "https://spdx.org/rdf/3/terms/Dataset/ConfidentialityLevelType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "For named recipients only. The dataset is highly confidential and shall be shared only with named recipients."
      }
