      }
    ],
    "http://www.w3.org/ns/shacl#pattern": [
      {
        "@value": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T(([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]|23:59:60)Z$"
      }
    ]
  },
  {
    "@id": "_:N78ef76512c8b4ec9813a9f2e575230be",
    "http://www.w3.org/ns/shacl#datatype": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#dateTimeStamp"
      }
    ],
