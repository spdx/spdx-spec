    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Data is in the form of a graph where entries are somehow related to each other through edges, such as a social network of friends."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
