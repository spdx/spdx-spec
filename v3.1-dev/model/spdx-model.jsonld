  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/key",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A key used in a generic key-value pair."
      }
    ],
