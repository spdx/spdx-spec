    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "This property is used to denote the root Element(s) of a tree of elements contained in a BOM."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
