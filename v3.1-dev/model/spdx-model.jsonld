      "https://spdx.org/rdf/3/terms/Core/RelationshipType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The `from` Element has been finetuned on the `to` Element(s)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "finetunedOn"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/actionLocation",
    "@type": [
