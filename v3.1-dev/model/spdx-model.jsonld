  {
    "@id": "https://spdx.org/rdf/3.1/terms/SupplyChain/ReproduceAction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reproduction is the biological process by which organisms generate new individuals of the same species."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
