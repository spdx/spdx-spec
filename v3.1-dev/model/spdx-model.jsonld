    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "the `from` Requirement is refined and further elaborated by each `to` Requirement, which contains more detailed implementation information."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "tracedToDetail"
      }
    ]
  },
