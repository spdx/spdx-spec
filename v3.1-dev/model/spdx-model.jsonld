      {
        "@language": "en",
        "@value": "The intendedUse property is designed to capture a summary of how or for what item or artifact is meant to be used for."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
