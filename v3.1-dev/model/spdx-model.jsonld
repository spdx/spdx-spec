  {
    "@id": "https://spdx.org/rdf/3/terms/Service/KeyValidationProtocolType/ocsp",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Service/KeyValidationProtocolType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Online Certificate Status Protocol, or OCSP, is a common scheme used to maintain the security of a server and other network resources as defined in [RFC 2560](https://datatracker.ietf.org/doc/rfc2560/)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ocsp"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/RelationshipType/hasOptionalComponent",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/RelationshipType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Every `to` Element is an optional component of the `from` Element (`from` hasOptionalComponent `to`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "hasOptionalComponent"
      }
    ]
  },
