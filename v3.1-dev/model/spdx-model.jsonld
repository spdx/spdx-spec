    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Enumeration of dataset types."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/SupplyChain/InstantiateVirtualHardwareProcess",
