    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel/assistiveAutomation",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Level 1 - Assistive automation. The system assists an operator."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "assistiveAutomation"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasDataFile",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Core/RelationshipType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The `from` Element treats each `to` Element as a data file. A data file is an artifact that stores data required or optional for the `from` Element's functionality. A data file can be a database file, an index file, a log file, an AI model file, a calibration data file, a temporary file, a backup file, and more. For AI training dataset, test dataset, test artifact, configuration data, build input data, and build output data, please consider using the more specific relationship types: `trainedOn`, `testedOn`, `hasTest`, `configures`, `hasInput`, and `hasOutput`, respectively. This relationship does not imply dependency."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "hasDataFile"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType/decommission",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A relationship has specific context implications for a product's retirement and/or decommissioning."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "decommission"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/test",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The Element is a test used to verify functionality on a software element."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "test"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/SpecificationType/specification",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Core/SpecificationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A specification is a detailed document (or set of documents) that describes the requirements, design, behavior, or other characteristics of a system, component, or process so that all stakeholders have a clear, unambiguous reference."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
