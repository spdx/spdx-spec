    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "typeFromSource is a value used to define an item within the definitionSource."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
