      {
        "@value": "supplyChain"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/RelationshipType/hasMetadata",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
