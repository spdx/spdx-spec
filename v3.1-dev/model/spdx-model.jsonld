    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Confidentiality level."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/contentType",
    "@type": [
