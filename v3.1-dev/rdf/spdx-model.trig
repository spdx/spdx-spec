        rdfs:subClassOf ns2:UseProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N2fe04af655a345c3950de9c93fe93145 .

    ns2:InstantiateVirtualHardwareProcess a owl:Class ;
        rdfs:comment "Class that describes an InstantiateVirtualHardwareProcess that is used to define VirtualHardware and its source."@en ;
        rdfs:subClassOf ns2:CreateProcess ;
        sh:nodeKind sh:IRI .

    ns2:ManufactureAction a owl:Class ;
        rdfs:comment "ManufactureAction represents the act of creating a product by a manufacturing process."@en ;
        rdfs:subClassOf ns2:CreateAction ;
        sh:nodeKind sh:IRI .

    ns2:ManufactureProcess a owl:Class ;
