    ns6:inputModality a owl:ObjectProperty ;
        rdfs:comment "Fundamental data or sensory type accepted as input by a software artifact or agent."@en ;
        rdfs:range ns1:Modality .

    ns6:lineRange a owl:ObjectProperty ;
        rdfs:comment """Defines the line range in the original host file that the snippet information
