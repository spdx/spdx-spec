        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns5:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns3:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0e70e5a3819248c584a58814274cf1fb,
            _:N0e743573efaa41f0a7b45ad2cd2098cd,
            _:N172beb66bb0648e28d05e107970f253f,
            _:N36352706214c44a1b243f9d07f1f4640,
            _:N46362c6feca1477f863b5e46982a2832,
