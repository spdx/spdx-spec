        sh:property _:N2575cbe2d31c4f269cbb940f1fa82bfa,
            _:N63c971c50f964a269095e3ba9f251f11 .

    ns2:StorageAction a owl:Class ;
        rdfs:comment "Records the storage of a product."@en ;
        rdfs:subClassOf ns2:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns2:StorageProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Prescribes the storage of a product."@en ;
        rdfs:subClassOf ns2:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N8e9407cfd2614c40a84f74c4d722794f .

    ns2:TestAction a owl:Class ;
        rdfs:comment "A test action is a specific action associated with a test."@en ;
        rdfs:subClassOf ns2:UseAction ;
        sh:nodeKind sh:IRI .

    ns2:TestProcess a owl:Class ;
        rdfs:comment "Test Process defines the testing process for an element."@en ;
        rdfs:subClassOf ns2:UseProcess ;
        sh:nodeKind sh:IRI .

