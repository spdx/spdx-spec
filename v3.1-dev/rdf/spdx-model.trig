        rdfs:range ns1:Location .

    ns2:plannedPickupLocation a owl:ObjectProperty ;
        rdfs:comment "A location where a package or an item will be picked up."@en ;
        rdfs:range ns1:Location .

    ns2:plannedPreviousResponsibleAgent a owl:ObjectProperty ;
