        sh:nodeKind sh:IRI ;
        sh:property _:N0514174092ee4b32a248f1840ed2e52a,
            _:N32d86222e63144cca570704f75a6d4aa,
            _:N4f1c91575f8b44e1b52d6901379eaf29,
            _:N6f3641eb2a65464aab096c5324c155b2,
            _:N8bbe393bff774845b1a29cb2bc4b720d,
            _:Na35db6fba7324e95a99ccad3948115df,
            _:Nabef59057f744878893f34196582b461,
            _:Nd43613eacf7c4f84b5d6b9ec966f36a3,
            _:Ndf7d8f25316c4d97868e77031bbb33a4 .

    <https://spdx.org/rdf/3/terms/Core/ProcessReadinessType/active> a owl:NamedIndividual,
            ns1:ProcessReadinessType ;
        rdfs:label "active" ;
        rdfs:comment "In use."@en .

