        sh:nodeKind sh:IRI ;
        sh:property _:Nff00a4ab21ce4ab4b135e0dcdf636cdc .

    ns5:DestroyProcess a owl:Class ;
        rdfs:comment "The destruction process is defined in this process."@en ;
