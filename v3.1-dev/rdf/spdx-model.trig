        rdfs:subClassOf ns3:UseProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0d403b1577ac4c93a1ed846e1d69f4d9 .

    ns3:InstantiateVirtualHardwareProcess a owl:Class ;
