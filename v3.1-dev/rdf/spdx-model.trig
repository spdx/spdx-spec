    ns4:OutOfSpecAction a owl:Class ;
        rdfs:comment "An out of specification action is defined in this class."@en ;
        rdfs:subClassOf ns4:UseAction ;
        sh:nodeKind sh:IRI .

    ns4:PlanAction a owl:Class ;
