    spdx: a owl:Ontology ;
        rdfs:label "System Package Data Exchange™ (SPDX®) Ontology"@en ;
        dcterms:abstract "This ontology defines the terms and relationships used in the SPDX specification to describe system packages"@en ;
        dcterms:created "2026-01-23"^^xsd:date ;
        dcterms:creator "SPDX Project"@en ;
        dcterms:license <https://spdx.org/licenses/Community-Spec-1.0.html> ;
        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns5:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns2:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N05f4f03e00d049d3a933ff0765f0b5e5,
            _:N12c143dcb70d4c029fe091f42e5b9760,
            _:N28d17fbc7d8c4d7bbd2c1aeb8e4f9627,
            _:N2e83192c83984b07b14496165c589909,
            _:N3d8b4b26ac94402c9a059e1e488a9d6b,
            _:N3e36d378bf284de4a3061a02d32e9946,
            _:N45e9ddfc9f574a55b1850c01e7fce945,
            _:N64fd1520f3c64dfb9cd939d3d9b2d9b9,
            _:N7b26369266664dac8c3d19f032beeb40,
            _:N7cf83922229e4a4587fd06617d6738b4,
            _:N8954a1b1a0494cf8bad34a14afd1ba89,
            _:N9034c6d9b1df405b89a90e56f43fd95f,
            _:Nac5bd24f430e4a4a810a40708829d652,
            _:Nafb904aaa75542bd996a1ae98f60259d,
            _:Nb5f893eb9c7e402290beb32cc4a84217,
