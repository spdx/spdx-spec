        sh:nodeKind sh:IRI ;
        sh:property _:N5008e2bdda9e466da58f2bf74ffee093,
            _:N9400c78931ac447dad812f897527456e .

    ns3:StorageAction a owl:Class ;
        rdfs:comment "Records the storage of a product."@en ;
        rdfs:subClassOf ns3:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns3:StorageProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Prescribes the storage of a product."@en ;
        rdfs:subClassOf ns3:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N8d53ddaf13594df8a9401cfcd20e8f14 .

    ns3:TestAction a owl:Class ;
        rdfs:comment "A test action is a specific action associated with a test."@en ;
        rdfs:subClassOf ns3:UseAction ;
        sh:nodeKind sh:IRI .

    ns3:TestProcess a owl:Class ;
        rdfs:comment "Test Process defines the testing process for an element."@en ;
        rdfs:subClassOf ns3:UseProcess ;
        sh:nodeKind sh:IRI .

    ns3:TransportAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "An actual change to a product's location."@en ;
