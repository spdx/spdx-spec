        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N717abd50de7f4b4491912bd75eb77323,
            _:N9e1ba1a5ab2b4cb996c5b9b8d7e70b4b,
