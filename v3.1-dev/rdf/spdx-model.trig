        sh:nodeKind sh:IRI ;
        sh:property _:N2707aec11b874e579a894ca5d33a3618 .

    ns5:BoundaryDefinitionProcess a owl:Class ;
        rdfs:comment "The Boundary Definition Process refers to the process class used to produce boundaries."@en ;
        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI .

    ns5:ChangeAction a owl:Class ;
        rdfs:comment "An actual change to a product."@en ;
        rdfs:subClassOf ns5:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns5:ChangeProcess a owl:Class ;
        rdfs:comment "A prescribed change to a product."@en ;
        rdfs:subClassOf ns5:ModifyProcess ;
        sh:nodeKind sh:IRI .

    ns5:DestroyAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "The record of destruction is entered in this action."@en ;
