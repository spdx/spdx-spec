            _:N73e9ec847d5b4c59aebc89a96ec623f4 .

    ns5:serverKeyValidationProtocol a owl:ObjectProperty ;
        rdfs:comment "Key validation protocol used during the authentication of servers or services over a network."@en ;
        rdfs:range ns5:KeyValidationProtocolType .

    ns5:serviceHostingCountry a owl:DatatypeProperty ;
        rdfs:comment "Specifies a country code where a software service is hosted."@en ;
        rdfs:range xsd:string .

    <https://spdx.org/rdf/3/terms/SimpleLicensing/LicenseExpression> a owl:Class,
            sh:NodeShape ;
        rdfs:comment "An SPDX Element containing an SPDX license expression string."@en ;
        rdfs:subClassOf <https://spdx.org/rdf/3/terms/SimpleLicensing/AnyLicenseInfo> ;
        sh:nodeKind sh:IRI ;
        sh:property _:N6762c71f986f429f9539202b6fd4598b,
            _:Nafbb6fd7508e40d3b847a3bf9453e213,
