where all elements apply."""@en ;
        rdfs:subClassOf <https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo> ;
        sh:nodeKind sh:IRI ;
        sh:property _:Ncfef9d0f141f463a994daf0ab1b99263 .

    ns5:CustomLicense a owl:Class ;
        rdfs:comment "A license that is not listed on the SPDX License List."@en ;
        rdfs:subClassOf ns5:License ;
        sh:nodeKind sh:IRI .

    ns5:CustomLicenseAddition a owl:Class ;
        rdfs:comment "A license addition that is not listed on the SPDX Exceptions List."@en ;
        rdfs:subClassOf ns5:LicenseAddition ;
        sh:nodeKind sh:IRI .

    ns5:DisjunctiveLicenseSet a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing a set of licensing information where
only one of the elements applies."""@en ;
        rdfs:subClassOf <https://spdx.org/rdf/3.1/terms/SimpleLicensing/AnyLicenseInfo> ;
        sh:nodeKind sh:IRI ;
        sh:property _:Nb04abd5fa8f9431a8c6022d71ea67738 .

    ns5:ListedLicense a owl:Class,
            sh:NodeShape ;
