            sh:NodeShape ;
        rdfs:comment "A prescribed change to a product's location."@en ;
        rdfs:subClassOf ns7:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N053b9e0577aa45919dec11621dd0e7aa,
            _:N0f5ded45edcf422c8cf1a9181f3e658c,
