        sh:nodeKind sh:IRI ;
        sh:property _:N01f6e71035954fe981f88189a7057243,
            _:N1f8f0f633ba0429dae060816459b411c,
            _:N3eaaf716cb0f4f3ba2213bbc3803d6c3,
