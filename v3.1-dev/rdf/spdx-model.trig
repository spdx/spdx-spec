    ns5:EvaluationResult a owl:Class,
            sh:NodeShape ;
        rdfs:comment "EvaluationResult is the result of an evaluation."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N47fe2dbdb5eb49c49fd2406db4d668fb,
