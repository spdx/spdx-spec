    spdx: a owl:Ontology ;
        rdfs:label "System Package Data Exchange™ (SPDX®) Ontology"@en ;
        dcterms:abstract "This ontology defines the terms and relationships used in the SPDX specification to describe system packages"@en ;
        dcterms:created "2026-01-23"^^xsd:date ;
        dcterms:creator "SPDX Project"@en ;
        dcterms:license <https://spdx.org/licenses/Community-Spec-1.0.html> ;
        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns6:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns5:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0af9281d704c4ecaa17c34b2bb24fc28,
            _:N0d44b483f41d42d1b84b8cc35d28640b,
            _:N20af0e54bed840d593aa2e1e2dcb9701,
            _:N3346785f7feb4db5ba1c3e5713f57b69,
            _:N421811fcd8634f50934d2239b755609a,
            _:N46dd6fdc38e94040b7087c59cad5d1db,
            _:N5e4aff3c7bb040458cd6102034d91827,
            _:N63813c3280594d7182b079a528a454f7,
            _:N89ea91d014f740dfb2d56413de950992,
            _:Nb1f20b1bd2d343afbb9c51940cb8ba11,
            _:Nb8bf39e9ba6a49f88f60de8d6deb8fdc,
            _:Nbf14374d2ba041bab91b6e4b40147567,
            _:Nc005facbee68476895e5bbc52027e385,
