        sh:property _:N92b1bcd106cb4998bc0be8e203186018,
            _:Ne4c5242197b24e5a83da68b067a54976 .

    ns7:StorageAction a owl:Class ;
        rdfs:comment "Records the storage of a product."@en ;
        rdfs:subClassOf ns7:ModifyAction ;
        sh:nodeKind sh:IRI .

