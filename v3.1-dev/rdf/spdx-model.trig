            sh:NodeShape ;
        rdfs:comment "A Package that contains a dataset."@en ;
        rdfs:subClassOf ns2:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N1cf78a8d31e44a5393d92db2f7518f28,
