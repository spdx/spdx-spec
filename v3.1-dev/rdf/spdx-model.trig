        rdfs:subClassOf ns9:CreateAction ;
        sh:nodeKind sh:IRI .

    ns9:ReproduceProcess a owl:Class ;
        rdfs:comment "Reproduction is the biological process by which living organisms produce offspring."@en ;
        rdfs:subClassOf ns9:CreateProcess ;
