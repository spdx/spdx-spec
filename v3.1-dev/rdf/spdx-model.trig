        sh:nodeKind sh:IRI ;
        sh:property _:N975e0240ff824b90bb600e1da1b5d594,
            _:N9f6cd41b62f8485582994317ff725085 .

    ns10:serverAuthenticationProtocol a owl:ObjectProperty ;
