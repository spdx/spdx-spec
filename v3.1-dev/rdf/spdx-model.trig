    <https://spdx.org/rdf/3.1/terms/Core/RelationshipType/testedOn> a owl:NamedIndividual,
            ns1:RelationshipType ;
        rdfs:label "testedOn" ;
        rdfs:comment "The `from` Element has been tested on the `to` Element(s)."@en .

