interpret an Element."""@en ;
        rdfs:range xsd:string .

    ns2:standardName a owl:DatatypeProperty ;
        rdfs:comment "The name of a relevant standard that may apply to an artifact."@en ;
        rdfs:range xsd:string .

    ns2:startTime a owl:DatatypeProperty ;
