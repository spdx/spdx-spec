from one location to another."""@en ;
        rdfs:range xsd:string .

    ns2:previousResponsibleAgent a owl:ObjectProperty ;
        rdfs:comment "This is the individual, business, or organization who was previously managing or responsible for the goods, services, or assets."@en ;
        rdfs:range ns1:Agent .

