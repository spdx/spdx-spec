        sh:nodeKind sh:IRI ;
        sh:property _:N23f23583c01f41338a984feec2b95d24,
            _:Ned9d1da49f3b40b39baa791c83907fca .

    ns2:additionText a owl:DatatypeProperty ;
        rdfs:comment "Identifies the full text of a LicenseAddition."@en ;
        rdfs:range xsd:string .

    ns2:isDeprecatedAdditionId a owl:DatatypeProperty ;
