    <https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/service> a owl:NamedIndividual,
            ns1:ProfileIdentifierType ;
        rdfs:label "service" ;
        rdfs:comment "The element follows the Service profile specification."@en .

