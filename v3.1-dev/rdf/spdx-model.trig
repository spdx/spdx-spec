        rdfs:subClassOf ns9:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N53443fc5d80f49fba5615e004a517293,
            _:N821a8e17c5db4289bd48e8bd02b04fe8,
