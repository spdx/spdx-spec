        rdfs:range ns1:ProfileIdentifierType .

    ns1:provinceStateCode a owl:DatatypeProperty ;
        rdfs:comment "Text specifying a province or state."@en ;
        rdfs:range xsd:string .

    ns1:quantity a owl:DatatypeProperty ;
