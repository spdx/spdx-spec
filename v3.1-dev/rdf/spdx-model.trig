            sh:NodeShape ;
        rdfs:comment "Software provided as a service over a network."@en ;
        rdfs:subClassOf ns1:Artifact ;
        sh:nodeKind sh:IRI ;
        sh:property _:N57ce314c8c364ccba1d5006a6be0965e,
            _:N734bd73cc2ff437bbd6f8e75ea97df8d .

    ns3:serverAuthenticationProtocol a owl:ObjectProperty ;
        rdfs:comment "Authentication protocol used by a server."@en ;
