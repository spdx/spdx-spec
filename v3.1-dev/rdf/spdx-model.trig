        rdfs:range ns3:RequirementVerification .

    ns3:evidenceCategory a owl:ObjectProperty ;
        rdfs:comment "evidenceCategory refers to a category of documented or observable proof."@en ;
        rdfs:range ns3:EvidenceType .

