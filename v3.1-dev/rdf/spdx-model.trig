            sh:NodeShape ;
        rdfs:comment "A prescribed change to a product's location."@en ;
        rdfs:subClassOf ns8:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N17b79c66fb5340f3bbfaab6ad1875afe,
            _:N4eee595baaf54feda8ff58129a6f5327,
