        sh:nodeKind sh:IRI ;
        sh:property _:N3a352723312f4224be3e3047abea8e9a,
            _:N928b0d9bb5b543f19e8263b3b14ea5c7 .

    ns5:OrLaterOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing this version, or any later version,
of the indicated License."""@en ;
