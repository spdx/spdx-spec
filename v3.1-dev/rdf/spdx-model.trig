            _:Nfdc38727895b45b88f2f6e03c04ac383 .

    ns8:additionText a owl:DatatypeProperty ;
        rdfs:comment "Identifies the full text of a LicenseAddition."@en ;
        rdfs:range xsd:string .

    ns8:isDeprecatedAdditionId a owl:DatatypeProperty ;
        rdfs:comment "Specifies whether an additional text identifier has been marked as deprecated."@en ;
        rdfs:range xsd:boolean .

    ns8:isDeprecatedLicenseId a owl:DatatypeProperty ;
