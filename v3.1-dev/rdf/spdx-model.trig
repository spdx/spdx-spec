        rdfs:comment "The Element is a machine learning or artificial intelligence model."@en .

    <https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/module> a owl:NamedIndividual,
            ns3:SoftwarePurpose ;
        rdfs:label "module" ;
