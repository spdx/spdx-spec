        sh:nodeKind sh:IRI ;
        sh:property _:N0600e00e46924d76a29e04ec7c3bc0a7,
            _:Nded1df4de45345b983c336e40843111d .

    ns10:ListedLicenseException a owl:Class,
            sh:NodeShape ;
