        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns7:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns2:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N06b11ec660e44209a04854183ba187de,
            _:N070bd2f124004fbeaaf076f94905dd9e,
            _:N1de9afda3de0441488562e4736e575e1,
            _:N1fc4d229aaf94e30a391cc386e73049a,
            _:N255d354017bc4139843cfeed8e0cbf66,
            _:N45b0e9202e264569b1b721144cc9cce1,
            _:N544f2ef7f455423cae3fc03a71cc6cfc,
            _:N664c359245d745dba29c8260d385b7af,
            _:N84d5f3704b814618a6424bd31253ee69,
            _:N9408f00d5ffb4f23b265849b546f1e91,
            _:Na1b06261eadd46e0938726a1f2e4fe77,
            _:Na389f70a2a6c4cb08c045a53959ee304,
            _:Na5b3c12af9eb49a882fd51b7b535b53e,
