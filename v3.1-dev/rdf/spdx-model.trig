        rdfs:subClassOf ns10:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns10:ChangeProcess a owl:Class ;
        rdfs:comment "A prescribed change to a product."@en ;
        rdfs:subClassOf ns10:ModifyProcess ;
        sh:nodeKind sh:IRI .

    ns10:DestroyAction a owl:Class,
