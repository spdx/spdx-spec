        sh:nodeKind sh:IRI ;
        sh:property _:N1be072e0fdfb48b58b3b69fa6e2f5df7,
            _:N2ecc2dc6035b42fbb2aa6ff4a4c04c20 .

    ns5:additionText a owl:DatatypeProperty ;
        rdfs:comment "Identifies the full text of a LicenseAddition."@en ;
        rdfs:range xsd:string .

