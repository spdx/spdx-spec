        rdfs:subClassOf ns3:CreateProcess ;
        sh:nodeKind sh:IRI .

    ns3:OutOfSpecAction a owl:Class ;
        rdfs:comment "An out of specification action is defined in this class."@en ;
        rdfs:subClassOf ns3:UseAction ;
        sh:nodeKind sh:IRI .

    ns3:PlanAction a owl:Class ;
        rdfs:comment "A PlanAction involves the execution of a plan in relation to a PlanProcess."@en ;
        rdfs:subClassOf ns3:UseAction ;
        sh:nodeKind sh:IRI .

    ns3:PlanProcess a owl:Class ;
        rdfs:comment "Process plans outline the stages of implementation or use related to a process."@en ;
        rdfs:subClassOf ns3:UseProcess ;
        sh:nodeKind sh:IRI .

    ns3:ReproduceAction a owl:Class ;
