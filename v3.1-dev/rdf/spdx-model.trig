        sh:nodeKind sh:IRI ;
        sh:property _:Ndf4b6e917a314754b66f9fefb3e63af4 .

    ns10:WithAdditionOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing a License which has additional
text applied to it."""@en ;
