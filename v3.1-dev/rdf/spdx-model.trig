    ns1:Organization a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A group of people who work together in an organized way for a shared purpose."@en ;
        rdfs:subClassOf ns1:Agent ;
        sh:nodeKind sh:IRI ;
