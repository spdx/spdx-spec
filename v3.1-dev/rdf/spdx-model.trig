        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns7:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns4:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N35011deebfc84fd082a1d2183f041b74,
            _:N3d9bf57269e547188373cef6bbefe760,
            _:N4115bf2cec754e1ca939357d58651256,
            _:N442ff24661bc42ac8941b22d0cef1a44,
            _:N57c6fc2d084d4cc09d512ad2b2ef407a,
            _:N674a47da2fed4cfaa294673be8d7ad55,
            _:N70af44f9beb44006bbc4a396fb90026b,
            _:N8251e9645b3445149e2b2cf184e1f32e,
            _:N834329172c634b53b7db064ba2d6ec09,
            _:N887da9469db74be5a54fdab2a04b8a77,
            _:N88df6c8849ab4c00a8206e8c35bc31ce,
            _:N8b6619a1a93041d58193d8584112607d,
            _:N8be80345ba7148a9887a3ad8521f4d42,
