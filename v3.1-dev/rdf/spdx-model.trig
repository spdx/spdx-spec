        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns9:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns8:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N2278434fc4814a5ab981974b1ed25637,
            _:N3ae5cab028d34feea151b51104dc1bb3,
            _:N3feffc843868469ea41fcb67c61b207c,
            _:N4c8701012a1a4500aa933e28f9e4ac05,
            _:N50265bb3f1bd4b9284ecdc8f16812366,
            _:N5f5478741d9f4e789b43b9d45e347123,
            _:N609a1d47d13d426192c6d0a5d224843d,
            _:N864ce93d388d4d25bf5f8f7d231a8bcc,
            _:N8c3c2fd8ddc4448a8da4c5ab2ce9fb45,
            _:N943e90cf5c9f4068a8d2e096cdc47c69,
            _:N9be55278c96c4b538717eba0671696c9,
            _:Na0f73556b62c4452a59cfdcdfcf8dfbe,
            _:Nb7adba0c04934f27ac67f16ef85191b6,
