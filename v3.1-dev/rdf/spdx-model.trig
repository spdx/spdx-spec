        rdfs:range ns9:ContentIdentifierType .

    ns9:contentIdentifierValue a owl:DatatypeProperty ;
        rdfs:comment "Specifies the value of the content identifier."@en ;
        rdfs:range xsd:anyURI .

    ns9:copyrightText a owl:DatatypeProperty ;
