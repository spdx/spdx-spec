        rdfs:subClassOf ns8:VulnAssessmentRelationship ;
        sh:nodeKind sh:IRI ;
        sh:property _:Nd08195e38d864ebab2a5fa56f1946893 .

    ns8:VexAffectedVulnAssessmentRelationship a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Connects a vulnerability and an element designating the element as a product
affected by the vulnerability."""@en ;
