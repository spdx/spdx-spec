    ns5:serialNumber a owl:DatatypeProperty ;
        rdfs:comment "Identifier for specific product is called a serial number."@en ;
        rdfs:range xsd:string .

    ns5:virtualHardwareModel a owl:DatatypeProperty ;
        rdfs:comment "Information related to virtual hardware simulation."@en ;
        rdfs:range ns5:VirtualHardwareModelType .

    ns5:xAxisLength a owl:ObjectProperty ;
