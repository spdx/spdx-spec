    ns7:serverAuthenticationProtocol a owl:ObjectProperty ;
        rdfs:comment "Authentication protocol used by a server."@en ;
        rdfs:range ns7:AuthenticationProtocolType .

    ns7:serviceHostingCountry a owl:DatatypeProperty ;
        rdfs:comment "Specifies a country code where a software service is hosted."@en ;
        rdfs:range xsd:string .

