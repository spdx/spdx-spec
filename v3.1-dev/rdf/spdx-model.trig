        sh:nodeKind sh:IRI ;
        sh:property _:N7bb4814a655749f0a8b42397783bcef6 .

    ns7:TestAction a owl:Class ;
        rdfs:comment "A test action is a specific action associated with a test."@en ;
        rdfs:subClassOf ns7:UseAction ;
        sh:nodeKind sh:IRI .

