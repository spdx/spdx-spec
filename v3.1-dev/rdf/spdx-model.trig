        rdfs:range xsd:string .

    ns4:AbstractPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Refers to an abstract, conceptual software entity."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N34a3830da9b8431ca32cb10b232857f5,
            _:N86f00519b6ff4dc28170ebfa0a218f17,
