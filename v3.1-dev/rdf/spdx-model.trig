        sh:nodeKind sh:IRI ;
        sh:property _:N8d0bc865057e4909b7d1d5835c87949e,
            _:N9b0ec40b8baf4f32b9b2b6a8d299ca44 .

    ns8:additionText a owl:DatatypeProperty ;
        rdfs:comment "Identifies the full text of a LicenseAddition."@en ;
        rdfs:range xsd:string .

