        rdfs:range xsd:string .

    ns4:evidenceCategory a owl:ObjectProperty ;
        rdfs:comment "evidenceCategory refers to a category of documented or observable proof."@en ;
        rdfs:range ns4:EvidenceType .

    ns4:evidenceUUID a owl:ObjectProperty ;
        rdfs:comment "A evidenceUUID is a universally unique identifier (UUID) assigned to an entity, item, or requirement."@en ;
        rdfs:range ns1:ExternalIdentifier .

    ns4:verificationMethod a owl:DatatypeProperty ;
        rdfs:comment "verificationMethod refers to the specific approach used for a checking an element's conformance with its requirements."@en ;
        rdfs:range ns4:VerificationType .

    ns4:verificationPostcondition a owl:DatatypeProperty ;
        rdfs:comment "Verification postcondition that are true immediately after a verification method has been performed"@en ;
        rdfs:range xsd:string .

    ns4:verificationPrecondition a owl:DatatypeProperty ;
        rdfs:comment "Verification preconditions are initial criteria that are to be met prior to initiating the verification method."@en ;
        rdfs:range xsd:string .

    ns4:verificationRationale a owl:DatatypeProperty ;
        rdfs:comment "A verificationRationale is supporting information that justifies the verification details."@en ;
        rdfs:range xsd:string .

    ns4:verificationUUID a owl:ObjectProperty ;
        rdfs:comment "A verificationUUID is a universally unique identifier (UUID) assigned to a Verification item."@en ;
        rdfs:range ns1:ExternalIdentifier .

