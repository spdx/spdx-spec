            _:Nd54d9e956f094b7cb73864e9f59fc83e .

    ns6:VexUnderInvestigationVulnAssessmentRelationship a owl:Class ;
        rdfs:comment """Designates elements as products where the impact of a vulnerability is being
investigated."""@en ;
        rdfs:subClassOf ns6:VexVulnAssessmentRelationship ;
        sh:nodeKind sh:IRI .

    ns6:Vulnerability a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Specifies a vulnerability and its associated information."@en ;
