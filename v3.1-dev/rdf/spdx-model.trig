        rdfs:comment "[Dilithium](https://pq-crystals.org/dilithium/)"@en .

    <https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/crystalsKyber> a owl:NamedIndividual,
            ns1:HashAlgorithm ;
