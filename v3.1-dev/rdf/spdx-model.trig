        sh:nodeKind sh:IRI ;
        sh:property _:N09efaf08d32844289edc56ab96d3aaeb,
            _:N154f9a0e519e4706b96fd917a431aa79,
            _:N3456c90e49134db59e97f10cbb99604b,
