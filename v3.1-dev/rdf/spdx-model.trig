            sh:NodeShape ;
        rdfs:comment "A distinct unit representing a constraint associated with an item's use in a system."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N8e9b9c7fc5cf4a559fc848358df2fe2f,
