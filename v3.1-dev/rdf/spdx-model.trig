by the License."""@en ;
        rdfs:range xsd:string .

    ns10:standardLicenseTemplate a owl:DatatypeProperty ;
        rdfs:comment "Identifies the full text of a License, in SPDX templating format."@en ;
        rdfs:range xsd:string .

