        sh:nodeKind sh:IRI ;
        sh:property _:N03e95a695086417b8681f7052cd3669c,
            _:N1a93e095db42488ab1b7bd5e5f480368,
            _:N349aef0aa7c7407c9a3dfaccf2ce7243,
