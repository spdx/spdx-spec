        sh:nodeKind sh:IRI ;
        sh:property _:N3444ff2103864875b3b929002d6479ad,
            _:N4e2cacd5f0294a1398fcc3a91dcb8ece,
            _:N5ae09d5081dc4cf49714b48f41d3fb52,
