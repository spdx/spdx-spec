    <https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/executable> a owl:NamedIndividual,
            ns6:SoftwarePurpose ;
        rdfs:label "executable" ;
        rdfs:comment "The Element is an Artifact that can be run on a computer."@en .

