        rdfs:comment "An action of crossing a boundary is defined in this class."@en ;
        rdfs:subClassOf ns8:UseAction ;
        sh:nodeKind sh:IRI .

    ns8:BoundaryDefinitionAction a owl:Class,
            sh:NodeShape ;
