        sh:nodeKind sh:IRI ;
        sh:property _:N4c040ece6fa04f7482857677438e9cfa,
            _:N5443a233ccd8444fade18ddbe61af13d,
            _:N5f58cb71a4ad4d2da48c5b39073a8cb7,
