        rdfs:subClassOf ns4:UseProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N91969820b6cd4cff882236eb5b3a177d .

    ns4:InstantiateVirtualHardwareProcess a owl:Class ;
