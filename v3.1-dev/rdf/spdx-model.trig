            ns3:SoftwarePurpose ;
        rdfs:label "executable" ;
        rdfs:comment "The Element is an Artifact that can be run on a computer."@en .

    <https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/file> a owl:NamedIndividual,
            ns3:SoftwarePurpose ;
