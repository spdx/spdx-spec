    _:N03198c4ba6cd4f53b69e7fdc599c7ecc a sh:SPARQLConstraint ;
        sh:message "When relationship is providesSupportFor, class must be SupportRelationship" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/providesSupportFor> .
    FILTER NOT EXISTS { $this rdf:type <Core/SupportRelationship> }
}""" .

    _:N03236daf9f4b4e6595f211cbb8f8058a a sh:SPARQLConstraint ;
        sh:message "When relationship is verifiedBy, to must be a RequirementVerification" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/verifiedBy> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <FunctionalSafety/RequirementVerification> }
}""" .

