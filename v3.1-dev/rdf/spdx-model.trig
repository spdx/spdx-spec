        rdfs:subClassOf ns8:License ;
        sh:nodeKind sh:IRI .

    ns8:CustomLicenseAddition a owl:Class ;
        rdfs:comment "A license addition that is not listed on the SPDX Exceptions List."@en ;
        rdfs:subClassOf ns8:LicenseAddition ;
        sh:nodeKind sh:IRI .

    ns8:DisjunctiveLicenseSet a owl:Class,
            sh:NodeShape ;
