        sh:nodeKind sh:IRI ;
        sh:property _:Nd94adfa727304cde9203870d8e1c8677 .

    ns4:BoundaryDefinitionProcess a owl:Class ;
        rdfs:comment "The Boundary Definition Process refers to the process class used to produce boundaries."@en ;
        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI .

    ns4:ChangeAction a owl:Class ;
        rdfs:comment "An actual change to a product."@en ;
        rdfs:subClassOf ns4:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns4:ChangeProcess a owl:Class ;
        rdfs:comment "A prescribed change to a product."@en ;
        rdfs:subClassOf ns4:ModifyProcess ;
        sh:nodeKind sh:IRI .

    ns4:DestroyAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "The record of destruction is entered in this action."@en ;
