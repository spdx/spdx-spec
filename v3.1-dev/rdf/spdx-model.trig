        ns1:created "2026-01-23T03:01:00Z"^^xsd:dateTimeStamp ;
        ns1:createdBy ns1:SpdxOrganization ;
        ns1:specVersion "3.1" .

    <https://spdx.org/rdf/3.1/creationInfo_SpdxOrganization> a ns1:CreationInfo ;
