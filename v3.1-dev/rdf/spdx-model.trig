        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N1719f223365a4d978f1cd3f26fa7ad35,
            _:N7fddc1bcb6e14c979dd09bf8568377b0,
