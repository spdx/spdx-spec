            _:Ncc0a0b73028445bc88842a468d2669b1 .

    ns4:ResponsibilityChangeProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "ResponsibilityChangeProcess refers to the process of transferring responsibility from one party to another."@en ;
        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N29ddefea09764f42a71e2e88ca49363d,
            _:N8977d7d1565b408e87afe840624e4d56,
            _:Nadd4b4f35ac14305992561febaa24174,
            _:Ndc1ac344d7b34a52afd522449375d470 .

    ns4:StateAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "This is the state of an affected Element at a specific moment in time."@en ;
        rdfs:subClassOf ns4:UseAction ;
        sh:nodeKind sh:IRI ;
        sh:property _:N93d1c962e85341f2829561395a15fbac,
            _:Nbfbc313ca2be4ea59194590d6ce6626b .

    ns4:StorageAction a owl:Class ;
        rdfs:comment "Records the storage of a product."@en ;
        rdfs:subClassOf ns4:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns4:StorageProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Prescribes the storage of a product."@en ;
        rdfs:subClassOf ns4:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N9ca7b02591b149609bb2ad8e791dd8e4 .

    ns4:TestAction a owl:Class ;
        rdfs:comment "A test action is a specific action associated with a test."@en ;
        rdfs:subClassOf ns4:UseAction ;
        sh:nodeKind sh:IRI .

    ns4:TestProcess a owl:Class ;
        rdfs:comment "Test Process defines the testing process for an element."@en ;
        rdfs:subClassOf ns4:UseProcess ;
        sh:nodeKind sh:IRI .

    ns4:TransportAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "An actual change to a product's location."@en ;
        rdfs:subClassOf ns4:ModifyAction ;
        sh:nodeKind sh:IRI ;
        sh:property _:N431e7938d60f4bd2ae8a1557eb680184,
            _:N9be46c85adb84526bb93a6018b17f8b1,
            _:Nf081a821cfec45cf91a5d6cf6d1b51b2 .

    ns4:TransportProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A prescribed change to a product's location."@en ;
        rdfs:subClassOf ns4:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N2e1183290c9b4353b6905999e2406964,
            _:Nd9620315d81344e0924093721465d4b8,
