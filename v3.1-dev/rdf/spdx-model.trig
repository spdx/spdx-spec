    <https://spdx.org/rdf/3/terms/SimpleLicensing/SimpleLicensingText> a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A license or a license addition that is not listed on the SPDX License List."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
