            _:Nb1da5670ccd046829e8dd3c2f15c434c .

    ns4:serverKeyValidationProtocol a owl:ObjectProperty ;
        rdfs:comment "Key validation protocol used during the authentication of servers or services over a network."@en ;
        rdfs:range ns4:KeyValidationProtocolType .

