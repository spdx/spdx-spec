        sh:nodeKind sh:IRI ;
        sh:property _:Na66ca9d2d0b4431386ab121aeb304093 .

    ns11:TestAction a owl:Class ;
        rdfs:comment "A test action is a specific action associated with a test."@en ;
        rdfs:subClassOf ns11:UseAction ;
        sh:nodeKind sh:IRI .

    ns11:TestProcess a owl:Class ;
        rdfs:comment "Test Process defines the testing process for an element."@en ;
        rdfs:subClassOf ns11:UseProcess ;
        sh:nodeKind sh:IRI .

