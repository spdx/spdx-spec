        sh:nodeKind sh:IRI ;
        sh:property _:N4c989c348a5749c38a9f5c4990eafc78,
            _:N4cdad7be02624899a8cb87b57f2f71ae,
            _:N52650ab2e36d4f648a2affa7045b2683,
