        rdfs:subClassOf <https://spdx.org/rdf/3/terms/Extension/Extension> ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:property _:Nf004c5bd03f04faa89d23d28ba3d64a4 .

    <https://spdx.org/rdf/3/terms/Operations/exportControlClassificationResult> a owl:ObjectProperty ;
