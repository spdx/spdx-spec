        sh:nodeKind sh:IRI ;
        sh:property _:N7696fb6618ae4eb3bcd1aa8e09f7f6cb .

    ns3:DestroyProcess a owl:Class ;
        rdfs:comment "The destruction process is defined in this process."@en ;
