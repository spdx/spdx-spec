    _:N02cd6904b9d241579ce400f7592cb775 a sh:SPARQLConstraint ;
        sh:message "When relationship is coordinatedBy, from must be a Vulnerability" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/coordinatedBy> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }
}""" .

    _:N02f3208e9bf644a9949da268799f734c a sh:SPARQLConstraint ;
        sh:message "When relationship is hasContactPoint, to must be an Agent" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/hasContactPoint> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Agent> }
}""" .

