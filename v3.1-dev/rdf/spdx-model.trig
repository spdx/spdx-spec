        rdfs:subClassOf ns2:CreateProcess ;
        sh:nodeKind sh:IRI .

    ns2:OutOfSpecAction a owl:Class ;
        rdfs:comment "An out of specification action is defined in this class."@en ;
        rdfs:subClassOf ns2:UseAction ;
        sh:nodeKind sh:IRI .

    ns2:PlanAction a owl:Class ;
        rdfs:comment "A PlanAction involves the execution of a plan in relation to a PlanProcess."@en ;
        rdfs:subClassOf ns2:UseAction ;
        sh:nodeKind sh:IRI .

    ns2:PlanProcess a owl:Class ;
