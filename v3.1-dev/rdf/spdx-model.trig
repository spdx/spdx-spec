        rdfs:subClassOf ns10:UseProcess ;
        sh:nodeKind sh:IRI .

    ns10:ReproduceAction a owl:Class ;
        rdfs:comment "Reproduction is the biological process by which organisms generate new individuals of the same species."@en ;
        rdfs:subClassOf ns10:CreateAction ;
        sh:nodeKind sh:IRI .

    ns10:ReproduceProcess a owl:Class ;
        rdfs:comment "Reproduction is the biological process by which living organisms produce offspring."@en ;
        rdfs:subClassOf ns10:CreateProcess ;
        sh:nodeKind sh:IRI .

