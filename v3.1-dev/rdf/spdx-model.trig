        sh:nodeKind sh:IRI .

    ns7:ChangeProcess a owl:Class ;
        rdfs:comment "A prescribed change to a product."@en ;
        rdfs:subClassOf ns7:ModifyProcess ;
        sh:nodeKind sh:IRI .

    ns7:DestroyAction a owl:Class,
