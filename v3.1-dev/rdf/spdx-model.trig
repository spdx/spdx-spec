        sh:nodeKind sh:IRI ;
        sh:property _:N3cea7888a8c54bd580f380fb19e5c76d,
            _:N595288bcecf745e4b485a482e3079a44,
            _:Nf60e614b524e46f188e8aecb144d3ab4 .

