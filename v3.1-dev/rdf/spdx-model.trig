        sh:nodeKind sh:IRI ;
        sh:property _:N3cac4e29c3bc4819aa6c635a964cf3ba,
            _:N8c04b99b533f4a989a993e76c202e662 .

    ns9:VexFixedVulnAssessmentRelationship a owl:Class ;
        rdfs:comment """Links a vulnerability and elements representing products (in the VEX sense) where
