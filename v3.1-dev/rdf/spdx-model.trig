        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N23f0f1ff5a8b4f36b116156b509d2c94,
            _:N8dde19d337f24f05b41a9d40c43d3ccb,
