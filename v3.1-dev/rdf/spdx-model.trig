            _:Na74f4a8f1360402cabf0896ab9cbb065 .

    ns5:ResponsibilityChangeProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "ResponsibilityChangeProcess refers to the process of transferring responsibility from one party to another."@en ;
        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N28c9c0f2f14041378aab0ea19c65d0a0,
            _:N42c382209da54c14b59ee96d3ef8e2b4,
