    _:N06c0cb22703743058e6354590ae45820 a sh:SPARQLConstraint ;
        sh:message "When relationship is hasAssociatedVulnerability, to must be a Vulnerability" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/hasAssociatedVulnerability> .
    $this <Core/to> ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Security/Vulnerability> }
}""" .

