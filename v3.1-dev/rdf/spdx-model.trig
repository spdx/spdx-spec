            ns8:ExploitCatalogType ;
        rdfs:label "kev" ;
        rdfs:comment "CISA's Known Exploited Vulnerability (KEV) catalog."@en .

    <https://spdx.org/rdf/3/terms/Security/ExploitCatalogType/other> a owl:NamedIndividual,
            ns8:ExploitCatalogType ;
        rdfs:label "other" ;
        rdfs:comment "Other exploit catalogs."@en .

    ns8:ExploitCatalogVulnAssessmentRelationship a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Provides an exploit assessment of a vulnerability."@en ;
        rdfs:subClassOf ns8:VulnAssessmentRelationship ;
        sh:nodeKind sh:IRI ;
        sh:property _:N30cd5799495244c0a21920c705e39636,
            _:Nc9ac9a02474944f3875380c4716a9b2d,
