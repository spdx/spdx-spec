        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:property _:N092688b9972a42bab8ca8621c042d01b .

    ns6:mass a owl:DatatypeProperty ;
        rdfs:comment "Information related to physical hardware."@en ;
