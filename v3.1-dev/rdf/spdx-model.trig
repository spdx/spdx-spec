        rdfs:comment "This is the individual, business, or organization who currently manages or responsible for the goods, services, or assets."@en ;
        rdfs:range ns1:Agent .

    ns6:currentState a owl:ObjectProperty ;
        rdfs:comment "This is the state of an affected Element."@en ;
        rdfs:range ns6:State .

    ns6:decisionProcess a owl:ObjectProperty ;
        rdfs:comment "This is how the currentState of an affected Element is found."@en ;
        rdfs:range ns6:StateProcess .

    ns6:destructionPerformedBy a owl:ObjectProperty ;
        rdfs:comment "This is the agent that performed the act of destroying the item."@en ;
        rdfs:range ns1:Agent .

    ns6:dropoffLocation a owl:ObjectProperty ;
        rdfs:comment "A location where a package or an item is being dropped off or delivered."@en ;
        rdfs:range ns1:Location .

    ns6:pickupLocation a owl:ObjectProperty ;
        rdfs:comment "A location where a package or an item is being picked up."@en ;
        rdfs:range ns1:Location .

    ns6:plannedCurrentResponsibleAgent a owl:ObjectProperty ;
        rdfs:comment "This is the planned individual, business, or organization who currently manages or responsible for the goods, services, or assets."@en ;
        rdfs:range ns1:Agent .

    ns6:plannedDropoffLocation a owl:ObjectProperty ;
        rdfs:comment "A location where a package or an item will be dropped off or delivered."@en ;
        rdfs:range ns1:Location .

    ns6:plannedInspectionLocation a owl:ObjectProperty ;
        rdfs:comment "A planned location where a good, product, or material is inspected."@en ;
        rdfs:range ns1:Location .

    ns6:plannedPickupLocation a owl:ObjectProperty ;
        rdfs:comment "A location where a package or an item will be picked up."@en ;
        rdfs:range ns1:Location .

    ns6:plannedPreviousResponsibleAgent a owl:ObjectProperty ;
        rdfs:comment "This is the planned individual, business, or organization who was previously managing or responsible for the goods, services, or assets."@en ;
        rdfs:range ns1:Agent .

    ns6:plannedProductOfResponsibilityChange a owl:ObjectProperty ;
        rdfs:comment "This is the planned product associated with the change of responsibility."@en ;
        rdfs:range ns1:Element .

    ns6:plannedStorageLocation a owl:ObjectProperty ;
        rdfs:comment "A planned location where a good, product, or material is stored."@en ;
        rdfs:range ns1:Location .

    ns6:plannedTransportRoute a owl:DatatypeProperty ;
        rdfs:comment """A planned path used to move people, goods, data, or resources
from one location to another."""@en ;
        rdfs:range xsd:string .

    ns6:previousResponsibleAgent a owl:ObjectProperty ;
        rdfs:comment "This is the individual, business, or organization who was previously managing or responsible for the goods, services, or assets."@en ;
        rdfs:range ns1:Agent .

    ns6:responsibilityChangedOn a owl:ObjectProperty ;
        rdfs:comment "The element that has its responsibility changed."@en ;
        rdfs:range ns1:Element .

    ns6:transportRoute a owl:DatatypeProperty ;
        rdfs:comment "A transport route refers to the specific path or network used to move people, goods, data, or resources from one location to another."@en ;
        rdfs:range xsd:string .

    ns6:validState a owl:ObjectProperty ;
        rdfs:comment "The valid state for StateProcess."@en ;
        rdfs:range ns6:State .

