        sh:nodeKind sh:IRI ;
        sh:property _:N6f358f976f2541739aead437b685562f,
            _:Nbf6f06b40392411381e439a5b039ceec .

    ns2:OrLaterOperator a owl:Class,
            sh:NodeShape ;
