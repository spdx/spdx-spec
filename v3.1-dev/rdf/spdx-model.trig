        rdfs:subClassOf ns5:VulnAssessmentRelationship ;
        sh:nodeKind sh:IRI ;
        sh:property _:Na79ad7ff347e4461a1b1d66c91f3da12 .

    ns5:VexAffectedVulnAssessmentRelationship a owl:Class,
