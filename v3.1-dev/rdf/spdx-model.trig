    ns7:EvaluationResult a owl:Class,
            sh:NodeShape ;
        rdfs:comment "EvaluationResult is the result of an evaluation."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N25c11c6dab1449af97d8592e27f748da,
