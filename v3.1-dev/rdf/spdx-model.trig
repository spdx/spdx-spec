        sh:nodeKind sh:IRI ;
        sh:property _:N026b849108ed4fa79b6ae462657facf3,
            _:N341d9edd69b549c096092f7ceaa374ba,
            _:N5f8fc53f5e9d4242b3d61e21123cd952,
