        sh:property _:Nde6322c8c90a481fa747a16e84802468 .

    ns8:CustomLicense a owl:Class ;
        rdfs:comment "A license that is not listed on the SPDX License List."@en ;
        rdfs:subClassOf ns8:License ;
        sh:nodeKind sh:IRI .

    ns8:CustomLicenseAddition a owl:Class ;
        rdfs:comment "A license addition that is not listed on the SPDX Exceptions List."@en ;
        rdfs:subClassOf ns8:LicenseAddition ;
        sh:nodeKind sh:IRI .

    ns8:DisjunctiveLicenseSet a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing a set of licensing information where
only one of the elements applies."""@en ;
        rdfs:subClassOf <https://spdx.org/rdf/3/terms/SimpleLicensing/AnyLicenseInfo> ;
        sh:nodeKind sh:IRI ;
        sh:property _:Nb72756f2a92648978a5ec9ec5c8ee5b8 .

    ns8:ListedLicense a owl:Class,
