        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N71bfea7135914da7bf976455c5ee31bd,
            _:Na5e14ee906114ffbabb27c01e6ae82e3,
