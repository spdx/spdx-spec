            _:N9c995291ab5b499cb9673514c34b3864 .

    <https://spdx.org/rdf/3/terms/SimpleLicensing/SimpleLicensingText> a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A license or addition that is not listed on the SPDX License List."@en ;
