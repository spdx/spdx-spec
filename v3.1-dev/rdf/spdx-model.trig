        sh:nodeKind sh:IRI ;
        sh:property _:N30c857767dbf4b1db8c9a2f3fa75727c,
            _:N7a6b16fc16be4b4f8b1a9f6d9fbbe725 .

    ns4:serverKeyValidationProtocol a owl:ObjectProperty ;
        rdfs:comment "Key validation protocol used during the authentication of servers or services over a network."@en ;
        rdfs:range ns4:KeyValidationProtocolType .

    ns4:serviceHostingCountry a owl:DatatypeProperty ;
        rdfs:comment "Specifies a country code where a software service is hosted."@en ;
        rdfs:range xsd:string .

    <https://spdx.org/rdf/3/terms/SimpleLicensing/LicenseExpression> a owl:Class,
            sh:NodeShape ;
