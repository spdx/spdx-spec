        rdfs:comment "The Element refers to a chipset, processor, or electronic board."@en .

    <https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/deviceDriver> a owl:NamedIndividual,
            ns8:SoftwarePurpose ;
        rdfs:label "deviceDriver" ;
