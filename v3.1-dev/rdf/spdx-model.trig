            sh:NodeShape ;
        rdfs:comment "A prescribed change to a product's location."@en ;
        rdfs:subClassOf ns6:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N3e53ade5b35240ca88f1645ef29795b6,
            _:Na51154cbd9f041199ad34e4d7f5b1e65,
