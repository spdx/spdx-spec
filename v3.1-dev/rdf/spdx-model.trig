instead.

Size of the dataset."""@en ;
        rdfs:range xsd:nonNegativeInteger .

    ns4:datasetType a owl:ObjectProperty ;
        rdfs:comment "Type of data in a dataset."@en ;
        rdfs:range ns4:DatasetType .

    ns4:datasetUpdateMechanism a owl:DatatypeProperty ;
        rdfs:comment "Mechanism to update the dataset."@en ;
        rdfs:range xsd:string .

    ns4:hasSensitivePersonalInformation a owl:ObjectProperty ;
