        sh:nodeKind sh:IRI ;
        sh:property _:N5a4f371e4821452eb449c67a74ed1d6a,
            _:N65df62f2eb62441088b287f8ffa8f35c .

    ns7:ListedLicenseException a owl:Class,
            sh:NodeShape ;
