        sh:nodeKind sh:IRI ;
        sh:property _:Nbe34f30574b5405ca065136348d3cd5b,
            _:Nf13a759fcba54408ba3a1c15933634a2 .

    ns10:serverAuthenticationProtocol a owl:ObjectProperty ;
