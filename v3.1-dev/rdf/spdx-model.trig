    spdx: a owl:Ontology ;
        rdfs:label "System Package Data Exchange™ (SPDX®) Ontology"@en ;
        dcterms:abstract "This ontology defines the terms and relationships used in the SPDX specification to describe system packages"@en ;
        dcterms:created "2026-01-23"^^xsd:date ;
        dcterms:creator "SPDX Project"@en ;
        dcterms:license <https://spdx.org/licenses/Community-Spec-1.0.html> ;
        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns6:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns7:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N1c5d6f608ea84c37a48fdd98ef40b337,
            _:N1dbbb7450da04146a00212697cdf521f,
            _:N27689d934eea40769bf182af43c79590,
            _:N27d9fd1641ba47abbf794db16cf11d2e,
            _:N2974dac0f5934678861bab147b479b27,
            _:N29fd31ed844d42b3a088fd4f5a06fb85,
            _:N2b912bbd3c594e07a82f42e812762073,
            _:N6740c69fe31c4f80b94136d41f38476d,
            _:N7def5546a8164c86b458c8cd27f5d81e,
            _:N805508d599e548ad9b0d402af6be1192,
            _:Na054b4a0a0e44405babf3eb2305ce173,
            _:Nd30d54a5be3d4d5d882c455b53a05857,
            _:Ne28142c196ba48daa287c0417c7d68cd,
            _:Ne5738c53db744eeaad7652925eee1621,
