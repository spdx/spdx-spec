        sh:nodeKind sh:IRI ;
        sh:property _:N7b698bec36bd478ea5f9db897cb9357b,
            _:N91576e6171ba4bf488711d85790f707c .

    ns9:StorageAction a owl:Class ;
        rdfs:comment "Records the storage of a product."@en ;
        rdfs:subClassOf ns9:ModifyAction ;
        sh:nodeKind sh:IRI .

