    ns8:StateAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "This is the state of an affected Element at a specific moment in time."@en ;
        rdfs:subClassOf ns8:UseAction ;
        sh:nodeKind sh:IRI ;
        sh:property _:N96f4b52adf144126b04d46e6df60719a,
            _:Ne54444df07a84f139e869c740b34f786 .

    ns8:StorageAction a owl:Class ;
        rdfs:comment "Records the storage of a product."@en ;
        rdfs:subClassOf ns8:ModifyAction ;
        sh:nodeKind sh:IRI .

    ns8:StorageProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Prescribes the storage of a product."@en ;
        rdfs:subClassOf ns8:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:Nebab7758bbf24557b3f6de4b956c13bc .

    ns8:TestAction a owl:Class ;
        rdfs:comment "A test action is a specific action associated with a test."@en ;
        rdfs:subClassOf ns8:UseAction ;
        sh:nodeKind sh:IRI .

    ns8:TestProcess a owl:Class ;
        rdfs:comment "Test Process defines the testing process for an element."@en ;
        rdfs:subClassOf ns8:UseProcess ;
        sh:nodeKind sh:IRI .

    ns8:TransportAction a owl:Class,
            sh:NodeShape ;
        rdfs:comment "An actual change to a product's location."@en ;
        rdfs:subClassOf ns8:ModifyAction ;
        sh:nodeKind sh:IRI ;
        sh:property _:N2d48367dc8de4924a06238cfa70d6097,
            _:Nc1bf652a9531421d8182eefc1119caac,
            _:Nfdae87086a0f4c8c9a6d6eb1227d49da .

