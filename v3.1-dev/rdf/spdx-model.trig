        rdfs:range xsd:string .

    ns4:AbstractPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Refers to an abstract, conceptual software entity."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N59be092d676241fc8490919f6744b69b,
            _:Nb25995dc84da4045885da0d2e5eecce2,
