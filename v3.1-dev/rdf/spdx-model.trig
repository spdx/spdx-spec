        rdfs:label "hardware" ;
        rdfs:comment "The element follows the Hardware profile specification."@en .

    <https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/lite> a owl:NamedIndividual,
            ns1:ProfileIdentifierType ;
