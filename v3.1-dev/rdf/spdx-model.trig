        rdfs:range xsd:string .

    ns1:startTime a owl:DatatypeProperty ;
        rdfs:comment "Specifies the time from which an element is applicable / valid."@en ;
        rdfs:range xsd:dateTimeStamp .

    ns1:statement a owl:DatatypeProperty ;
