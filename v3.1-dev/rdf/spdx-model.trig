        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:property _:N1d4f4000053b4c66a5872541e28a1a27 .

    ns3:mass a owl:DatatypeProperty ;
        rdfs:comment "Information related to physical hardware."@en ;
