            sh:NodeShape ;
        rdfs:comment "Provides an SSVC assessment for a vulnerability."@en ;
        rdfs:subClassOf ns2:VulnAssessmentRelationship ;
        sh:nodeKind sh:IRI ;
        sh:property _:N540e18debf194b9c9fa0cd7585475b16 .

