        sh:nodeKind sh:IRI .

    ns3:Vulnerability a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Specifies a vulnerability and its associated information."@en ;
        rdfs:subClassOf ns1:Artifact ;
        sh:nodeKind sh:IRI ;
        sh:property _:N367091f413f54bbea59e1246a3e993df,
