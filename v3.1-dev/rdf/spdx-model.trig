        sh:nodeKind sh:IRI ;
        sh:property _:N15525e103cb249a89b7c529cc3d6efd4,
            _:N1d52b5b7051a40f49b2affade105f7f8,
            _:N4b6fb8aa382442c7be3d80fe400106a2,
            _:N5d39002cfca9411aa5e880e1560eff77,
            _:N5fd8277925bf473fabe596a9ea2c234f,
            _:Na390d54b162b418bad102532fd70ce03,
            _:Nc16e8f7305744ba5936e120e7d253747,
            _:Nd1c33b5a7771483ba00d7997519003e6,
            _:Nf3773e3184844bb7adc4ee831874418a .

