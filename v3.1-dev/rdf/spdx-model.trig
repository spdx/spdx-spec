        rdfs:range ns1:PositiveIntegerRange .

    ns7:outputModality a owl:ObjectProperty ;
        rdfs:comment "Fundamental data or sensory type produced as output by a software artifact or agent."@en ;
        rdfs:range ns1:Modality .

    ns7:packageUrl a owl:DatatypeProperty ;
        rdfs:comment """Provides a place for the SPDX data creator to record the Package-URL
for a software Package."""@en ;
        rdfs:range xsd:anyURI .

    ns7:primaryPurpose a owl:ObjectProperty ;
        rdfs:comment "Provides information about the primary purpose of the software artifact."@en ;
        rdfs:range ns7:SoftwarePurpose .

    ns7:sbomType a owl:ObjectProperty ;
