        rdfs:range ns4:SoftwarePurpose .

    ns4:artifactSize a owl:DatatypeProperty ;
        rdfs:comment "Identifies the size of a software Artifact, in bytes."@en ;
        rdfs:range xsd:nonNegativeInteger .

