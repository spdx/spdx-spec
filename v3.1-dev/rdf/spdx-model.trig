        rdfs:subClassOf ns1:DefinedProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N997081ee35f04d1792191ee2b9cf16b7,
            _:Nbd97606e466744b39b4a3d7647d03980,
