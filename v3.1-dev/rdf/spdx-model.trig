            ns5:SoftwarePurpose ;
        rdfs:label "patch" ;
        rdfs:comment "The Element contains a set of changes to update, fix, or improve another Element."@en .

    <https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/platform> a owl:NamedIndividual,
            ns5:SoftwarePurpose ;
