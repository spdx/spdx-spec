    _:N02a93621557344e5bffd2c68706fd65e a sh:SPARQLConstraint ;
        sh:message "When relationship is doesNotAffect, from must be a Vulnerability" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/doesNotAffect> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }
}""" .

    _:N030c11e140784ba7a7674437af9defe7 sh:datatype xsd:string ;
