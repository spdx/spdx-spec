        sh:nodeKind sh:IRI ;
        sh:property _:N2ccf7fc8f751439287bf0ada628589c6,
            _:N2e66c4922bcd4933bec80e1bedd04554,
            _:N4adad9f4067740f2aa0e13eb01a50800,
            _:N4b903b3701db4bc3aff46444a68e1a3f,
            _:N5361f0f0de4e45c4953d083eb3b11e81,
            _:N6e133101198d4edcb047504220a15bb0,
