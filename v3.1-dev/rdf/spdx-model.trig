        sh:nodeKind sh:IRI .

    ns5:Vulnerability a owl:Class,
            sh:NodeShape ;
        rdfs:comment "Specifies a vulnerability and its associated information."@en ;
        rdfs:subClassOf ns1:Artifact ;
        sh:nodeKind sh:IRI ;
        sh:property _:N00bc13bafa6b4e6a808f6b7dbf0233d5,
