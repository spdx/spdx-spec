        rdfs:comment """Captures the size of the dataset.

Deprecated in SPDX 3.1.
Use [artifactSize](../../Software/Properties/artifactSize.md) instead."""@en ;
        rdfs:range xsd:nonNegativeInteger .

    ns8:datasetType a owl:ObjectProperty ;
        rdfs:comment "Describes the type of the given dataset."@en ;
        rdfs:range ns8:DatasetType .

    ns8:datasetUpdateMechanism a owl:DatatypeProperty ;
        rdfs:comment "Describes a mechanism to update the dataset."@en ;
