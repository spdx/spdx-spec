    _:N064db4fe72f04115978611044096843b a sh:SPARQLConstraint ;
        sh:message "When relationship is affects, from must be a Vulnerability, Action, or DefinedProcess" ;
        sh:select """BASE <https://spdx.org/rdf/3/terms/>
SELECT $this WHERE {
    $this <Core/relationshipType> <Core/RelationshipType/affects> .
    $this <Core/from> ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Action> }
