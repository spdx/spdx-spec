        sh:nodeKind sh:IRI ;
        sh:property _:N0f0c6d03513c42249c27cfd963c6ff83,
            _:N16aa89186fbf4f7cb535aecc19996cb4,
            _:N54c89f32717e4b73b12fb8219036490d,
