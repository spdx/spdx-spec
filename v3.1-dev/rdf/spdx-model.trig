        rdfs:range xsd:anyURI .

    ns5:from a owl:ObjectProperty ;
        rdfs:comment "References the Element on the left-hand side of a relationship."@en ;
        rdfs:range ns5:Element .

    ns5:geographicPointLocation a owl:DatatypeProperty ;
        rdfs:comment "This is a set of point coordinates as defined in by the GPS standard."@en ;
        rdfs:range xsd:string .

    ns5:headquartersLocation a owl:ObjectProperty ;
        rdfs:comment "The headquartersLocation defines the location of the organization's headquarters."@en ;
        rdfs:range ns5:Location .

    ns5:identifier a owl:DatatypeProperty ;
        rdfs:comment "Uniquely identifies an external element."@en ;
        rdfs:range xsd:string .

    ns5:identifierLocator a owl:DatatypeProperty ;
        rdfs:comment "Provides the location for more information regarding an external identifier."@en ;
        rdfs:range xsd:anyURI .

    ns5:import a owl:ObjectProperty ;
        rdfs:comment "Provides an ExternalMap of Element identifiers."@en ;
        rdfs:range ns5:ExternalMap .

    ns5:inLanguage a owl:DatatypeProperty ;
        rdfs:comment "Specifies a human language used within the content of an Element or a property."@en ;
        rdfs:range xsd:string .

    ns5:intendedUse a owl:DatatypeProperty ;
        rdfs:comment "The intendedUse property is designed to capture a summary of how or for what item or artifact is meant to be used for."@en ;
        rdfs:range xsd:string .

    ns5:isoAutomationLevel a owl:ObjectProperty ;
        rdfs:comment "Indicates level of automation."@en ;
        rdfs:range ns5:IsoAutomationLevel .

    ns5:issuingAuthority a owl:DatatypeProperty ;
        rdfs:comment "An entity that is authorized to issue identification credentials."@en ;
