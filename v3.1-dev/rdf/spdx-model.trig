        rdfs:comment "The Element is an archived collection of one or more files (.tar, .zip, etc.)."@en .

    <https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/bom> a owl:NamedIndividual,
            ns2:SoftwarePurpose ;
        rdfs:label "bom" ;
