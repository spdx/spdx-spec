    ns3:EvaluationResult a owl:Class,
            sh:NodeShape ;
        rdfs:comment "EvaluationResult is the result of an evaluation."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N1da87a244d584f249c94fe9185a0f48a,
            _:N7591912bb75f4bc59518c8abec1223d8,
