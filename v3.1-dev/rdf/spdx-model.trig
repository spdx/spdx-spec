        sh:nodeKind sh:IRI ;
        sh:property _:N01c323d415a74d3a84325094b74f21f7 .

    ns9:VexAffectedVulnAssessmentRelationship a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Connects a vulnerability and an element designating the element as a product
affected by the vulnerability."""@en ;
