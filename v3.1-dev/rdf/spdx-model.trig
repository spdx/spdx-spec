            sh:NodeShape ;
        rdfs:comment "A prescribed change to a product's location."@en ;
        rdfs:subClassOf ns3:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N3c0df28db1914d2ea6e562e231bf283b,
            _:N55558a4d64e242b68c7aba4f885ed227,
