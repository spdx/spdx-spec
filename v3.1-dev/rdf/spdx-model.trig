            _:N3760e930e62f445987e7d5d40f6cdf6f,
            _:N63b648dfa47844eaa738ecb1169aefa4 .

    ns10:TransportProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A prescribed change to a product's location."@en ;
        rdfs:subClassOf ns10:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N75c9a6c576624bb1ad3a37306aa5a19d,
