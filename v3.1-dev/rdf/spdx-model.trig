        sh:nodeKind sh:IRI ;
        sh:property _:N04381127d73e431d8ebddd7e8e9951dc,
            _:N5bcb5e3491f34b218d89b6ed628731f6,
            _:N96bc8e406c8e4c24b1df7b8471a261ab,
            _:N9b5a3ed639e6451fab1d0d109d48f6be,
            _:Na3caf936188742ada515039d6f0394d8,
            _:Ndafd057aa3c34315bc95ac1b60c0c017,
            _:Ne864185de76c49eca075d15336d08a50,
            _:Nf97350512d8c41d3aa8fd9eba345db58,
            _:Nfa2daa2ac892419b95feb733dbddfc60 .

