        ns1:created "2026-01-23T03:01:00Z"^^xsd:dateTimeStamp ;
        ns1:createdBy ns1:SpdxOrganization ;
        ns1:specVersion "3.1" .

    <https://spdx.org/rdf/3.1/creationInfo_NoneElement> a ns1:CreationInfo ;
        rdfs:comment "This individual element was defined by the spec."@en ;
        ns1:created "2026-01-23T03:01:00Z"^^xsd:dateTimeStamp ;
        ns1:createdBy ns1:SpdxOrganization ;
        ns1:specVersion "3.1" .

    <https://spdx.org/rdf/3.1/creationInfo_NoneLicense> a ns1:CreationInfo ;
