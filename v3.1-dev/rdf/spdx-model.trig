        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns6:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns9:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0253c45ce2a74136bda0ced07c1a8cbe,
            _:N153d7dff286847c3a774f8e6539a3b3c,
            _:N1b06bf261176418a931a7744e1467522,
            _:N1bffec8b2c7d4bd7aef42b70a1a3cee2,
            _:N231b1444e77344e2876d5767ad22aff3,
            _:N25ee5fed7c7240f5b5e80b64c707a691,
            _:N2909575cde534562a6e13ec2d28f0f3e,
            _:N7d0e05ef238e46f9af34c333746b54ac,
            _:N86eaba08b0f346aeb16da3d4537cbe52,
            _:N8a2a4f28b9d04e1c89a51949e0ba3eb0,
