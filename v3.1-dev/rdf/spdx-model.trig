            sh:NodeShape ;
        rdfs:comment "Refers to an abstract, conceptual software entity."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N4341b1b665594fc8992b5286ffff3136,
            _:N5b7f1a295af04d34b06d4f7c46b66314,
