            sh:NodeShape ;
        rdfs:comment "A prescribed change to a product's location."@en ;
        rdfs:subClassOf ns6:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N0f308f683e4f4ec389316c362a3154ae,
            _:N97a448dab26440f994fb5b70f17ed157,
