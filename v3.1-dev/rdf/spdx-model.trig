        sh:nodeKind sh:IRI ;
        sh:property _:N503bd65cdcb74052aa8c70f04eafefa4,
            _:N75b5b5deac7248a399a7703761e2495b .

    ns4:OrLaterOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing this version, or any later version,
