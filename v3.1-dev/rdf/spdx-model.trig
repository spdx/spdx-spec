    ns2:EvaluationResult a owl:Class,
            sh:NodeShape ;
        rdfs:comment "EvaluationResult is the result of an evaluation."@en ;
        rdfs:subClassOf ns1:Element ;
        sh:nodeKind sh:IRI ;
        sh:property _:N2e7a080fb0ae4e288e1b9a84deae7662,
