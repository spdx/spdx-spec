            _:N6c06c6113a494aa693c8d65ead2b0429,
            _:Nf502ce4cde03426aa5b4f8eca7ac297a .

    ns9:TransportProcess a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A prescribed change to a product's location."@en ;
        rdfs:subClassOf ns9:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N2376a604ae554632a0886b5163151644,
            _:N5daac70cc64b4b94b66898216d47b2f9,
