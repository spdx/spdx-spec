        sh:nodeKind sh:IRI ;
        sh:property _:N508c0a7dd483467184fed07808bb67bf,
            _:N5fb99a3773ec46df91b5f28c80428f2d,
            _:N636aefdfdd2f43e58c5adbff2913abcb,
