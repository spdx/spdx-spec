        sh:nodeKind sh:IRI ;
        sh:property _:N8f3b02925fce40679729fd382e1b85a4,
            _:Ned52f2faa5414436a8d8806dc4d93000 .

    ns9:serverAuthenticationProtocol a owl:ObjectProperty ;
