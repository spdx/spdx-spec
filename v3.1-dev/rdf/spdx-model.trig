        sh:nodeKind sh:IRI ;
        sh:property _:N52cf7fa27b514022aa5b622ce7fa4275,
            _:N76494b94a8f44aa6b8660ff2cf395287 .

    ns5:OrLaterOperator a owl:Class,
            sh:NodeShape ;
        rdfs:comment """Portion of an AnyLicenseInfo representing this version, or any later version,
of the indicated License."""@en ;
        rdfs:subClassOf ns5:ExtendableLicense ;
        sh:nodeKind sh:IRI ;
        sh:property _:Nd2f78906957e43938a5f0686083a0cd3 .

