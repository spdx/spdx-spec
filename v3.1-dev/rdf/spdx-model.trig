        sh:nodeKind sh:IRI ;
        sh:property _:N2eca6d7338ca44bfa854476bb006dec5,
            _:Ne9cfab52d2b04050af455b146ea4f0fb .

    ns7:additionText a owl:DatatypeProperty ;
