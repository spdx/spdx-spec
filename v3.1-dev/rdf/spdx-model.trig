        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:property _:N1075092a015f4b79b35e3b76ca6915ab .

    ns9:mass a owl:DatatypeProperty ;
        rdfs:comment "Information related to physical hardware."@en ;
