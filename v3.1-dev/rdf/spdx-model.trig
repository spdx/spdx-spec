        dcterms:references <https://spdx.dev/specifications/> ;
        dcterms:title "System Package Data Exchange (SPDX) Ontology"@en ;
        owl:versionIRI spdx: ;
        omg-ann:copyright "Copyright (C) 2026 SPDX Project"@en .

    ns7:AIPackage a owl:Class,
            sh:NodeShape ;
        rdfs:comment "A Package that contains AI software or an AI model."@en ;
        rdfs:subClassOf ns3:Package ;
        sh:nodeKind sh:IRI ;
        sh:property _:N20c81d45ef7b499082c17587dfb01b7e,
            _:N24bbd199e50b4a24bfa13659851488ed,
            _:N2ce20a57711b454b90a49c74a23d69f3,
            _:N32db1c1a4aca4886be2973a63987c506,
            _:N3e396c79185c419bae61a87fa823942d,
