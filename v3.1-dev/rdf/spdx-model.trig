        sh:nodeKind sh:IRI ;
        sh:property _:N022f4d5033c341c88d9a77f46d7bb476,
            _:N5c64f04d3b184b8b9760de584a89625f .

    ns8:ListedLicenseException a owl:Class,
            sh:NodeShape ;
