            ns1:HashAlgorithm ;
        rdfs:label "adler32" ;
        rdfs:comment "Adler-32 checksum is part of the widely used zlib compression library as defined in [RFC 1950](https://datatracker.ietf.org/doc/rfc1950/) Section 2.3."@en .

