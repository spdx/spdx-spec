        rdfs:subClassOf ns9:ModifyProcess ;
        sh:nodeKind sh:IRI ;
        sh:property _:N144fbdfcdd584c6fa3e6a104867520ac,
            _:N19360f670b2b44cdbb215c6dbd26d58c,
