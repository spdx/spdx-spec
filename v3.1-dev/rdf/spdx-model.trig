        rdfs:subClassOf ns10:CreateProcess ;
        sh:nodeKind sh:IRI .

    ns10:BoundaryCrossingAction a owl:Class ;
        rdfs:comment "An action of crossing a boundary is defined in this class."@en ;
        rdfs:subClassOf ns10:UseAction ;
        sh:nodeKind sh:IRI .

