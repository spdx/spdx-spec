        rdfs:subClassOf ns7:VulnAssessmentRelationship ;
        sh:nodeKind sh:IRI ;
        sh:property _:N3efe9748bbd240ed8b797cfb1be65f5f .

    ns7:VexAffectedVulnAssessmentRelationship a owl:Class,
