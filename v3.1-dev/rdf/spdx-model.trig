        rdfs:comment "The element follows the Build profile specification."@en .

    <https://spdx.org/rdf/3.1/terms/Core/ProfileIdentifierType/core> a owl:NamedIndividual,
            ns1:ProfileIdentifierType ;
        rdfs:label "core" ;
