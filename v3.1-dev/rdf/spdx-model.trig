        sh:nodeKind sh:IRI ;
        sh:property _:N385d08e8bfd4454e8743e2074d17bad6,
            _:N452dcc2d1a7049788894e8dc558e9f89,
            _:N68bfbcb2c4784bd1ae6c901ef83dfdab,
            _:N7190e657d54342fc861f9f72d3b9d673,
            _:N9ef10ebb102b45ffbfdf2b210b3af4bd,
            _:Na7ce3765b5244e78a1821b3940cd6387,
            _:Nb6b7c89d760d4cc9a98057568b60ab81,
            _:Nd96bc24b7adf4611ab83502b50ff513a,
            _:Nffcd69fd96aa4bee98526f15c2084fcb .

