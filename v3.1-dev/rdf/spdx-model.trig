        sh:nodeKind sh:IRI ;
        sh:property _:N2e2e9ebdcd314e5589a9a059b1d4ff3e,
            _:N38a8887bb7f24195adfb9aa17e7ba73d,
            _:N5abececfb6dc406daaa5636b7d539250,
