      {
        "@language": "en",
        "@value": "Used to associate a `from` Artifact with each `to` /Security/Vulnerability."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "hasAssociatedVulnerability"
      }
