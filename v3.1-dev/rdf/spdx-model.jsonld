      "https://spdx.org/rdf/3/terms/Core/SpecificationType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A mandatory legal specification issued by a governmental or regulatory authority. Compliance is enforceable by law."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "regulation"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalRefType/buildMeta",
