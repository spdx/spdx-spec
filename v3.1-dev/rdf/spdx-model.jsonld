      {
        "@id": "https://spdx.org/rdf/3/terms/Core/PositiveIntegerRange"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/RelationshipType/contains",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
