  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/requirementUUID",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The UUID used by a requirements management or any other lifecycle management tool to uniquely identify a requirement item. UUID, or universally unique ID, is a standard term in requirements engineering."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "requirementUUID"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Build/buildStartTime",
    "@type": [
