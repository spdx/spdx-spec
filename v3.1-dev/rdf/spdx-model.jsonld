      {
        "@language": "en",
        "@value": "Automotive Safety Integrity Level C under ISO 26262."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "asilC"
      }
    ]
  },
  {
