    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "When relationship is serializedInArtifact, to must be an Artifact"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/serializedInArtifact> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Artifact> }\n}"
      }
    ]
  },
  {
