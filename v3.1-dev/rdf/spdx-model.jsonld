      {
        "@language": "en",
        "@value": "The `from` /Security/Vulnerability impact is being investigated for each `to` Element. The use of the `underInvestigationFor` type is constrained to `/Security/VexUnderInvestigationVulnAssessmentRelationship` classed relationships."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
