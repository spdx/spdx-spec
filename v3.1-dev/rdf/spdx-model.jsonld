      {
        "@language": "en",
        "@value": "The `from` Element was invoked by the `to` Agent, during a LifecycleScopeType period (for example, a Build element that describes a build step)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
