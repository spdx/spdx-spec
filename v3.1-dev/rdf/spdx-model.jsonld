        "@value": "Identifies an external Element used within an SpdxDocument but defined\nexternal to that SpdxDocument."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ]
  },
