      {
        "@id": "https://spdx.org/rdf/3/terms/Security/ExploitCatalogType"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/devLifecycleStage",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
