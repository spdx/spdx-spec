        "@language": "en",
        "@value": "Specifies the licenseId that is preferred to be used in place of a deprecated\nLicense or LicenseAddition."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
