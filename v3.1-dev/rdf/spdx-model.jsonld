      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/geographicPointLocation",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "This is a set of point coordinates as defined in by the GPS standard."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
