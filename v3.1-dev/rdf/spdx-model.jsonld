    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Relates a `from` Vulnerability and each `to` Element with a security assessment. The use of the `hasAssessmentFor` type is constrained to `VulnAssessmentRelationship` classed relationships."
