    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "This is the individual, business, or organization who was previously managing or responsible for the goods, services, or assets."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/Agent"
      }
    ]
  },
