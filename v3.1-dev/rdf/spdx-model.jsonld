      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/SupplyChain/ChangeAction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An actual change to a product."
      }
    ],
