    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Package-URL, as defined in the corresponding [Annex](../../../annexes/pkg-url-specification.md) of this document."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "packageUrl"
      }
    ]
  },
