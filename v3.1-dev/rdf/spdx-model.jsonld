  {
    "@id": "https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/manifest",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The Element is a software manifest."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "manifest"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/namespace",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Provides an unambiguous mechanism for conveying a URI fragment portion of an\nElement ID."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
