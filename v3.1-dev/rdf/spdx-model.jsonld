  },
  {
    "@id": "_:N6ea542223aa54c408254682da1e23bf8",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "https://spdx.org/rdf/3.1/terms/ExpandedLicensing/ExtendableLicense is an abstract class and should not be instantiated directly. Instantiate a subclass instead."
      }
    ],
