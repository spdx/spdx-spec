  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/eli",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "[European Legislation Identifier (ELI)](https://eur-lex.europa.eu/content/help/eurlex-content/eli.html) is a Uniform Resource Identifier (URI) that uniquely identifies a legal resource, typically consisting of a document type, adoption year, and document number (e.g., `http://data.europa.eu/eli/reg/2024/2847/oj`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "eli"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Software/SbomType/build",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Software/SbomType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "SBOM generated as part of the process of building the software to create a releasable artifact (e.g., executable or package) from data such as source files, dependencies, built components, build process ephemeral data, and other SBOMs."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "build"
      }
    ]
  },
