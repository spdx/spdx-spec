  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isci",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "International Standard Collection Identifier (ISCI) is a variable-length identifier standardized by [ISO 27730](https://www.iso.org/standard/44293.html) for identifying collections held by libraries, archives, museums, and other memory institutions. It consists of two parts: the identifier for the assigning organization (an ISIL) enclosed in square brackets, followed by a local collection identifier string (e.g., `[FR-751041001]Casadesus1`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "isci"
      }
    ]
  },
