        "@value": "Level 4 - High automation. The system performs parts of its mission without external intervention."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "highAutomation"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType/query",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
