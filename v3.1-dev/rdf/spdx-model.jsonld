      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/AI/SafetyRiskAssessmentType/serious",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/AI/SafetyRiskAssessmentType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The highest level of risk posed by an AI system."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "serious"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/glue",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "[GLobal Unique Enterprise (GLUE) Identifiers](https://datatracker.ietf.org/doc/draft-ietf-spice-glue-id/), as defined by the IETF Internet-Draft, is expressed as a GLUE URI, a Uniform Resource Identifier that standardizes the representation of existing organizational entity identifiers."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "glue"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/patch",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Software/SoftwarePurpose"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The Element contains a set of changes to update, fix, or improve another Element."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "patch"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/postOfficeBoxNumber",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The number that identifies a PO box. A PO box is a box in a post office or other postal service location assigned to an organization where postal items may be kept."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalRefType/bom",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalRefType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A reference to a bill of materials related to a package."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "bom"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/RelationshipType/hasInput",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/RelationshipType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The `from` Build, DefinedProcess or Action element has each `to` Element as an input."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "hasInput"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibrn",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "[International Business Registration Number (IBRN)](https://ekys.org/business_identifiers/) is a unique identifier for legal entities standardized by [ISO 8000-116](https://www.iso.org/standard/75117.html). It is composed of two parts: a jurisdiction prefix and a local authoritative legal entity identifier (ALEI), separated by a colon. The prefix contains an ISO 3166 country code, an optional subdivision code, and a register code (e.g., `US-DE.BER:3031657`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ibrn"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ark",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "[Archival Resource Key (ARK)](https://arks.org/about/), is a Uniform Resource Identifier (URI) suited to being a persistent identifier for information objects of any type, standardized by the [ARK Identifier Scheme](https://datatracker.ietf.org/doc/draft-kunze-ark/) Internet-Draft. It consists of the \"ark:\" label followed by a Name Assigning Authority Number, a forward slash, a name, and an optional qualifier (e.g., `ark:12148/btv1b8449691v/f29`)."
      }
    ],
