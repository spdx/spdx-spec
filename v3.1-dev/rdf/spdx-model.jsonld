      {
        "@id": "_:Nd88bb1ccbaa34550905419a2730abe40"
      }
    ]
  },
  {
    "@id": "_:Nd88bb1ccbaa34550905419a2730abe40",
    "http://www.w3.org/ns/shacl#datatype": [
      {
