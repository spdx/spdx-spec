    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The `from` Element has a role in the `to` Element. The use of the `hasRoleIn` type is constrained to `RoleRelationship` classed relationships. The type of role can be specified using a `givenRole` property on the `to` Element."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "hasRoleIn"
      }
    ]
  },
