    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "ISO level of automation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Hardware/yAxisLength",
    "@type": [
