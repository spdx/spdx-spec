# N2e38e45d17764c4994d279ded55fd249 node1466
node1466 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N2e38e45d17764c4994d279ded55fd249</B></td></tr><tr><td href='N2e38e45d17764c4994d279ded55fd249' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N2e38e45d17764c4994d279ded55fd249</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasUninstall, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasUninstall&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
