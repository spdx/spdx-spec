# N40ce5aff26e94f029496ae31c79eb37a node1556
node1556 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N40ce5aff26e94f029496ae31c79eb37a</B></td></tr><tr><td href='N40ce5aff26e94f029496ae31c79eb37a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N40ce5aff26e94f029496ae31c79eb37a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
