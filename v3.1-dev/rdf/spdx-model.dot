# Ne4b9456049db4cf29ce931caec50c11d node636
node636 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne4b9456049db4cf29ce931caec50c11d</B></td></tr><tr><td href='Ne4b9456049db4cf29ce931caec50c11d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne4b9456049db4cf29ce931caec50c11d</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is providesSupportFor, from must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/providesSupportFor&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
