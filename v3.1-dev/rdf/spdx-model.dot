node1057 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N1048b623bb744f05a4c573039221eb30</B></td></tr><tr><td href='N1048b623bb744f05a4c573039221eb30' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N1048b623bb744f05a4c573039221eb30</font></td></tr></table> > ] 
