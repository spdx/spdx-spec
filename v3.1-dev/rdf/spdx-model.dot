# N582d911a1dde4dd1b9c59dc1159bb53a node1212
node1212 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N582d911a1dde4dd1b9c59dc1159bb53a</B></td></tr><tr><td href='N582d911a1dde4dd1b9c59dc1159bb53a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N582d911a1dde4dd1b9c59dc1159bb53a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is resolved, from must be a ResolutionAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/resolved&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;SupplyChain/ResolutionAction&gt; }
}&quot;</td></tr></table> > ] 
