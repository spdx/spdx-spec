# Nf5c13668ce13425ea802b1bdd1967079 node1443
node1443 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf5c13668ce13425ea802b1bdd1967079</B></td></tr><tr><td href='Nf5c13668ce13425ea802b1bdd1967079' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf5c13668ce13425ea802b1bdd1967079</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasInput, from must be a Build, DefinedProcess, or Action&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
