# N738249ecafdd4758831339ad743ded7c node1217
node1217 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N738249ecafdd4758831339ad743ded7c</B></td></tr><tr><td href='N738249ecafdd4758831339ad743ded7c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N738249ecafdd4758831339ad743ded7c</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is assumes, to must be an Assumption&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
