# N3cc4642002ea48faa877db0dd15a6874 node545
node545 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N3cc4642002ea48faa877db0dd15a6874</B></td></tr><tr><td href='N3cc4642002ea48faa877db0dd15a6874' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N3cc4642002ea48faa877db0dd15a6874</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is affects, from must be a Vulnerability, Action, or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/affects&gt; .
    $this &lt;Core/from&gt; ?from .
