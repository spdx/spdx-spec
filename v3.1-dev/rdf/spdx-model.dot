# Nb023e1c33dd842a9bfdb1ba1b7f8e554 node1417
node1417 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb023e1c33dd842a9bfdb1ba1b7f8e554</B></td></tr><tr><td href='Nb023e1c33dd842a9bfdb1ba1b7f8e554' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb023e1c33dd842a9bfdb1ba1b7f8e554</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is reportedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/reportedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
