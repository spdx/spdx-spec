node474 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne2cdea0645b6475eb4768825331679ed</B></td></tr><tr><td href='Ne2cdea0645b6475eb4768825331679ed' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne2cdea0645b6475eb4768825331679ed</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is assumes, to must be an Assumption&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
