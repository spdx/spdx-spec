node227 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N71b4b419bb184cc48780c94dfe140326</B></td></tr><tr><td href='N71b4b419bb184cc48780c94dfe140326' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N71b4b419bb184cc48780c94dfe140326</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasResolution, to must be an OutOfSpecAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
