# N00008ad3f6514abebe79a12bbc1af5c6 node435
node435 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N00008ad3f6514abebe79a12bbc1af5c6</B></td></tr><tr><td href='N00008ad3f6514abebe79a12bbc1af5c6' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N00008ad3f6514abebe79a12bbc1af5c6</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is verifiedBy, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/verifiedBy&gt; .
    $this &lt;Core/from&gt; ?from .
