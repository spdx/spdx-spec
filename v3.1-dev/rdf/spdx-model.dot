node1372 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nab8c01c329ae4664917f3358b34fb8b5</B></td></tr><tr><td href='Nab8c01c329ae4664917f3358b34fb8b5' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nab8c01c329ae4664917f3358b34fb8b5</font></td></tr></table> > ] 
