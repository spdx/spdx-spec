# N4134db38d93045d691735459c858f2b3 node1399
node1399 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N4134db38d93045d691735459c858f2b3</B></td></tr><tr><td href='N4134db38d93045d691735459c858f2b3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N4134db38d93045d691735459c858f2b3</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is verifiedBy, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/verifiedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
