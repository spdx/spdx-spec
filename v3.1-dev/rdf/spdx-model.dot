node1420 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N835965c6084e41edaf465ffe1e55ae9c</B></td></tr><tr><td href='N835965c6084e41edaf465ffe1e55ae9c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N835965c6084e41edaf465ffe1e55ae9c</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
