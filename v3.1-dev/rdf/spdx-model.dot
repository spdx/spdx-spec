node1487 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>active</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RequirementStatusType/active' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RequirementStatusType/active</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A requirement has been approved by stakeholder, and can be include in traceability.&quot;@en</td></tr></table> > ] 
