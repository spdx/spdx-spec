node193 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N72be0216f9e145d39e3ee2121c374abd</B></td></tr><tr><td href='N72be0216f9e145d39e3ee2121c374abd' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N72be0216f9e145d39e3ee2121c374abd</font></td></tr></table> > ] 
