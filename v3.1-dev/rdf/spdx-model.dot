node320 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N39934cf87a924d219d66c9dcd238b4f3</B></td></tr><tr><td href='N39934cf87a924d219d66c9dcd238b4f3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N39934cf87a924d219d66c9dcd238b4f3</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
