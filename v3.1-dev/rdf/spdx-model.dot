node0 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>hasExample</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipType/hasExample' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipType/hasExample</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Every `to` Element is an example for the `from` Element (`from` hasExample `to`).&quot;@en</td></tr></table> > ] 
# Nbaaeed511c2b4fb296bb30982536d25e node1
node1 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nbaaeed511c2b4fb296bb30982536d25e</B></td></tr><tr><td href='Nbaaeed511c2b4fb296bb30982536d25e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nbaaeed511c2b4fb296bb30982536d25e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is reportedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/reportedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
