# N61db6a054c07428ab673d501973a4008 node1745
node1745 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N61db6a054c07428ab673d501973a4008</B></td></tr><tr><td href='N61db6a054c07428ab673d501973a4008' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N61db6a054c07428ab673d501973a4008</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is runsOn, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/runsOn&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
# Nb9e4c022d1594f678f0869121d806142 node1746
