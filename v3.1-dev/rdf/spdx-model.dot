node1536 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N44ff0f1b3c904abca30fb517a9a8dd72</B></td></tr><tr><td href='N44ff0f1b3c904abca30fb517a9a8dd72' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N44ff0f1b3c904abca30fb517a9a8dd72</font></td></tr></table> > ] 
