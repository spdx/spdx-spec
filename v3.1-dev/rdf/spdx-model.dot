# N92da554658334cce89c496bfbb1e2211 node1347
node1347 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N92da554658334cce89c496bfbb1e2211</B></td></tr><tr><td href='N92da554658334cce89c496bfbb1e2211' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N92da554658334cce89c496bfbb1e2211</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is doesNotAffect, class must be VexNotAffectedVulnAssessmentRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
