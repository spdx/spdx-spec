node763 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N56788e1183a14288af12869205ab41a4</B></td></tr><tr><td href='N56788e1183a14288af12869205ab41a4' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N56788e1183a14288af12869205ab41a4</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:minCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
# https://spdx.org/rdf/3.1/terms/Security/SsvcDecisionType/attend node764
node764 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>attend</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Security/SsvcDecisionType/attend' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Security/SsvcDecisionType/attend</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The vulnerability requires attention from the organization&#x27;s internal, supervisory-level individuals. Necessary actions include requesting assistance or information about the vulnerability, and may involve publishing a notification either internally and/or externally. CISA recommends remediating Attend vulnerabilities sooner than standard update timelines.&quot;@en</td></tr></table> > ] 
