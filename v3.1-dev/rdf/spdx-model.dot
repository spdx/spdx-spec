# https://spdx.org/rdf/3/terms/Core/SpecificationType/specification node1295
node1295 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>specification</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/SpecificationType/specification' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/SpecificationType/specification</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A specification is a detailed document (or set of documents) that describes the requirements, design, behavior, or other characteristics of a system, component, or process so that all stakeholders have a clear, unambiguous reference.&quot;@en</td></tr></table> > ] 
# N8beb8e766c6440918368413e92a4f426 node1296
node1296 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8beb8e766c6440918368413e92a4f426</B></td></tr><tr><td href='N8beb8e766c6440918368413e92a4f426' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8beb8e766c6440918368413e92a4f426</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is createdBy, from must be an Action or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/createdBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/DefinedProcess&gt; }
}&quot;</td></tr></table> > ] 
