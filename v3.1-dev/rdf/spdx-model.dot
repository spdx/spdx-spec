# Nc375cbcb39be498db034ab3c66e6ef29 node1478
node1478 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nc375cbcb39be498db034ab3c66e6ef29</B></td></tr><tr><td href='Nc375cbcb39be498db034ab3c66e6ef29' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nc375cbcb39be498db034ab3c66e6ef29</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is providesSupportFor, from must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
