# Na8ddf5d8ca074042b0846e0099bc7836 node1569
node1569 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na8ddf5d8ca074042b0846e0099bc7836</B></td></tr><tr><td href='Na8ddf5d8ca074042b0846e0099bc7836' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na8ddf5d8ca074042b0846e0099bc7836</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is runsOn, to must be a Hardware&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/runsOn&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Hardware/Hardware&gt; }
}&quot;</td></tr></table> > ] 
