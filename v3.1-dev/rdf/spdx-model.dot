# Nc2a185b6336e4fe99c0355bcf2a0eb22 node454
node454 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nc2a185b6336e4fe99c0355bcf2a0eb22</B></td></tr><tr><td href='Nc2a185b6336e4fe99c0355bcf2a0eb22' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nc2a185b6336e4fe99c0355bcf2a0eb22</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is resolved, to must be an OutOfSpecAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/resolved&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;SupplyChain/OutOfSpecAction&gt; }
}&quot;</td></tr></table> > ] 
