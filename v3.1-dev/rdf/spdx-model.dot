node983 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N083ca5d08c05431ba449100a3a9ca80f</B></td></tr><tr><td href='N083ca5d08c05431ba449100a3a9ca80f' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N083ca5d08c05431ba449100a3a9ca80f</font></td></tr></table> > ] 
