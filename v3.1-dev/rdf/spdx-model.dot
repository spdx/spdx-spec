node601 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>withdrawnTime</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Security/withdrawnTime' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Security/withdrawnTime</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Specified the time and date when a vulnerability was withdrawn.&quot;@en</td></tr></table> > ] 
