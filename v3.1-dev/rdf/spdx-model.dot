# N9e9347a1f7824c13b3197a6004f3a77d node1284
node1284 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N9e9347a1f7824c13b3197a6004f3a77d</B></td></tr><tr><td href='N9e9347a1f7824c13b3197a6004f3a77d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N9e9347a1f7824c13b3197a6004f3a77d</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasResolution, from must be a ResolutionAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasResolution&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;SupplyChain/ResolutionAction&gt; }
}&quot;</td></tr></table> > ] 
