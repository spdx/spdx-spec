# N7ce5721602cc420faaa84fdf4c021ea7 node1702
node1702 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N7ce5721602cc420faaa84fdf4c021ea7</B></td></tr><tr><td href='N7ce5721602cc420faaa84fdf4c021ea7' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N7ce5721602cc420faaa84fdf4c021ea7</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is conformsTo, to must be an Assumption or Specification&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
