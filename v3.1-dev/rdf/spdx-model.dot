node1093 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>source</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Software/SbomType/source' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Software/SbomType/source</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;SBOM created directly from the development environment, source files, and included dependencies used to build a product artifact.&quot;@en</td></tr></table> > ] 
