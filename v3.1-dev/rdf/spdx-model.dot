node762 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>md2</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/HashAlgorithm/md2' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/HashAlgorithm/md2</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;MD2 message-digest algorithm, as defined in [RFC 1319](https://datatracker.ietf.org/doc/rfc1319/).&quot;@en</td></tr></table> > ] 
