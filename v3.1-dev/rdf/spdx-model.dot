# N3465b5c7d5fe4a9a914863e0c94c10c2 node624
node624 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N3465b5c7d5fe4a9a914863e0c94c10c2</B></td></tr><tr><td href='N3465b5c7d5fe4a9a914863e0c94c10c2' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N3465b5c7d5fe4a9a914863e0c94c10c2</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasInstall, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasInstall&gt; .
    $this &lt;Core/to&gt; ?to .
