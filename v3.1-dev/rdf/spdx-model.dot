node1527 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>email</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/email' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/email</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Email address, as defined in [RFC 3696](https://datatracker.ietf.org/doc/rfc3696/) Section 3.&quot;@en</td></tr></table> > ] 
