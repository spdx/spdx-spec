# Ne32ce2482e63409396a7c7933871dddc node1089
node1089 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne32ce2482e63409396a7c7933871dddc</B></td></tr><tr><td href='Ne32ce2482e63409396a7c7933871dddc' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne32ce2482e63409396a7c7933871dddc</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasTest, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
