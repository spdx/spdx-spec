# Nf9a6d89ecd4b45e8ac243bd8f492b7e0 node1831
node1831 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf9a6d89ecd4b45e8ac243bd8f492b7e0</B></td></tr><tr><td href='Nf9a6d89ecd4b45e8ac243bd8f492b7e0' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf9a6d89ecd4b45e8ac243bd8f492b7e0</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is implementedBy, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/implementedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
