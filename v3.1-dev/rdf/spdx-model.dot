# N1792e96a3057406488e06a4153f09831 node605
node605 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N1792e96a3057406488e06a4153f09831</B></td></tr><tr><td href='N1792e96a3057406488e06a4153f09831' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N1792e96a3057406488e06a4153f09831</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;At least one of Core/country, Core/city, Core/streetAddress, Core/geographicPointLocation, or Core/name is required&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    FILTER NOT EXISTS { $this &lt;Core/country&gt; ?country . }
    FILTER NOT EXISTS { $this &lt;Core/city&gt; ?city . }
    FILTER NOT EXISTS { $this &lt;Core/streetAddress&gt; ?streetAddress . }
    FILTER NOT EXISTS { $this &lt;Core/geographicPointLocation&gt; ?point . }
    FILTER NOT EXISTS { $this &lt;Core/name&gt; ?name . }
}&quot;</td></tr></table> > ] 
