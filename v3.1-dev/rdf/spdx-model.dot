# N855eae6623be46c79fa03e9734c15cef node1351
node1351 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N855eae6623be46c79fa03e9734c15cef</B></td></tr><tr><td href='N855eae6623be46c79fa03e9734c15cef' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N855eae6623be46c79fa03e9734c15cef</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is invokedBy, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
