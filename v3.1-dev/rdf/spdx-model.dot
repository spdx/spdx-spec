node737 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>postOfficeBoxNumber</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/postOfficeBoxNumber' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/postOfficeBoxNumber</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The number that identifies a PO box. A PO box is a box in a post office or other postal service location assigned to an organization where postal items may be kept.&quot;@en</td></tr></table> > ] 
