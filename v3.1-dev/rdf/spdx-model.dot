# Nbe2ed2da0ca743eba4109776708bdc7b node1401
node1401 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nbe2ed2da0ca743eba4109776708bdc7b</B></td></tr><tr><td href='Nbe2ed2da0ca743eba4109776708bdc7b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nbe2ed2da0ca743eba4109776708bdc7b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasResolution, to must be an OutOfSpecAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
