# Ncf97e9fb59a04abf9e595428d10aa511 node1305
node1305 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ncf97e9fb59a04abf9e595428d10aa511</B></td></tr><tr><td href='Ncf97e9fb59a04abf9e595428d10aa511' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ncf97e9fb59a04abf9e595428d10aa511</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is serializedInArtifact, from must be a SpdxDocument&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
