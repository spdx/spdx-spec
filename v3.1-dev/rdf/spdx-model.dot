# Nf6b18cf099ab4b4f9bdc7d98cc23aa70 node1842
node1842 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf6b18cf099ab4b4f9bdc7d98cc23aa70</B></td></tr><tr><td href='Nf6b18cf099ab4b4f9bdc7d98cc23aa70' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf6b18cf099ab4b4f9bdc7d98cc23aa70</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasResolution, from must be a ResolutionAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasResolution&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;SupplyChain/ResolutionAction&gt; }
}&quot;</td></tr></table> > ] 
