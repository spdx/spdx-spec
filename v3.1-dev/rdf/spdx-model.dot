# N226bad01f9ee45b8bdb6c0c85f768e7d node2039
node2039 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N226bad01f9ee45b8bdb6c0c85f768e7d</B></td></tr><tr><td href='N226bad01f9ee45b8bdb6c0c85f768e7d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N226bad01f9ee45b8bdb6c0c85f768e7d</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasInstall, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasInstall&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Artifact&gt; }
}&quot;</td></tr></table> > ] 
# N71128eb0bd97425b8d3fc717e5eafead node2040
node2040 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N71128eb0bd97425b8d3fc717e5eafead</B></td></tr><tr><td href='N71128eb0bd97425b8d3fc717e5eafead' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N71128eb0bd97425b8d3fc717e5eafead</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is verifiedBy, to must be a RequirementVerification&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/verifiedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;FunctionalSafety/RequirementVerification&gt; }
}&quot;</td></tr></table> > ] 
