node1653 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N522163a91aec4c1b8fa51afa3df9623e</B></td></tr><tr><td href='N522163a91aec4c1b8fa51afa3df9623e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N522163a91aec4c1b8fa51afa3df9623e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
