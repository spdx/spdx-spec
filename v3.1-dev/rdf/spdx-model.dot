# N054709227c6e4d0abc1f3bb23baa41f2 node1222
node1222 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N054709227c6e4d0abc1f3bb23baa41f2</B></td></tr><tr><td href='N054709227c6e4d0abc1f3bb23baa41f2' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N054709227c6e4d0abc1f3bb23baa41f2</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is invokedBy, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
