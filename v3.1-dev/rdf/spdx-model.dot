node656 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Requirement</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/Requirement' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/Requirement</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A distinct unit representing a requirement, as used in systems, software, and hardware engineering.&quot;@en</td></tr></table> > ] 
