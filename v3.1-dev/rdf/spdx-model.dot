node273 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>validUntilTime</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/validUntilTime' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/validUntilTime</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Specifies until when the artifact can be used before its usage needs to be
