# Nda0cae88e2d2416f9064a7b5a79b2548 node1434
node1434 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nda0cae88e2d2416f9064a7b5a79b2548</B></td></tr><tr><td href='Nda0cae88e2d2416f9064a7b5a79b2548' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nda0cae88e2d2416f9064a7b5a79b2548</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is invokedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
