# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iswc node839
node839 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>iswc</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iswc' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iswc</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;[International Standard Musical Work Code (ISWC)](https://www.iswc.org/iswc) is an 11-character unique identifier standardized by [ISO 15707](https://www.iso.org/standard/83125.html) for musical works (compositions) as distinct from specific recordings. While the &quot;ISWC&quot; label and grouping separators (dots and hyphens) are used for human readability, they shall be omitted when the identifier is stored electronically (e.g., `T0017812031`).&quot;@en</td></tr></table> > ] 
# N58a0ed8d26f545079bad02c6806ea8f7 node840
node840 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N58a0ed8d26f545079bad02c6806ea8f7</B></td></tr><tr><td href='N58a0ed8d26f545079bad02c6806ea8f7' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N58a0ed8d26f545079bad02c6806ea8f7</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasAssociatedVulnerability, to must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasAssociatedVulnerability&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
