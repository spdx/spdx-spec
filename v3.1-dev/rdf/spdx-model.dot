# N343e2b8d2f3a4bdf99f6f7b3af98d3c9 node179
node179 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N343e2b8d2f3a4bdf99f6f7b3af98d3c9</B></td></tr><tr><td href='N343e2b8d2f3a4bdf99f6f7b3af98d3c9' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N343e2b8d2f3a4bdf99f6f7b3af98d3c9</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is tracedToDetail, to must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/tracedToDetail&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
