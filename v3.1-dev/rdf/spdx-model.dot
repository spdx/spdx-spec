# N6da0979fd2d24465b5a3f7c3f61e2835 node1365
node1365 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N6da0979fd2d24465b5a3f7c3f61e2835</B></td></tr><tr><td href='N6da0979fd2d24465b5a3f7c3f61e2835' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N6da0979fd2d24465b5a3f7c3f61e2835</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, to must be a Relationship whose relationshipType is invokedBy&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
