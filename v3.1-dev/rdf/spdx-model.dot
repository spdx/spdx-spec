# N97fa0c3c2f6f458283b51ecbbba98f1c node1724
node1724 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N97fa0c3c2f6f458283b51ecbbba98f1c</B></td></tr><tr><td href='N97fa0c3c2f6f458283b51ecbbba98f1c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N97fa0c3c2f6f458283b51ecbbba98f1c</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasConcludedLicense, to must be an AnyLicenseInfo&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasConcludedLicense&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;SimpleLicensing/AnyLicenseInfo&gt; }
}&quot;</td></tr></table> > ] 
# Nb4b40b2e811343d08248f0f7b5e0a73a node1725
