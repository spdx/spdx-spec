# N683dcd727128417789eccb20fb90b279 node936
node936 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N683dcd727128417789eccb20fb90b279</B></td></tr><tr><td href='N683dcd727128417789eccb20fb90b279' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N683dcd727128417789eccb20fb90b279</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is usesTool, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/usesTool&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
# Nacb84a344c8147ccbf0e4836a767595d node937
node937 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nacb84a344c8147ccbf0e4836a767595d</B></td></tr><tr><td href='Nacb84a344c8147ccbf0e4836a767595d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nacb84a344c8147ccbf0e4836a767595d</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, to must be a Relationship whose relationshipType is invokedBy&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/delegatedTo&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS {
        ?to rdf:type/rdfs:subClassOf* &lt;Core/Relationship&gt; .
        ?to &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    }
}&quot;</td></tr></table> > ] 
