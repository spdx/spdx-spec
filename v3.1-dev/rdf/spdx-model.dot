node1699 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ncbeac8d41c77428497234c719cbf6360</B></td></tr><tr><td href='Ncbeac8d41c77428497234c719cbf6360' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ncbeac8d41c77428497234c719cbf6360</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasAssessmentFor, class must be VulnAssessmentRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
