# https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/orcidid node835
node835 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>orcidid</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/orcidid' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/orcidid</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;[Open Researcher and Contributor ID (ORCID) iD](https://info.orcid.org/what-is-orcid/) is a unique identifier for authors and contributors in scholarly communication; as a subset of the International Standard Name Identifier (ISNI), it typically appears as a URI such as `https://orcid.org/0000-0002-1825-0097`.&quot;@en</td></tr></table> > ] 
