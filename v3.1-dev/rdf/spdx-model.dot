# Na81adcdb611046ebb58582a7f5ca5447 node1629
node1629 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na81adcdb611046ebb58582a7f5ca5447</B></td></tr><tr><td href='Na81adcdb611046ebb58582a7f5ca5447' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na81adcdb611046ebb58582a7f5ca5447</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is republishedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
