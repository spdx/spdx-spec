# Na310972aca6f4235805cbc899f019814 node1585
node1585 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na310972aca6f4235805cbc899f019814</B></td></tr><tr><td href='Na310972aca6f4235805cbc899f019814' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na310972aca6f4235805cbc899f019814</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is publishedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
