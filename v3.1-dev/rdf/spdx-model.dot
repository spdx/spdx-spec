node1254 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>hasStaticLink</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipType/hasStaticLink' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipType/hasStaticLink</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The `from` Element statically links in each `to` Element, during a LifecycleScopeType period.&quot;@en</td></tr></table> > ] 
