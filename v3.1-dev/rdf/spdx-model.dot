# N2c72e3fe86734b7cbf7813054324653d node1428
node1428 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N2c72e3fe86734b7cbf7813054324653d</B></td></tr><tr><td href='N2c72e3fe86734b7cbf7813054324653d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N2c72e3fe86734b7cbf7813054324653d</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is verifiedBy, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
