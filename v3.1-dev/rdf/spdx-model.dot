# N65afa416551246d5a43a8979d0fb6ed6 node1727
node1727 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N65afa416551246d5a43a8979d0fb6ed6</B></td></tr><tr><td href='N65afa416551246d5a43a8979d0fb6ed6' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N65afa416551246d5a43a8979d0fb6ed6</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is serializedInArtifact, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
