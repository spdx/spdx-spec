node1073 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N3446a338a12e495882a91a4e1d2e22cd</B></td></tr><tr><td href='N3446a338a12e495882a91a4e1d2e22cd' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N3446a338a12e495882a91a4e1d2e22cd</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:minCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
