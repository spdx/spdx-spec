node143 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N6f5ae4757810493babc0961d3cc1808c</B></td></tr><tr><td href='N6f5ae4757810493babc0961d3cc1808c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N6f5ae4757810493babc0961d3cc1808c</font></td></tr></table> > ] 
