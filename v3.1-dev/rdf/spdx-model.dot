# Ne2a5825d7584404aad9a8557b0ba9a77 node1068
node1068 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne2a5825d7584404aad9a8557b0ba9a77</B></td></tr><tr><td href='Ne2a5825d7584404aad9a8557b0ba9a77' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne2a5825d7584404aad9a8557b0ba9a77</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is resolved, to must be an OutOfSpecAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/resolved&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;SupplyChain/OutOfSpecAction&gt; }
}&quot;</td></tr></table> > ] 
