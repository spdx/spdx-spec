# N0b01d36c9cd540efa63a7870b22d5141 node1302
node1302 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N0b01d36c9cd540efa63a7870b22d5141</B></td></tr><tr><td href='N0b01d36c9cd540efa63a7870b22d5141' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N0b01d36c9cd540efa63a7870b22d5141</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedIn, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
