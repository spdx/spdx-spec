# N057d73cbc42f467daca86546dd9b3dd2 node268
node268 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N057d73cbc42f467daca86546dd9b3dd2</B></td></tr><tr><td href='N057d73cbc42f467daca86546dd9b3dd2' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N057d73cbc42f467daca86546dd9b3dd2</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasDynamicLink, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasDynamicLink&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
# N801495b9ac884fc6bf853225044276a2 node269
