node293 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N47fe705ab5044c4eaf2e7ea70613a75a</B></td></tr><tr><td href='N47fe705ab5044c4eaf2e7ea70613a75a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N47fe705ab5044c4eaf2e7ea70613a75a</font></td></tr><tr><td align='left'>sh:minCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
