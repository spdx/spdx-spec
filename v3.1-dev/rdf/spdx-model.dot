# Nb2e282dccea4470cbc51eef25c61c10e node1325
node1325 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb2e282dccea4470cbc51eef25c61c10e</B></td></tr><tr><td href='Nb2e282dccea4470cbc51eef25c61c10e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb2e282dccea4470cbc51eef25c61c10e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, from must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
