# https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/inspection node923
node923 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>inspection</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/inspection' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/inspection</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A thorough examination or checking of documentation, records, processes, or systems to confirm compliance or adherence. An inspection needs to have a defined set of acceptance criteria (e.g. a checklist), a documentation of roles involved in the inspection (e.g. to document the inspector&#x27;s independence) and a clear documentation of when and how it was performed.&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/orcidid node924
node924 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>orcidid</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/orcidid' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/orcidid</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;[Open Researcher and Contributor ID (ORCID) iD](https://info.orcid.org/what-is-orcid/) is a unique identifier for authors and contributors in scholarly communication; as a subset of the International Standard Name Identifier (ISNI), it typically appears as a URI such as `https://orcid.org/0000-0002-1825-0097`.&quot;@en</td></tr></table> > ] 
