node1265 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nfc148238405f4b06b9eb4999c0a8ba8d</B></td></tr><tr><td href='Nfc148238405f4b06b9eb4999c0a8ba8d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nfc148238405f4b06b9eb4999c0a8ba8d</font></td></tr></table> > ] 
