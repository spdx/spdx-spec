node1403 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>runsOn</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipType/runsOn' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipType/runsOn</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The `from` Element (the instructions) runs on each `to` /Hardware/Hardware (processing element), during a LifecycleScopeType period.&quot;@en</td></tr></table> > ] 
# N1d2aa57788854a0cb207b59e3ba59757 node1404
node1404 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N1d2aa57788854a0cb207b59e3ba59757</B></td></tr><tr><td href='N1d2aa57788854a0cb207b59e3ba59757' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N1d2aa57788854a0cb207b59e3ba59757</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;A value for Core/name is required when a value for Core/version is present&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Software/version&gt; ?version .
    FILTER NOT EXISTS {
        $this &lt;Software/name&gt; ?name .
    }
}&quot;</td></tr></table> > ] 
