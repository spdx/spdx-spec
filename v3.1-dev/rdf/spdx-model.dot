node217 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N09bf747730954c22adc2d1168b05e432</B></td></tr><tr><td href='N09bf747730954c22adc2d1168b05e432' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N09bf747730954c22adc2d1168b05e432</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
