# N78bf0098de65447aa1b5f513df19b23d node266
node266 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N78bf0098de65447aa1b5f513df19b23d</B></td></tr><tr><td href='N78bf0098de65447aa1b5f513df19b23d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N78bf0098de65447aa1b5f513df19b23d</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is reportedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/reportedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
