node1045 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>namespaceMap</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/namespaceMap' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/namespaceMap</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Provides a NamespaceMap of prefixes and associated namespace partial URIs applicable to an SpdxDocument and independent of any specific serialization format or instance.&quot;@en</td></tr></table> > ] 
# N9b715b597c25442890dce52e247c1313 node1046
node1046 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N9b715b597c25442890dce52e247c1313</B></td></tr><tr><td href='N9b715b597c25442890dce52e247c1313' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N9b715b597c25442890dce52e247c1313</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasHost, from must be a Build&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasHost&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Build/Build&gt; }
}&quot;</td></tr></table> > ] 
