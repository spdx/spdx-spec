# Nba04d22daade4b7f92ab2446cb8acc84 node1445
node1445 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nba04d22daade4b7f92ab2446cb8acc84</B></td></tr><tr><td href='Nba04d22daade4b7f92ab2446cb8acc84' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nba04d22daade4b7f92ab2446cb8acc84</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is coordinatedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
