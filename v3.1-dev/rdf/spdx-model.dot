# N3714b6ce294640e19fd66069057bbeaf node1752
node1752 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N3714b6ce294640e19fd66069057bbeaf</B></td></tr><tr><td href='N3714b6ce294640e19fd66069057bbeaf' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N3714b6ce294640e19fd66069057bbeaf</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship id dependsOn, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
