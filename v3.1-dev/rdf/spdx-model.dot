# N43dcca1b47d145b1b87eeed7551cff28 node1316
node1316 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N43dcca1b47d145b1b87eeed7551cff28</B></td></tr><tr><td href='N43dcca1b47d145b1b87eeed7551cff28' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N43dcca1b47d145b1b87eeed7551cff28</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is tracedToDetail, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/tracedToDetail&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
