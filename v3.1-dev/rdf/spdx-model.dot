# N250ec9b9c14e421b9a7553650385d047 node1353
node1353 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N250ec9b9c14e421b9a7553650385d047</B></td></tr><tr><td href='N250ec9b9c14e421b9a7553650385d047' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N250ec9b9c14e421b9a7553650385d047</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;A value for Core/name is required when a value for Core/version is present&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Software/version&gt; ?version .
    FILTER NOT EXISTS {
        $this &lt;Software/name&gt; ?name .
    }
}&quot;</td></tr></table> > ] 
# N02a85aaf75c44d16a48b5f5a6bb1ea08 node1354
node1354 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N02a85aaf75c44d16a48b5f5a6bb1ea08</B></td></tr><tr><td href='N02a85aaf75c44d16a48b5f5a6bb1ea08' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N02a85aaf75c44d16a48b5f5a6bb1ea08</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is doesNotAffect, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/doesNotAffect&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
