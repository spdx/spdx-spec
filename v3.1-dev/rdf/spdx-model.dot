node510 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb3c341f1fb7d4d84a01321cf9322ec0e</B></td></tr><tr><td href='Nb3c341f1fb7d4d84a01321cf9322ec0e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb3c341f1fb7d4d84a01321cf9322ec0e</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:pattern</td><td align='left'>&quot;^\d\d\d\d-\d\d-\d\dT\d\d:\d\d:\d\dZ$&quot;</td></tr></table> > ] 
