# Nda525edc0ffc4730b99c65d11b7d3ec3 node1678
node1678 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nda525edc0ffc4730b99c65d11b7d3ec3</B></td></tr><tr><td href='Nda525edc0ffc4730b99c65d11b7d3ec3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nda525edc0ffc4730b99c65d11b7d3ec3</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is serializedInArtifact, from must be a SpdxDocument&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/serializedInArtifact&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/SpdxDocument&gt; }
}&quot;</td></tr></table> > ] 
