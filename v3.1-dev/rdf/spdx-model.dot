# Na327f4853107400cad647c625a9c98ce node2062
node2062 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na327f4853107400cad647c625a9c98ce</B></td></tr><tr><td href='Na327f4853107400cad647c625a9c98ce' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na327f4853107400cad647c625a9c98ce</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is reportedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/reportedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
