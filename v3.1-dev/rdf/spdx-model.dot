# Ne039ce58f0fa4dca98a74e2d027bc728 node1624
node1624 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne039ce58f0fa4dca98a74e2d027bc728</B></td></tr><tr><td href='Ne039ce58f0fa4dca98a74e2d027bc728' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne039ce58f0fa4dca98a74e2d027bc728</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, to must be a Relationship whose relationshipType is invokedBy&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
