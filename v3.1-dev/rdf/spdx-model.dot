# Na9b036e2fd534d2388b3a8671e716c1b node1446
node1446 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na9b036e2fd534d2388b3a8671e716c1b</B></td></tr><tr><td href='Na9b036e2fd534d2388b3a8671e716c1b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na9b036e2fd534d2388b3a8671e716c1b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is providesSupportFor, class must be SupportRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/providesSupportFor&gt; .
