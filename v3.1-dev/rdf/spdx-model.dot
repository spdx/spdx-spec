# N13346d9121844ff194e4b79a3cec16f4 node1354
node1354 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N13346d9121844ff194e4b79a3cec16f4</B></td></tr><tr><td href='N13346d9121844ff194e4b79a3cec16f4' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N13346d9121844ff194e4b79a3cec16f4</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is assumes, to must be an Assumption&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/assumes&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;FunctionalSafety/Assumption&gt; }
