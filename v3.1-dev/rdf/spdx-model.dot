# N077c596d9bdf477995ae67813663fb37 node965
node965 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N077c596d9bdf477995ae67813663fb37</B></td></tr><tr><td href='N077c596d9bdf477995ae67813663fb37' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N077c596d9bdf477995ae67813663fb37</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is invokedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
