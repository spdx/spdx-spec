node3 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na4b60211042e48fb86c6692fe88fcdb0</B></td></tr><tr><td href='Na4b60211042e48fb86c6692fe88fcdb0' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na4b60211042e48fb86c6692fe88fcdb0</font></td></tr></table> > ] 
