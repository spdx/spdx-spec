node835 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ndbd2c64e82f24c69951cb89389511829</B></td></tr><tr><td href='Ndbd2c64e82f24c69951cb89389511829' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ndbd2c64e82f24c69951cb89389511829</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
