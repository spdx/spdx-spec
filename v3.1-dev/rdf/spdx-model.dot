node734 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N5f60ea25e88c4c5ca6453318bf9dcc0d</B></td></tr><tr><td href='N5f60ea25e88c4c5ca6453318bf9dcc0d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N5f60ea25e88c4c5ca6453318bf9dcc0d</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;At least one of Core/country, Core/city, Core/streetAddress, Core/geographicPointLocation, or Core/name is required&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
