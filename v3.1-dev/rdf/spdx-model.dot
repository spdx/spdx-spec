node0 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N5d4281b5ce3f4dbd9dff68a730e295c6</B></td></tr><tr><td href='N5d4281b5ce3f4dbd9dff68a730e295c6' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N5d4281b5ce3f4dbd9dff68a730e295c6</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is underInvestigationFor, class must be VexUnderInvestigationVulnAssessmentRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
