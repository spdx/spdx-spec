# Nb63c6ccd30a14ad78cbbf4ecb22fd804 node411
node411 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb63c6ccd30a14ad78cbbf4ecb22fd804</B></td></tr><tr><td href='Nb63c6ccd30a14ad78cbbf4ecb22fd804' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb63c6ccd30a14ad78cbbf4ecb22fd804</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasDynamicLink, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasDynamicLink&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
# N093a32cc2a65481b8392893fccbd5cd6 node412
node412 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N093a32cc2a65481b8392893fccbd5cd6</B></td></tr><tr><td href='N093a32cc2a65481b8392893fccbd5cd6' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N093a32cc2a65481b8392893fccbd5cd6</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasConcludedLicense, to must be an AnyLicenseInfo&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasConcludedLicense&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;SimpleLicensing/AnyLicenseInfo&gt; }
}&quot;</td></tr></table> > ] 
