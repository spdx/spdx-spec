# Na197a16fc7c844fbbf0619136f3394c2 node1734
node1734 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na197a16fc7c844fbbf0619136f3394c2</B></td></tr><tr><td href='Na197a16fc7c844fbbf0619136f3394c2' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na197a16fc7c844fbbf0619136f3394c2</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is serializedInArtifact, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/serializedInArtifact&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Artifact&gt; }
