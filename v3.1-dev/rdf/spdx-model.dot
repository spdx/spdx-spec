# Nbbb23d04f1a948c1b30df40f2c7d75ca node1145
node1145 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nbbb23d04f1a948c1b30df40f2c7d75ca</B></td></tr><tr><td href='Nbbb23d04f1a948c1b30df40f2c7d75ca' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nbbb23d04f1a948c1b30df40f2c7d75ca</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedIn, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/fixedIn&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
