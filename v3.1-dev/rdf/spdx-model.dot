# N4aa28b2348e846d1a8b510e83582da0d node1940
node1940 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N4aa28b2348e846d1a8b510e83582da0d</B></td></tr><tr><td href='N4aa28b2348e846d1a8b510e83582da0d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N4aa28b2348e846d1a8b510e83582da0d</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/fixedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
