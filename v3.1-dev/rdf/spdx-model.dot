# Nb2299b7f121b4db5b3934097977d6489 node1515
node1515 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb2299b7f121b4db5b3934097977d6489</B></td></tr><tr><td href='Nb2299b7f121b4db5b3934097977d6489' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb2299b7f121b4db5b3934097977d6489</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/fixedBy&gt; .
    $this &lt;Core/from&gt; ?from .
