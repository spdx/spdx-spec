# Nfa88efd5cd77448e80ca7a5d9644d340 node1703
node1703 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nfa88efd5cd77448e80ca7a5d9644d340</B></td></tr><tr><td href='Nfa88efd5cd77448e80ca7a5d9644d340' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nfa88efd5cd77448e80ca7a5d9644d340</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasResolution, to must be an OutOfSpecAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasResolution&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;SupplyChain/OutOfSpecAction&gt; }
}&quot;</td></tr></table> > ] 
