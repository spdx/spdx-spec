node1138 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>other</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/RelationshipType/other' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/RelationshipType/other</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Every `to` Element is related to the `from` Element where the relationship type is not described by any of the SPDX relationship types (this relationship is directionless).&quot;@en</td></tr></table> > ] 
