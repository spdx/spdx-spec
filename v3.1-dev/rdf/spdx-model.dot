# N8fe0ad1152794f0e866bdc8b717b5fd8 node1982
node1982 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8fe0ad1152794f0e866bdc8b717b5fd8</B></td></tr><tr><td href='N8fe0ad1152794f0e866bdc8b717b5fd8' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8fe0ad1152794f0e866bdc8b717b5fd8</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasOptionalDependency, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
