# N49ad74f690134c269d1172ca9f59f9b5 node1416
node1416 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N49ad74f690134c269d1172ca9f59f9b5</B></td></tr><tr><td href='N49ad74f690134c269d1172ca9f59f9b5' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N49ad74f690134c269d1172ca9f59f9b5</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is publishedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/publishedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
