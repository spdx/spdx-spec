# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/hsCodes node516
node516 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>hsCodes</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/hsCodes' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/hsCodes</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The [Harmonized System (HS)](https://www.wcoomd.org/en/topics/nomenclature/overview/what-is-the-harmonized-system.aspx) of tariff nomenclature is an internationally standardized system of names and numbers, defined by the World Customs Organization, used to classify traded products.&quot;@en</td></tr></table> > ] 
# N7b4bd56555524e859bb8a5d8dce6032b node517
node517 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N7b4bd56555524e859bb8a5d8dce6032b</B></td></tr><tr><td href='N7b4bd56555524e859bb8a5d8dce6032b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N7b4bd56555524e859bb8a5d8dce6032b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is tracedToDetail, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/tracedToDetail&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isan node518
node518 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>isan</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isan' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/isan</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;[International Standard Audiovisual Number (ISAN)](https://www.isan.org/about/#what_is_isan) is a unique 24-digit hexadecimal identifier for audiovisual works standardized by [ISO 15706](https://www.iso.org/standard/83124.html). The ISAN remains persistent for a work regardless of its distribution format or its use. To facilitate human readability, the &quot;ISAN&quot; label, grouping hyphens, and two check characters are included (e.g., `ISAN 0000-0000-3A8D-0000-Z-0000-0000-6`); however, these elements shall be omitted when the identifier is stored electronically (e.g., `000000003A8D000000000000`).&quot;@en</td></tr></table> > ] 
