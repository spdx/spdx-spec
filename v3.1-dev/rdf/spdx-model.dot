# Nbbc7e9d0c0984a54b908ffe74f0b7a46 node1590
node1590 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nbbc7e9d0c0984a54b908ffe74f0b7a46</B></td></tr><tr><td href='Nbbc7e9d0c0984a54b908ffe74f0b7a46' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nbbc7e9d0c0984a54b908ffe74f0b7a46</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is providesSupportFor, from must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/providesSupportFor&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
