node362 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>roleQualification</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/roleQualification' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/roleQualification</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;roleQualification specifies the requirements, criteria, or conditions that must be met for an entity to be considered qualified to fulfill a particular role.&quot;@en</td></tr></table> > ] 
