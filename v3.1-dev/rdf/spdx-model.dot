# N948749b2eb94457a8cf0503cbf71b041 node1933
node1933 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N948749b2eb94457a8cf0503cbf71b041</B></td></tr><tr><td href='N948749b2eb94457a8cf0503cbf71b041' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N948749b2eb94457a8cf0503cbf71b041</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasConcludedLicense, to must be an AnyLicenseInfo&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasConcludedLicense&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;SimpleLicensing/AnyLicenseInfo&gt; }
}&quot;</td></tr></table> > ] 
