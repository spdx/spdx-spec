# https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/inspection node1478
node1478 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>inspection</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/inspection' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/inspection</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A thorough examination or checking of documentation, records, processes, or systems to confirm compliance or adherence. An inspection needs to have a defined set of acceptance criteria (e.g. a checklist), a documentation of roles involved in the inspection (e.g. to document the inspector&#x27;s independence) and a clear documentation of when and how it was performed.&quot;@en</td></tr></table> > ] 
# N69984bfe57fd476eb6a140d02cbfa957 node1479
node1479 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N69984bfe57fd476eb6a140d02cbfa957</B></td></tr><tr><td href='N69984bfe57fd476eb6a140d02cbfa957' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N69984bfe57fd476eb6a140d02cbfa957</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/fixedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
