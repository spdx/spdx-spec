# N540c2b2f9e1e45c196b341810deb991d node1362
node1362 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N540c2b2f9e1e45c196b341810deb991d</B></td></tr><tr><td href='N540c2b2f9e1e45c196b341810deb991d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N540c2b2f9e1e45c196b341810deb991d</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is tracedToDetail, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/tracedToDetail&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
