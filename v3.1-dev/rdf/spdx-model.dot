# N407c3109d11443028ad79b4fc2d59c4b node1425
node1425 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N407c3109d11443028ad79b4fc2d59c4b</B></td></tr><tr><td href='N407c3109d11443028ad79b4fc2d59c4b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N407c3109d11443028ad79b4fc2d59c4b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is publishedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/publishedBy&gt; .
    $this &lt;Core/from&gt; ?from .
