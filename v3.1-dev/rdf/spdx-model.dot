node834 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb5f0240f49f74c1fb90e75678a6812d8</B></td></tr><tr><td href='Nb5f0240f49f74c1fb90e75678a6812d8' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb5f0240f49f74c1fb90e75678a6812d8</font></td></tr></table> > ] 
