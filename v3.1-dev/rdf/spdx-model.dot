# N67b2fb14fa3945b2a6bfb70fc88716fa node1549
node1549 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N67b2fb14fa3945b2a6bfb70fc88716fa</B></td></tr><tr><td href='N67b2fb14fa3945b2a6bfb70fc88716fa' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N67b2fb14fa3945b2a6bfb70fc88716fa</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is underInvestigationFor, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/underInvestigationFor&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
