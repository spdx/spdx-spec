node5 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>bower</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/bower' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/bower</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A reference to a Bower package. The package locator format, looks like `package#version`, is defined in the &quot;install&quot; section of [Bower API documentation](https://bower.io/docs/api/#install).&quot;@en</td></tr></table> > ] 
