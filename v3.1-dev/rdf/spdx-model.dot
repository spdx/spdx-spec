node1021 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nab52bf89d13144089fc93327252ab21d</B></td></tr><tr><td href='Nab52bf89d13144089fc93327252ab21d' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nab52bf89d13144089fc93327252ab21d</font></td></tr></table> > ] 
