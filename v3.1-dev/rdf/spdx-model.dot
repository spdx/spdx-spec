node379 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N85c510c5c9f541ba9304a908cb0c3b4b</B></td></tr><tr><td href='N85c510c5c9f541ba9304a908cb0c3b4b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N85c510c5c9f541ba9304a908cb0c3b4b</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
