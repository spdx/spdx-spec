node1403 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>hasTestCase</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipType/hasTestCase' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipType/hasTestCase</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Every `to` Element is a test case for the `from` Element (`from` hasTestCase `to`).&quot;@en</td></tr></table> > ] 
