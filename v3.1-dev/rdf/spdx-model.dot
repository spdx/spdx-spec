node1253 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>serialNumber</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Hardware/serialNumber' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Hardware/serialNumber</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Identifier for specific product is called a serial number.&quot;@en</td></tr></table> > ] 
