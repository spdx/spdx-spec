# https://spdx.org/rdf/3/terms/Core/ExternalRefType/vulnerabilityDisclosureReport node435
node435 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>vulnerabilityDisclosureReport</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalRefType/vulnerabilityDisclosureReport' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalRefType/vulnerabilityDisclosureReport</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A reference to a Vulnerability Disclosure Report (VDR) which provides the software supplier&#x27;s analysis and findings describing the impact (or lack of impact) that reported vulnerabilities have on packages or products in the supplier&#x27;s SBOM as defined in [NIST SP 800-161 Cybersecurity Supply Chain Risk Management Practices for Systems and Organizations](https://csrc.nist.gov/pubs/sp/800/161/r1/final).&quot;@en</td></tr></table> > ] 
# Ncbb8563b31a44c33aa48d895a4c2d5ee node436
node436 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ncbb8563b31a44c33aa48d895a4c2d5ee</B></td></tr><tr><td href='Ncbb8563b31a44c33aa48d895a4c2d5ee' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ncbb8563b31a44c33aa48d895a4c2d5ee</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is runsOn, to must be a Hardware&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/runsOn&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Hardware/Hardware&gt; }
}&quot;</td></tr></table> > ] 
