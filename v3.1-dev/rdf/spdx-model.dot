# N271aa283de304d17a4cefadad456c9f2 node1594
node1594 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N271aa283de304d17a4cefadad456c9f2</B></td></tr><tr><td href='N271aa283de304d17a4cefadad456c9f2' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N271aa283de304d17a4cefadad456c9f2</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is invokedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/invokedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
