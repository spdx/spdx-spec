# N85362f994b4e4f57bdad6d5db5cecce8 node0
node0 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N85362f994b4e4f57bdad6d5db5cecce8</B></td></tr><tr><td href='N85362f994b4e4f57bdad6d5db5cecce8' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N85362f994b4e4f57bdad6d5db5cecce8</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is verifiedBy, to must be a RequirementVerification&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/verifiedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;FunctionalSafety/RequirementVerification&gt; }
}&quot;</td></tr></table> > ] 
# N16925f8456c046b78386c3f7ec3eb295 node1
node1 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N16925f8456c046b78386c3f7ec3eb295</B></td></tr><tr><td href='N16925f8456c046b78386c3f7ec3eb295' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N16925f8456c046b78386c3f7ec3eb295</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is doesNotAffect, class must be VexNotAffectedVulnAssessmentRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/doesNotAffect&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Security/VexNotAffectedVulnAssessmentRelationship&gt; }
}&quot;</td></tr></table> > ] 
