node1877 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nb05de8f2b369486990715ef637fa3203</B></td></tr><tr><td href='Nb05de8f2b369486990715ef637fa3203' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nb05de8f2b369486990715ef637fa3203</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasDynamicLink, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
