# N91b7e72a474f495696305121948531c6 node982
node982 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N91b7e72a474f495696305121948531c6</B></td></tr><tr><td href='N91b7e72a474f495696305121948531c6' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N91b7e72a474f495696305121948531c6</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, from must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
