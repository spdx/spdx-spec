# Nbe7c8b4ab4e443e4a49a305a929c558c node1484
node1484 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nbe7c8b4ab4e443e4a49a305a929c558c</B></td></tr><tr><td href='Nbe7c8b4ab4e443e4a49a305a929c558c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nbe7c8b4ab4e443e4a49a305a929c558c</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasAssessmentFor, class must be VulnAssessmentRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasAssessmentFor&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Security/VulnAssessmentRelationship&gt; }
}&quot;</td></tr></table> > ] 
