# Nc398a1b0af424387b8bc2c47663f3375 node1278
node1278 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nc398a1b0af424387b8bc2c47663f3375</B></td></tr><tr><td href='Nc398a1b0af424387b8bc2c47663f3375' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nc398a1b0af424387b8bc2c47663f3375</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is resolved, from must be a ResolutionAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
