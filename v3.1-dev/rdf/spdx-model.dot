node1355 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N623ef15f53b7474896f0c4ebf5abb90a</B></td></tr><tr><td href='N623ef15f53b7474896f0c4ebf5abb90a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N623ef15f53b7474896f0c4ebf5abb90a</font></td></tr></table> > ] 
