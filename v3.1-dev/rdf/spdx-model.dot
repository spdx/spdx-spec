# N70b5617bbf514c72901681d5f9d15ca7 node303
node303 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N70b5617bbf514c72901681d5f9d15ca7</B></td></tr><tr><td href='N70b5617bbf514c72901681d5f9d15ca7' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N70b5617bbf514c72901681d5f9d15ca7</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasInput, from must be a Build, DefinedProcess, or Action&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasInput&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Build/Build&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/DefinedProcess&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
}&quot;</td></tr></table> > ] 
