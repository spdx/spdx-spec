node551 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>blake3</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/HashAlgorithm/blake3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/HashAlgorithm/blake3</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;[BLAKE3](https://github.com/BLAKE3-team/BLAKE3-specs/blob/master/blake3.pdf)&quot;@en</td></tr></table> > ] 
