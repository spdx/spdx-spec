# Na318d267247f4ca983ac94baa6228e8a node1524
node1524 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na318d267247f4ca983ac94baa6228e8a</B></td></tr><tr><td href='Na318d267247f4ca983ac94baa6228e8a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na318d267247f4ca983ac94baa6228e8a</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is reportedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/reportedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
