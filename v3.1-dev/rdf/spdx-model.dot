# Ne1c8dc30e6f64006904cf1bc7eac6824 node21
node21 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne1c8dc30e6f64006904cf1bc7eac6824</B></td></tr><tr><td href='Ne1c8dc30e6f64006904cf1bc7eac6824' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne1c8dc30e6f64006904cf1bc7eac6824</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasConcludedLicense, to must be an AnyLicenseInfo&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasConcludedLicense&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;SimpleLicensing/AnyLicenseInfo&gt; }
}&quot;</td></tr></table> > ] 
