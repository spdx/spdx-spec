node1061 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>assessmentTimestamp</B></td></tr><tr><td href='https://spdx.org/rdf/3.1/terms/Operations/assessmentTimestamp' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3.1/terms/Operations/assessmentTimestamp</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Timestamp, when an assessment was conducted.&quot;@en</td></tr></table> > ] 
