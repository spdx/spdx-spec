node897 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N730ef05782504faebb89d06a27e58e93</B></td></tr><tr><td href='N730ef05782504faebb89d06a27e58e93' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N730ef05782504faebb89d06a27e58e93</font></td></tr></table> > ] 
