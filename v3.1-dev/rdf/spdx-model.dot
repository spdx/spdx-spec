node1413 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>other</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/SpecificationType/other' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/SpecificationType/other</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Any specification that does not fall under any of the other entries.&quot;@en</td></tr></table> > ] 
