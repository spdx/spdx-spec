# N64bae07a6103498eb36525fb7f5a6573 node1215
node1215 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N64bae07a6103498eb36525fb7f5a6573</B></td></tr><tr><td href='N64bae07a6103498eb36525fb7f5a6573' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N64bae07a6103498eb36525fb7f5a6573</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedIn, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
