# Nc540cc0f91a34aa18b351afff253ce2e node1453
node1453 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nc540cc0f91a34aa18b351afff253ce2e</B></td></tr><tr><td href='Nc540cc0f91a34aa18b351afff253ce2e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nc540cc0f91a34aa18b351afff253ce2e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasConcludedLicense, to must be an AnyLicenseInfo&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasConcludedLicense&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;SimpleLicensing/AnyLicenseInfo&gt; }
}&quot;</td></tr></table> > ] 
