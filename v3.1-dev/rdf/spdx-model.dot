# N3e584b6863d2467a92587a17f8142917 node514
node514 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N3e584b6863d2467a92587a17f8142917</B></td></tr><tr><td href='N3e584b6863d2467a92587a17f8142917' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N3e584b6863d2467a92587a17f8142917</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is runsOn, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/runsOn&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
# N5725da8e6b664255b72969da6524f981 node515
node515 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N5725da8e6b664255b72969da6524f981</B></td></tr><tr><td href='N5725da8e6b664255b72969da6524f981' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N5725da8e6b664255b72969da6524f981</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasInput, from must be a Build, DefinedProcess, or Action&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasInput&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Build/Build&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/DefinedProcess&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
}&quot;</td></tr></table> > ] 
