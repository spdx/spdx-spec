node1726 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>namespaceMap</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/namespaceMap' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/namespaceMap</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Provides a NamespaceMap of prefixes and associated namespace partial URIs applicable to an SpdxDocument and independent of any specific serialization format or instance.&quot;@en</td></tr></table> > ] 
