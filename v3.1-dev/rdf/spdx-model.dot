# Nf175e2c71c384bc880ff1c93fae1d7ef node1682
node1682 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf175e2c71c384bc880ff1c93fae1d7ef</B></td></tr><tr><td href='Nf175e2c71c384bc880ff1c93fae1d7ef' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf175e2c71c384bc880ff1c93fae1d7ef</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/fixedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
