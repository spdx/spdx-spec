# N44a8c58fd99643928fdccf5cf60ed6ca node1631
node1631 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N44a8c58fd99643928fdccf5cf60ed6ca</B></td></tr><tr><td href='N44a8c58fd99643928fdccf5cf60ed6ca' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N44a8c58fd99643928fdccf5cf60ed6ca</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasHost, from must be a Build&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasHost&gt; .
    $this &lt;Core/from&gt; ?from .
