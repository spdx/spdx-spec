# Nbe9b9a0262b44e8ea2020610a7458a64 node10
node10 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nbe9b9a0262b44e8ea2020610a7458a64</B></td></tr><tr><td href='Nbe9b9a0262b44e8ea2020610a7458a64' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nbe9b9a0262b44e8ea2020610a7458a64</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasPrerequisite, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasPrerequisite&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
