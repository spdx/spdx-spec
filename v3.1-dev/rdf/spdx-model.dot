node1410 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>specification</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/specification' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/specification</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The Element is a plan, guideline or strategy how to create, perform or analyze an application.&quot;@en</td></tr></table> > ] 
