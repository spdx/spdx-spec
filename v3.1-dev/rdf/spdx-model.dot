# Nfe1a4482eaee4999a241a7b8ae34791c node291
node291 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nfe1a4482eaee4999a241a7b8ae34791c</B></td></tr><tr><td href='Nfe1a4482eaee4999a241a7b8ae34791c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nfe1a4482eaee4999a241a7b8ae34791c</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasAssociatedVulnerability, to must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasAssociatedVulnerability&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
