node1419 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ncb3c785c21e94abe86a08f4d15125e79</B></td></tr><tr><td href='Ncb3c785c21e94abe86a08f4d15125e79' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ncb3c785c21e94abe86a08f4d15125e79</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:minCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
