# N9f6a2a73888f4c239f6b761948aef274 node893
node893 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N9f6a2a73888f4c239f6b761948aef274</B></td></tr><tr><td href='N9f6a2a73888f4c239f6b761948aef274' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N9f6a2a73888f4c239f6b761948aef274</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasDynamicLink, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasDynamicLink&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
# N624e4e71d76d4b8eaa6d8f0e9130808f node894
