node772 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nd19928cb18ff4f6db2935e91bc6112c3</B></td></tr><tr><td href='Nd19928cb18ff4f6db2935e91bc6112c3' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nd19928cb18ff4f6db2935e91bc6112c3</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr></table> > ] 
