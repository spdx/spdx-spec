# N5d128c5b0da14e5394560e14922328da node228
node228 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N5d128c5b0da14e5394560e14922328da</B></td></tr><tr><td href='N5d128c5b0da14e5394560e14922328da' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N5d128c5b0da14e5394560e14922328da</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasConcludedLicense, to must be an AnyLicenseInfo&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasConcludedLicense&gt; .
    $this &lt;Core/to&gt; ?to .
