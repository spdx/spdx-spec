# N5398411258a644b5ab8172c300e1958b node690
node690 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N5398411258a644b5ab8172c300e1958b</B></td></tr><tr><td href='N5398411258a644b5ab8172c300e1958b' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N5398411258a644b5ab8172c300e1958b</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is affects, from must be a Vulnerability, Action, or DefinedProcess&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/affects&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/DefinedProcess&gt; }
}&quot;</td></tr></table> > ] 
