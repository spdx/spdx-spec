# Na6bfd3b28dd84716aa015b76561b57b9 node1248
node1248 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na6bfd3b28dd84716aa015b76561b57b9</B></td></tr><tr><td href='Na6bfd3b28dd84716aa015b76561b57b9' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na6bfd3b28dd84716aa015b76561b57b9</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, to must be a Relationship whose relationshipType is invokedBy&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
