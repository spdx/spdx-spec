# Nf28b6752630144a9a3a1035f6b612f69 node1639
node1639 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nf28b6752630144a9a3a1035f6b612f69</B></td></tr><tr><td href='Nf28b6752630144a9a3a1035f6b612f69' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nf28b6752630144a9a3a1035f6b612f69</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is verifiedBy, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/verifiedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
