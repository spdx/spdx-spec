# N80ae6b9069e1419d8cc366d126cf3aab node1637
node1637 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N80ae6b9069e1419d8cc366d126cf3aab</B></td></tr><tr><td href='N80ae6b9069e1419d8cc366d126cf3aab' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N80ae6b9069e1419d8cc366d126cf3aab</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is foundBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
