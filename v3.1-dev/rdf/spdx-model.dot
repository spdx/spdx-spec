node860 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>PhysicalLocation</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/PhysicalLocation' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/PhysicalLocation</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A physical location is a tangible, geographically identifiable place where objects, people, or assets exist or operate.&quot;@en</td></tr></table> > ] 
