node1543 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne61493c2fdc94d71b2a661ff3fc21a7a</B></td></tr><tr><td href='Ne61493c2fdc94d71b2a661ff3fc21a7a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne61493c2fdc94d71b2a661ff3fc21a7a</font></td></tr></table> > ] 
