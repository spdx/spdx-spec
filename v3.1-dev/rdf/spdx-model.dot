# N75c8338aa39f4ba499ba3630fb9789c7 node1439
node1439 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N75c8338aa39f4ba499ba3630fb9789c7</B></td></tr><tr><td href='N75c8338aa39f4ba499ba3630fb9789c7' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N75c8338aa39f4ba499ba3630fb9789c7</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasInstall, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasInstall&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Artifact&gt; }
}&quot;</td></tr></table> > ] 
