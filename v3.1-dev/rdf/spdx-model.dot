# Nbe18297501ab45869845eb5beb94ae24 node1287
node1287 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nbe18297501ab45869845eb5beb94ae24</B></td></tr><tr><td href='Nbe18297501ab45869845eb5beb94ae24' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nbe18297501ab45869845eb5beb94ae24</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasInput, from must be a Build, DefinedProcess, or Action&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasInput&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Build/Build&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/DefinedProcess&gt; }
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Action&gt; }
}&quot;</td></tr></table> > ] 
# N605b548639254147bc4287ac327a8d88 node1288
node1288 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N605b548639254147bc4287ac327a8d88</B></td></tr><tr><td href='N605b548639254147bc4287ac327a8d88' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N605b548639254147bc4287ac327a8d88</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasSpecification, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasSpecification&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
