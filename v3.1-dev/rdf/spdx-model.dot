# N8ece6b2d4509489bbe2fa20845211517 node1465
node1465 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8ece6b2d4509489bbe2fa20845211517</B></td></tr><tr><td href='N8ece6b2d4509489bbe2fa20845211517' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8ece6b2d4509489bbe2fa20845211517</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/delegatedTo&gt; .
    FILTER NOT EXISTS { $this rdf:type &lt;Core/LifecycleScopedRelationship&gt; }
}&quot;</td></tr></table> > ] 
# N69d0c0efa13a42749c5805ecf95ed258 node1466
node1466 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N69d0c0efa13a42749c5805ecf95ed258</B></td></tr><tr><td href='N69d0c0efa13a42749c5805ecf95ed258' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N69d0c0efa13a42749c5805ecf95ed258</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasDeclaredLicense, to must be an AnyLicenseInfo&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/hasDeclaredLicense&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;SimpleLicensing/AnyLicenseInfo&gt; }
}&quot;</td></tr></table> > ] 
