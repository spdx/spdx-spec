# Nd2b7f058625a4df5bdb351139c402783 node1113
node1113 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nd2b7f058625a4df5bdb351139c402783</B></td></tr><tr><td href='Nd2b7f058625a4df5bdb351139c402783' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nd2b7f058625a4df5bdb351139c402783</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is resolved, to must be an OutOfSpecAction&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
