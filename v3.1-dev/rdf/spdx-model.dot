node846 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>backlog</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RequirementStatusType/backlog' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RequirementStatusType/backlog</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A requirement has been captured and logged, but not yet ready to become a formal requirement draft. A backlog requirement may still be incomplete or ambiguous.&quot;@en</td></tr></table> > ] 
