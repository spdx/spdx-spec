# https://spdx.org/rdf/3/terms/Core/RelationshipType/delegatedTo node0
node0 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>delegatedTo</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipType/delegatedTo' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipType/delegatedTo</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;The `from` Agent is delegating an action to the Agent of the `to` Relationship (which shall be of type invokedBy), during a LifecycleScopeType period (e.g. the `to` invokedBy Relationship is being done on behalf of `from`).&quot;@en</td></tr></table> > ] 
# http://www.w3.org/2002/07/owl#NamedIndividual node1
node1 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>NamedIndividual</B></td></tr><tr><td href='http://www.w3.org/2002/07/owl#NamedIndividual' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>http://www.w3.org/2002/07/owl#NamedIndividual</font></td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/Relationship node2
node2 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Relationship</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/Relationship' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/Relationship</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Describes a relationship between one or more elements.&quot;@en</td></tr></table> > ] 
# N4a30d8485a7c41d49a1d0db9d7dd18e9 node3
node3 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N4a30d8485a7c41d49a1d0db9d7dd18e9</B></td></tr><tr><td href='N4a30d8485a7c41d49a1d0db9d7dd18e9' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N4a30d8485a7c41d49a1d0db9d7dd18e9</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is fixedBy, to must be an Agent&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/fixedBy&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Agent&gt; }
}&quot;</td></tr></table> > ] 
