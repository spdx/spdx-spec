node828 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na0ccaf2f7c334f41b52b42520a77f45a</B></td></tr><tr><td href='Na0ccaf2f7c334f41b52b42520a77f45a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na0ccaf2f7c334f41b52b42520a77f45a</font></td></tr></table> > ] 
