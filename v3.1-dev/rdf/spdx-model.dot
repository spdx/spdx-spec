node38 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>RelationshipCompleteness</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/RelationshipCompleteness' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/RelationshipCompleteness</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Indicates whether a relationship is known to be complete, incomplete, or if no assertion is made with respect to relationship completeness.&quot;@en</td></tr></table> > ] 
