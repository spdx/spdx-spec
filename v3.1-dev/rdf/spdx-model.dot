node1237 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N09ddb153e04e4ae7a3aec5c7f2eb077e</B></td></tr><tr><td href='N09ddb153e04e4ae7a3aec5c7f2eb077e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N09ddb153e04e4ae7a3aec5c7f2eb077e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, to must be a Relationship whose relationshipType is invokedBy&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
