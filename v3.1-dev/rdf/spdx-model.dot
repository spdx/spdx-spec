node939 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>knownBias</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Dataset/knownBias' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Dataset/knownBias</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;Records the biases that the dataset is known to encompass.&quot;@en</td></tr></table> > ] 
