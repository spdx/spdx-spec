# Nfef81ef989994ac2b4b008f119dd79ae node1621
node1621 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Nfef81ef989994ac2b4b008f119dd79ae</B></td></tr><tr><td href='Nfef81ef989994ac2b4b008f119dd79ae' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Nfef81ef989994ac2b4b008f119dd79ae</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is publishedBy, from must be a Vulnerability&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/publishedBy&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Security/Vulnerability&gt; }
}&quot;</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/issn node1622
node1622 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>issn</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/issn' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/issn</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;[International Standard Serial Number (ISSN)](https://www.issn.org/understanding-the-issn/what-is-an-issn/) is an eight-digit identifier for serial publications and other continuing resources standardized by [ISO 3297](https://www.iso.org/standard/84536.html). It consists of two groups of four digits separated by a hyphen, where the final character is a check digit that may be an &quot;X&quot;. The hyphen is retained when the identifier is stored electronically to maintain the standard 9-character string format (e.g., `1464-3693`). The ISSN is media-specific; the same journal title may be assigned different identifiers for its physical and digital versions.&quot;@en</td></tr></table> > ] 
# Ne232a46c4382407fbd197b67846f1a3c node1623
node1623 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Ne232a46c4382407fbd197b67846f1a3c</B></td></tr><tr><td href='Ne232a46c4382407fbd197b67846f1a3c' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Ne232a46c4382407fbd197b67846f1a3c</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is providesSupportFor, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/providesSupportFor&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Artifact&gt; }
}&quot;</td></tr></table> > ] 
