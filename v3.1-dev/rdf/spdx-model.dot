# Na6da327d6f3e4504afc55e25e9710cdc node1071
node1071 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>Na6da327d6f3e4504afc55e25e9710cdc</B></td></tr><tr><td href='Na6da327d6f3e4504afc55e25e9710cdc' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>Na6da327d6f3e4504afc55e25e9710cdc</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is tracedToDetail, from must be a Requirement&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/tracedToDetail&gt; .
    $this &lt;Core/from&gt; ?from .
    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* &lt;Core/Requirement&gt; }
}&quot;</td></tr></table> > ] 
