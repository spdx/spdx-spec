# N36ccf0941a07488badd2f36d0fc04d4e node1217
node1217 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N36ccf0941a07488badd2f36d0fc04d4e</B></td></tr><tr><td href='N36ccf0941a07488badd2f36d0fc04d4e' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N36ccf0941a07488badd2f36d0fc04d4e</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is serializedInArtifact, to must be an Artifact&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
SELECT $this WHERE {
    $this &lt;Core/relationshipType&gt; &lt;Core/RelationshipType/serializedInArtifact&gt; .
    $this &lt;Core/to&gt; ?to .
    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* &lt;Core/Artifact&gt; }
}&quot;</td></tr></table> > ] 
