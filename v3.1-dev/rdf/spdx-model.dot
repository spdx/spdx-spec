# https://spdx.org/rdf/3/terms/Core/ExternalRefType/secureSoftwareAttestation node605
node605 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>secureSoftwareAttestation</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalRefType/secureSoftwareAttestation' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalRefType/secureSoftwareAttestation</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A reference to information assuring that the software is developed using security practices as defined by [NIST SP 800-218 Secure Software Development Framework (SSDF) Version 1.1](https://csrc.nist.gov/pubs/sp/800/218/final) or [CISA Secure Software Development Attestation Form](https://www.cisa.gov/resources-tools/resources/secure-software-development-attestation-form).&quot;@en</td></tr></table> > ] 
# https://spdx.org/rdf/3/terms/Core/ExternalRefType/x509Cert node606
node606 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>x509Cert</B></td></tr><tr><td href='https://spdx.org/rdf/3/terms/Core/ExternalRefType/x509Cert' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>https://spdx.org/rdf/3/terms/Core/ExternalRefType/x509Cert</font></td></tr><tr><td align='left'>rdfs:comment</td><td align='left'>&quot;A reference to an X.509 certificate as defined in [RFC 5280](https://datatracker.ietf.org/doc/rfc5280/). The primary media type shall be `application/pkix-cert`. The legacy media types `application/x-x509-ca-cert` and `application/x-x509-user-cert` may be used for backward compatibility, but shall not be used in new implementations. NOTE — RFC 5280 supersedes earlier X.509 profiles, including RFC 1422. Existing references based on RFC 1422 remain valid.&quot;@en</td></tr></table> > ] 
