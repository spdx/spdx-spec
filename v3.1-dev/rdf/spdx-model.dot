# N28879d750213402b87974c300a9efbc5 node1505
node1505 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N28879d750213402b87974c300a9efbc5</B></td></tr><tr><td href='N28879d750213402b87974c300a9efbc5' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N28879d750213402b87974c300a9efbc5</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is hasInstall, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
