# N8aa1c5c6e2304839bf3880f10d138178 node372
node372 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N8aa1c5c6e2304839bf3880f10d138178</B></td></tr><tr><td href='N8aa1c5c6e2304839bf3880f10d138178' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N8aa1c5c6e2304839bf3880f10d138178</font></td></tr><tr><td align='left'>sh:message</td><td align='left'>&quot;When relationship is delegatedTo, class must be LifecycleScopedRelationship&quot;</td></tr><tr><td align='left'>sh:select</td><td align='left'>&quot;BASE &lt;https://spdx.org/rdf/3/terms/&gt;
