node907 [ shape=none, color=black label=< <table color='#666666' cellborder='0' cellspacing='0' border='1'><tr><td colspan='2' bgcolor='grey'><B>N99c46736aace4be4a4dec65453a4d02a</B></td></tr><tr><td href='N99c46736aace4be4a4dec65453a4d02a' bgcolor='#eeeeee' colspan='2'><font point-size='10' color='#6666ff'>N99c46736aace4be4a4dec65453a4d02a</font></td></tr><tr><td align='left'>sh:maxCount</td><td align='left'>&quot;1&quot;^^xsd:integer</td></tr><tr><td align='left'>sh:pattern</td><td align='left'>&quot;^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$&quot;</td></tr></table> > ] 
