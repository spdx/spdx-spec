    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Makes no assertion about the field."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "noAssertion"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Dataset/sensor",
    "@type": [
