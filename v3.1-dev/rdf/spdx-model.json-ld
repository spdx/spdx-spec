      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "exportControlAssessment"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/PhysicalLocation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A physical location is a tangible, geographically identifiable place where objects, people, or assets exist or operate."
      }
    ],
