        "@value": "Identifies the download Uniform Resource Identifier for the package at the time\nthat the document was created."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#anyURI"
      }
    ]
  },
