        "@language": "en",
        "@value": "Email address, as defined in [RFC 3696](https://datatracker.ietf.org/doc/rfc3696/) Section 3."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "email"
      }
    ]
  },
