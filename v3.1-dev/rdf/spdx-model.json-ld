    "http://www.w3.org/ns/shacl#class": [
      {
        "@id": "https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm"
      }
    ],
    "http://www.w3.org/ns/shacl#in": [
      {
        "@list": [
          {
            "@id": "https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/adler32"
          },
          {
            "@id": "https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/blake2b256"
