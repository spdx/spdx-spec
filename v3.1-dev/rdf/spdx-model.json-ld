    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Uniquely identifies an external element."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/gtin",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "[Global Trade Item Number (GTIN)](https://www.gs1.org/standards/id-keys/gtin) is a number, assigned by GS1, that uniquely identifies a trade item (product or service)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "gtin"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/Bom",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/ns/shacl#NodeShape"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A container for a grouping of SPDX 3 content characterizing details\n(provenance, composition, licensing, etc.) about a product."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/Bundle"
      }
    ],
    "http://www.w3.org/ns/shacl#nodeKind": [
      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ],
    "http://www.w3.org/ns/shacl#property": [
      {
        "@id": "_:Nf1fa66473f7a44dfbc6185151a62e838"
      }
    ],
    "http://www.w3.org/ns/shacl#sparql": [
      {
        "@id": "_:N5b6e6f24618b4f44976955978c661277"
      }
    ]
  },
  {
    "@id": "_:N5b6e6f24618b4f44976955978c661277",
    "@type": [
      "http://www.w3.org/ns/shacl#SPARQLConstraint"
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@value": "A value for Core/name is required when a value for Core/version is present"
      }
    ],
    "http://www.w3.org/ns/shacl#select": [
      {
        "@value": "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Software/version> ?version .\n    FILTER NOT EXISTS {\n        $this <Software/name> ?name .\n    }\n}"
      }
    ]
  },
  {
    "@id": "_:Nf1fa66473f7a44dfbc6185151a62e838",
    "http://www.w3.org/ns/shacl#datatype": [
