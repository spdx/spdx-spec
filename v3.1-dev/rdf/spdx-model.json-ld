        "@value": "References the Element on the left-hand side of a relationship."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Core/Element"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/algorithm",
    "@type": [
