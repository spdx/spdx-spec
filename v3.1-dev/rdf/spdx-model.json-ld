        "@id": "_:N25e0b6f48ce4489594d06547dbffd467"
      },
      {
        "@id": "_:N68fc87ef79b84426b3899260f10c692c"
      }
    ]
  },
  {
    "@id": "_:N25e0b6f48ce4489594d06547dbffd467",
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "https://spdx.org/rdf/3/terms/Core/Location is an abstract class and should not be instantiated directly. Instantiate a subclass instead."
      }
    ],
    "http://www.w3.org/ns/shacl#not": [
