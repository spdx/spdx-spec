        "@value": "Online Certificate Status Protocol, or OCSP, is a common scheme used to maintain the security of a server and other network resources."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "ocsp"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel/autonomous",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Level 6 - Autonomous. The system is capable of modifying its intended domain of use or its goals without external intervention, control or oversight."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "autonomous"
      }
    ]
  },
