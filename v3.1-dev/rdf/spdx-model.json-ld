    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "dynamicAnalysisReport"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/builtTime",
