    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Points to a resource outside the scope of the SPDX 3 content\nthat provides additional characteristics of an Element."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
