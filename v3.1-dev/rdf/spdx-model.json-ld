      {
        "@language": "en",
        "@value": "Provides a set of values to be used to describe the common types of SBOMs that\ntools may create."
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/SupportType/noSupport",
