  {
    "@id": "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/iswc",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "[International Standard Musical Work Code (ISWC)](https://www.iswc.org/iswc) is an 11-character unique identifier standardized by [ISO 15707](https://www.iso.org/standard/83125.html) for musical works (compositions) as distinct from specific recordings. While the \"ISWC\" label and grouping separators (dots and hyphens) are used for human readability, they shall be omitted when the identifier is stored electronically (e.g., `T0017812031`)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "iswc"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/RelationshipType/follows",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/RelationshipType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The `to` Element succeeds the `from` Element, establishing a unidirectional sequence. This succession is defined as chronological, procedural, or logical. It is used to represent either a temporal order (e.g., in a workflow) or a logical order for processing and traversal (e.g., in an ordered list)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "follows"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/ExpandedLicensing/isFsfLibre",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Specifies whether the License is listed as free by the\nFree Software Foundation (FSF)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/AI/AgentTrustLevel/selfDeclared",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/AI/AgentTrustLevel"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The agent's developer or operator has described its behavior, but no one else has checked those claims. Suitable for internal or sandboxed use where the declaring party is trusted."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "selfDeclared"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/RelationshipType/usesTool",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/RelationshipType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The `from` Element uses each `to` Element as a tool, during a LifecycleScopeType period."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "usesTool"
      }
    ]
  },
