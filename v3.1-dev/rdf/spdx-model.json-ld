        "@value": "phoneNumber"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasTestCase",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
