    "@id": "https://spdx.org/rdf/3/terms/Core/LifecycleScopeType/test",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3/terms/Core/LifecycleScopeType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A relationship has specific context implications during an element's testing phase, during development."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "test"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/description",
