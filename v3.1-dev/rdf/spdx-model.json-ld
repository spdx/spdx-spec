      {
        "@id": "http://www.w3.org/ns/shacl#IRI"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType/decommission",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A relationship has specific context implications for a product's retirement and/or decommissioning."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "decommission"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasOutput",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "https://spdx.org/rdf/3.1/terms/Core/RelationshipType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The `from` Build, DefinedProcess or Action element generates each `to` Element as an output."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "hasOutput"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/SupplyChain/State",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A state is an instance that describes what a system, component, subsystem, process, or project has achieved at any given time."
      }
