        "@value": "Type of data in a dataset."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://spdx.org/rdf/3/terms/Dataset/DatasetType"
      }
    ]
  },
  {
