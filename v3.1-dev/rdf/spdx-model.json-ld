      {
        "@language": "en",
        "@value": "The Element is an operating system."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "operatingSystem"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3.1/terms/Core/RelationshipType/underInvestigationFor",
