    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Designates a `from` /Security/Vulnerability was originally discovered by the `to` Agent(s)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "foundBy"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Security/ExploitCatalogType",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
