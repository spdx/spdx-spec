        "@value": "Identifies the text of one or more copyright notices for a software Package,\nFile or Snippet, if any."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
