    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "verifiedBy"
      }
    ]
  },
  {
    "@id": "https://spdx.org/rdf/3/terms/Core/HashAlgorithm/sha224",
    "@type": [
