_:N5d7525d63ee745459fe54e441f13d90f <http://www.w3.org/ns/shacl#select> "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/hasRoleIn> .\n    FILTER NOT EXISTS { $this rdf:type <Core/RoleRelationship> }\n}" .
