["https://spdx.org/rdf/3.1/terms/Software/FileKindType/file", "http://www.w3.org/2000/01/rdf-schema#comment", "The file represents a single file (default).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/ExpandedLicensing/OrLaterOperator", "http://www.w3.org/ns/shacl#nodeKind", "http://www.w3.org/ns/shacl#IRI", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/ExpandedLicensing/License", "http://www.w3.org/ns/shacl#property", "_:Nfd19dba122e94bd083a5d43d2a88b2be", "localId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/isci", "http://www.w3.org/2000/01/rdf-schema#comment", "International Standard Collection Identifier (ISCI) is a variable-length identifier standardized by [ISO 27730](https://www.iso.org/standard/44293.html) for identifying collections held by libraries, archives, museums, and other memory institutions. It consists of two parts: the identifier for the assigning organization (an ISIL) enclosed in square brackets, followed by a local collection identifier string (e.g., `[FR-751041001]Casadesus1`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/from", "http://www.w3.org/2000/01/rdf-schema#comment", "References the Element on the left-hand side of a relationship.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
