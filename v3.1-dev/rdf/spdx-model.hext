["https://spdx.org/rdf/3/terms/Core/elementValue", "http://www.w3.org/2000/01/rdf-schema#comment", "A value used in a key-value pair with a generic key that refers to an Element", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ProfileIdentifierType/hardware", "http://www.w3.org/2000/01/rdf-schema#comment", "The element follows the Hardware profile specification.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
