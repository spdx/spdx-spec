["_:N3e838dcca6374898a5e06c348a633169", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/hasInstall> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Artifact> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3/terms/Security/VexJustificationType/vulnerableCodeNotPresent", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["_:Nba3ee195050b4819abbad2efe9f8a3d2", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/conformsTo> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <FunctionalSafety/Assumption> }\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Specification> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/WithAdditionOperator", "http://www.w3.org/ns/shacl#property", "_:Nba42794e54b04aba9a8129a0558a3af5", "localId", "", ""]
["_:Nf07e593474e04396a54e5ee2196b81e1", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/providesSupportFor> .\n    FILTER NOT EXISTS { $this rdf:type <Core/SupportRelationship> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["_:Nc75f4343469a431f910c1fa1994c1808", "http://www.w3.org/ns/shacl#datatype", "http://www.w3.org/2001/XMLSchema#string", "globalId", "", ""]
["_:N776d702b186548c7bc55a7919e443c73", "http://www.w3.org/ns/shacl#class", "https://spdx.org/rdf/3/terms/Core/RequirementStatusType", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Software/ContentIdentifierType/swhid", "http://www.w3.org/2000/01/rdf-schema#comment", "SoftWare Hash IDentifier, a persistent intrinsic identifier for digital artifacts, such as files, trees (also known as directories or folders), commits, and other objects typically found in version control systems. The format of the identifiers is defined in the [SWHID specification](https://www.swhid.org/swhid-specification/v1.2/) ([ISO/IEC 18670](https://www.iso.org/standard/89985.html)). They typically look like `swh:1:cnt:94a9ed024d3859793618152ea559a168bbcbb5e2`.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
