["https://spdx.org/rdf/3/terms/Security/CvssSeverityType/critical", "http://www.w3.org/2000/01/rdf-schema#comment", "When a CVSS score is between 9.0 - 10.0.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N8c4d1918105d49bca4b914561476c679", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3/terms/Build/environment", "globalId", "", ""]
