["https://spdx.org/rdf/3/terms/Core/ProcessReadinessType/active", "http://www.w3.org/2000/01/rdf-schema#comment", "In use.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N1e6ef81efd9144d4a93f1f9140657731", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:N6af45df6ea6f4da4af39f91474a39b3d", "localId", "", ""]
["https://spdx.org/rdf/3/terms/Core/IsoAutomationLevel/fullAutomation", "http://www.w3.org/2000/01/rdf-schema#comment", "Level 5 - Full automation. The system is capable of performing its entire mission without external intervention.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nb81b87790d8f45b393a2326826eddd23", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Security/VexJustificationType/vulnerableCodeNotInExecutePath", "globalId", "", ""]
