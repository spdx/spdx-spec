["https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/bom", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3.1/terms/Core/ExternalRefType", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/isni", "http://www.w3.org/2000/01/rdf-schema#comment", "[International Standard Name Identifier (ISNI)](https://isni.org/page/what-is-isni/) is a unique identifier used to distinguish the public identities of parties involved in the creation, production, and distribution of media content. Standardized by [ISO 27729](https://www.iso.org/standard/87177.html), it consists of 16 characters\u201415 digits plus a final check character\u2014and is often represented as a URI, such as `https://isni.org/isni/000000012146438X`.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nb986c1b7dcbc4e71beecf27d608e39bc", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:N503bfd38e89b433886cfb9d923f86d39", "localId", "", ""]
["_:N4b63dcf4102045658caa0233478a6110", "http://www.w3.org/ns/shacl#class", "https://spdx.org/rdf/3.1/terms/Software/Sbom", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/isan", "http://www.w3.org/2000/01/rdf-schema#comment", "[International Standard Audiovisual Number (ISAN)](https://www.isan.org/about/#what_is_isan) is a unique 24-digit hexadecimal identifier for audiovisual works standardized by [ISO 15706](https://www.iso.org/standard/83124.html). The ISAN remains persistent for a work regardless of its distribution format or its use. To facilitate human readability, the \"ISAN\" label, grouping hyphens, and two check characters are included (e.g., `ISAN 0000-0000-3A8D-0000-Z-0000-0000-6`); however, these elements shall be omitted when the identifier is stored electronically (e.g., `000000003A8D000000000000`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/ExpandedLicensing/NoAssertionLicense", "http://www.w3.org/2002/07/owl#sameAs", "https://spdx.org/rdf/3.1/terms/Licensing/NoAssertion", "globalId", "", ""]
