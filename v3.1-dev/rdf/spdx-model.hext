["https://spdx.org/rdf/3/terms/Build/configSourceUri", "http://www.w3.org/2000/01/rdf-schema#comment", "Property that describes the URI of the build configuration source file.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
