["https://spdx.org/rdf/3/terms/ExpandedLicensing/ExtendableLicense", "http://www.w3.org/2000/01/rdf-schema#comment", "Abstract class representing a License or an OrLaterOperator.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
