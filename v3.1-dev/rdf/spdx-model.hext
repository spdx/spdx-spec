["_:Nbb1a072c28024b7abdfc10b189ecc5c7", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/doesNotAffect> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
