["https://spdx.org/rdf/3/terms/Service/AuthenticationProtocolType/tls", "http://www.w3.org/2000/01/rdf-schema#comment", "Transport Layer Security, or TLS, is a widely adopted security protocol designed to facilitate privacy and data security for communications over the Internet.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N09cb15613d9b4281aa17f67d0b51e8d8", "http://www.w3.org/ns/shacl#minCount", "1", "http://www.w3.org/2001/XMLSchema#integer", "", ""]
