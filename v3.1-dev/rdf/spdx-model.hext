["_:Naf0060e2d987477c954acbf78dfae61d", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/performedBy> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Action> }\n    FILTER NOT EXISTS { ?from <Core/relationshipType> <Core/RelationshipType/hasInstall> }\n    FILTER NOT EXISTS { ?from <Core/relationshipType> <Core/RelationshipType/hasUninstall> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/hasUninstall", "http://www.w3.org/2000/01/rdf-schema#comment", "The `from` Element has each `to` Artifact uninstalled (removed from position for use) from it during a LifecycleScopeType period. To express the Agent doing the uninstall, link this relationship as the `from` in `performedBy`.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
