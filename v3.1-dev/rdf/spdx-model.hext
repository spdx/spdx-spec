["_:N34ceefe1552f4e2abfadfc5dce89ec7a", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/implementedBy> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Requirement> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
