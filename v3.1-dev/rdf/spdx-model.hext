["https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/evidence", "http://www.w3.org/2000/01/rdf-schema#comment", "The Element is the evidence that a specification or requirement has been fulfilled.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/AI/SafetyRiskAssessmentType", "http://www.w3.org/2000/01/rdf-schema#comment", "Safety risk level.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ecli", "http://www.w3.org/2000/01/rdf-schema#comment", "[European Case Law Identifier (ECLI)](https://data.europa.eu/data/datasets/european-case-law-identifier-ecli) is a uniform identifier for judicial decisions across Europe. It consists of five mandatory components: the \"ECLI\" prefix, a country code, a court code, the year of the decision, and a unique serial number (e.g., `ECLI:EU:C:2023:94`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/plannedCurrentResponsibleAgent", "http://www.w3.org/2000/01/rdf-schema#comment", "This is the planned individual, business, or organization who currently manages or responsible for the goods, services, or assets.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
