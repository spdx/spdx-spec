["https://spdx.org/rdf/3/terms/Core/headquartersLocation", "http://www.w3.org/2000/01/rdf-schema#comment", "A location of the organization's headquarters.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
