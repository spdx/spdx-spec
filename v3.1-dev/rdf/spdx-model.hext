["_:Nb69f9abdd49940cf9c783edf25ac0457", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3.0.1/terms/Security/SsvcDecisionType/act", "globalId", "", ""]
