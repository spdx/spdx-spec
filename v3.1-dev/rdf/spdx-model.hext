["https://spdx.org/rdf/3/terms/FunctionalSafety/SafetyIntegrityLevelType/dalE", "http://www.w3.org/2000/01/rdf-schema#comment", "Design Assurance Level E for aviation software assurance.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
