["https://spdx.org/rdf/3/terms/Software/downloadLocation", "http://www.w3.org/2000/01/rdf-schema#comment", "Identifies the download Uniform Resource Identifier for the package at the time\nthat the document was created.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
