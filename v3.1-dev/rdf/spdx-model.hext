["https://spdx.org/rdf/3/terms/Build/buildId", "http://www.w3.org/2000/01/rdf-schema#comment", "A buildId is a locally unique identifier used by a builder to identify a unique\ninstance of a build produced by it.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/listVersionAdded", "http://www.w3.org/2000/01/rdf-schema#comment", "Specifies the SPDX License List version in which this ListedLicense or\nListedLicenseException identifier was first added.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/ResponsibilityType/custody", "http://www.w3.org/2000/01/rdf-schema#comment", "Custody refers to the responsibility, control, and safekeeping of an asset, person, or legal entity. It involves both physical possession and legal accountability over something.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
