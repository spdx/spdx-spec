["https://spdx.org/rdf/3.1/terms/Hardware/itemVersion", "http://www.w3.org/2000/01/rdf-schema#comment", "Version identifier for the item.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
