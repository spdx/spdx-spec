["https://spdx.org/rdf/3/terms/Software/sourceInfo", "http://www.w3.org/2000/01/rdf-schema#comment", "Records any relevant background information or additional comments\nabout the origin of the package.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N95ad83469b0a488db5e32fe0ecbbec1d", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:N1b3908ad9df44f1e955c5627c666b148", "localId", "", ""]
