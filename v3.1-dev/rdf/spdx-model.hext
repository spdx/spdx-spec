["_:Nde0d447a9bd34bba95592b5d7de7c87e", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/exploitCreatedBy> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Agent> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
