["_:Nd695ff57620e40b485a3dae79922b3c1", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:Nb1a504d7d5dc4bb1818ab54caac32a3d", "localId", "", ""]
["https://spdx.org/rdf/3/terms/ExpandedLicensing/subjectAddition", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#ObjectProperty", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ElementMap", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/ns/shacl#NodeShape", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/scope", "http://www.w3.org/2000/01/rdf-schema#comment", "Capture the scope of information about a specific relationship between elements.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N2652b21fc0fc4e2fb6f75ef5d7800995", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/hasResolution> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <SupplyChain/OutOfSpecAction> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["_:N5601f33e555c4fababdbb458d24d6707", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Core/PresenceType/no", "globalId", "", ""]
