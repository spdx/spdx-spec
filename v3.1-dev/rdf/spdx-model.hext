["_:Nf9641be3d93644f0992c58c9d5077cfa", "http://www.w3.org/ns/shacl#class", "https://spdx.org/rdf/3.1/terms/Core/Specification", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Software/SbomType/analyzed", "http://www.w3.org/2000/01/rdf-schema#comment", "SBOM generated through analysis of artifacts (e.g., executables, packages, containers, and virtual machine images) after its build. Such analysis generally requires a variety of heuristics. In some contexts, this may also be referred to as a \"3rd party\" SBOM.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N74507c35c3a44c81be85ec0e3f9ec98c", "http://www.w3.org/1999/02/22-rdf-syntax-ns#rest", "_:N1fc90affc35241eaa5f0f20e4966f962", "localId", "", ""]
["https://spdx.org/rdf/3.1/terms/Software/snippetFromFile", "http://www.w3.org/2000/01/rdf-schema#comment", "Defines the original host file that the snippet information applies to.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/hsCodes", "http://www.w3.org/2000/01/rdf-schema#comment", "The [Harmonized System (HS)](https://www.wcoomd.org/en/topics/nomenclature/overview/what-is-the-harmonized-system.aspx) of tariff nomenclature is an internationally standardized system of names and numbers, defined by the World Customs Organization, used to classify traded products.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
