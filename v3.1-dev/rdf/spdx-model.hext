["https://spdx.org/rdf/3/terms/SupplyChain/HarvestProcess", "http://www.w3.org/2000/01/rdf-schema#comment", "Harvest is the process of extracting goods or products from nature.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Dataset/DatasetAvailabilityType/scrapingScript", "http://www.w3.org/2000/01/rdf-schema#comment", "Dataset provider is not making available the underlying data and the dataset shall be reassembled, typically using the provided script for scraping the data.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Dataset/DatasetType/categorical", "http://www.w3.org/2000/01/rdf-schema#comment", "Data that is classified into a discrete number of categories, such as the eye color of a population of people.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
