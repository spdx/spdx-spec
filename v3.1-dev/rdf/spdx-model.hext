["https://spdx.org/rdf/3.1/terms/Core/ExternalRefType/securityThreatModel", "http://www.w3.org/2000/01/rdf-schema#comment", "A reference to the [security threat model](https://en.wikipedia.org/wiki/Threat_model) for a package.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N1584fe233b33418ea347a7e53b95ea2a", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType/directDownload", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/SupplyChain/AssemblyProcess", "http://www.w3.org/2000/01/rdf-schema#comment", "The AssemblyProcess represents the process of creating a product by assembling a set of components, potentially in a way that allows for at disassembly (at least partially).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Dataset/DatasetAvailabilityType/clickthrough", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["_:Na1f61dc39e984d19b7287f947b3ba65f", "http://www.w3.org/ns/shacl#nodeKind", "http://www.w3.org/ns/shacl#Literal", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Dataset/ConfidentialityLevelType/amber", "http://www.w3.org/2000/01/rdf-schema#label", "amber", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ismn", "http://www.w3.org/2000/01/rdf-schema#comment", "[International Standard Music Number (ISMN)](https://ismn-international.org/ismn/the-ismn/) is a unique numeric identifier for printed music (notated music) standardized by [ISO 10957](https://www.iso.org/standard/83122.html). It consists of either 10 characters (starting with the letter \"M\" for assignments prior to January 1, 2008) or 13 digits. A 13-digit ISMN is composed of four parts: the GS1 prefix `979-0`, a registrant element, an item element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., `9790006538424`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N781dac9fcb8340439bb504f77e3af205", "http://www.w3.org/ns/shacl#path", "https://spdx.org/rdf/3.1/terms/Core/context", "globalId", "", ""]
