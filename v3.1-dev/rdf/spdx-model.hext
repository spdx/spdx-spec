["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/duns", "http://www.w3.org/2000/01/rdf-schema#comment", "[Data Universal Numbering System (D-U-N-S) Number](https://www.dnb.com/en-us/smb/duns.html) is a unique nine-digit identifier, issued by Dun & Bradstreet, that identifies a business entity, often on a location-specific basis.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Hardware/Dimensions", "http://www.w3.org/2000/01/rdf-schema#comment", "Dimensions generally refer to measurable extents or attributes that define the size, shape, or scale of an object, system, or concept.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/SupplyChain/UseProcess", "http://www.w3.org/2000/01/rdf-schema#comment", "Use Process defines actions used by elements.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/framework", "http://www.w3.org/2000/01/rdf-schema#comment", "The Element is a software framework.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
