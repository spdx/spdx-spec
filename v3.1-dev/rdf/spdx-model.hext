["https://spdx.org/rdf/3/terms/Security/VulnAssessmentRelationship", "http://www.w3.org/2000/01/rdf-schema#comment", "Abstract ancestor class for all vulnerability assessments.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/SupplyChain/BoundaryCrossingAction", "http://www.w3.org/2000/01/rdf-schema#comment", "An action of crossing a boundary is defined in this class.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
