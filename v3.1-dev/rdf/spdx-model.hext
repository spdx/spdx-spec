["https://spdx.org/rdf/3/terms/AI/EnergyUnitType/other", "http://www.w3.org/2000/01/rdf-schema#comment", "Any other units of energy measurement.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
