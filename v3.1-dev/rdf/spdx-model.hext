["https://spdx.org/rdf/3.1/terms/Hardware/partNumber", "http://www.w3.org/2000/01/rdf-schema#comment", "Product Part Number as defined by OEM.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
