["https://spdx.org/rdf/3.1/terms/Core/LifecycleScopeType/runtime", "http://www.w3.org/2000/01/rdf-schema#comment", "A relationship has specific context implications during the execution phase of an element.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
