["https://spdx.org/rdf/3/terms/Core/specType", "http://www.w3.org/2000/01/rdf-schema#comment", "A specification type defines the nature of a specification.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/EvaluationResultType/inconclusive", "http://www.w3.org/2000/01/rdf-schema#comment", "Inconclusive refers to a result or outcome from a verification, test, or analysis that cannot be clearly classified as either positive (successful, pass) or negative (failed, reject). An inconclusive result means there was not enough clear evidence, data, or signal to make a definitive determination, and further investigation or additional testing is necessary. An inconclusive result always shall need a comment on it.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/demonstration", "http://www.w3.org/2000/01/rdf-schema#comment", "Demonstrating and monitoring or recording that the item under verification to confirm that a requirement is met by the item under verification.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Build/buildStartTime", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#DatatypeProperty", "globalId", "", ""]
