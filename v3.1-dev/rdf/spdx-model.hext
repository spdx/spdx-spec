["https://spdx.org/rdf/3/terms/Service/KeyValidationProtocolType/ocsp", "http://www.w3.org/2000/01/rdf-schema#comment", "Online Certificate Status Protocol, or OCSP, is a common scheme used to maintain the security of a server and other network resources as defined in [RFC 2560](https://datatracker.ietf.org/doc/rfc2560/)", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Dataset/DatasetType/text", "http://www.w3.org/2000/01/rdf-schema#comment", "Data consists of unstructured text, such as a book, a Wikipedia article (without images), or a transcript.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
