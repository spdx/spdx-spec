["_:N5c6eb9787e0945b8a6e05d1ca32efb79", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Dataset/DatasetType/structured", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalRefType/cwe", "http://www.w3.org/2000/01/rdf-schema#comment", "[Common Weakness Enumeration](https://csrc.nist.gov/glossary/term/common_weakness_enumeration). A reference to a source of software flaws defined within the official [CWE List](https://cwe.mitre.org/data/) that conforms to the [CWE specification](https://cwe.mitre.org/).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Software/FileKindType", "http://www.w3.org/2000/01/rdf-schema#comment", "Enumeration of the different kinds of SPDX file.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/assumes", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3/terms/Core/RelationshipType", "globalId", "", ""]
