["https://spdx.org/rdf/3.1/terms/Core/MeasureOfMass", "http://www.w3.org/2000/01/rdf-schema#comment", "The measure of mass refers to the quantity of matter in an object or substance.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
