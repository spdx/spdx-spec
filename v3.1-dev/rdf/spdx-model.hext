["https://spdx.org/rdf/3.1/terms/SimpleLicensing/customIdToLicense", "http://www.w3.org/2000/01/rdf-schema#comment", "Maps a \"LicenseRef-\" string for a custom license or a \"AdditionRef-\" string for\na custom license addition to a `CustomLicense`, a `CustomLicenseAddition`, or a\n`SimpleLicensingText`.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasDeclaredLicense", "http://www.w3.org/2000/01/rdf-schema#comment", "The `from` Artifact was discovered to actually contain each `to` AnyLicenseInfo (for example, as detected by automated tooling).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasHost", "http://www.w3.org/2000/01/rdf-schema#comment", "The `from` Build was run on the `to` Element during a LifecycleScopeType period (e.g. the host that the build runs on).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
