["https://spdx.org/rdf/3.1/terms/Core/postOfficeBoxNumber", "http://www.w3.org/2000/01/rdf-schema#comment", "The number that identifies a PO box. A PO box is a box in a post office or other postal service location assigned to an organization where postal items may be kept.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N53d5dd8e321c4062957ebf81dd50c32d", "http://www.w3.org/ns/shacl#class", "https://spdx.org/rdf/3.1/terms/AI/EnergyConsumptionDescription", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ibid", "http://www.w3.org/2000/01/rdf-schema#comment", "[International Business Identifier (IBID)](https://ekys.org/business_identifiers/) is a verifiable unique identifier for legal entities as defined in the [ISO/DIS 25500-3](https://www.iso.org/standard/87705.html) draft standard. It is composed of three data elements: the International Business Registration Number (IBRN), the legal name, and the date of origin formatted as eight numeric characters (YYYYMMDD). Each element is separated by a pipe character (`|`) (e.g., `US-DE.BER:3031657|Code Management Association|19990420`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N0d159b42cda64d30877e5d935e581faa", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/nli", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/sha3_384", "http://www.w3.org/2000/01/rdf-schema#comment", "SHA-3 with a digest length of 384, as defined in [FIPS 202](https://csrc.nist.gov/pubs/fips/202/final).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Service/SoftwareService", "http://www.w3.org/ns/shacl#property", "_:Ne30651bddcbf40458ed5d7f4d0a18425", "localId", "", ""]
