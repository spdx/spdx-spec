["https://spdx.org/rdf/3.1/terms/Software/SoftwarePurpose/operatingSystem", "http://www.w3.org/2000/01/rdf-schema#comment", "The Element is an operating system.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/isni", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["_:Nb72ed282f0f04c63a455c102782bc24e", "http://www.w3.org/ns/shacl#in", "_:Ne6da38af509c42d88fc9b36788697d1b", "localId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/RelationshipType/hasVariant", "http://www.w3.org/2000/01/rdf-schema#comment", "Every `to` Element is a variant the `from` Element (`from` hasVariant `to`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/RelationshipType/assumes", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3.1/terms/Core/RelationshipType", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/FunctionalSafety/EvidenceRelationship", "http://www.w3.org/ns/shacl#nodeKind", "http://www.w3.org/ns/shacl#IRI", "globalId", "", ""]
["https://spdx.org/rdf/3.1/terms/Software/attributionText", "http://www.w3.org/2000/01/rdf-schema#comment", "Provides a place for the SPDX data creator to record acknowledgement text for\na software Package, File or Snippet.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType/ismn", "http://www.w3.org/2000/01/rdf-schema#comment", "[International Standard Music Number (ISMN)](https://ismn-international.org/ismn/the-ismn/) is a unique numeric identifier for printed music (notated music) standardized by [ISO 10957](https://www.iso.org/standard/83122.html). It consists of either 10 characters (starting with the letter \"M\" for assignments prior to January 1, 2008) or 13 digits. A 13-digit ISMN is composed of four parts: the GS1 prefix `979-0`, a registrant element, an item element, and a check digit. While elements may be divided by spaces or hyphens for human readability, these separators shall be omitted when the identifier is stored electronically (e.g., `9790006538424`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm/md2", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "https://spdx.org/rdf/3.1/terms/Core/HashAlgorithm", "globalId", "", ""]
