["_:Na6f5da6d62134e0ca608cb161c6bc7cd", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/createdBy> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Agent> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
