["https://spdx.org/rdf/3.1/terms/Core/ContactPointRelationship", "http://www.w3.org/2000/01/rdf-schema#comment", "A contact point from an Artifact to an Agent.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
