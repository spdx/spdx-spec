["_:N2883dc257cff447eacfc77c02392fc60", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/republishedBy> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["_:Nd7815108619c4a00b090f92f5fc8e635", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/ns/shacl#SPARQLConstraint", "globalId", "", ""]
