["_:Nf927a813e2b3491fb395ae232aae5305", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    FILTER NOT EXISTS { $this <Core/country> ?country . }\n    FILTER NOT EXISTS { $this <Core/city> ?city . }\n    FILTER NOT EXISTS { $this <Core/streetAddress> ?streetAddress . }\n    FILTER NOT EXISTS { $this <Core/geographicPointLocation> ?point . }\n    FILTER NOT EXISTS { $this <Core/name> ?name . }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/rorid", "http://www.w3.org/2000/01/rdf-schema#label", "rorid", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3/terms/Core/ExternalIdentifierType/ibid", "http://www.w3.org/2000/01/rdf-schema#comment", "[International Business Identifier (IBID)](https://ekys.org/business_identifiers/) is a verifiable unique identifier for legal entities as defined in the [ISO/DIS 25500-3](https://www.iso.org/standard/87705.html) draft standard. It is composed of three data elements: the International Business Registration Number (IBRN), the legal name, and the date of origin formatted as eight numeric characters (YYYYMMDD). Each element is separated by a pipe character (`|`) (e.g., `US-DE.BER:3031657|Code Management Association|19990420`).", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/AI/EnergyUnitType/kilowattHour", "http://www.w3.org/2000/01/rdf-schema#comment", "Kilowatt-hour.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
