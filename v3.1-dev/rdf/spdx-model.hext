["_:N96e1506b24214607bd53c50dcc8dc3f5", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/file", "globalId", "", ""]
