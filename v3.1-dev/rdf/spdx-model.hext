["https://spdx.org/rdf/3/terms/Core/additionalInformationSpecification", "http://www.w3.org/2000/01/rdf-schema#comment", "An authoritative or credible entity, document, or body of knowledge\nthat provides the meaning of an `additionalInformation` key and/or its values,\nensuring accuracy, context, and standardization.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N4a7c530bb49147709e2f32d9e91161ef", "http://www.w3.org/ns/shacl#message", "When relationship is performedBy, to must be an Agent", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/VerificationType/inspection", "http://www.w3.org/2000/01/rdf-schema#comment", "A thorough examination or checking of documentation, records, processes, or systems to confirm compliance or adherence. An inspection needs to have a defined set of acceptance criteria (e.g. a checklist), a documentation of roles involved in the inspection (e.g. to document the inspector's independence) and a clear documentation of when and how it was performed.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:Nac1d55d1a37444cc859e485c5a268769", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "https://spdx.org/rdf/3/terms/Software/SoftwarePurpose/requirement", "globalId", "", ""]
["_:N4651ceb35438413e85172dee2aeb3190", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/invokedBy> .\n    FILTER NOT EXISTS { $this rdf:type <Core/LifecycleScopedRelationship> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
