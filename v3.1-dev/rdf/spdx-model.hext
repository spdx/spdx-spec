["https://spdx.org/rdf/3/terms/ExpandedLicensing/seeAlso", "http://www.w3.org/2000/01/rdf-schema#comment", "Contains a URL where the License or LicenseAddition can be found in use.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/Core/contentType", "http://www.w3.org/2000/01/rdf-schema#comment", "Provides information about the content type of an Element or a property.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["https://spdx.org/rdf/3/terms/FunctionalSafety/EvidenceType/recording", "http://www.w3.org/1999/02/22-rdf-syntax-ns#type", "http://www.w3.org/2002/07/owl#NamedIndividual", "globalId", "", ""]
["https://spdx.org/rdf/3/terms/Core/RelationshipType/hasRoleIn", "http://www.w3.org/2000/01/rdf-schema#comment", "The `from` Element has a role in the `to` Element. The use of the `hasRoleIn` type is constrained to `RoleRelationship` classed relationships. The type of role can be specified using a `givenRole` property on the `to` Element.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
