["_:N4036b976c0a2498fbcabee2d38da210b", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/assumes> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <FunctionalSafety/Assumption> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
