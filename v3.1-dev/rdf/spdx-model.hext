["_:N0303d074bc554a149251b63b9c493692", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/affects> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Security/Vulnerability> }\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Action> }\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/DefinedProcess> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["_:N968b2cdaca394f5e82d24da0d72af8f3", "http://www.w3.org/ns/shacl#in", "_:N7b3fb510ca844e1db0922b56d0670bb1", "localId", "", ""]
["_:N4342cab6c3e54818b76afa56fd173e53", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/dependsOn> .\n    FILTER NOT EXISTS { $this rdf:type <Core/LifecycleScopedRelationship> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["https://spdx.org/rdf/3/terms/Core/endTime", "http://www.w3.org/2000/01/rdf-schema#comment", "The point in time when an element or an action ends,\nbecomes no longer applicable, or becomes no longer valid.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
["_:N46d365952be645498e970e9d1e61fdd9", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/verifiedBy> .\n    $this <Core/from> ?from .\n    FILTER NOT EXISTS { ?from rdf:type/rdfs:subClassOf* <Core/Requirement> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
["_:Nc5641d4ae2a5437282dd8354d89d4c8a", "http://www.w3.org/ns/shacl#class", "https://spdx.org/rdf/3/terms/ExpandedLicensing/ListedLicenseException", "globalId", "", ""]
