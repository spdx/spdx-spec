["_:N0bd5b7a613e14c2684c51ae356f4258b", "http://www.w3.org/ns/shacl#select", "BASE <https://spdx.org/rdf/3/terms/>\nSELECT $this WHERE {\n    $this <Core/relationshipType> <Core/RelationshipType/foundBy> .\n    $this <Core/to> ?to .\n    FILTER NOT EXISTS { ?to rdf:type/rdfs:subClassOf* <Core/Agent> }\n}", "http://www.w3.org/2001/XMLSchema#string", "", ""]
