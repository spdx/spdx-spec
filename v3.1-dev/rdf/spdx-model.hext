["_:Neabe15426525469b8424cc2a6382cd9f", "http://www.w3.org/1999/02/22-rdf-syntax-ns#first", "_:Nfcc8f4c9b3c54d4a8e8c7aa7625297f3", "localId", "", ""]
["https://spdx.org/rdf/3.1/terms/Core/IsoAutomationLevel/partialAutomation", "http://www.w3.org/2000/01/rdf-schema#comment", "Level 2 - Partial automation or task automation. Some sub-functions of the system are fully automated while the system remain under control of an external agent. The system can perform actions for an approved task without requiring the agent's continuous direct control.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
