["https://spdx.org/rdf/3.1/terms/Core/ExternalIdentifierType", "http://www.w3.org/2000/01/rdf-schema#comment", "Specifies the type of an external identifier.", "http://www.w3.org/1999/02/22-rdf-syntax-ns#langString", "en", ""]
